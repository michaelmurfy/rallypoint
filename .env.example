# Rallypoint server settings. `make config` copies this to .env; edit it and run `make restart`.
# Keep comments on their own lines (make reads this file too).

# UDP port players connect to.
PORT=7777

# Only let players from these countries connect: two-letter codes, comma separated, e.g. NZ or NZ,AU.
# Empty means anyone can connect. `make up` downloads the matching IP lists for you.
ALLOWED_COUNTRIES=

# Keep letting local-network addresses (10.x, 192.168.x, 172.16-31.x, 127.x) through the country limit.
ALLOW_PRIVATE=true

# Which released server image to run (default: latest). Pin one with e.g. RELAY_TAG=0.2.0-beta.4
#RELAY_TAG=latest
