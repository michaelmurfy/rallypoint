+	STDMETHOD_(UINT, GetAvailableTextureMem)(THIS) override { NULLGFX_UNUSED_PARAMS; return 0; }
+	STDMETHOD(ResourceManagerDiscardBytes)(THIS_ DWORD Bytes) override { NULLGFX_UNUSED_PARAMS; return D3D_OK; }
