+struct PostCfg
+{
+	float bloomThreshold = 0.92f, bloomKnee = 0.25f, bloomIntensity = 0.16f, saturation = 1.04f, contrast = 1.03f;
+	bool fxaa = false;
+	float aoStrength = 0.85f, aoRadius = 22.0f;
