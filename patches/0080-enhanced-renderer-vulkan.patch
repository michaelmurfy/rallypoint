+// Timed screenshots for comparing renderers: GENERALS_SHOTS="2,4,6" (seconds of game time, 30 logic frames each), GENERALS_SHOTDIR, GENERALS_SHOTTAG
+static Bool timedScreenshotDue( char *path, size_t size )
