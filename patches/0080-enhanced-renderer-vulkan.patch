+	STDMETHOD(SetCursorProperties)(THIS_ UINT XHotSpot,UINT YHotSpot,IDirect3DSurface8* pCursorBitmap) override { NULLGFX_UNUSED_PARAMS; return D3D_OK; }
+	STDMETHOD_(void, SetCursorPosition)(THIS_ UINT XScreenSpace,UINT YScreenSpace,DWORD Flags) override { NULLGFX_UNUSED_PARAMS;  }
+	STDMETHOD_(BOOL, ShowCursor)(THIS_ BOOL bShow) override { NULLGFX_UNUSED_PARAMS; return 0; }
+	STDMETHOD(CreateAdditionalSwapChain)(THIS_ D3DPRESENT_PARAMETERS* pPresentationParameters,IDirect3DSwapChain8** pSwapChain) override { NULLGFX_UNUSED_PARAMS; return D3D_OK; }
+	STDMETHOD(Reset)(THIS_ D3DPRESENT_PARAMETERS* pPresentationParameters) override { NULLGFX_UNUSED_PARAMS; return D3D_OK; }
+	STDMETHOD(Present)(THIS_ CONST RECT* pSourceRect,CONST RECT* pDestRect,HWND hDestWindowOverride,CONST RGNDATA* pDirtyRegion) override { NULLGFX_UNUSED_PARAMS; return D3D_OK; }
