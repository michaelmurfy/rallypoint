+static uint32_t s_crcFrames[64][2];
+static unsigned s_crcFramesNext = 0;
+
+void RelayWire_NoteCrc(uint32_t frame, uint32_t crc)
+{
+  s_crcFrames[s_crcFramesNext % 64][0] = frame;
+  s_crcFrames[s_crcFramesNext % 64][1] = crc;
+  ++s_crcFramesNext;
+}
+
 // Tell the agent our simulation checksum for a frame; it passes it to the relay, which compares all players'.
 void RelayWire_ReportCrc(uint32_t frame, uint32_t crc, bool host)
 {
   const RelayWire::Config &relay = RelayWire::config();
   if (!relay.on)
     return;
+  // `frame` is when the message was executed, which differs between the players (a game with real simulation
+  // differences was not the problem on 2026-10-26: the relay compared the checksum of frame 50 with that of frame 30).
+  // File the checksum under the frame it was taken at, if we remember it.
+  for (unsigned i = 0; i < 64 && i < s_crcFramesNext; ++i)
+  {
+    const unsigned k = (s_crcFramesNext - 1 - i) % 64;
+    if (s_crcFrames[k][1] == crc)
+    {
+      frame = s_crcFrames[k][0];
+      break;
+    }
+  }
   static int fd = -2;
   if (fd == -2)
     fd = (int)socket(AF_INET, SOCK_DGRAM, DEFAULT_PROTOCOL);
