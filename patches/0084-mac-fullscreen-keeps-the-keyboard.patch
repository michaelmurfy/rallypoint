+    if ([NSApp isActive] && !w.isKeyWindow && w.isVisible && !w.isMiniaturized && ![NSApp modalWindow]) {
+        if (FocusLog()) fprintf(stderr, "[mtl-focus] window was not key (key window: %s); making it key\n",
+                                FocusWindowName([NSApp keyWindow]).UTF8String);
         [w makeKeyAndOrderFront:nil];
+        if (!w.isKeyWindow && FocusLog()) fprintf(stderr, "[mtl-focus] the window did not become key\n");
