+// Names a window for the [mtl-focus] lines: its class and title.
+static NSString* FocusWindowName(NSWindow* w)
+{
+    if (!w) return @"no window";
+    return [NSString stringWithFormat:@"%@ '%@'", NSStringFromClass([w class]), w.title ? w.title : @""];
+}
+
+static bool FocusLog()
+{
+    static int s_logged = 0;
+    return s_logged++ < 60;
+}
