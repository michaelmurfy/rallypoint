         [w makeFirstResponder:v];
     }
+    }
 }
 
+// Native fullscreen shows the Dock when the pointer rests on the bottom edge and the menu bar on the top edge, which is
+// exactly where an RTS scrolls the map; a click there goes to the Dock or the menu bar, the game stops being the
+// active app, and the keyboard goes with it. Hide both while the game is fullscreen. GEN_FULLSCREEN_MENUBAR=1 keeps them.
+@interface GameWindowDelegate : NSObject <NSWindowDelegate>
+@end
+@implementation GameWindowDelegate
+- (NSApplicationPresentationOptions)window:(NSWindow*)window
+      willUseFullScreenPresentationOptions:(NSApplicationPresentationOptions)proposed
+{
+    (void)window;
+    const char* keep = getenv("GEN_FULLSCREEN_MENUBAR");
+    if (keep && keep[0] == '1') return proposed;
+    return NSApplicationPresentationFullScreen | NSApplicationPresentationHideDock | NSApplicationPresentationHideMenuBar;
+}
+@end
