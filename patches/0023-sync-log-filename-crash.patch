 static AsciiString getFname(AsciiString path)
 {
-	return path.reverseFind('\\') + 1;
+	// Rallypoint: __FILE__ uses '/' on macOS. reverseFind() returns null when there is no '\\', and null + 1 was
+	// then passed to AsciiString(const char *), which crashed the first time a sync log line was written.
+	const char *s = path.str();
+	const char *slash = strrchr(s, '/');
+	const char *back = strrchr(s, '\\');
+	const char *cut = (slash && (!back || slash > back)) ? slash : back;
+	return cut ? AsciiString(cut + 1) : path;
 }
 
