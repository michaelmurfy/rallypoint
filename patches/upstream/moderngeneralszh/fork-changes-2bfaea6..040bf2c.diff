+	if (!ready)
+	{
+		// minimised or the swapchain could not be made: just drop the frame's recorded work (uploads still have to happen)
+		EndPass();
+		FlushUploadsSync();
+		B.colorLoaded = false; B.depthLoaded = false; B.semaphoreUsed = false; B.stage = 1; B.scene3D = false;
