+
+// ---- CMP
+#define GFX_CMP_ALWAYS D3DCMP_ALWAYS
+#define GFX_CMP_EQUAL D3DCMP_EQUAL
+#define GFX_CMP_GREATER D3DCMP_GREATER
+#define GFX_CMP_GREATEREQUAL D3DCMP_GREATEREQUAL
