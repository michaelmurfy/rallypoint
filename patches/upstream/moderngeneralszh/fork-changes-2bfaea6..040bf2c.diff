+#define GFX_BLEND_SRCCOLOR D3DBLEND_SRCCOLOR
+#define GFX_BLEND_ZERO D3DBLEND_ZERO
+
+// ---- BLENDOP
+#define GFX_BLENDOP_ADD D3DBLENDOP_ADD
