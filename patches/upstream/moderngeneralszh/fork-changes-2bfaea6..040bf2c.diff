+bool RecordShotCopy()
+{
+	const VkDeviceSize need = (VkDeviceSize)B.extent.width * B.extent.height * 4;
+	if (g_shotSize < need)
+	{
+		if (g_shotBuf) { vkDestroyBuffer(B.device, g_shotBuf, nullptr); Free(g_shotAlloc); g_shotBuf = VK_NULL_HANDLE; }
