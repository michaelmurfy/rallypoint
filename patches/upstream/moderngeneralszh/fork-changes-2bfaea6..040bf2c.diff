+// Neutral graphics constants used by the game code, mapped to the Direct3D 8 values of the current backend.
+// Game code uses only the GFX_* names, so a different backend (for example Vulkan) defines its own values here
+// instead of this file. Generated once from the identifiers in use; add new entries by hand.
+#pragma once
+
+#include <d3d8.h>
+
+// ---- object types
+// The game code names graphics objects only through these types. The Direct3D 8 backend aliases them to the COM interfaces;
+// another backend provides its own classes with the same member functions (Lock/Unlock/GetDesc/Release...).
+typedef IDirect3DDevice8 GfxDevice;
+typedef IDirect3DTexture8 GfxTexture;
+typedef IDirect3DBaseTexture8 GfxBaseTexture;
+typedef IDirect3DSurface8 GfxSurface;
+typedef IDirect3DVertexBuffer8 GfxVertexBuffer;
+typedef IDirect3DIndexBuffer8 GfxIndexBuffer;
+typedef D3DVIEWPORT8 GfxViewport;
+typedef D3DLIGHT8 GfxLight;
+typedef D3DMATERIAL8 GfxMaterial;
+
