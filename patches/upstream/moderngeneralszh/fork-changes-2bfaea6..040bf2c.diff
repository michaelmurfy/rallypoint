+// ---- COLORWRITEENABLE
+#define GFX_COLORWRITEENABLE_ALPHA D3DCOLORWRITEENABLE_ALPHA
+#define GFX_COLORWRITEENABLE_BLUE D3DCOLORWRITEENABLE_BLUE
+#define GFX_COLORWRITEENABLE_GREEN D3DCOLORWRITEENABLE_GREEN
+#define GFX_COLORWRITEENABLE_RED D3DCOLORWRITEENABLE_RED
+
+// ---- CULL
+#define GFX_CULL_CCW D3DCULL_CCW
+#define GFX_CULL_CW D3DCULL_CW
+#define GFX_CULL_NONE D3DCULL_NONE
+
+// ---- FILL
