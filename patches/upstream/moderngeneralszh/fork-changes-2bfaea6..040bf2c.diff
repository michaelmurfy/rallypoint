+IDirect3D8* WINAPI NullGfx_Direct3DCreate8(UINT)
+{
+	return new NullD3D();
+}
+
+bool NullGfx_Requested()
+{
+	char value[32] = {};
+	DWORD n = GetEnvironmentVariableA("GENERALS_GFX", value, sizeof(value));
+	return n > 0 && n < sizeof(value) && _stricmp(value, "null") == 0;
+}
