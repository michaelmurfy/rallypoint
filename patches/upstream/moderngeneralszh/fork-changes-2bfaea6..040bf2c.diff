+
+void __stdcall AIL_set_3D_orientation(H3DPOBJECT obj, F32 xf, F32 yf, F32 zf, F32 xu, F32 yu, F32 zu)
+{
+	Voice* v = (Voice*)obj; if (!v) return;
+	Lock l;
+	v->face[0] = xf; v->face[1] = yf; v->face[2] = zf;
+	v->up[0] = xu; v->up[1] = yu; v->up[2] = zu;
+}
+
+void __stdcall AIL_set_3D_velocity_vector(H3DPOBJECT, F32, F32, F32) {}
+void __stdcall AIL_set_3D_sample_effects_level(H3DSAMPLE, F32) {}
+
+void __stdcall AIL_set_3D_sample_distances(H3DSAMPLE s, F32 max_dist, F32 min_dist)
+{
+	Voice* v = (Voice*)s; if (!v) return;
+	Lock l;
+	v->maxDist = max_dist;
+	v->minDist = min_dist;
+}
+
+void __stdcall AIL_set_3D_sample_occlusion(H3DSAMPLE s, F32 occlusion)
+{
+	Voice* v = (Voice*)s; if (!v) return;
+	Lock l; v->occlusion = occlusion; applyGain(v);
+}
+
+// ---- streams ------------------------------------------------------------------------------------
+HSTREAM __stdcall AIL_open_stream(HDIGDRIVER, const char* filename, S32)
+{
+	if (!g_engineReady || !filename)
+		return nullptr;
+
+	std::vector<unsigned char> bytes;
+	if (!readWholeFile(filename, bytes))
+		return nullptr;
+
+	Voice* v = newVoice(VK_STREAM);
+	{
+		Lock l;
+		v->own.swap(bytes);
+		if (!prepare(v, &v->own[0], v->own.size()))
+		{
+			destroyVoice(v);
+			return nullptr;
+		}
+	}
+	return (HSTREAM)v;
+}
+
+void __stdcall AIL_close_stream(HSTREAM s) { Voice* v = (Voice*)s; if (v) destroyVoice(v); }
+
+void __stdcall AIL_start_stream(HSTREAM s) { Voice* v = (Voice*)s; if (v) { Lock l; startVoice(v); } }
+
+void __stdcall AIL_pause_stream(HSTREAM s, S32 onoff)
+{
+	Voice* v = (Voice*)s; if (!v) return;
+	Lock l;
+	if (onoff) stopVoice(v); else resumeVoice(v);
+}
+
+AIL_stream_callback __stdcall AIL_register_stream_callback(HSTREAM s, AIL_stream_callback cb)
+{
+	Voice* v = (Voice*)s; if (!v) return nullptr;
+	Lock l; AIL_stream_callback old = v->eosStream; v->eosStream = cb; return old;
+}
+
+void __stdcall AIL_set_stream_volume_pan(HSTREAM s, F32 volume, F32 pan) { AIL_set_sample_volume_pan((HSAMPLE)s, volume, pan); }
+void __stdcall AIL_stream_volume_pan(HSTREAM s, F32* volume, F32* pan) { AIL_sample_volume_pan((HSAMPLE)s, volume, pan); }
+
+void __stdcall AIL_set_stream_loop_count(HSTREAM s, S32 count) { AIL_set_sample_loop_count((HSAMPLE)s, count); }
+S32 __stdcall AIL_stream_loop_count(HSTREAM s) { return AIL_sample_loop_count((HSAMPLE)s); }
+void __stdcall AIL_set_stream_loop_block(HSTREAM, S32, S32) {}
+void __stdcall AIL_set_stream_playback_rate(HSTREAM s, S32 rate) { AIL_set_sample_playback_rate((HSAMPLE)s, rate); }
+S32 __stdcall AIL_stream_playback_rate(HSTREAM s) { return AIL_sample_playback_rate((HSAMPLE)s); }
+void __stdcall AIL_stream_ms_position(HSTREAM s, S32* total, S32* current) { AIL_sample_ms_position((HSAMPLE)s, total, current); }
+void __stdcall AIL_set_stream_ms_position(HSTREAM s, S32 pos) { AIL_set_sample_ms_position((HSAMPLE)s, pos); }
+
+// ---- quick play (used for forced one-shot audio such as mission briefings) ----------------------------
+HAUDIO __stdcall AIL_quick_load_and_play(const char* filename, U32 loop_count, S32)
+{
+	if (!g_engineReady || !filename)
+		return nullptr;
+
+	std::vector<unsigned char> bytes;
+	if (!readWholeFile(filename, bytes))
+		return nullptr;
+
+	Voice* v = newVoice(VK_QUICK);
+	{
+		Lock l;
+		v->loopCount = (LONG)loop_count;
+		v->own.swap(bytes);
+		if (!prepare(v, &v->own[0], v->own.size()))
+		{
+			destroyVoice(v);
+			return nullptr;
+		}
+		startVoice(v);
+	}
+	return (HAUDIO)v;
+}
+
+void __stdcall AIL_quick_set_volume(HAUDIO a, F32 volume, F32 extravol)
+{
+	Voice* v = (Voice*)a; if (!v) return;
+	Lock l; v->volume = volume; v->pan = extravol; applyGain(v);
+}
+
+void __stdcall AIL_quick_unload(HAUDIO a) { Voice* v = (Voice*)a; if (v) destroyVoice(v); }
+
+} // extern "C"
+
+// ------------------------------------------------------------------------------------------------
+// Sound of movies (not Miles API): a ring buffer that the video player fills, played as a sound of the engine
+// ------------------------------------------------------------------------------------------------
+#include "MiniMilesVideo.h"
+
+namespace
+{
+struct VideoAudio
+{
+	ma_data_source_base base;	// first member: the engine passes this pointer around
+	ma_pcm_rb rb;
+	ma_uint32 channels;
+	ma_uint32 sampleRate;
+	ma_sound sound;
+	bool soundReady;
+};
+
+ma_result videoAudioRead(ma_data_source* ds, void* out, ma_uint64 frameCount, ma_uint64* framesRead)
+{
+	VideoAudio* v = (VideoAudio*)ds;
+	const ma_uint32 bytesPerFrame = v->channels * 2;
+	char* dst = (char*)out;
+	ma_uint64 got = 0;
+	while (got < frameCount)
+	{
+		ma_uint32 n = (ma_uint32)(frameCount - got);
+		void* p = nullptr;
+		if (ma_pcm_rb_acquire_read(&v->rb, &n, &p) != MA_SUCCESS || n == 0)
+			break;
+		memcpy(dst + got * bytesPerFrame, p, (size_t)n * bytesPerFrame);
+		ma_pcm_rb_commit_read(&v->rb, n);
+		got += n;
+	}
+	if (got < frameCount)
+		memset(dst + got * bytesPerFrame, 0, (size_t)(frameCount - got) * bytesPerFrame);		// nothing decoded yet: silence, the sound never ends
+	*framesRead = frameCount;
+	return MA_SUCCESS;
+}
+
+ma_result videoAudioSeek(ma_data_source*, ma_uint64) { return MA_NOT_IMPLEMENTED; }
+
+ma_result videoAudioFormat(ma_data_source* ds, ma_format* f, ma_uint32* c, ma_uint32* r, ma_channel* map, size_t mapCap)
+{
+	VideoAudio* v = (VideoAudio*)ds;
+	*f = ma_format_s16; *c = v->channels; *r = v->sampleRate;
+	if (map && mapCap > 0)
+		ma_channel_map_init_standard(ma_standard_channel_map_default, map, mapCap, v->channels);
+	return MA_SUCCESS;
+}
+
+ma_result videoAudioCursor(ma_data_source*, ma_uint64*) { return MA_NOT_IMPLEMENTED; }
+ma_result videoAudioLength(ma_data_source*, ma_uint64*) { return MA_NOT_IMPLEMENTED; }
+
+ma_data_source_vtable g_videoAudioVtable = { videoAudioRead, videoAudioSeek, videoAudioFormat, videoAudioCursor, videoAudioLength, nullptr, 0 };
+}
+
+void* MiniMiles_VideoAudioOpen(unsigned channels, unsigned sampleRate)
+{
+	if (!g_engineReady || channels < 1 || channels > 2 || sampleRate < 8000)
+		return nullptr;
+	VideoAudio* v = new VideoAudio();
+	memset(&v->sound, 0, sizeof(v->sound));
+	v->channels = channels; v->sampleRate = sampleRate; v->soundReady = false;
+	if (ma_pcm_rb_init(ma_format_s16, channels, sampleRate * 4, nullptr, nullptr, &v->rb) != MA_SUCCESS)
+	{
+		delete v;
+		return nullptr;
+	}
+	ma_data_source_config dsc = ma_data_source_config_init();
+	dsc.vtable = &g_videoAudioVtable;
+	if (ma_data_source_init(&dsc, &v->base) != MA_SUCCESS)
+	{
+		ma_pcm_rb_uninit(&v->rb);
+		delete v;
+		return nullptr;
+	}
+	if (ma_sound_init_from_data_source(&g_engine, &v->base, MA_SOUND_FLAG_NO_SPATIALIZATION, nullptr, &v->sound) != MA_SUCCESS)
+	{
+		ma_data_source_uninit(&v->base);
+		ma_pcm_rb_uninit(&v->rb);
+		delete v;
+		return nullptr;
+	}
+	v->soundReady = true;
+	ma_sound_start(&v->sound);
+	return v;
+}
+
+void MiniMiles_VideoAudioWrite(void* handle, const short* interleaved, unsigned frames)
+{
+	VideoAudio* v = (VideoAudio*)handle;
+	if (!v)
+		return;
+	const ma_uint32 bytesPerFrame = v->channels * 2;
+	unsigned done = 0;
+	while (done < frames)
+	{
+		ma_uint32 n = frames - done;
+		void* p = nullptr;
+		if (ma_pcm_rb_acquire_write(&v->rb, &n, &p) != MA_SUCCESS || n == 0)
+			break;		// full: the rest is dropped
+		memcpy(p, (const char*)interleaved + (size_t)done * bytesPerFrame, (size_t)n * bytesPerFrame);
+		ma_pcm_rb_commit_write(&v->rb, n);
+		done += n;
+	}
+}
+
+void MiniMiles_VideoAudioSetVolume(void* handle, float volume)
+{
+	VideoAudio* v = (VideoAudio*)handle;
+	if (v && v->soundReady)
+		ma_sound_set_volume(&v->sound, volume < 0.0f ? 0.0f : volume);
+}
+
+void MiniMiles_VideoAudioClose(void* handle)
+{
+	VideoAudio* v = (VideoAudio*)handle;
+	if (!v)
+		return;
+	if (v->soundReady)
+		ma_sound_uninit(&v->sound);
+	ma_data_source_uninit(&v->base);
+	ma_pcm_rb_uninit(&v->rb);
+	delete v;
+}
