+/**
+ * Rallypoint: how long until timeForNewFrame() allows the next logic frame, so the engine loop can wake up for it
+ * instead of sleeping to its own frame cap, and can tell when it has fallen behind.
+ */
+Bool Network::getSecondsUntilNextFrame(Real &seconds, Real &period)
+{
+	if (m_localStatus != NETLOCALSTATUS_INGAME || m_nextFrameTime == 0 || m_frameRate <= 0 || m_perfCountFreq <= 0)
+		return FALSE;
+	__int64 curTime;
+	QueryPerformanceCounter((LARGE_INTEGER *)&curTime);
+	seconds = (Real)((double)(m_nextFrameTime - curTime) / (double)m_perfCountFreq);
+	period = 1.0f / (Real)m_frameRate;
+	return TRUE;
+}
