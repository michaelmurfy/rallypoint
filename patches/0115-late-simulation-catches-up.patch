+// Rallypoint: where the time of a game goes, once every 1000 logic frames on stderr (so in engine.log):
+// "[perf] frame 34000: 1000 frames in 58.1 s (17.2 a second), logic 21.3 ms, picture 36.0 ms a frame (1.0 pictures a frame),
+// worst logic 180 ms, 5210 objects". "logic" is GameLogic::update, "picture" everything else in the loop (drawing, sound,
+// input, network), per logic frame. Two clock reads a loop, nothing else.
+namespace
+{
+	struct PerfWindow
+	{
+		std::chrono::steady_clock::time_point start;
+		double logic = 0.0, client = 0.0, worstLogic = 0.0;
+		Int frames = 0, loops = 0, skipped = 0;
+		Bool running = FALSE;
+	};
+	PerfWindow s_perf;
+
+	double perfSeconds(std::chrono::steady_clock::time_point a, std::chrono::steady_clock::time_point b)
+	{
+		return std::chrono::duration<double>(b - a).count();
+	}
+
+	void notePerfIdle(std::chrono::steady_clock::time_point start, std::chrono::steady_clock::time_point clientDone)
+	{
+		if (s_perf.running)
+		{
+			s_perf.client += perfSeconds(start, clientDone);
+			++s_perf.loops;
+			if (TheFramePacer->isPictureSkipped())
+				++s_perf.skipped;
+		}
+	}
+
+	// Rallypoint: the loop is "sound, input, picture, network, one logic frame, wait for the frame cap". A loop that takes
+	// longer than a logic frame (33 ms) therefore slowed the simulation, and in a network game the slowest machine's rate
+	// becomes everyone's (ConnectionManager::updateRunAhead). The logic has a schedule: the network's own frame clock in a
+	// network game, one frame per cap period otherwise. After each loop this looks at it:
+	//  - the next frame is not due yet: wait until it is (not to the cap, which could be a little later and lose the slot);
+	//  - it is overdue: do not wait, and if it is more than half a frame late leave out the picture of the next loop
+	//    (never two in a row), so that loop is short and the simulation catches up.
+	// Lost time is never made up beyond two frames (the network clock already works like that). GEN_NO_PICTURE_SKIP=1
+	// switches it off. Nothing here touches the simulation itself.
+	void planNextFrame(Bool ranLogic)
+	{
+		static Int off = -1;
+		static Bool haveDue = FALSE;
+		static std::chrono::steady_clock::time_point due;
+		if (off < 0)
+		{
+			const char *e = ::getenv("GEN_NO_PICTURE_SKIP");
+			off = (e && e[0] && e[0] != '0') ? 1 : 0;
+		}
+
+		const Bool skippedThis = TheFramePacer->isPictureSkipped();
+		TheFramePacer->setPictureSkipped(FALSE);
+		TheFramePacer->setWaitLimit(-1.0f);
+
+		const Bool playing = !off && TheGameLogic->isInGame() && !TheGameLogic->isInShellGame() && !TheGameLogic->isGamePaused()
+			&& !(TheGlobalData->m_TiVOFastMode && TheGameLogic->isInReplayGame());
+		if (!playing)
+		{
+			haveDue = FALSE;
+			return;
+		}
+
+		Real untilDue = 0.0f;
+		Real period = 0.0f;
+		if (TheNetwork != nullptr)
+		{
+			if (!TheNetwork->getSecondsUntilNextFrame(untilDue, period))
+				return;
+			if (!ranLogic && untilDue <= 0.0f)
+				return;	// due, but the other players' commands are not here yet: nothing to catch up with
+		}
+		else
+		{
+			const Int cap = TheFramePacer->getActualFramesPerSecondLimit();
+			if (!ranLogic || TheFramePacer->isLogicTimeScaleEnabled() || cap < (Int)LOGICFRAMES_PER_SECOND || cap > 60)
+			{
+				haveDue = FALSE;
+				return;
+			}
+			period = 1.0f / (Real)cap;
+			const std::chrono::steady_clock::time_point now = std::chrono::steady_clock::now();
+			const std::chrono::steady_clock::duration step = std::chrono::duration_cast<std::chrono::steady_clock::duration>(std::chrono::duration<double>(period));
+			if (!haveDue)
+			{
+				haveDue = TRUE;
+				due = now;
+			}
+			due += step;
+			if (due + 2 * step < now)
+				due = now;
+			untilDue = (Real)perfSeconds(now, due);
+		}
+
+		if (untilDue > 0.0f)
+		{
+			TheFramePacer->setWaitLimit(untilDue);
+		}
+		else
+		{
+			TheFramePacer->setWaitLimit(0.0f);
+			if (untilDue < -0.5f * period && !skippedThis)
+				TheFramePacer->setPictureSkipped(TRUE);
+		}
+	}
+
+	void notePerfFrame(std::chrono::steady_clock::time_point start, std::chrono::steady_clock::time_point clientDone)
+	{
+		const std::chrono::steady_clock::time_point now = std::chrono::steady_clock::now();
+		if (!TheGameLogic->isInGame() || TheGameLogic->isInShellGame())
+		{
+			s_perf.running = FALSE;
+			return;
+		}
+		if (!s_perf.running)
+		{
+			s_perf = PerfWindow();
+			s_perf.running = TRUE;
+			s_perf.start = start;
+		}
+		const double logic = perfSeconds(clientDone, now);
+		s_perf.client += perfSeconds(start, clientDone);
+		s_perf.logic += logic;
+		if (logic > s_perf.worstLogic)
+			s_perf.worstLogic = logic;
+		++s_perf.loops;
+		if (TheFramePacer->isPictureSkipped())
+			++s_perf.skipped;
+		if (++s_perf.frames >= 1000)
+		{
+			const double wall = perfSeconds(s_perf.start, now);
+			fprintf(stderr, "[perf] frame %u: %d frames in %.1f s (%.1f a second), logic %.1f ms, picture %.1f ms a frame (%.2f pictures a frame), worst logic %.0f ms, %u objects\n",
+				TheGameLogic->getFrame(), s_perf.frames, wall, wall > 0.0 ? s_perf.frames / wall : 0.0,
+				1000.0 * s_perf.logic / s_perf.frames, 1000.0 * s_perf.client / s_perf.frames, (double)(s_perf.loops - s_perf.skipped) / s_perf.frames,
+				1000.0 * s_perf.worstLogic, TheGameLogic->getObjectCount());
+			fflush(stderr);
+			s_perf = PerfWindow();
+			s_perf.running = TRUE;
+			s_perf.start = now;
+		}
+	}
+}
