+void PartitionContactList::growContactHash()
+{
+	const size_t newSize = m_contactHash.size() * 8 + 1;
+	m_contactHash.assign(newSize, nullptr);
+	for (PartitionContactListNode* cd = m_contactList; cd; cd = cd->m_next)
