+// Wire format and settings for tunnelling engine UDP through the launcher's relay agent.
+// Mirrors shared/src/lib.rs in the launcher repo (golden bytes are checked on both sides).
+// Enabled by env: GEN_RELAY=127.0.0.1:<agent port>, GEN_RELAY_VIP=<our virtual ip>. Pure C++, no sockets.
+#pragma once
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace RelayWire
+{
+
+enum Tag : uint8_t { TagBcast = 4, TagData = 5, TagBind = 7 };
+static const size_t HEADER = 9; // tag + vip(4) + src port(2) + dst port(2)
+
+struct Config
+{
+	bool on;
+	uint32_t agentIp; // host order
+	uint16_t agentPort;
+	uint32_t vip;     // host order
+};
+
+inline bool parseIp(const char *s, uint32_t &ip)
+{
+	unsigned a, b, c, d;
+	if (!s || sscanf(s, "%u.%u.%u.%u", &a, &b, &c, &d) != 4 || a > 255 || b > 255 || c > 255 || d > 255)
+		return false;
+	ip = (a << 24) | (b << 16) | (c << 8) | d;
+	return true;
+}
+
+inline Config parseConfig(const char *relay, const char *vip)
+{
+	Config c = { false, 0, 0, 0 };
+	unsigned port = 0;
+	char host[64];
+	if (!relay || !vip || sscanf(relay, "%63[0-9.]:%u", host, &port) != 2 || port == 0 || port > 65535)
+		return c;
+	if (parseIp(host, c.agentIp) && parseIp(vip, c.vip))
+	{
+		c.agentPort = (uint16_t)port;
+		c.on = true;
+	}
+	return c;
+}
+
+inline const Config &config()
+{
+	static const Config c = parseConfig(getenv("GEN_RELAY"), getenv("GEN_RELAY_VIP"));
+	return c;
+}
+
+inline void put32(uint8_t *o, uint32_t v) { o[0] = v >> 24; o[1] = v >> 16; o[2] = v >> 8; o[3] = v; }
+inline void put16(uint8_t *o, uint16_t v) { o[0] = v >> 8; o[1] = v; }
+
+// Engine -> agent. A destination of 255.255.255.255 is the LAN broadcast. Returns bytes written, 0 if cap too small.
+inline size_t encode(uint8_t *out, size_t cap, uint32_t dstIp, uint16_t srcPort, uint16_t dstPort, const uint8_t *payload, size_t n)
+{
+	if (cap < HEADER + n)
+		return 0;
+	const bool bcast = dstIp == 0xFFFFFFFFu;
+	out[0] = bcast ? TagBcast : TagData;
+	put32(out + 1, bcast ? 0 : dstIp);
+	put16(out + 5, srcPort);
+	put16(out + 7, dstPort);
+	memcpy(out + HEADER, payload, n);
+	return HEADER + n;
+}
+
+inline size_t encodeBind(uint8_t *out, uint16_t port)
+{
+	out[0] = TagBind;
+	put16(out + 1, port);
+	return 3;
+}
+
+// Agent -> engine. Anything that is not a Bcast/Data packet is ignored (returns false).
+inline bool decode(const uint8_t *in, size_t n, uint32_t &srcIp, uint16_t &srcPort, uint16_t &dstPort, const uint8_t *&payload, size_t &payloadLen)
+{
+	if (n < HEADER || (in[0] != TagBcast && in[0] != TagData))
+		return false;
+	srcIp = ((uint32_t)in[1] << 24) | ((uint32_t)in[2] << 16) | ((uint32_t)in[3] << 8) | in[4];
+	srcPort = (uint16_t)((in[5] << 8) | in[6]);
+	dstPort = (uint16_t)((in[7] << 8) | in[8]);
+	payload = in + HEADER;
+	payloadLen = n - HEADER;
+	return true;
+}
+
+}
