+// Receives from the relay agent: unwraps Bcast/Data and reports the sender as virtual-IP:logical-port.
+Int UDP::ReadRelay(unsigned char *msg,UnsignedInt len,sockaddr_in *from)
+{
+  uint8_t buf[2048];
+  for (;;)
+  {
+    int n = recvfrom(fd,(char *)buf,sizeof(buf),0,nullptr,nullptr);
+    if (n < 0)
+    {
+      #ifdef _WIN32
+      return (WSAGetLastError() == WSAEWOULDBLOCK) ? 0 : -1;
+      #else
+      return -1; // same as the direct path: callers see EAGAIN as "nothing to read"
+      #endif
+    }
+    uint32_t srcIp; uint16_t srcPort, dstPort; const uint8_t *payload; size_t payloadLen;
+    if (!RelayWire::decode(buf, (size_t)n, srcIp, srcPort, dstPort, payload, payloadLen) || payloadLen > len)
+      continue; // not for us, or too big for the caller's buffer
+    memcpy(msg, payload, payloadLen);
+    if (from)
+    {
+      memset(from, 0, sizeof(*from));
+      from->sin_family = AF_INET;
+      from->sin_addr.s_addr = htonl(srcIp);
+      from->sin_port = htons(srcPort);
+    }
+    return (Int)payloadLen;
+  }
+}
