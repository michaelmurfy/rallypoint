  *  the destination onto the nearest place it can stand; 3. if that did not help either, give up on the order, so the
  *  AI's team moves on instead of waiting for it forever. Only uses what every player's game has (positions, frame,
  *  paths), so it is the same everywhere; humans' units are never touched. */
+// ------------------------------------------------------------------------------------------------
 // ------------------------------------------------------------------------------------------------
+/** Rallypoint: a computer player's unit was sent somewhere no route leads to: the way into a base closed off with
+ *  buildings, usually. The pathfinder then takes it as close as it can get, and it stood there for the rest of the
+ *  game, asking for the same path again and again (a whole army, in the report that led here). What a player would
+ *  do is shoot a way in. So an armed unit that has stood short of such a destination for 8 seconds attacks the
+ *  nearest enemy building within 30 cells; one it cannot see (camouflaged) is fired at where it stands. When the
+ *  building is gone the unit's team gives it its next order and a route may exist.
+ *  Returns true when it gave an order. Same on every machine: positions, frames and the partition manager only. */
+// ------------------------------------------------------------------------------------------------
+Bool AIUpdateInterface::watchForNoRoute(UnsignedInt now)
+{
+	Object *obj = getObject();
+	const Player *player = obj->getControllingPlayer();
+	const Coord3D *pos = obj->getPosition();
+	const Bool fighting = obj->testStatus(OBJECT_STATUS_IS_ATTACKING) || obj->testStatus(OBJECT_STATUS_IS_FIRING_WEAPON)
+		|| obj->testStatus(OBJECT_STATUS_IS_AIMING_WEAPON);
+	if (m_noRouteFrame == 0 || now - m_noRouteFrame > 30 * LOGICFRAMES_PER_SECOND || fighting
+		|| !player || player->getPlayerType() != PLAYER_COMPUTER || !obj->isAbleToAttack()
+		|| isAiInDeadState() || obj->isEffectivelyDead() || obj->isDisabled() || obj->isContained())
+	{
+		m_noRouteChecks = 0;
+		return FALSE;
+	}
+
+	const Real gx = m_noRouteGoal.x - pos->x, gy = m_noRouteGoal.y - pos->y;
+	const Real mx = pos->x - m_noRoutePos.x, my = pos->y - m_noRoutePos.y;
+	const Real cell = PATHFIND_CELL_SIZE_F;
+	if (m_noRouteChecks == 0 || mx*mx + my*my > cell*cell || gx*gx + gy*gy < 36 * cell*cell)
+	{
+		// first look, still walking to the closest place, or close enough to the destination after all
+		m_noRoutePos = *pos;
+		m_noRouteChecks = (gx*gx + gy*gy < 36 * cell*cell) ? 0 : 1;
+		return FALSE;
+	}
+	if (++m_noRouteChecks < 8)
+		return FALSE;
+	m_noRouteChecks = 0;
+	m_noRouteFrame = 0;
+
+	PartitionFilterRelationship enemies(obj, PartitionFilterRelationship::ALLOW_ENEMIES);
+	PartitionFilterAcceptByKindOf buildings(MAKE_KINDOF_MASK(KINDOF_STRUCTURE), MAKE_KINDOF_MASK(KINDOF_MINE));
+	PartitionFilterAlive alive;
+	PartitionFilter *filters[] = { &enemies, &buildings, &alive, nullptr };
+	Object *wall = ThePartitionManager->getClosestObject(pos, 30 * cell, FROM_CENTER_2D, filters);
+	if (!wall)
+	{
+		fprintf(stderr, "[noroute] frame %u object %u %s at %.0f,%.0f has no way to %.0f,%.0f and no enemy building near\n", now,
+			(unsigned)obj->getID(), obj->getTemplate()->getName().str(), pos->x, pos->y, m_noRouteGoal.x, m_noRouteGoal.y);
+		return FALSE;
+	}
+	const Bool hidden = wall->testStatus(OBJECT_STATUS_STEALTHED) && !wall->testStatus(OBJECT_STATUS_DETECTED);
+	fprintf(stderr, "[noroute] frame %u object %u %s at %.0f,%.0f has no way to %.0f,%.0f: attacks %s at %.0f,%.0f%s\n", now,
+		(unsigned)obj->getID(), obj->getTemplate()->getName().str(), pos->x, pos->y, m_noRouteGoal.x, m_noRouteGoal.y,
+		wall->getTemplate()->getName().str(), wall->getPosition()->x, wall->getPosition()->y, hidden ? " (hidden: fires at the spot)" : "");
+	if (hidden)
+	{
+		const Coord3D spot = *wall->getPosition();
+		aiAttackPosition(&spot, 12, CMD_FROM_AI);
+	}
+	else
+		aiAttackObject(wall, NO_MAX_SHOTS_LIMIT, CMD_FROM_AI);
+	return TRUE;
+}
