 /**
  * Constructor for the AI system
  */
+static Int aiBoostLevel()
+{
+	static Int level = -1;
+	if (level < 0)
+	{
+		const char *v = getenv("GEN_AI_BOOST");
+		level = v ? atoi(v) : 0;
+		if (level < 0) level = 0;
+		if (level > 3) level = 3;
+	}
+	return level;
+}
+
+Real AI::boostSpeed()
+{
+	static const Real speeds[4] = { 1.0f, 1.35f, 1.7f, 2.0f };
+	return speeds[aiBoostLevel()];
+}
+
+Int AI::boostGatherers()
+{
+	static const Int extra[4] = { 0, 1, 1, 2 };
+	return extra[aiBoostLevel()];
+}
