+// Keyboard events reach the game through the MetalView's keyDown: (the view must be the first responder of the key
+// window), unlike the mouse, which DrainEvents reads from the application. Going to another Space (the fullscreen window has
+// its own) and back left the window without key status or the view without first responder, so the keyboard, Escape
+// and the hotkeys stayed dead until the game was restarted. Called every frame and on every activation.
+static void ReclaimKeyboardFocus()
+{
+    NSView* v = g_inputView;
+    NSWindow* w = v ? v.window : nil;
+    if (!w) return;
+    if ([NSApp isActive] && !w.isKeyWindow && w.isVisible && !w.isMiniaturized)
+        [w makeKeyAndOrderFront:nil];
+    if (w.isKeyWindow && w.firstResponder != v)
+        [w makeFirstResponder:v];
+}
+
+static void InstallFocusObservers()
+{
+    static bool installed = false;
+    if (installed) return;
+    installed = true;
+    NSNotificationCenter* nc = [NSNotificationCenter defaultCenter];
+    void (^reclaim)(NSNotification*) = ^(NSNotification* n) { (void)n; ReclaimKeyboardFocus(); };
+    for (NSNotificationName name in @[NSApplicationDidBecomeActiveNotification, NSWindowDidBecomeKeyNotification,
+                                       NSWindowDidBecomeMainNotification, NSWindowDidExitFullScreenNotification,
+                                       NSWindowDidEnterFullScreenNotification])
+        [nc addObserverForName:name object:nil queue:nil usingBlock:reclaim];
+    [[[NSWorkspace sharedWorkspace] notificationCenter] addObserverForName:NSWorkspaceActiveSpaceDidChangeNotification
+                                                                    object:nil queue:nil usingBlock:reclaim];
+}
+
 static void DrainEvents()
 {
+    ReclaimKeyboardFocus();
