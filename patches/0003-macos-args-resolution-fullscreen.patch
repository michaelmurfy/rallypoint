+    @autoreleasepool {
+        NSScreen* s = [NSScreen mainScreen];
+        if (!s) return;
+        CGFloat k = s.backingScaleFactor;
+        if (width)  *width  = (int)(s.frame.size.width  * k + 0.5);
+        if (height) *height = (int)(s.frame.size.height * k + 0.5);
+    }
+}
