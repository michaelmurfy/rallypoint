+// Quit from the app menu. NSApplication terminate: calls exit(), which runs the engine's static destructors, and one of
+// them (a pooled allocator) crashes on a normal shutdown. Flush and leave without them.
+@interface RPQuitTarget : NSObject
+- (void)quit:(id)sender;
+@end
+@implementation RPQuitTarget
+- (void)quit:(id)sender { (void)sender; fflush(NULL); _exit(0); }
