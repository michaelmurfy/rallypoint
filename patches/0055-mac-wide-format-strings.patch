+#if !defined(_WIN32)
+// On Windows a wide printf reads %s/%c as wide and %S/%C as narrow; elsewhere it is the other way
+// round, so a wide string passed to %s printed only its first character. Swap them.
+static void toPosixWideFormat(const WideChar* in, WideChar* out, size_t cap)
+{
+	size_t n = 0;
+	while (*in && n + 3 < cap)
+	{
+		if (*in != L'%') { out[n++] = *in++; continue; }
+		out[n++] = *in++;
+		if (*in == L'%') { out[n++] = *in++; continue; }
+		bool hasLen = false;
+		while (*in && n + 3 < cap && wcschr(L"-+ #0123456789.*hlLzjtI", *in))
+		{
+			if (*in == L'l' || *in == L'h') hasLen = true;
+			out[n++] = *in++;
+		}
+		if (*in == L's' || *in == L'c')
+		{
+			if (!hasLen) out[n++] = L'l';
+			out[n++] = *in++;
+		}
+		else if (*in == L'S' || *in == L'C')
+		{
+			out[n++] = (*in == L'S') ? L's' : L'c';
+			in++;
+		}
+	}
+	out[n] = 0;
+}
+#endif
