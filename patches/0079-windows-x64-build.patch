+        find_library(_ffmpeg_lib_${_mod} NAMES ${_mod})
+        if(_ffmpeg_lib_${_mod})
+            list(APPEND FFMPEG_LIBRARIES ${_ffmpeg_lib_${_mod}})
+        else()
+            list(APPEND _ffmpeg_missing ${_mod})
+        endif()
+    endforeach()
+    if(NOT _ffmpeg_inc OR _ffmpeg_missing)
+        set(FFMPEG_FOUND FALSE)
+        if(FFMPEG_FIND_REQUIRED)
+            message(FATAL_ERROR "FindFFMPEG: FFmpeg not found (missing: ${_ffmpeg_missing}). Install it with vcpkg.")
+        endif()
+        return()
+    endif()
+    set(FFMPEG_INCLUDE_DIRS ${_ffmpeg_inc})
+    set(FFMPEG_FOUND TRUE)
