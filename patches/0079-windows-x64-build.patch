+	v->maxDist = max_dist;
+	v->minDist = min_dist;
+}
+
+void __stdcall AIL_set_3D_sample_occlusion(H3DSAMPLE s, F32 occlusion)
+{
+	Voice* v = (Voice*)s; if (!v) return;
