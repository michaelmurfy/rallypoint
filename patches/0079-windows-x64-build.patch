+++ b/Dependencies/Miles/CMakeLists.txt	2026-11-11 22:29:08
@@ -0,0 +1,23 @@
+# 64-bit Windows: mss32.dll (Miles) has no 64-bit build and cannot be redistributed, so the part of the Miles
+# API that the engine uses is implemented on top of miniaudio (MiniMiles.cpp). The target keeps the name of the
+# 32-bit stub library so that the engine links it unchanged.
+# miniaudio 0.11.25 (public domain / MIT-0), a single header. Not built on its own.
+FetchContent_Declare(
+    miniaudio
+    GIT_REPOSITORY https://github.com/mackron/miniaudio.git
+    GIT_TAG        9634bedb5b5a2ca38c1ee7108a9358a4e233f14d
+    SOURCE_SUBDIR  headers-only-do-not-add
+)
+FetchContent_MakeAvailable(miniaudio)
+
+add_library(milesstub STATIC MiniMiles.cpp MilesLoader.h mss/mss.h)
+
+target_include_directories(milesstub PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}
+    ${CMAKE_CURRENT_SOURCE_DIR}/mss
+)
+
+target_include_directories(milesstub PRIVATE ${miniaudio_SOURCE_DIR})
+target_compile_definitions(milesstub PRIVATE NOMINMAX)
+# Movies play their sound through MiniMiles (no OpenAL on this platform).
+target_compile_definitions(milesstub PUBLIC RTS_MINIMILES)
