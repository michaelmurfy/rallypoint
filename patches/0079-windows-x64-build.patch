 # files (`brew install ffmpeg`) — they cover both header and library
 # search paths and Just Work for `find_package(FFMPEG REQUIRED)`.
 
+if(WIN32)
+    # Windows (vcpkg, `ffmpeg` in vcpkg.json): the libraries are found by name in the vcpkg prefix, no pkg-config.
+    # The DLLs next to them are copied beside the executable by vcpkg's application-local deployment.
+    set(FFMPEG_INCLUDE_DIRS)
+    set(FFMPEG_LIBRARY_DIRS)
