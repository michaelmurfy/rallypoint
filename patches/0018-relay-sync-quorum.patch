+// Engine -> agent: this machine's simulation checksum for a game frame. The relay compares every player's checksum.
+inline size_t encodeCrc(uint8_t *out, uint32_t frame, uint32_t crc)
+{
+	out[0] = TagCrc;
+	put32(out + 1, frame);
+	put32(out + 5, crc);
+	return 9;
+}
+
+inline uint32_t get32(const uint8_t *in) { return ((uint32_t)in[0] << 24) | ((uint32_t)in[1] << 16) | ((uint32_t)in[2] << 8) | in[3]; }
+
+// Agent -> engine: the relay found that the players' checksums for `frame` differ. If `certain`, a strict majority
+// agreed and the entries marked `odd` are the players that diverged; otherwise nobody can say who is right.
+static const int MaxSyncPlayers = 8;
+struct Desync
+{
+	uint32_t frame;
+	bool certain;
+	int count;
+	uint32_t vip[MaxSyncPlayers]; // host order, same as the game's slot addresses
+	uint32_t crc[MaxSyncPlayers];
+	bool odd[MaxSyncPlayers];
+};
+
+inline bool decodeDesync(const uint8_t *in, size_t n, Desync &d)
+{
+	// tag, frame (4), certain (1), count (1), then count * (virtual address 4, checksum 4, odd 1)
+	if (n < 7 || in[0] != TagDesync)
+		return false;
+	const int count = in[6];
+	if (count > MaxSyncPlayers || n != (size_t)(7 + count * 9))
+		return false;
+	d.frame = get32(in + 1);
+	d.certain = in[5] != 0;
+	d.count = count;
+	for (int i = 0; i < count; ++i)
+	{
+		const uint8_t *e = in + 7 + i * 9;
+		d.vip[i] = get32(e);
+		d.crc[i] = get32(e + 4);
+		d.odd[i] = e[8] != 0;
+	}
+	return true;
+}
+
 }
