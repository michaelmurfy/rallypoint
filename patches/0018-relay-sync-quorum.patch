+// The relay's latest sync verdict, kept until the game loop picks it up (GameLogic::update).
+static RelayWire::Desync s_desync;
+static bool s_desyncPending = false;
+
+bool RelayWire_TakeDesync(RelayWire::Desync &out)
+{
+  if (!s_desyncPending)
+    return false;
+  out = s_desync;
+  s_desyncPending = false;
+  return true;
+}
+
+// Tell the agent our simulation checksum for a frame; it passes it to the relay, which compares all players'.
+void RelayWire_ReportCrc(uint32_t frame, uint32_t crc)
+{
+  const RelayWire::Config &relay = RelayWire::config();
+  if (!relay.on)
+    return;
+  static int fd = -2;
+  if (fd == -2)
+    fd = (int)socket(AF_INET, SOCK_DGRAM, DEFAULT_PROTOCOL);
+  if (fd < 0)
+    return;
+  uint8_t pkt[16];
+  const size_t n = RelayWire::encodeCrc(pkt, frame, crc);
+  sockaddr_in to;
+  memset(&to, 0, sizeof(to));
+  to.sin_family = AF_INET;
+  to.sin_addr.s_addr = htonl(relay.agentIp);
+  to.sin_port = htons(relay.agentPort);
+  sendto(fd, (const char *)pkt, (int)n, 0, (struct sockaddr *)&to, sizeof(to));
+}
