+// Implemented in udp.cpp (the engine target): send our checksum to the agent; take the relay's latest verdict, if any.
+void RelayWire_ReportCrc(uint32_t frame, uint32_t crc);
+bool RelayWire_TakeDesync(RelayWire::Desync &out);
