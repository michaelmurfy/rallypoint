+// Rallypoint: the relay compared every player's simulation checksum and they were not all equal. Say so in the game, naming
+// the players (the relay identifies them by their virtual address, which is also the game's slot address).
+static void reportRelayDesync(const RelayWire::Desync &d)
+{
+	UnicodeString who;
+	for (int i = 0; i < d.count; ++i)
+	{
+		DEBUG_LOG(("Relay sync check, frame %u: %u.%u.%u.%u has checksum %8.8X%s", d.frame, (d.vip[i] >> 24) & 255, (d.vip[i] >> 16) & 255, (d.vip[i] >> 8) & 255, d.vip[i] & 255, d.crc[i], d.odd[i] ? " (differs from the majority)" : ""));
+		if (d.certain && !d.odd[i])
+			continue;
+		UnicodeString name = L"?";
+		if (TheGameInfo)
+		{
+			for (Int s = 0; s < MAX_SLOTS; ++s)
+			{
+				const GameSlot *slot = TheGameInfo->getConstSlot(s);
+				if (slot && slot->isHuman() && slot->getIP() == d.vip[i])
+				{
+					name = slot->getName();
+					break;
+				}
+			}
+		}
+		if (!who.isEmpty())
+			who.concat(L", ");
+		who.concat(name);
+	}
+	UnicodeString msg;
+	if (d.certain)
+		msg.format(L"Rallypoint: the game went out of sync at frame %u. Out of step with the others: %ls.", d.frame, who.str());
+	else
+		msg.format(L"Rallypoint: the game went out of sync at frame %u. The server cannot tell who is right (%ls).", d.frame, who.str());
+	TheInGameUI->messageNoFormat(msg);
+}
