+	// Rallypoint: GEN_AUTO_AI=N (the launcher's skirmish options) asks for N computer opponents, 1 to 7, each against
+	// everyone else; the map's own player count still limits it (adjustSlotsForMap below).
+	if (const char *ai = ::getenv("GEN_AUTO_AI"))
+	{
+		const int wanted = atoi(ai);
+		for (int i = 2; i <= wanted && i <= 7; ++i)
+		{
+			GameSlot extra;
+			extra.setState(aiSlotState);
+			TheSkirmishGameInfo->setSlot(i, extra);
+		}
+	}
