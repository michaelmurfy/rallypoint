@@ -658,6 +671,29 @@ void DebugAutoStartSkirmish( const char *mapName )
 	if ( map.isEmpty() )
 		map = prefs.getPreferredMap();
 
+	// Rallypoint: the launcher names a map by its folder (`Tournament Desert`); the cache is keyed by the map's full path,
+	// which is different on every machine, so find the entry whose path ends in `<folder>/<folder>.map`.
+	if ( TheMapCache && !map.isEmpty() && !TheMapCache->findMap(map) )
+	{
+		AsciiString want = map;
+		want.toLower();
+		AsciiString suffix;
+		suffix.format("/%s/%s.map", want.str(), want.str());
+		for (std::map<AsciiString, MapMetaData>::iterator it = TheMapCache->begin(); it != TheMapCache->end(); ++it)
+		{
+			char path[1024];
+			strncpy(path, it->first.str(), sizeof(path) - 1);
+			path[sizeof(path) - 1] = 0;
+			for (char *c = path; *c; ++c)
+				*c = (*c == '\\') ? '/' : (char)tolower((unsigned char)*c);
+			if (AsciiString(path).endsWith(suffix))
+			{
+				map = it->first;
+				break;
+			}
+		}
+	}
+
 	// Validate against the cache; fall back to the default multiplayer map if unknown.
 	if ( !TheMapCache || !TheMapCache->findMap(map) )
 		map = getDefaultMap(TRUE);
