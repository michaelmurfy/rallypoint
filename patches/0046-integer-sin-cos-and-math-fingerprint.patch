+// Rallypoint: a fingerprint of this build's maths, taken through the calls the simulation makes (our Sin and Cos, the
+// float flavours of the rest, and the matrix the game builds for a rotated object), over fixed inputs. It is part of
+// the simulation id below, so two players whose maths gives different bits are refused at the lobby instead of
+// starting a game that quietly runs two different simulations (which is what a Mac and a Windows PC did on 2026-10-26).
+// Each part is also printed, so a refusal can be traced to the function that differs.
+static UnsignedInt mathFingerprint()
+{
+	struct Hash
+	{
+		UnsignedInt h;
+		Hash() : h(2166136261u) {}
+		void mix(float v) { UnsignedInt b; memcpy(&b, &v, 4); for (int i = 0; i < 4; ++i) { h ^= (b >> (8 * i)) & 0xff; h *= 16777619u; } }
+	};
+	Hash trig, inverse, expo, matrix;
+	UnsignedInt lcg = 12345u;
+	const float knownAngles[2] = { 0.78539818525f, -2.6354470253f };
+	for (int i = 0; i < 4098; ++i)
+	{
+		float x;
+		if (i < 2) x = knownAngles[i];
+		else { lcg = lcg * 1664525u + 1013904223u; x = ((Int)(lcg >> 8) - 8388608) / 8388608.0f * (i < 2048 ? 7.0f : i < 4000 ? 600.0f : 0.01f); }
+		trig.mix(Sin(x)); trig.mix(Cos(x));
+		trig.mix(DetMath::tanf(x * 0.2f));
+		const float u = x / 600.0f;
+		const float unit = u < -1.0f ? -1.0f : u > 1.0f ? 1.0f : u;
+		inverse.mix(DetMath::asinf(unit)); inverse.mix(DetMath::acosf(unit));
+		inverse.mix(DetMath::atan2f(x, 3.0f + unit)); inverse.mix(DetMath::atanf(x));
+		const float pos = 0.001f + (x < 0 ? -x : x);
+		expo.mix(DetMath::expf(unit * 8.0f)); expo.mix(DetMath::logf(pos)); expo.mix(DetMath::powf(pos, 0.5f + unit * 0.4f));
+		expo.mix((float)sqrt((double)pos)); expo.mix(sqrtf(pos));
+		if (i < 512)
+		{
+			Coord3D pos3 = { 100.0f, 200.0f, 0.0f }, up = { 0.0f, 0.0f, 1.0f }, slope = { 0.2f, -0.1f, 0.9746794f };
+			Matrix3D m, m2;
+			makeAlignToNormalMatrix(x, pos3, up, m);
+			makeAlignToNormalMatrix(x, pos3, slope, m2);
+			for (int r = 0; r < 3; ++r) for (int c = 0; c < 4; ++c) { matrix.mix(m[r][c]); matrix.mix(m2[r][c]); }
+		}
+	}
+	const UnsignedInt parts[4] = { trig.h, inverse.h, expo.h, matrix.h };
+	fprintf(stderr, "[env] math fingerprint: sin/cos/tan %08X, inverse trig %08X, exp/log/pow/sqrt %08X, object matrices %08X\n", parts[0], parts[1], parts[2], parts[3]);
+	fflush(stderr);
+	UnsignedInt all = 2166136261u;
+	for (int i = 0; i < 4; ++i) { all ^= parts[i]; all *= 16777619u; }
+	return all;
+}
