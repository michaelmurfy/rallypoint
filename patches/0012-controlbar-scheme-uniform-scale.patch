diff --git a/Core/GameEngine/Include/Common/WideScreen.h b/Core/GameEngine/Include/Common/WideScreen.h
index e570565..baf018b 100644
--- a/Core/GameEngine/Include/Common/WideScreen.h
+++ b/Core/GameEngine/Include/Common/WideScreen.h
@@ -43,4 +43,15 @@ inline UiScale uiScale(int dispW, int dispH, int createW, int createH, bool cove
 	return s;
 }
 
+
+// The control bar scheme (frame art, command-bar buttons) is laid out in its own creation resolution. The retail
+// code stretched it over the display (display / creation res). The windows get a uniform, centred 4:3 region
+// instead (see uiScale), so the scheme must be mapped into that same region or its art and icons land far from
+// the windows on a wide display. Returns the x and y multipliers and the left offset, in display pixels.
+inline UiScale schemeScale(int dispW, int dispH, int createW, int createH)
+{
+	const UiScale w = uiScale(dispW, dispH, 800, 600, false); // the region the windows use (800x600 is the UI base size)
+	return { w.x * 800.0f / (float)createW, w.y * 600.0f / (float)createH, w.xOffset };
+}
+
 }
