+#if RTS_ZEROHOUR
+	// Weather.ini ships only in Zero Hour's INIZH.big. If the working directory is the executable's
+	// folder rather than the game folder, that archive was not loaded above and startup throws while
+	// reading Data\INI\Default\Weather. The launcher names the game folder with GEN_ZH_PATH.
+	if (TheFileSystem && !TheFileSystem->doesFileExist("Data\\INI\\Default\\Weather.ini")) {
+		const char* zhPathEnv = ::getenv("GEN_ZH_PATH");
+		if (zhPathEnv && zhPathEnv[0]) {
+			AsciiString zhPath = zhPathEnv;
+			const char last = zhPathEnv[strlen(zhPathEnv) - 1];
+			if (last != '/' && last != '\\')
+				zhPath.concat('/');
+			loadBigFilesFromDirectory(zhPath, "*.big");
+		}
+	}
+#endif
