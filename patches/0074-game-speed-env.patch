+
+	// Rallypoint: GEN_GAME_SPEED=N (percent, 50 to 200) runs a single-player game at N% of normal speed by stepping the
+	// simulation at 30*N/100 Hz (the logic time scale the in-game hotkeys use). 100 or unset leaves the game as it was.
+	{
+		const char *gs = ::getenv("GEN_GAME_SPEED");
+		const Int pct = (gs && *gs) ? atoi(gs) : 100;
+		if (pct >= 50 && pct <= 200 && pct != 100)
+		{
+			m_enableLogicTimeScale = TRUE;
+			m_logicTimeScaleFPS = ((Int)LOGICFRAMES_PER_SECOND * pct + 50) / 100;
+		}
+	}
 }
 
