 void FramePacer::setFramesPerSecondLimit( Int fps )
 {
+	// Rallypoint: a faster game speed needs the render cap above the logic rate, or the logic just follows the render frames.
+	if (m_enableLogicTimeScale && m_logicTimeScaleFPS > (Int)LOGICFRAMES_PER_SECOND && fps > 0 && fps < m_logicTimeScaleFPS * 2)
+		fps = m_logicTimeScaleFPS * 2;
 	DEBUG_LOG(("FramePacer::setFramesPerSecondLimit() - setting max fps to %d (TheGlobalData->m_useFpsLimit == %d)", fps, TheGlobalData->m_useFpsLimit));
 	m_maxFPS = fps;
 }
