+
+// Run the end-of-sample callbacks of voices that finished. Game thread only, from a point where the
+// engine is not walking its own lists (the listener update at the top of MilesAudioManager::update).
+// One voice at a time, looked up again after every callback, because a callback can release voices.
+static void fireEnded()
+{
+	static bool firing = false;
+	if (firing || !g_lockInit)
+		return;
+	firing = true;
+	for (;;)
+	{
+		Voice* v = nullptr;
+		VoiceKind kind = VK_SAMPLE;
+		AIL_sample_callback eosSample = nullptr;
+		AIL_3dsample_callback eos3D = nullptr;
+		AIL_stream_callback eosStream = nullptr;
 		{
-			Voice* v = fire[i].v;
-			switch (v->kind)
+			Lock l;
+			for (std::list<Voice*>::iterator it = g_voices.begin(); it != g_voices.end(); ++it)
 			{
-				case VK_SAMPLE: if (v->eosSample) v->eosSample((HSAMPLE)v); break;
-				case VK_SAMPLE3D: if (v->eos3D) v->eos3D((H3DPOBJECT)v); break;
-				case VK_STREAM: if (v->eosStream) v->eosStream((HSTREAM)v); break;
-				default: break;
+				if ((*it)->endPending && (*it)->allocated)
+				{
+					v = *it;
+					v->endPending = false;
+					kind = v->kind;
+					eosSample = v->eosSample; eos3D = v->eos3D; eosStream = v->eosStream;
+					break;
+				}
 			}
 		}
-		Sleep(10);
+		if (!v)
+			break;
+		switch (kind)
+		{
+			case VK_SAMPLE: if (eosSample) eosSample((HSAMPLE)v); break;
+			case VK_SAMPLE3D: if (eos3D) eos3D((H3DPOBJECT)v); break;
+			case VK_STREAM: if (eosStream) eosStream((HSTREAM)v); break;
+			default: break;
+		}
 	}
-	return 0;
+	firing = false;
 }
 
