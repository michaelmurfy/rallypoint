 Win* asWin(HWND h) { return h ? static_cast<Win*>(h) : g; }
 
+// GNOME and other desktops present several monitors as one big X screen, so DisplayWidth() is all of them
+// together. Ask XRandR (opened at run time, so it is no new dependency) for the monitors and use the one
+// under the mouse, else the primary. GEN_SPAN_MONITORS=1 keeps the whole desktop (surround).
+void pickMonitor(Win* w)
+{
+    struct Mon { unsigned long name; int primary, automatic, noutput, x, y, width, height, mwidth, mheight; unsigned long* outputs; };
+    void* lib = dlopen("libXrandr.so.2", RTLD_NOW);
+    if (!lib) return;
+    using Get = Mon* (*)(Display*, ::Window, int, int*);
+    using Free = void (*)(Mon*);
+    auto get = reinterpret_cast<Get>(dlsym(lib, "XRRGetMonitors"));
+    auto release = reinterpret_cast<Free>(dlsym(lib, "XRRFreeMonitors"));
+    int n = 0;
+    Mon* m = get && release ? get(w->dpy, DefaultRootWindow(w->dpy), 1, &n) : nullptr;
+    if (!m || n <= 0) { if (m) release(m); return; }
+    bool span = std::getenv("GEN_SPAN_MONITORS") && std::getenv("GEN_SPAN_MONITORS")[0] == '1';
+    ::Window rootRet, childRet; int rx = 0, ry = 0, wx, wy; unsigned mask;
+    XQueryPointer(w->dpy, DefaultRootWindow(w->dpy), &rootRet, &childRet, &rx, &ry, &wx, &wy, &mask);
+    int pick = 0, found = -1;
+    for (int i = 0; i < n; i++) {
+        if (m[i].primary) pick = i;
+        if (found < 0 && rx >= m[i].x && rx < m[i].x + m[i].width && ry >= m[i].y && ry < m[i].y + m[i].height) found = i;
+    }
+    if (found >= 0) pick = found;
+    if (span && n > 1) {
+        int t = 0, b = 0, l = 0, r = 0;
+        for (int i = 1; i < n; i++) {
+            if (m[i].y < m[t].y) t = i;
+            if (m[i].y + m[i].height > m[b].y + m[b].height) b = i;
+            if (m[i].x < m[l].x) l = i;
+            if (m[i].x + m[i].width > m[r].x + m[r].width) r = i;
+        }
+        w->fsMonitors[0] = t; w->fsMonitors[1] = b; w->fsMonitors[2] = l; w->fsMonitors[3] = r;
+        w->screenX = m[l].x; w->screenY = m[t].y;
+        w->screenW = m[r].x + m[r].width - m[l].x;
+        w->screenH = m[b].y + m[b].height - m[t].y;
+    } else {
+        for (int k = 0; k < 4; k++) w->fsMonitors[k] = pick;
+        w->screenX = m[pick].x; w->screenY = m[pick].y; w->screenW = m[pick].width; w->screenH = m[pick].height;
+    }
+    std::fprintf(stderr, "[linux] %d monitor(s), using %s %d,%d %dx%d\n", n, span && n > 1 ? "all (span)" : "one", w->screenX, w->screenY, w->screenW, w->screenH);
+    release(m);
+}
