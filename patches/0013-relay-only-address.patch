@@ -27,6 +27,7 @@
 #include "GameNetwork/IPEnumeration.h"
 #include "GameNetwork/networkutil.h"
 #include "GameClient/ClientInstance.h"
+#include "GameNetwork/RelayWire.h"
 
 #if defined(__APPLE__)
 // TheSuperHackers @port macOS: native IPv4 interface enumeration (see getAddresses).
@@ -63,6 +64,16 @@ EnumeratedIP * IPEnumeration::getAddresses()
 	if (m_IPlist)
 		return m_IPlist;
 
+	// Playing through a Rallypoint relay: the only network this game has is the relay's virtual one. Every menu
+	// that lists or picks an address (Options, the LAN lobby, Direct Connect) then sees just that, never the
+	// adapters of the machine's real network.
+	if (RelayWire::config().on)
+	{
+		const uint32_t v = RelayWire::config().vip;
+		addNewIP((UnsignedByte)(v >> 24), (UnsignedByte)(v >> 16), (UnsignedByte)(v >> 8), (UnsignedByte)v);
+		return m_IPlist;
+	}
+
 #if defined(__APPLE__)
 	// TheSuperHackers @port macOS: enumerate local IPv4 interfaces with getifaddrs()
 	// instead of gethostbyname(hostname). On macOS the machine's ".local" hostname
