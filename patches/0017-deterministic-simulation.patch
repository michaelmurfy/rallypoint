diff --git a/b/Core/Libraries/Source/WWVegas/WWLib/detmath.h b/Core/Libraries/Source/WWVegas/WWLib/detmath.h
new file mode 100644
index 0000000..032ce70
--- /dev/null
+++ b/Core/Libraries/Source/WWVegas/WWLib/detmath.h
@@ -0,0 +1,325 @@
+// Deterministic math: the same results on every platform and compiler.
+//
+// The C library's sin/cos/atan2/... are allowed to differ in the last bit between Apple's libm, Microsoft's CRT and
+// glibc, and lockstep multiplayer needs every machine to compute the *identical* float. These functions use only
+// +, -, *, / and sqrt/floor/ldexp/frexp/fmod on doubles (all exactly specified by IEEE 754) with series whose
+// coefficients are fixed here, so every machine gets the same bits as long as the compiler does not fuse a*b+c
+// into one rounding (the macOS build passes -ffp-contract=off; x86 SSE2 never fuses). Accuracy is about 1e-15
+// relative, well beyond what the game needs. The coefficients are exact Taylor terms (1/n!) and the constants were
+// computed with 100-digit arithmetic and checked against fdlibm's published split of pi/2; do not edit them by hand.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+
+namespace DetMath
+{
+namespace detail
+{
+	// Plain helpers instead of std::isinf & co: some platform headers define those (and PI) as macros.
+	inline bool isNaN(double x) { return x != x; }
+	inline bool isInf(double x) { return x > 1.7976931348623157e308 || x < -1.7976931348623157e308; }
+	inline bool signBit(double x)
+	{
+		uint64_t b;
+		std::memcpy(&b, &x, sizeof b);
+		return (b >> 63) != 0;
+	}
+	inline double fromBits(uint64_t b)
+	{
+		double d;
+		std::memcpy(&d, &b, sizeof d);
+		return d;
+	}
+	inline double quietNaN() { return fromBits(0x7ff8000000000000ull); }
+	inline double posInf() { return fromBits(0x7ff0000000000000ull); }
+
+	static const double K_PI       = 3.141592653589793;
+	static const double K_PIO2     = 1.5707963267948966;
+	static const double K_INV_PIO2 = 0.6366197723675814;
+	// pi/2 in four pieces of 33 bits each, so k * piece is exact for |k| < 2^20.
+	static const double K_PIO2_1   = 1.5707963267341256;
+	static const double K_PIO2_2   = 6.077100506303966e-11;
+	static const double K_PIO2_3   = 2.0222662487111665e-21;
+	static const double K_PIO2_4   = 8.4784276603689e-32;
+	static const double K_INV_LN2  = 1.4426950408889634;
+	static const double K_LN2_HI   = 0.6931471803691238;
+	static const double K_LN2_LO   = 1.9082149292705877e-10;
+
+	// sin(x) = x + x^3*S[0] + ... for |x| <= pi/4 (Taylor: 1/n! with alternating signs).
+	inline double sinKernel(double x)
+	{
+	static const double S[] = {
+		-0.16666666666666666,
+		0.008333333333333333,
+		-0.0001984126984126984,
+		2.7557319223985893e-06,
+		-2.505210838544172e-08,
+		1.6059043836821613e-10,
+		-7.647163731819816e-13,
+		2.8114572543455206e-15,
+		-8.22063524662433e-18,
+		1.9572941063391263e-20,
+		-3.868170170630684e-23,
+		6.446950284384474e-26,
+		-9.183689863795546e-29 };
+		const double z = x * x;
+		double p = S[11];
+		for (int i = 10; i >= 0; --i)
+			p = S[i] + z * p;
+		return x + x * z * p;
+	}
+
+	// cos(x) = 1 + x^2*C[0] + ... for |x| <= pi/4.
+	inline double cosKernel(double x)
+	{
+	static const double C[] = {
+		-0.5,
+		0.041666666666666664,
+		-0.001388888888888889,
+		2.48015873015873e-05,
+		-2.755731922398589e-07,
+		2.08767569878681e-09,
+		-1.1470745597729725e-11,
+		4.779477332387385e-14,
+		-1.5619206968586225e-16,
+		4.110317623312165e-19,
+		-8.896791392450574e-22,
+		1.6117375710961184e-24,
+		-2.4795962632247976e-27 };
+		const double z = x * x;
+		double p = C[12];
+		for (int i = 11; i >= 0; --i)
+			p = C[i] + z * p;
+		return 1.0 + z * p;
+	}
+
+	// x = k * pi/2 + r with |r| <= ~pi/4. Returns k mod 4 (0..3) and r.
+	inline int reduce(double x, double &r)
+	{
+		if (std::fabs(x) > 1.0e6)
+			x = std::fmod(x, 2.0 * K_PI); // exact; keeps k small enough for the exact products below
+		const double k = std::floor(x * K_INV_PIO2 + 0.5);
+		r = x - k * K_PIO2_1;
+		r = r - k * K_PIO2_2;
+		r = r - k * K_PIO2_3;
+		r = r - k * K_PIO2_4;
+		const double q = k - 4.0 * std::floor(k * 0.25);
+		return (int)q;
+	}
+
+	// atan for 0 <= x <= 1, by halving the angle twice then a short series.
+	inline double atanUnit(double x)
+	{
+	static const double A[] = {
+		-0.3333333333333333,
+		0.2,
+		-0.14285714285714285,
+		0.1111111111111111,
+		-0.09090909090909091,
+		0.07692307692307693,
+		-0.06666666666666667,
+		0.058823529411764705,
+		-0.05263157894736842,
+		0.047619047619047616,
+		-0.043478260869565216,
+		0.04 };
+		double t = x / (1.0 + std::sqrt(1.0 + x * x));
+		t = t / (1.0 + std::sqrt(1.0 + t * t)); // tan(angle / 4)
+		const double z = t * t;
+		double p = A[11];
+		for (int i = 10; i >= 0; --i)
+			p = A[i] + z * p;
+		return 4.0 * (t + t * z * p);
+	}
+}
+
+inline double sin(double x)
+{
+	if (x != x || detail::isInf(x)) return detail::quietNaN();
+	double r;
+	const int q = detail::reduce(x, r);
+	switch (q)
+	{
+	case 0: return detail::sinKernel(r);
+	case 1: return detail::cosKernel(r);
+	case 2: return -detail::sinKernel(r);
+	default: return -detail::cosKernel(r);
+	}
+}
+
+inline double cos(double x)
+{
+	if (x != x || detail::isInf(x)) return detail::quietNaN();
+	double r;
+	const int q = detail::reduce(x, r);
+	switch (q)
+	{
+	case 0: return detail::cosKernel(r);
+	case 1: return -detail::sinKernel(r);
+	case 2: return -detail::cosKernel(r);
+	default: return detail::sinKernel(r);
+	}
+}
+
+inline double tan(double x)
+{
+	if (x != x || detail::isInf(x)) return detail::quietNaN();
+	double r;
+	const int q = detail::reduce(x, r);
+	const double s = detail::sinKernel(r), c = detail::cosKernel(r);
+	return (q & 1) ? -c / s : s / c;
+}
+
+inline double atan(double x)
+{
+	if (x != x) return x;
+	const double ax = std::fabs(x);
+	double a;
+	if (detail::isInf(ax))
+		a = detail::K_PIO2;
+	else if (ax > 1.0)
+		a = detail::K_PIO2 - detail::atanUnit(1.0 / ax);
+	else
+		a = detail::atanUnit(ax);
+	return x < 0.0 ? -a : a;
+}
+
+inline double atan2(double y, double x)
+{
+	if (x != x || y != y) return detail::quietNaN();
+	if (y == 0.0)
+		return detail::signBit(x) ? (detail::signBit(y) ? -detail::K_PI : detail::K_PI) : y;
+	if (x == 0.0)
+		return y > 0.0 ? detail::K_PIO2 : -detail::K_PIO2;
+	if (detail::isInf(x))
+	{
+		if (detail::isInf(y))
+		{
+			const double q = x > 0.0 ? detail::K_PI * 0.25 : detail::K_PI * 0.75;
+			return y > 0.0 ? q : -q;
+		}
+		return x > 0.0 ? (y > 0.0 ? 0.0 : -0.0) : (y > 0.0 ? detail::K_PI : -detail::K_PI);
+	}
+	if (detail::isInf(y))
+		return y > 0.0 ? detail::K_PIO2 : -detail::K_PIO2;
+	const double a = atan(std::fabs(y / x));
+	if (x > 0.0)
+		return y > 0.0 ? a : -a;
+	return y > 0.0 ? detail::K_PI - a : -(detail::K_PI - a);
+}
+
+inline double asin(double x)
+{
+	if (x != x || std::fabs(x) > 1.0) return detail::quietNaN();
+	if (x == 1.0) return detail::K_PIO2;
+	if (x == -1.0) return -detail::K_PIO2;
+	return atan(x / std::sqrt((1.0 - x) * (1.0 + x)));
+}
+
+inline double acos(double x)
+{
+	if (x != x || std::fabs(x) > 1.0) return detail::quietNaN();
+	return atan2(std::sqrt((1.0 - x) * (1.0 + x)), x);
+}
+
+inline double exp(double x)
+{
+	if (x != x) return x;
+	if (x > 709.0) return detail::posInf();
+	if (x < -745.0) return 0.0;
+	static const double E[] = {
+		0.5,
+		0.16666666666666666,
+		0.041666666666666664,
+		0.008333333333333333,
+		0.001388888888888889,
+		0.0001984126984126984,
+		2.48015873015873e-05,
+		2.7557319223985893e-06,
+		2.755731922398589e-07,
+		2.505210838544172e-08,
+		2.08767569878681e-09,
+		1.6059043836821613e-10,
+		1.1470745597729725e-11,
+		7.647163731819816e-13,
+		4.779477332387385e-14,
+		2.8114572543455206e-15,
+		1.5619206968586225e-16,
+		8.22063524662433e-18,
+		4.110317623312165e-19 };
+	const double k = std::floor(x * detail::K_INV_LN2 + 0.5);
+	const double r = (x - k * detail::K_LN2_HI) - k * detail::K_LN2_LO;
+	double p = E[18];
+	for (int i = 17; i >= 0; --i)
+		p = E[i] + r * p;
+	return std::ldexp(1.0 + r + r * r * p, (int)k);
+}
+
+inline double log(double x)
+{
+	if (x != x) return x;
+	if (x < 0.0) return detail::quietNaN();
+	if (x == 0.0) return -detail::posInf();
+	if (detail::isInf(x)) return x;
+	static const double L[] = {
+		0.3333333333333333,
+		0.2,
+		0.14285714285714285,
+		0.1111111111111111,
+		0.09090909090909091,
+		0.07692307692307693,
+		0.06666666666666667,
+		0.058823529411764705,
+		0.05263157894736842,
+		0.047619047619047616,
+		0.043478260869565216,
+		0.04,
+		0.037037037037037035 };
+	int e;
+	double m = std::frexp(x, &e); // x = m * 2^e, m in [0.5, 1)
+	if (m < 0.70710678118654752440)
+	{
+		m *= 2.0;
+		--e;
+	}
+	const double f = (m - 1.0) / (m + 1.0);
+	const double s = f * f;
+	double p = L[11];
+	for (int i = 10; i >= 0; --i)
+		p = L[i] + s * p;
+	const double series = 2.0 * (f + f * s * p);
+	return (double)e * detail::K_LN2_HI + ((double)e * detail::K_LN2_LO + series);
+}
+
+inline double pow(double x, double y)
+{
+	if (y == 0.0 || x == 1.0) return 1.0;
+	if (x != x || y != y) return detail::quietNaN();
+	if (y == 2.0) return x * x; // the game's own use: distances squared
+	if (y == 1.0) return x;
+	if (x == 0.0) return y > 0.0 ? 0.0 : detail::posInf();
+	bool negative = false;
+	if (x < 0.0)
+	{
+		if (y != std::floor(y)) return detail::quietNaN();
+		negative = std::fmod(std::fabs(y), 2.0) == 1.0;
+		x = -x;
+	}
+	const double r = exp(y * log(x));
+	return negative ? -r : r;
+}
+
+// The float flavours the engine calls: compute in double, round once.
+inline float sinf(float x)  { return (float)sin((double)x); }
+inline float cosf(float x)  { return (float)cos((double)x); }
+inline float tanf(float x)  { return (float)tan((double)x); }
+inline float asinf(float x) { return (float)asin((double)x); }
+inline float acosf(float x) { return (float)acos((double)x); }
+inline float atanf(float x) { return (float)atan((double)x); }
+inline float atan2f(float y, float x) { return (float)atan2((double)y, (double)x); }
+inline float expf(float x)  { return (float)exp((double)x); }
+inline float logf(float x)  { return (float)log((double)x); }
+inline float powf(float x, float y) { return (float)pow((double)x, (double)y); }
+}
