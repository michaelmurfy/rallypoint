+// Rallypoint: the game thread no longer talks to AVAudioEngine for sound effects. Attaching a node, starting it,
+// stopping it, setting its pan and detaching it each take the engine's lock and can wait for the audio thread: a
+// profile of a large battle had 57% of the game thread in those calls (-[AVAudioPlayerNode play] alone 25%), and the
+// simulation ran at a quarter of its speed. They now go, in order, to one serial queue. The game thread only records
+// what it wants; completions still come back through enqueueCallback and run on the game thread as before.
+// Streams (music, speech) are few and keep their direct calls.
+static dispatch_queue_t audioQueue() {
+    static dispatch_queue_t q = dispatch_queue_create("rallypoint.audio.commands",
+        dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL, QOS_CLASS_USER_INTERACTIVE, 0));
+    return q;
+}
+static void audioAsync(dispatch_block_t work) {
+    dispatch_async(audioQueue(), ^{
+        @autoreleasepool {
+            @try { work(); } @catch (NSException *ex) { MLOG(1, "audio command NSException: %s", ex.reason.UTF8String ?: "?"); }
+        }
+    });
+}
+// For the rare calls that still act on a node directly (seeking): let everything queued for it happen first.
+static void audioFlush() { dispatch_sync(audioQueue(), ^{}); }
+
+// Volume and pan are set every frame for every playing 3D voice; only a real change is sent.
+static void setNodeMix(ApplePlayerBase *p, float volume, float pan) {
+    AVAudioPlayerNode *node = p->node;
+    if (!node) return;
+    const bool newVolume = fabsf(volume - p->sentVolume) > 0.004f;
+    const bool newPan = fabsf(pan - p->sentPan) > 0.01f;
+    if (!newVolume && !newPan) return;
+    if (newVolume) p->sentVolume = volume;
+    if (newPan) p->sentPan = pan;
+    audioAsync(^{
+        if (newVolume) node.volume = volume;
+        if (newPan) node.pan = pan;
+    });
+}
