 		expo.mix(DetMath::expf(unit * 8.0f)); expo.mix(DetMath::logf(pos)); expo.mix(DetMath::powf(pos, 0.5f + unit * 0.4f));
 		expo.mix((float)sqrt((double)pos)); expo.mix(sqrtf(pos));
+		{
+			// the double flavours the game logic calls (the 53-bit results, as 32-bit halves)
+			const double xd = (double)x * 0.37, pd = (double)pos;
+			const double ds[7] = { DetMath::sin(xd), DetMath::cos(xd), DetMath::atan2(xd, pd), DetMath::exp(unit * 5.0), DetMath::log(pd), DetMath::pow(pd, 0.3), (xd * pd + 0.1) / (pd + 1.0) };
+			for (int k = 0; k < 7; ++k) { UnsignedInt w[2]; memcpy(w, &ds[k], 8); doubles.h ^= w[0]; doubles.h *= 16777619u; doubles.h ^= w[1]; doubles.h *= 16777619u; }
+		}
 		if (i < 512)
 		{
 			Coord3D pos3 = { 100.0f, 200.0f, 0.0f }, up = { 0.0f, 0.0f, 1.0f }, slope = { 0.2f, -0.1f, 0.9746794f };
@@ -1317,11 +1326,11 @@ static UnsignedInt mathFingerprint()
 			for (int r = 0; r < 3; ++r) for (int c = 0; c < 4; ++c) { matrix.mix(m[r][c]); matrix.mix(m2[r][c]); }
 		}
 	}
-	const UnsignedInt parts[4] = { trig.h, inverse.h, expo.h, matrix.h };
-	fprintf(stderr, "[env] math fingerprint: sin/cos/tan %08X, inverse trig %08X, exp/log/pow/sqrt %08X, object matrices %08X\n", parts[0], parts[1], parts[2], parts[3]);
+	const UnsignedInt parts[5] = { trig.h, inverse.h, expo.h, matrix.h, doubles.h };
+	fprintf(stderr, "[env] math fingerprint: sin/cos/tan %08X, inverse trig %08X, exp/log/pow/sqrt %08X, object matrices %08X, double precision %08X\n", parts[0], parts[1], parts[2], parts[3], parts[4]);
 	fflush(stderr);
 	UnsignedInt all = 2166136261u;
-	for (int i = 0; i < 4; ++i) { all ^= parts[i]; all *= 16777619u; }
+	for (int i = 0; i < 5; ++i) { all ^= parts[i]; all *= 16777619u; }
