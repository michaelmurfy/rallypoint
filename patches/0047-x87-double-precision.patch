@@ -12,11 +12,40 @@
 #include <cmath>
 #include <cstdint>
 #include <cstring>
+#if defined(_MSC_VER) && defined(_M_IX86)
+#include <float.h>
+#endif
 
 namespace DetMath
 {
 namespace detail
 {
+	// The game sets the x87 unit to 24-bit precision (setFPMode), which is right for float arithmetic but turns every
+	// double operation compiled to x87 instructions into a single-precision one: on 2026-10-26 the game logged
+	// DetMath::sin(0x3F490FDB) = 0x3FE6A09E80000000 on Windows against 0x3FE6A09E6ECB41FE on macOS, and an AI-placed
+	// building ended one ulp apart. Every double function below runs at 53-bit precision, then puts the setting back.
+	// (Nothing happens where doubles are computed with SSE2 or on ARM.)
+#if defined(_MSC_VER) && defined(_M_IX86)
+	struct DoublePrecision
+	{
+		unsigned saved;
+		bool changed;
+		DoublePrecision() : saved(0), changed(false)
+		{
+			const unsigned cw = _controlfp(0, 0);
+			if ((cw & _MCW_PC) != _PC_53)
+			{
+				saved = cw & _MCW_PC;
+				_controlfp(_PC_53, _MCW_PC);
+				changed = true;
+			}
+		}
+		~DoublePrecision() { if (changed) _controlfp(saved, _MCW_PC); }
+	};
+#else
+	struct DoublePrecision { DoublePrecision() {} };
+#endif
+
 	// Plain helpers instead of std::isinf & co: some platform headers define those (and PI) as macros.
 	inline bool isNaN(double x) { return x != x; }
 	inline bool isInf(double x) { return x > 1.7976931348623157e308 || x < -1.7976931348623157e308; }
@@ -137,6 +166,7 @@ namespace detail
 
 inline double sin(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || detail::isInf(x)) return detail::quietNaN();
 	double r;
 	const int q = detail::reduce(x, r);
@@ -151,6 +181,7 @@ inline double sin(double x)
 
 inline double cos(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || detail::isInf(x)) return detail::quietNaN();
 	double r;
 	const int q = detail::reduce(x, r);
@@ -165,6 +196,7 @@ inline double cos(double x)
 
 inline double tan(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || detail::isInf(x)) return detail::quietNaN();
 	double r;
 	const int q = detail::reduce(x, r);
@@ -174,6 +206,7 @@ inline double tan(double x)
 
 inline double atan(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x) return x;
 	const double ax = std::fabs(x);
 	double a;
@@ -188,6 +221,7 @@ inline double atan(double x)
 
 inline double atan2(double y, double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || y != y) return detail::quietNaN();
 	if (y == 0.0)
 		return detail::signBit(x) ? (detail::signBit(y) ? -detail::K_PI : detail::K_PI) : y;
@@ -212,6 +246,7 @@ inline double atan2(double y, double x)
 
 inline double asin(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || std::fabs(x) > 1.0) return detail::quietNaN();
 	if (x == 1.0) return detail::K_PIO2;
 	if (x == -1.0) return -detail::K_PIO2;
@@ -220,12 +255,14 @@ inline double asin(double x)
 
 inline double acos(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x || std::fabs(x) > 1.0) return detail::quietNaN();
 	return atan2(std::sqrt((1.0 - x) * (1.0 + x)), x);
 }
 
 inline double exp(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x) return x;
 	if (x > 709.0) return detail::posInf();
 	if (x < -745.0) return 0.0;
@@ -259,6 +296,7 @@ inline double exp(double x)
 
 inline double log(double x)
 {
+	detail::DoublePrecision precision;
 	if (x != x) return x;
 	if (x < 0.0) return detail::quietNaN();
 	if (x == 0.0) return -detail::posInf();
@@ -295,6 +333,7 @@ inline double log(double x)
 
 inline double pow(double x, double y)
 {
+	detail::DoublePrecision precision;
 	if (y == 0.0 || x == 1.0) return 1.0;
 	if (x != x || y != y) return detail::quietNaN();
 	if (y == 2.0) return x * x; // the game's own use: distances squared
