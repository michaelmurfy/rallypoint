 }
 
diff --git a/GeneralsMD/Code/GameEngine/Source/GameLogic/System/GameLogic.cpp b/GeneralsMD/Code/GameEngine/Source/GameLogic/System/GameLogic.cpp
index 5c11583..d971103 100644
--- a/GeneralsMD/Code/GameEngine/Source/GameLogic/System/GameLogic.cpp
+++ b/GeneralsMD/Code/GameEngine/Source/GameLogic/System/GameLogic.cpp
@@ -1203,6 +1203,18 @@ static void logFloatEnvironment()
 		memcpy(&d0, &ds, 8); memcpy(&d1, &dc, 8);
 		fprintf(stderr, "[env] angle %08X: Sin %08X Cos %08X, DetMath double sin %016llX cos %016llX, libm sinf %08X cosf %08X\n", angleBits[i], o0, o1, d0, d1, c0, c1);
 	}
+	{
+		// Double arithmetic as the game runs it: 1/3 should be 3FD5555555555555 and (1/3)*3 exactly 1. At x87 24-bit
+		// precision they are single precision values.
+		volatile double d1 = 1.0, d3 = 3.0, dp = 0.1;
+		double third = d1 / d3, back = third * d3, tenth = dp * dp;
+		unsigned long long b0, b1, b2;
+		memcpy(&b0, &third, 8); memcpy(&b1, &back, 8); memcpy(&b2, &tenth, 8);
+#if defined(_MSC_VER) && defined(_M_IX86)
+		fprintf(stderr, "[env] x87 control word %08X, _M_IX86_FP %d\n", (unsigned)_controlfp(0, 0), (int)_M_IX86_FP);
+#endif
+		fprintf(stderr, "[env] double probes: 1/3 %016llX, (1/3)*3 %016llX, 0.1*0.1 %016llX (should be 3FD5555555555555, 3FF0000000000000, 3F847AE147AE147C)\n", b0, b1, b2);
+	}
 	fflush(stderr);
 }
 
diff --git a/cmake/compilers.cmake b/cmake/compilers.cmake
index e63161f..a958d92 100644
--- a/cmake/compilers.cmake
+++ b/cmake/compilers.cmake
@@ -51,6 +51,12 @@ if (NOT IS_VS6_BUILD)
         add_compile_options(/Zc:__cplusplus)
         # Strict IEEE float semantics (the default, stated so it is not changed by accident): multiplayer needs identical bits.
         add_compile_options(/fp:precise)
+        # SSE2 for floats and doubles on 32-bit x86 (also the compiler's default; stated so it stays that way): the x87
+        # unit runs at the 24-bit precision the game sets, which makes doubles single precision and differ from other
+        # platforms. See DetMath::detail::DoublePrecision.
+        if(CMAKE_SIZEOF_VOID_P EQUAL 4)
+            add_compile_options(/arch:SSE2)
+        endif()
     else()
         add_compile_options(-Wsuggest-override)
     endif()
