diff --git a/GeneralsMD/Code/Tools/CMakeLists.txt b/GeneralsMD/Code/Tools/CMakeLists.txt
index eb85f07..99c3e10 100644
--- a/GeneralsMD/Code/Tools/CMakeLists.txt
+++ b/GeneralsMD/Code/Tools/CMakeLists.txt
@@ -10,6 +10,12 @@ if(RTS_BUILD_ZEROHOUR_TOOLS)
     add_subdirectory(WorldBuilder)
 endif()
 
+# Rallypoint builds only the map editor (MFC, Windows 32-bit): it does not need the other tools.
+option(RTS_BUILD_WORLDBUILDER "Build only the Zero Hour map editor" OFF)
+if(RTS_BUILD_WORLDBUILDER AND NOT RTS_BUILD_ZEROHOUR_TOOLS)
+    add_subdirectory(WorldBuilder)
+endif()
+
 # Build less useful tool/test binaries.
 if(RTS_BUILD_ZEROHOUR_EXTRAS)
     add_subdirectory(Autorun)
diff --git a/GeneralsMD/Code/Tools/WorldBuilder/src/WorldBuilder.cpp b/GeneralsMD/Code/Tools/WorldBuilder/src/WorldBuilder.cpp
index 7efd924..aa368dc 100644
--- a/GeneralsMD/Code/Tools/WorldBuilder/src/WorldBuilder.cpp
+++ b/GeneralsMD/Code/Tools/WorldBuilder/src/WorldBuilder.cpp
@@ -321,7 +321,12 @@ BOOL CWorldBuilderApp::InitInstance()
 	if (char *pEnd = strrchr(buf, '\\')) {
 		*pEnd = 0;
 	}
-	::SetCurrentDirectory(buf);
+	// Rallypoint keeps the editor outside the game folder; GEN_ZH_PATH names the folder with the game's .big files.
+	{
+		const char* gameDir = ::getenv("GEN_ZH_PATH");
+		if (!(gameDir && gameDir[0] && ::SetCurrentDirectory(gameDir)))
+			::SetCurrentDirectory(buf);
+	}
 
 	TheFileSystem = new FileSystem;
 
@@ -342,6 +347,18 @@ BOOL CWorldBuilderApp::InitInstance()
 	ini.loadFileDirectory( "Data\\INI\\GameDataDebug", INI_LOAD_MULTIFILE, nullptr );
 #endif
 
+	// The selected mod, as the game loads it (GameEngine.cpp): GEN_MOD_DIR is a folder of .big/.gib archives, GEN_MOD one archive.
+	// Mod files win over the game's, so the editor shows the mod's objects, terrain, water and scripts.
+	if (const char* modBig = ::getenv("GEN_MOD"); modBig && modBig[0])
+		TheWritableGlobalData->m_modBIG = modBig;
+	if (const char* modDir = ::getenv("GEN_MOD_DIR"); modDir && modDir[0]) {
+		AsciiString dir = modDir;
+		if (!dir.endsWith("/") && !dir.endsWith("\\"))
+			dir.concat('\\');
+		TheWritableGlobalData->m_modDir = dir;
+	}
+	TheArchiveFileSystem->loadMods();
+
 #ifdef DEBUG_CRASHING
 	TheWritableGlobalData->m_debugIgnoreAsserts = false;
 #endif
