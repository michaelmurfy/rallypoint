+} // namespace
+
+// "data\\cursors\\Foo.ANI" from the engine, on a case-sensitive file system: fix the slashes and match each part ignoring case.
+static std::string resolve(const char* path)
+{
+    std::string rel(path);
+    for (char& ch : rel) if (ch == '\\') ch = '/';
+    std::string cur = rel.size() && rel[0] == '/' ? "/" : ".";
+    size_t pos = 0;
+    while (pos < rel.size()) {
+        size_t e = rel.find('/', pos);
+        if (e == std::string::npos) e = rel.size();
+        std::string part = rel.substr(pos, e - pos);
+        pos = e + 1;
+        if (part.empty() || part == ".") continue;
+        std::string next = cur + "/" + part;
+        if (access(next.c_str(), F_OK) != 0) {
+            DIR* d = opendir(cur.c_str());
+            if (!d) return rel;
+            while (dirent* ent = readdir(d))
+                if (strcasecmp(ent->d_name, part.c_str()) == 0) { next = cur + "/" + ent->d_name; break; }
+            closedir(d);
+        }
+        cur = next;
+    }
+    return cur;
+}
+
+extern "C" void* LinuxCursor_Load(const char* path)
+{
+    if (!path || !*path) return nullptr;
+    auto& cache = g_cache();
+    std::string key(path);
+    auto it = cache.find(key);
+    if (it != cache.end()) return it->second;
+    std::vector<uint8_t> buf = read_file(resolve(path));
+    AniCursor* c = buf.empty() ? nullptr : parse_ani(buf);
+    cache[key] = c;
+    return c;
+}
+
+// SetCursor: a loaded cursor, or null / 0x1 for "the engine draws its own", which hides the system one.
+extern "C" void LinuxCursor_Set(void* h)
+{
+    Display* dpy = static_cast<Display*>(LinuxWindow_Display());
+    ::Window win = LinuxWindow_Win();
+    if (!dpy || !win) return;
+    static void* last = reinterpret_cast<void*>(~uintptr_t(0));
+    if (h == last) return;
+    last = h;
+    static unsigned long blank = 0;
+    unsigned long cur = 0;
+    if (h && (uintptr_t)h != 1) {
+        AniCursor* c = static_cast<AniCursor*>(h);
+        if (!c->xcursor) build_xcursor(c, dpy);
+        cur = c->xcursor;
+    }
+    if (!cur) {
+        if (!blank) {
+            char zero = 0;
+            Pixmap pm = XCreateBitmapFromData(dpy, win, &zero, 1, 1);
+            XColor black{};
+            blank = XCreatePixmapCursor(dpy, pm, pm, &black, &black, 0, 0);
+            XFreePixmap(dpy, pm);
+        }
+        cur = blank;
+    }
+    XDefineCursor(dpy, win, cur);
+    XFlush(dpy);
+}
