+// In-memory LANMessage <-> wire layout (16-bit characters). Only the variant for the message type is converted.
+template <class D, class S>
+static void lanConvert(D &d, const S &s)
+{
+	memset(&d, 0, sizeof(d));
+	d.messageType = (typename D::Type)(int)s.messageType;
+	LANWire::text(d.name, ARRAY_SIZE(d.name), s.name, ARRAY_SIZE(s.name));
+	memcpy(d.userName, s.userName, sizeof(d.userName));
+	memcpy(d.hostName, s.hostName, sizeof(d.hostName));
+#define LAN_TEXT(v, f) LANWire::text(d.v.f, ARRAY_SIZE(d.v.f), s.v.f, ARRAY_SIZE(s.v.f))
+	switch (s.messageType)
+	{
+	case S::MSG_GAME_ANNOUNCE:
+		LAN_TEXT(GameInfo, gameName);
+		d.GameInfo.inProgress = s.GameInfo.inProgress;
+		memcpy(d.GameInfo.options, s.GameInfo.options, sizeof(d.GameInfo.options));
+		d.GameInfo.isDirectConnect = s.GameInfo.isDirectConnect;
+		break;
+	case S::MSG_REQUEST_GAME_INFO:
+		d.PlayerInfo.ip = s.PlayerInfo.ip;
+		LAN_TEXT(PlayerInfo, playerName);
+		break;
+	case S::MSG_REQUEST_JOIN:
+		d.GameToJoin.gameIP = s.GameToJoin.gameIP;
+		d.GameToJoin.exeCRC = s.GameToJoin.exeCRC;
+		d.GameToJoin.iniCRC = s.GameToJoin.iniCRC;
+		memcpy(d.GameToJoin.serial, s.GameToJoin.serial, sizeof(d.GameToJoin.serial));
+		break;
+	case S::MSG_JOIN_ACCEPT:
+		LAN_TEXT(GameJoined, gameName);
+		d.GameJoined.gameIP = s.GameJoined.gameIP;
+		d.GameJoined.playerIP = s.GameJoined.playerIP;
+		d.GameJoined.slotPosition = s.GameJoined.slotPosition;
+		break;
+	case S::MSG_JOIN_DENY:
+		LAN_TEXT(GameNotJoined, gameName);
+		d.GameNotJoined.gameIP = s.GameNotJoined.gameIP;
+		d.GameNotJoined.playerIP = s.GameNotJoined.playerIP;
+		d.GameNotJoined.reason = s.GameNotJoined.reason;
+		break;
+	case S::MSG_REQUEST_GAME_LEAVE:
+		LAN_TEXT(GameToLeave, gameName);
+		break;
+	case S::MSG_SET_ACCEPT:
+		LAN_TEXT(Accept, gameName);
+		d.Accept.isAccepted = s.Accept.isAccepted;
+		break;
+	case S::MSG_MAP_AVAILABILITY:
+		LAN_TEXT(MapStatus, gameName);
+		d.MapStatus.mapCRC = s.MapStatus.mapCRC;
+		d.MapStatus.hasMap = s.MapStatus.hasMap;
+		break;
+	case S::MSG_CHAT:
+		LAN_TEXT(Chat, gameName);
+		d.Chat.chatType = s.Chat.chatType;
+		LAN_TEXT(Chat, message);
+		break;
+	case S::MSG_GAME_START_TIMER:
+		d.StartTimer.seconds = s.StartTimer.seconds;
+		break;
+	case S::MSG_GAME_OPTIONS:
+		memcpy(d.GameOptions.options, s.GameOptions.options, sizeof(d.GameOptions.options));
+		break;
+	default:
+		break; // no payload beyond the header fields
+	}
+#undef LAN_TEXT
+}
+
 void LANAPI::sendMessage(LANMessage *msg, UnsignedInt ip /* = 0 */)
+{
+	LANWireMessage wire;
+	lanConvert(wire, *msg);
+	sendWire(&wire, ip);
+}
