diff --git a/b/Core/GameEngine/Include/GameNetwork/LANWire.h b/Core/GameEngine/Include/GameNetwork/LANWire.h
new file mode 100644
index 0000000..5273bcf
--- /dev/null
+++ b/Core/GameEngine/Include/GameNetwork/LANWire.h
@@ -0,0 +1,43 @@
+// LAN lobby packets carry text as UTF-16 code units on every platform, so a Mac and a Windows PC can see each
+// other's games. WideChar is 16 bits only on Windows; elsewhere it is 32, which made the in-memory LANMessage
+// larger than a packet. Pure functions, no engine dependencies.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace LANWire
+{
+
+// Copies a NUL-terminated string between character types of any width, converting through code points
+// (UTF-16 surrogate pairs <-> single 32-bit characters). Always terminates dst and never splits a pair.
+template <class D, class S>
+inline void text(D *dst, size_t dstCap, const S *src, size_t srcCap)
+{
+	if (dstCap == 0)
+		return;
+	size_t o = 0;
+	for (size_t i = 0; i < srcCap && src[i] != 0; ++i)
+	{
+		uint32_t cp = (uint32_t)src[i];
+		if (sizeof(S) == 2 && cp >= 0xD800 && cp <= 0xDBFF && i + 1 < srcCap && (uint32_t)src[i + 1] >= 0xDC00 && (uint32_t)src[i + 1] <= 0xDFFF)
+			cp = 0x10000 + ((cp - 0xD800) << 10) + ((uint32_t)src[++i] - 0xDC00);
+		if (sizeof(D) == 2 && cp >= 0x10000)
+		{
+			if (o + 2 >= dstCap)
+				break;
+			cp -= 0x10000;
+			dst[o++] = (D)(0xD800 + (cp >> 10));
+			dst[o++] = (D)(0xDC00 + (cp & 0x3FF));
+		}
+		else
+		{
+			if (o + 1 >= dstCap)
+				break;
+			dst[o++] = (D)cp;
+		}
+	}
+	dst[o] = 0;
+}
+
+}
