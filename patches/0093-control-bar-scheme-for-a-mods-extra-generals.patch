+// A mod can add generals that the loaded control bar has no scheme for: Shockwave's Armor, Special Weapons and Salvage
+// generals with Control Bar Pro, whose ControlBarScheme.ini replaces the mod's. They get their faction's scheme
+// (PlayerTemplate BaseSide; "USA" there is "America" in the scheme names) instead of the Default one.
+static ControlBarScheme *schemeForBaseSide(const std::list<ControlBarScheme*> &schemes, const AsciiString &baseSide)
+{
+	AsciiString base = baseSide;
+	if (base.compareNoCase("USA") == 0)
+		base.set("America");
+	ControlBarScheme *best = nullptr;
+	if (base.isEmpty())
+		return best;
+	for (std::list<ControlBarScheme*>::const_iterator it = schemes.begin(); it != schemes.end(); ++it)
+	{
+		ControlBarScheme *scheme = *it;
+		if (scheme && scheme->m_side.compareNoCase(base) == 0 && (!best || best->m_ScreenCreationRes.x < scheme->m_ScreenCreationRes.x))
+			best = scheme;
 	}
+	return best;
 }
 
