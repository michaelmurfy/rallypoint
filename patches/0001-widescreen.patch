+//-------------------------------------------------------------------------------------------------
+/** Sets the 3D view plane from the viewport size. Keeps world scale per pixel constant (hor+). */
+//-------------------------------------------------------------------------------------------------
+static void applyViewPlane(CameraClass *cam, Int width, Int height, Int displayWidth, Int displayHeight)
+{
+	if (!WideScreen::enabled())
+	{
+		// retail: fixed horizontal fov scaled by viewport width, vertical follows aspect
+		cam->Set_Aspect_Ratio((Real)width/(Real)height);
+		cam->Set_View_Plane((Real)width/(Real)displayWidth*DEG_TO_RADF(50.0f),-1);
+		return;
+	}
+	const WideScreen::ViewPlane p = WideScreen::viewPlane(width, height, displayHeight);
+	cam->Set_View_Plane(Vector2(-p.halfW, -p.halfH), Vector2(p.halfW, p.halfH));
+}
+
