@@ -0,0 +1,46 @@
+// Resolution/aspect-independent view and UI scaling. Pure math, no engine dependencies.
+// GEN_STRETCH=1 restores the retail behaviour (fixed horizontal fov, stretched 2D UI).
+#pragma once
+
+#include <cmath>
+#include <cstdlib>
+
+namespace WideScreen
+{
+
+inline bool enabled()
+{
+	static const bool on = []{ const char *v = getenv("GEN_STRETCH"); return !(v && v[0] == '1'); }();
+	return on;
+}
+
+struct ViewPlane { float halfW, halfH; };
+
+// Half extents (tan of half-angle) of the 3D view plane for a viewW x viewH viewport on a display
+// displayH pixels high. The retail camera is 50 degrees horizontal at 4:3; we pin the vertical
+// scale to that, so world units per pixel stay constant across resolutions and aspect ratios.
+// Wider screens see more to the sides instead of being zoomed in.
+inline ViewPlane viewPlane(int viewW, int viewH, int displayH)
+{
+	const float refHalfH = std::tan(0.5f * 50.0f * 3.14159265f / 180.0f) * 0.75f;
+	const float halfH = refHalfH * (float)viewH / (float)displayH;
+	return { halfH * (float)viewW / (float)viewH, halfH };
+}
+
+struct UiScale { float x, y; int xOffset; };
+
+// Scale for a 2D UI region authored at createW x createH. Wider than 4:3 gets uniform scaling,
+// centred horizontally, so the UI is not stretched. A region covering the whole creation
+// resolution (backdrops, modal blockers) still stretches to fill the display.
+inline UiScale uiScale(int dispW, int dispH, int createW, int createH, bool coversWholeScreen)
+{
+	UiScale s = { (float)dispW / (float)createW, (float)dispH / (float)createH, 0 };
+	if (enabled() && !coversWholeScreen && s.x > s.y)
+	{
+		s.x = s.y;
+		s.xOffset = (int)(((float)dispW - (float)createW * s.y) * 0.5f);
+	}
+	return s;
+}
+
+}
