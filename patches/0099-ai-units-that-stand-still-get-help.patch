  * The "main loop" of the AI subsystem
  */
 DECLARE_PERF_TIMER(AIUpdateInterface_update)
+// ------------------------------------------------------------------------------------------------
+/** Rallypoint: units of the computer players that have somewhere to go but do not move (boxed in by a chokepoint,
+ *  a path that no longer fits, allies that will not budge) used to stand there for the rest of the game.
+ *  Every second we compare the position with the last one. After 8 seconds without moving more than a cell:
+ *  1. ask for a new path to the same destination; 2. if that did not help, step the unit a couple of cells towards
+ *  the destination onto the nearest place it can stand; 3. if that did not help either, give up on the order, so the
+ *  AI's team moves on instead of waiting for it forever. Only uses what every player's game has (positions, frame,
+ *  paths), so it is the same everywhere; humans' units are never touched. */
+// ------------------------------------------------------------------------------------------------
+void AIUpdateInterface::watchForStuck(UpdateSleepTime &sleep)
+{
+	Object *obj = getObject();
+	const UnsignedInt now = TheGameLogic->getFrame();
+	if (now < m_stuckNextCheck)
+	{
+		// we are watching this unit: wake up for the next check even if the state machine would sleep longer
+		if (m_stuckChecks > 0 && UPDATE_SLEEP(m_stuckNextCheck - now) < sleep)
+			sleep = UPDATE_SLEEP(m_stuckNextCheck - now);
+		return;
+	}
+	m_stuckNextCheck = now + LOGICFRAMES_PER_SECOND;
+
+	const Player *player = obj->getControllingPlayer();
+	const Coord3D *pos = obj->getPosition();
+	const Path *path = getPath();
+	if (!player || player->getPlayerType() != PLAYER_COMPUTER || !path || !path->getLastNode()
+		|| !isMoving() || isWaitingForPath() || isAiInDeadState() || obj->isEffectivelyDead() || obj->isDisabled() || obj->isContained())
+	{
+		m_stuckChecks = 0;
+		m_stuckStage = 0;
+		m_stuckPos = *pos;
+		return;
+	}
+
+	const Real dx = pos->x - m_stuckPos.x;
+	const Real dy = pos->y - m_stuckPos.y;
+	if (dx*dx + dy*dy > PATHFIND_CELL_SIZE_F*PATHFIND_CELL_SIZE_F)
+	{
+		m_stuckChecks = 0;
+		m_stuckStage = 0;
+		m_stuckPos = *pos;
+		return;
+	}
+
+	if (++m_stuckChecks < 8)
+	{
+		if (UPDATE_SLEEP(LOGICFRAMES_PER_SECOND) < sleep)
+			sleep = UPDATE_SLEEP(LOGICFRAMES_PER_SECOND);
+		return;
+	}
+	m_stuckChecks = 0;
+
+	const Coord3D goal = *path->getLastNode()->getPosition();
+	fprintf(stderr, "[stuck] frame %u object %u %s at %.0f,%.0f for 8 s, going to %.0f,%.0f, step %d\n", now, (unsigned)obj->getID(),
+		obj->getTemplate()->getName().str(), pos->x, pos->y, goal.x, goal.y, (int)m_stuckStage);
+
+	switch (m_stuckStage)
+	{
+		case 0:
+			m_stuckStage = 1;
+			aiMoveToPosition(&goal, CMD_FROM_AI);
+			break;
+
+		case 1:
+		{
+			m_stuckStage = 2;
+			Coord3D to = *pos;
+			const Real gx = goal.x - pos->x, gy = goal.y - pos->y;
+			const Real len = sqrtf(gx*gx + gy*gy);
+			if (len > 1.0f && isDoingGroundMovement() && obj->getLayer() == LAYER_GROUND)
+			{
+				to.x += gx / len * PATHFIND_CELL_SIZE_F * 2;
+				to.y += gy / len * PATHFIND_CELL_SIZE_F * 2;
+				if (TheAI->pathfinder()->adjustToPossibleDestination(obj, getLocomotorSet(), &to))
+				{
+					const Real mx = to.x - pos->x, my = to.y - pos->y;
+					if (mx*mx + my*my <= 16 * PATHFIND_CELL_SIZE_F * PATHFIND_CELL_SIZE_F)
+					{
+						to.z = TheTerrainLogic->getGroundHeight(to.x, to.y);
+						obj->setPosition(&to);
+						TheAI->pathfinder()->updatePos(obj, &to);
+					}
+				}
+			}
+			aiMoveToPosition(&goal, CMD_FROM_AI);
+			break;
+		}
+
+		default:
+			m_stuckStage = 0;
+			aiIdle(CMD_FROM_AI);
+			break;
+	}
+	m_stuckPos = *obj->getPosition();
+	sleep = UPDATE_SLEEP_NONE;
+}
