+++ b/cmake/dx8_stub/linux_window.cpp
@@ -0,0 +1,313 @@
+// X11 window for the Linux engine. The rest of the game still speaks Win32
+// (HWND, GetClientRect). Input is queued in the same shape the macOS keyboard
+// and mouse already drain (MetalInput_Poll*), so no second input path is needed.
+#include <windows.h>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <string>
+
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+#include <X11/keysym.h>
+#undef Bool
+#undef Status
+#undef True
+#undef False
+#undef None
+#undef Success
+
+namespace {
+
+struct Win {
+    Display* dpy = nullptr;
+    ::Window win = 0;
+    int width = 800;
+    int height = 600;
+    int screenW = 1920;
+    int screenH = 1080;
+    Atom wmDelete = 0;
+    bool caps = false;
+};
+
+struct MouseEv { int type, x, y, delta; };
+struct KeyEv { int code, down; };
+
+Win* g = nullptr;
+std::deque<MouseEv> g_mouse;
+std::deque<KeyEv> g_keys;
+std::deque<unsigned> g_chars;
+
+// macOS virtual key codes, the values CocoaKeyboard::MapMacKey already understands.
+enum {
+    kVK_A=0x00, kVK_S=0x01, kVK_D=0x02, kVK_F=0x03, kVK_H=0x04, kVK_G=0x05,
+    kVK_Z=0x06, kVK_X=0x07, kVK_C=0x08, kVK_V=0x09, kVK_B=0x0B, kVK_Q=0x0C,
+    kVK_W=0x0D, kVK_E=0x0E, kVK_R=0x0F, kVK_Y=0x10, kVK_T=0x11,
+    kVK_1=0x12, kVK_2=0x13, kVK_3=0x14, kVK_4=0x15, kVK_6=0x16, kVK_5=0x17,
+    kVK_Equal=0x18, kVK_9=0x19, kVK_7=0x1A, kVK_Minus=0x1B, kVK_8=0x1C, kVK_0=0x1D,
+    kVK_RightBracket=0x1E, kVK_O=0x1F, kVK_U=0x20, kVK_LeftBracket=0x21,
+    kVK_I=0x22, kVK_P=0x23, kVK_Return=0x24, kVK_L=0x25, kVK_J=0x26,
+    kVK_Quote=0x27, kVK_K=0x28, kVK_Semicolon=0x29, kVK_Backslash=0x2A,
+    kVK_Comma=0x2B, kVK_Slash=0x2C, kVK_N=0x2D, kVK_M=0x2E, kVK_Period=0x2F,
+    kVK_Tab=0x30, kVK_Space=0x31, kVK_Grave=0x32, kVK_Delete=0x33, kVK_Escape=0x35,
+    kVK_Shift=0x38, kVK_CapsLock=0x39, kVK_Option=0x3A, kVK_Control=0x3B,
+    kVK_RightShift=0x3C, kVK_RightOption=0x3D, kVK_RightControl=0x3E,
+    kVK_F1=0x7A, kVK_F2=0x78, kVK_F3=0x63, kVK_F4=0x76, kVK_F5=0x60, kVK_F6=0x61,
+    kVK_F7=0x62, kVK_F8=0x64, kVK_F9=0x65, kVK_F10=0x6D, kVK_F11=0x67, kVK_F12=0x6F,
+    kVK_LeftArrow=0x7B, kVK_RightArrow=0x7C, kVK_DownArrow=0x7D, kVK_UpArrow=0x7E,
+    kVK_ForwardDelete=0x75, kVK_Home=0x73, kVK_End=0x77, kVK_PageUp=0x74, kVK_PageDown=0x79,
+    kVK_KP0=0x52, kVK_KP1=0x53, kVK_KP2=0x54, kVK_KP3=0x55, kVK_KP4=0x56,
+    kVK_KP5=0x57, kVK_KP6=0x58, kVK_KP7=0x59, kVK_KP8=0x5B, kVK_KP9=0x5C,
+    kVK_KPEnter=0x4C, kVK_KPPlus=0x45, kVK_KPMinus=0x4E, kVK_KPMultiply=0x43,
+    kVK_KPDivide=0x4B, kVK_KPDecimal=0x41,
+};
+
+int macKey(KeySym k)
+{
+    if (k >= XK_a && k <= XK_z) {
+        static const int map[] = { kVK_A,kVK_B,kVK_C,kVK_D,kVK_E,kVK_F,kVK_G,kVK_H,kVK_I,kVK_J,kVK_K,kVK_L,kVK_M,kVK_N,kVK_O,kVK_P,kVK_Q,kVK_R,kVK_S,kVK_T,kVK_U,kVK_V,kVK_W,kVK_X,kVK_Y,kVK_Z };
+        return map[k - XK_a];
+    }
+    if (k >= XK_A && k <= XK_Z) return macKey(k - XK_A + XK_a);
+    if (k >= XK_0 && k <= XK_9) {
+        static const int map[] = { kVK_0,kVK_1,kVK_2,kVK_3,kVK_4,kVK_5,kVK_6,kVK_7,kVK_8,kVK_9 };
+        return map[k - XK_0];
+    }
+    if (k >= XK_KP_0 && k <= XK_KP_9) {
+        static const int map[] = { kVK_KP0,kVK_KP1,kVK_KP2,kVK_KP3,kVK_KP4,kVK_KP5,kVK_KP6,kVK_KP7,kVK_KP8,kVK_KP9 };
+        return map[k - XK_KP_0];
+    }
+    if (k >= XK_F1 && k <= XK_F12) {
+        static const int map[] = { kVK_F1,kVK_F2,kVK_F3,kVK_F4,kVK_F5,kVK_F6,kVK_F7,kVK_F8,kVK_F9,kVK_F10,kVK_F11,kVK_F12 };
+        return map[k - XK_F1];
+    }
+    switch (k) {
+    case XK_Return: case XK_KP_Enter: return k == XK_KP_Enter ? kVK_KPEnter : kVK_Return;
+    case XK_Escape: return kVK_Escape;
+    case XK_space: return kVK_Space;
+    case XK_Tab: return kVK_Tab;
+    case XK_BackSpace: return kVK_Delete;
+    case XK_Delete: return kVK_ForwardDelete;
+    case XK_minus: return kVK_Minus;
+    case XK_equal: return kVK_Equal;
+    case XK_bracketleft: return kVK_LeftBracket;
+    case XK_bracketright: return kVK_RightBracket;
+    case XK_semicolon: return kVK_Semicolon;
+    case XK_apostrophe: return kVK_Quote;
+    case XK_grave: return kVK_Grave;
+    case XK_backslash: return kVK_Backslash;
+    case XK_comma: return kVK_Comma;
+    case XK_period: return kVK_Period;
+    case XK_slash: return kVK_Slash;
+    case XK_Caps_Lock: return kVK_CapsLock;
+    case XK_Shift_L: return kVK_Shift;
+    case XK_Shift_R: return kVK_RightShift;
+    case XK_Control_L: return kVK_Control;
+    case XK_Control_R: return kVK_RightControl;
+    case XK_Alt_L: return kVK_Option;
+    case XK_Alt_R: return kVK_RightOption;
+    case XK_Up: return kVK_UpArrow;
+    case XK_Down: return kVK_DownArrow;
+    case XK_Left: return kVK_LeftArrow;
+    case XK_Right: return kVK_RightArrow;
+    case XK_Home: return kVK_Home;
+    case XK_End: return kVK_End;
+    case XK_Page_Up: return kVK_PageUp;
+    case XK_Page_Down: return kVK_PageDown;
+    case XK_KP_Add: return kVK_KPPlus;
+    case XK_KP_Subtract: return kVK_KPMinus;
+    case XK_KP_Multiply: return kVK_KPMultiply;
+    case XK_KP_Divide: return kVK_KPDivide;
+    case XK_KP_Decimal: return kVK_KPDecimal;
+    default: return -1;
+    }
+}
+
+void drain()
+{
+    if (!g || !g->dpy) return;
+    while (XPending(g->dpy)) {
+        XEvent e;
+        XNextEvent(g->dpy, &e);
+        if (e.xany.window != g->win) continue;
+        if (e.type == MotionNotify) {
+            g_mouse.push_back({1, e.xmotion.x, e.xmotion.y, 0});
+        } else if (e.type == ButtonPress || e.type == ButtonRelease) {
+            int down = e.type == ButtonPress;
+            int x = e.xbutton.x, y = e.xbutton.y;
+            if (e.xbutton.button == Button4 || e.xbutton.button == Button5) {
+                if (down) g_mouse.push_back({9, x, y, e.xbutton.button == Button4 ? 120 : -120});
+                continue;
+            }
+            int type = 0;
+            if (e.xbutton.button == Button1) type = down ? 2 : 3;
+            else if (e.xbutton.button == Button3) type = down ? 5 : 6;
+            else if (e.xbutton.button == Button2) type = down ? 7 : 8;
+            if (type) g_mouse.push_back({type, x, y, 0});
+        } else if (e.type == KeyPress || e.type == KeyRelease) {
+            // Key-repeat comes through as a release plus a press. Keep both.
+            KeySym k = XLookupKeysym(&e.xkey, 0);
+            int code = macKey(k);
+            int down = e.type == KeyPress;
+            if (code == kVK_CapsLock && down) g->caps = !g->caps;
+            if (code >= 0) g_keys.push_back({code, down});
+            if (down) {
+                char buf[8] = {};
+                int n = XLookupString(&e.xkey, buf, sizeof(buf), nullptr, nullptr);
+                if (n == 1 && buf[0] >= 32 && buf[0] != 127) g_chars.push_back((unsigned char)buf[0]);
+            }
+        } else if (e.type == ConfigureNotify) {
+            g->width = e.xconfigure.width;
+            g->height = e.xconfigure.height;
+        } else if (e.type == ClientMessage && (Atom)e.xclient.data.l[0] == g->wmDelete) {
+            std::fprintf(stderr, "[linux] window closed\n");
+            std::_Exit(0);
+        }
+    }
+}
+
+Win* asWin(HWND h) { return h ? static_cast<Win*>(h) : g; }
+
+} // namespace
+
+extern "C" int MetalInput_PollMouse(int* type, int* x, int* y, int* delta)
+{
+    drain();
+    if (g_mouse.empty()) return 0;
+    MouseEv e = g_mouse.front();
+    g_mouse.pop_front();
+    if (type) *type = e.type;
+    if (x) *x = e.x;
+    if (y) *y = e.y;
+    if (delta) *delta = e.delta;
+    return 1;
+}
+extern "C" int MetalInput_PollKey(int* code, int* down)
+{
+    drain();
+    if (g_keys.empty()) return 0;
+    KeyEv e = g_keys.front();
+    g_keys.pop_front();
+    if (code) *code = e.code;
+    if (down) *down = e.down;
+    return 1;
+}
+extern "C" int MetalInput_CapsOn(void) { return g && g->caps ? 1 : 0; }
+extern "C" int MetalInput_PollChar(unsigned int* out)
+{
+    drain();
+    if (g_chars.empty()) return 0;
+    if (out) *out = g_chars.front();
+    g_chars.pop_front();
+    return 1;
+}
+
+extern "C" int Linux_CreateVulkanSurface(void* hwnd, void* instance, void* getProc, void** surface)
+{
+    Win* w = asWin((HWND)hwnd);
+    if (!w || !w->dpy || !instance || !getProc || !surface) return -1;
+    using GetProc = void* (*)(void*, const char*);
+    using Create = int (*)(void*, const void*, const void*, void**);
+    auto gp = reinterpret_cast<GetProc>(getProc);
+    auto create = reinterpret_cast<Create>(gp(instance, "vkCreateXlibSurfaceKHR"));
+    if (!create) return -1;
+    struct Info {
+        uint32_t sType; const void* pNext; uint32_t flags; Display* dpy; ::Window window;
+    } sci{};
+    sci.sType = 1000004000; // VK_STRUCTURE_TYPE_XLIB_SURFACE_CREATE_INFO_KHR
+    sci.dpy = w->dpy;
+    sci.window = w->win;
+    return create(instance, &sci, nullptr, surface);
+}
+
+ATOM RegisterClass(const WNDCLASS*) { return (ATOM)1; }
+BOOL UnregisterClass(const char*, HINSTANCE) { return TRUE; }
+
+HWND CreateWindow(const char*, const char* title, DWORD, int x, int y, int w, int h, HWND, HMENU, HINSTANCE, void*)
+{
+    if (!g) g = new Win;
+    if (!g->dpy) {
+        g->dpy = XOpenDisplay(nullptr);
+        if (!g->dpy) {
+            std::fprintf(stderr, "[linux] XOpenDisplay failed. Set DISPLAY (an XWayland session is enough).\n");
+            return nullptr;
+        }
+        g->screenW = DisplayWidth(g->dpy, DefaultScreen(g->dpy));
+        g->screenH = DisplayHeight(g->dpy, DefaultScreen(g->dpy));
+    }
+    if (w <= 0) w = 800;
+    if (h <= 0) h = 600;
+    g->width = w;
+    g->height = h;
+    int scr = DefaultScreen(g->dpy);
+    g->win = XCreateSimpleWindow(g->dpy, RootWindow(g->dpy, scr), x < 0 ? 0 : x, y < 0 ? 0 : y, (unsigned)w, (unsigned)h, 0,
+        BlackPixel(g->dpy, scr), BlackPixel(g->dpy, scr));
+    if (title) XStoreName(g->dpy, g->win, title);
+    g->wmDelete = XInternAtom(g->dpy, "WM_DELETE_WINDOW", 0);
+    XSetWMProtocols(g->dpy, g->win, &g->wmDelete, 1);
+    XSelectInput(g->dpy, g->win, KeyPressMask | KeyReleaseMask | ButtonPressMask | ButtonReleaseMask | PointerMotionMask | StructureNotifyMask | FocusChangeMask);
+    XMapWindow(g->dpy, g->win);
+    XFlush(g->dpy);
+    std::fprintf(stderr, "[linux] window %dx%d on %dx%d\n", w, h, g->screenW, g->screenH);
+    return g;
+}
+
+HWND CreateWindowEx(DWORD, const char* cls, const char* title, DWORD style, int x, int y, int w, int h, HWND parent, HMENU menu, HINSTANCE inst, void* param)
+{
+    return CreateWindow(cls, title, style, x, y, w, h, parent, menu, inst, param);
+}
+
+BOOL DestroyWindow(HWND h)
+{
+    Win* w = asWin(h);
+    if (w && w->dpy && w->win) {
+        XDestroyWindow(w->dpy, w->win);
+        w->win = 0;
+        XFlush(w->dpy);
+    }
+    return TRUE;
+}
+
+BOOL GetClientRect(HWND h, RECT* r)
+{
+    Win* w = asWin(h);
+    if (r) {
+        r->left = r->top = 0;
+        r->right = w ? w->width : 0;
+        r->bottom = w ? w->height : 0;
+    }
+    return TRUE;
+}
+BOOL GetWindowRect(HWND h, RECT* r) { return GetClientRect(h, r); }
+
+BOOL SetWindowPos(HWND h, HWND, int x, int y, int w, int hgt, unsigned flags)
+{
+    Win* win = asWin(h);
+    if (!win || !win->dpy || !win->win) return TRUE;
+    if (!(flags & 0x0001)) { // SWP_NOSIZE
+        win->width = w;
+        win->height = hgt;
+        XResizeWindow(win->dpy, win->win, (unsigned)w, (unsigned)hgt);
+    }
+    if (!(flags & 0x0002)) XMoveWindow(win->dpy, win->win, x, y); // SWP_NOMOVE
+    XFlush(win->dpy);
+    return TRUE;
+}
+
+BOOL SetWindowText(HWND h, const char* s)
+{
+    Win* w = asWin(h);
+    if (w && w->dpy && w->win && s) XStoreName(w->dpy, w->win, s);
+    return TRUE;
+}
+
+int GetSystemMetrics(int index)
+{
+    if (g && g->dpy) {
+        if (index == 0) return g->screenW;
+        if (index == 1) return g->screenH;
+    }
+    if (index == 0) return 1920;
+    if (index == 1) return 1080;
+    return 0;
+}
diff --git a/tmp/engine-linux/cmake/linux.cmake b/cmake/linux.cmake
new file mode 100644
index 0000000..d7c358f
--- /dev/null
+++ b/cmake/linux.cmake
@@ -0,0 +1,21 @@
+# Linux x86_64. The game window is X11 (XWayland on a Wayland desktop) and the picture is the native Vulkan renderer.
+if(UNIX AND NOT APPLE)
+    message(STATUS "Configuring Linux build settings")
+    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+        message(FATAL_ERROR "The Linux build requires 64-bit pointers.")
+    endif()
+    add_compile_options(
+        -fno-strict-aliasing
+        -ffp-contract=off
+        -fdeclspec
+        -Wno-deprecated-declarations
+        -Wno-ignored-attributes
+    )
+    add_compile_definitions(_USE_MATH_DEFINES RTS_PLATFORM_LINUX=1 _snprintf=snprintf _vsnprintf=vsnprintf)
+    # One binary for Debian, Ubuntu, Fedora and Arch: the C++ runtime travels with the executable.
+    # Vulkan, X11 and ALSA stay shared libraries. Their sonames are the same on those distros.
+    add_link_options(-static-libstdc++ -static-libgcc)
+    find_package(X11 REQUIRED)
+    add_library(linux_sys INTERFACE)
+    target_link_libraries(linux_sys INTERFACE X11::X11 ${CMAKE_DL_LIBS} pthread)
+endif()
