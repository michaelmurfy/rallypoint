+// A fullscreen window is borderless (WS_POPUP). Moving it to another virtual desktop or monitor makes
+// Windows recalculate the frame and put a border back. Drop any frame styles it put back.
+static void keepFullscreenBorderless(HWND hWnd)
+{
+	if (!TheGlobalData || TheGlobalData->m_windowed || !hWnd)
+		return;
+	const LONG frame = WS_CAPTION | WS_THICKFRAME | WS_BORDER | WS_DLGFRAME | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX;
+	LONG style = GetWindowLong(hWnd, GWL_STYLE);
+	if (!(style & frame))
+		return;
+	static Bool busy = FALSE;
+	if (busy)
+		return;
+	busy = TRUE;
+	SetWindowLong(hWnd, GWL_STYLE, (style & ~frame) | WS_POPUP | WS_VISIBLE);
+	SetWindowPos(hWnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+	busy = FALSE;
+}
