+/// Free supplies per second for computer players. Faster build timers alone stall on cash (the AI cannot
+/// spend money it does not have), so the trickle funds the pace: roughly one extra gatherer at 1, more above.
+Int AI::boostIncome()
+{
+	static const Int income[4] = { 0, 25, 60, 110 };
+	return income[aiBoostLevel()];
+}
+
+/// Fraction of a team's cost the AI must have banked before starting it (times AIData's TeamResourcesToBuild).
+/// Below 1.0 the AI attacks with less saved up instead of turtling until it can afford the whole team.
+Real AI::boostTeamFunds()
+{
+	static const Real funds[4] = { 1.0f, 0.85f, 0.7f, 0.55f };
+	return funds[aiBoostLevel()];
+}
