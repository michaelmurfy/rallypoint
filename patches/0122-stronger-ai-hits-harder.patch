 //-------------------------------------------------------------------------------------------------
 enum GameDifficulty AIPlayer::getAIDifficulty() const
 {
+	// Rallypoint "Stronger AI": a boosted computer player fights at least as well as the level below says.
+	// Everything that reads the difficulty (victim choice, team focus fire, gatherer counts, map team conditions)
+	// moves up together; the saved m_difficulty is untouched, so this matches on every machine.
+	if (AI::boostLevel() >= 2) {
+		return DIFFICULTY_HARD;
+	}
+	if (AI::boostLevel() == 1 && m_difficulty == DIFFICULTY_EASY) {
+		return DIFFICULTY_NORMAL;
+	}
 	return m_difficulty;
 }
 
