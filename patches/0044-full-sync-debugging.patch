+UnsignedInt W3DTerrainVisual::getLogicHeightHash()
+{
+	if (!m_logicHeightMap)
+		return 0;
+	UnsignedInt h = 2166136261u;
+	const UnsignedByte *d = m_logicHeightMap->getDataPtr();
+	const Int n = m_logicHeightMap->getXExtent() * m_logicHeightMap->getYExtent();
+	for (Int k = 0; k < n; k++)
+		h = (h ^ d[k]) * 16777619u;
+	return h;
+}
