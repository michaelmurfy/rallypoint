+// Rallypoint: what this machine's floating point does, so two machines' logs can be compared without a debugger.
+// The probes go through volatiles so the compiler cannot fold them.
+static void logFloatEnvironment()
+{
+	static Bool done = FALSE;
+	if (done)
+		return;
+	done = TRUE;
+	volatile float a = 1.1f, b = 3.7f, c = -4.07f, big = 16777217.0f, ang = 0.7f;
+	float fused = a * b + c;
+	float root = (float)sqrt((double)(a * b));
+	float big1 = big + 1.0f;
+	float s = (float)Sin(ang), co = (float)Cos(ang);
+	float ls = sinf(ang), lc = cosf(ang);
+	UnsignedInt v[7];
+	memcpy(&v[0], &fused, 4); memcpy(&v[1], &root, 4); memcpy(&v[2], &big1, 4);
+	memcpy(&v[3], &s, 4); memcpy(&v[4], &co, 4); memcpy(&v[5], &ls, 4); memcpy(&v[6], &lc, 4);
+#if defined(_MSC_VER)
+	const char *compiler = "msvc";
+	int compilerVersion = (int)_MSC_VER;
+#elif defined(__clang__)
+	const char *compiler = "clang";
+	int compilerVersion = (int)__clang_major__;
+#else
+	const char *compiler = "other";
+	int compilerVersion = 0;
+#endif
+#ifdef FLT_EVAL_METHOD
+	int evalMethod = (int)FLT_EVAL_METHOD;
+#else
+	int evalMethod = -1;
+#endif
+	fprintf(stderr, "[env] compiler %s %d, FLT_EVAL_METHOD %d, sizeof(long) %d, sizeof(void*) %d, sizeof(wchar_t) %d\n", compiler, compilerVersion, evalMethod, (int)sizeof(long), (int)sizeof(void*), (int)sizeof(wchar_t));
+	fprintf(stderr, "[env] float probes: a*b+c %08X, sqrt %08X, 2^24+1+1 %08X, Sin(0.7) %08X, Cos(0.7) %08X, libm sinf %08X, libm cosf %08X\n", v[0], v[1], v[2], v[3], v[4], v[5], v[6]);
+	fflush(stderr);
+}
