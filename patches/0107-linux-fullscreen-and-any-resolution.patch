+
+// A fullscreen game window is WS_POPUP without a caption. XFCE still draws a
+// title bar unless the motif hints say there are no decorations, and it keeps
+// the panel on top unless the window is the screen and asks to be fullscreen.
+void applyBorderless(Win* w)
+{
+    if (!w || !w->dpy || !w->win || !w->borderless) return;
+    Atom motif = XInternAtom(w->dpy, "_MOTIF_WM_HINTS", 0);
+    unsigned long hints[5] = { 2, 0, 0, 0, 0 }; // decorations = none
+    XChangeProperty(w->dpy, w->win, motif, motif, 32, PropModeReplace, reinterpret_cast<unsigned char*>(hints), 5);
+    if (w->width < w->screenW - 2 || w->height < w->screenH - 2) return;
+    Atom state = XInternAtom(w->dpy, "_NET_WM_STATE", 0);
+    Atom full = XInternAtom(w->dpy, "_NET_WM_STATE_FULLSCREEN", 0);
+    XChangeProperty(w->dpy, w->win, state, XA_ATOM, 32, PropModeReplace, reinterpret_cast<unsigned char*>(&full), 1);
+    XEvent ev{};
+    ev.type = ClientMessage;
+    ev.xclient.window = w->win;
+    ev.xclient.message_type = state;
+    ev.xclient.format = 32;
+    ev.xclient.data.l[0] = 1; // _NET_WM_STATE_ADD
+    ev.xclient.data.l[1] = static_cast<long>(full);
+    XSendEvent(w->dpy, DefaultRootWindow(w->dpy), 0, SubstructureRedirectMask | SubstructureNotifyMask, &ev);
+}
 
 } // namespace
 
