# Keys only. Named 10- so it wins over the provider's own drop-ins (sshd uses the first value it reads).
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
# Nothing here needs these, and each is a way for a stranger's machine to reach back into yours.
X11Forwarding no
AllowAgentForwarding no
MaxAuthTries 3
LoginGraceTime 30
