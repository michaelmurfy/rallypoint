{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rallypoint",
  "version": "1.0.7",
  "identifier": "nz.co.murfy.rallypoint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rallypoint",
        "width": 1200,
        "height": 840,
        "minWidth": 860,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engine",
      "ra2engine",
      "ra2-mappacks"
    ],
    "category": "Game",
    "publisher": "Michael Murphy <michael@murfy.co.nz>",
    "shortDescription": "Launcher for C&C Generals: Zero Hour",
    "longDescription": "Launcher, mods, maps and online play for C&C Generals: Zero Hour on Linux. You bring your own copy of the game.",
    "linux": {
      "deb": {
        "depends": ["libx11-6", "libfreetype6", "libvulkan1", "libasound2t64 | libasound2"],
        "recommends": ["mesa-vulkan-drivers", "zip"]
      },
      "rpm": {
        "depends": ["libX11", "freetype", "vulkan-loader", "mesa-vulkan-drivers", "alsa-lib", "zip"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
