{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rallypoint",
  "version": "0.4.1",
  "identifier": "nz.co.murfy.rallypoint",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Rallypoint",
        "width": 980,
        "height": 700,
        "minWidth": 780,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "engine/*"
    ],
    "shortDescription": "Launcher for C&C Generals: Zero Hour",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
