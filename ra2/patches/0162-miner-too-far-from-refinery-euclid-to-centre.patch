+// 0162 [RE: Mission_Harvest FUN_0073E5E0 0x0073EBB1..0x0073EC19]: too far = ftol(sqrt(d^2)) from the miner to the
+// refinery's footprint centre > HarvesterTooFarDistance (5) * 256 leptons.
+TEST_CASE("harvest: the too-far-from-refinery test measures to the foundation centre") {
+    Building b;
+    b.cx = 20; b.cy = 20; b.fw = 3; b.fh = 3;   // centre (21.5, 21.5) cells
+    CHECK_FALSE(ra2engine::harvester_too_far(21, 21, b));
+    CHECK_FALSE(ra2engine::harvester_too_far(21, 26, b));   // 5 cells south of the centre: 1280 leptons is "close"
+    CHECK(ra2engine::harvester_too_far(21, 27, b));
+    CHECK(ra2engine::harvester_too_far(21, 15, b));         // 6 cells north of the centre; the edge is 5 cells off
+    CHECK_FALSE(ra2engine::harvester_too_far(21, 16, b));
+    CHECK(ra2engine::harvester_too_far(26, 26, b));         // Euclid: the diagonal reaches further than 5 per axis
+}
