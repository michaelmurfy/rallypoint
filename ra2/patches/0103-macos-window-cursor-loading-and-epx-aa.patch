+static std::vector<uint8_t> epx_aa_2x(const uint8_t* src, int w, int h) {
+    const int ow = w * 2, oh = h * 2;
+    std::vector<uint8_t> out(static_cast<std::size_t>(ow) * oh * 4, 0);
+    auto at = [&](int x, int y) -> const uint8_t* {
+        x = std::max(0, std::min(w - 1, x));
+        y = std::max(0, std::min(h - 1, y));
+        return src + (static_cast<std::size_t>(y) * w + x) * 4;
+    };
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const uint8_t* P = at(x, y);
+            const uint8_t* A = at(x, y - 1);
+            const uint8_t* B = at(x + 1, y);
+            const uint8_t* C = at(x - 1, y);
+            const uint8_t* D = at(x, y + 1);
+            uint8_t* p0 = out.data() + (static_cast<std::size_t>(2 * y) * ow + 2 * x) * 4;
+            uint8_t* p1 = p0 + 4;
+            uint8_t* p2 = p0 + static_cast<std::size_t>(ow) * 4;
+            uint8_t* p3 = p2 + 4;
+            for (int k = 0; k < 4; ++k) p0[k] = p1[k] = p2[k] = p3[k] = P[k];
+            if (P[3] == 0) {
+                // Subpixel silhouette corner anti-aliasing on transparent staircase notches.
+                if (C[3] > 0 && A[3] > 0 && px_sim(C, A) && !px_sim(C, D) && !px_sim(A, B)) {
+                    px_avg(p0, C, A);
+                    p0[3] = static_cast<uint8_t>(static_cast<int>(p0[3]) * 140 / 255);
+                }
+                if (A[3] > 0 && B[3] > 0 && px_sim(A, B) && !px_sim(A, C) && !px_sim(B, D)) {
+                    px_avg(p1, A, B);
+                    p1[3] = static_cast<uint8_t>(static_cast<int>(p1[3]) * 140 / 255);
+                }
+                if (D[3] > 0 && C[3] > 0 && px_sim(D, C) && !px_sim(D, B) && !px_sim(C, A)) {
+                    px_avg(p2, D, C);
+                    p2[3] = static_cast<uint8_t>(static_cast<int>(p2[3]) * 140 / 255);
+                }
+                if (B[3] > 0 && D[3] > 0 && px_sim(B, D) && !px_sim(B, A) && !px_sim(D, C)) {
+                    px_avg(p3, B, D);
+                    p3[3] = static_cast<uint8_t>(static_cast<int>(p3[3]) * 140 / 255);
+                }
+            } else {
+                uint8_t ca[4], ab[4], dc[4], bd[4];
+                if (px_sim(C, A) && !px_sim(C, D) && !px_sim(A, B)) { px_avg(ca, C, A); px_avg(p0, P, ca); }
+                if (px_sim(A, B) && !px_sim(A, C) && !px_sim(B, D)) { px_avg(ab, A, B); px_avg(p1, P, ab); }
+                if (px_sim(D, C) && !px_sim(D, B) && !px_sim(C, A)) { px_avg(dc, D, C); px_avg(p2, P, dc); }
+                if (px_sim(B, D) && !px_sim(B, A) && !px_sim(D, C)) { px_avg(bd, B, D); px_avg(p3, P, bd); }
+            }
+        }
+    }
+    return out;
+}
