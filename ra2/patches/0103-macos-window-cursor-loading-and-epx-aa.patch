 }
 
+// 2x EPX / Scale2x + subpixel diagonal edge anti-aliasing for unit, building,
+// effect, cameo and cursor sprites (terrain tiles with '#' in their key and
+// pre-rasterized 'tt:' font runs stay 1:1).
+static bool should_epx_aa(const std::string& key, int w, int h) {
+    if (w < 2 || h < 2 || w * h > 512 * 512) return false;
+    if (key.find('#') != std::string::npos) return false;
+    if (key.rfind("tt:", 0) == 0 || key.rfind("fnt", 0) == 0 || key.rfind("ug:", 0) == 0) return false;
+    if (key.rfind("mp_prev:", 0) == 0) return false;
+    return true;
+}
+
+static bool px_sim(const uint8_t* a, const uint8_t* b) {
+    if ((a[3] == 0) != (b[3] == 0)) return false;
+    if (a[3] == 0) return true;
+    const int dr = static_cast<int>(a[0]) - static_cast<int>(b[0]);
+    const int dg = static_cast<int>(a[1]) - static_cast<int>(b[1]);
+    const int db = static_cast<int>(a[2]) - static_cast<int>(b[2]);
+    return dr * dr + dg * dg + db * db <= 24 * 24;
+}
+
+static void px_avg(uint8_t* dst, const uint8_t* a, const uint8_t* b) {
+    if (a[3] == 0 && b[3] == 0) {
+        dst[0] = dst[1] = dst[2] = dst[3] = 0;
+    } else if (a[3] == 0) {
+        dst[0] = b[0]; dst[1] = b[1]; dst[2] = b[2]; dst[3] = static_cast<uint8_t>(b[3] * 140 / 255);
+    } else if (b[3] == 0) {
+        dst[0] = a[0]; dst[1] = a[1]; dst[2] = a[2]; dst[3] = static_cast<uint8_t>(a[3] * 140 / 255);
+    } else {
+        dst[0] = static_cast<uint8_t>((static_cast<int>(a[0]) + b[0] + 1) >> 1);
+        dst[1] = static_cast<uint8_t>((static_cast<int>(a[1]) + b[1] + 1) >> 1);
+        dst[2] = static_cast<uint8_t>((static_cast<int>(a[2]) + b[2] + 1) >> 1);
