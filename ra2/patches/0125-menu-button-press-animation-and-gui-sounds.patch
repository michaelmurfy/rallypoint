 // [Task 5] Decode theme.mix/grinder.wav (stereo IMA, T4) and downmix to the mono
-// SDL sink, register as the looping "menu:grinder" voice. Best-effort: any
-// failure leaves sys.enabled=false (menu simply runs silent). Honors no_audio at
-// the call site (run_menu skips this entirely when no_audio).
+// SDL sink, register as the looping "menu:grinder" voice. Best-effort: a missing
+// theme.mix (or grinder.wav) only loses the music; the shell GUI sounds still
+// load and the menu is still clickable. Honors no_audio at the call site
+// (run_menu skips this entirely when no_audio).
+//
+// Steam ships the file as THEME.MIX; Linux is case-sensitive, so the lowercase
+// name must be resolved to the real spelling first.
+std::string find_data_file(const std::string& dir, const std::string& name) {
+    const std::string exact = dir + name;
+    {
+        std::ifstream f(exact, std::ios::binary);
+        if (f) return exact;
+    }
+    std::error_code ec;
+    std::filesystem::directory_iterator it(std::filesystem::u8path(dir), ec), end;
+    for (; !ec && it != end; it.increment(ec)) {
+        std::string fn = it->path().filename().u8string();
+        if (fn.size() != name.size()) continue;
+        bool same = true;
+        for (std::size_t i = 0; i < fn.size() && same; ++i)
+            same = std::tolower(static_cast<unsigned char>(fn[i])) ==
+                   std::tolower(static_cast<unsigned char>(name[i]));
+        if (same) return it->path().u8string();
+    }
+    return exact;
+}
