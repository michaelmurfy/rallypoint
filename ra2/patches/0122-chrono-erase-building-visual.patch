diff --git a/tests/test_pres_chrono_tint.cpp b/tests/test_pres_chrono_tint.cpp
new file mode 100644
index 0000000..15f01da
--- /dev/null
+++ b/tests/test_pres_chrono_tint.cpp
@@ -0,0 +1,11 @@
+#include "doctest.h"
+#include "pres_chrono_tint.hpp"
+
+TEST_CASE("chrono erase building tint is translucent only while warping") {
+    unsigned char alpha = 255;
+    CHECK_FALSE(pres_apply_chrono_warp_alpha(alpha, 0));
+    CHECK(alpha == 255);
+
+    CHECK(pres_apply_chrono_warp_alpha(alpha, 1));
+    CHECK(alpha == 128);
+}
