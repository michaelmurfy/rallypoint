diff --git a/engine/pres_chrono_tint.hpp b/engine/pres_chrono_tint.hpp
new file mode 100644
index 0000000..a154e22
--- /dev/null
+++ b/engine/pres_chrono_tint.hpp
@@ -0,0 +1,11 @@
+#pragma once
+
+// The Chrono Legionnaire's erase effect is presentation-only. Keep this tiny
+// alpha rule separate so it can be regression-tested without game assets.
+inline bool pres_apply_chrono_warp_alpha(unsigned char& alpha, int warp_remaining) {
+    if (warp_remaining > 0) {
+        alpha = 128;
+        return true;
+    }
+    return false;
+}
