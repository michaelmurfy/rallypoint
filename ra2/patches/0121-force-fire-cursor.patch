+TEST_CASE("Input: Ctrl over ground with a selected unit classifies force-fire") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    world.add_unit(10, 10, "GI", 0);
+    Camera cam;
+    Input input(world, cam, 1280, 720);
+    input.selection().set(0);
+
+    int px = 0, py = 0;
+    px_for_cell(20, 20, px, py);
+    InputEvent move;
+    move.kind = InputEvent::PointerMove;
+    move.x = px;
+    move.y = py;
+    move.ctrl = true;
+    input.handle(move);
+
+    CHECK(input.force_fire_held());
+    CHECK(input.action_at(px, py) == Input::Action::Attack);
+}
