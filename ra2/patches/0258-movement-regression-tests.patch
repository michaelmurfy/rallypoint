+TEST_CASE("abilities world: drone re-attacks after the host dies [RE: §B]") {
+    // Asset-free (blank map): infect tank A, let ticks kill it, the drone
+    // pops out alive, then infects tank B on a fresh order.
+    // Note: blank maps are not walkable, so the drone is staged by hand;
+    // locomotion itself is covered by test_movement/test_group_move.
+    ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World world(map);
+    AbilityProfile dp;
+    dp.fire_kind = AbilityKind::Parasite;
+    dp.parasiteable = false;
+    dp.suppression_threshold = 5;
+    world.register_ability_profile("DRON", dp);
+    const std::vector<int> para = {100, 100, 100, 100, 100, 100, 0, 0, 0, 0, 0};
+    world.add_combat_unit(10, 10, 1, mk("DRON", 100, "special_1", 50, 60, 1.83, para));
+    world.add_combat_unit(11, 10, 0, mk("HTNK", 400, "heavy", 0, 60, 0.0, {}, true));
+    world.add_combat_unit(13, 10, 0, mk("HTNK", 400, "heavy", 0, 60, 0.0, {}, true));
+    world.units()[0].target = 1;
+    world.units()[0].attack_order = true;
+    int infects = 0, exits = 0, ticks = 0;
+    for (int k = 0; k < 800 && exits < 1; ++k) {
+        world.step(1.0 / 15.0);
+        for (const Ev& e : world.take_ability_events()) {
+            if (e.kind == Ev::Kind::Infect) ++infects;
+            if (e.kind == Ev::Kind::DroneExit) ++exits;
+            if (e.kind == Ev::Kind::ParasiteTick) ++ticks;
+        }
+    }
+    {
+        std::string s;
+        for (int k = 0; k < 0; ++k) (void)k;
+        s += "evdump:";
+        // re-run dump skipped; inspect via second loop below
+        MESSAGE(s);
+    }
+    REQUIRE(infects == 1);
+    REQUIRE(exits == 1);                       // host died, drone popped out
+    REQUIRE(ticks >= 1);
+    REQUIRE(world.units()[0].alive);            // drone survived
+    REQUIRE(world.units()[0].cargo_of == -1);
+    for (int k = 0; k < 200 && world.units()[1].alive; ++k) world.step(1.0 / 15.0);
+    REQUIRE(!world.units()[1].alive);           // host tombstoned
+    // Stage the drone beside tank B (locomotion itself is covered by
+    // test_movement/test_group_move; this probes re-infection after eject).
+    world.units()[0].cell_x = 12; world.units()[0].cell_y = 10;
+    world.units()[0].fx = 12.0; world.units()[0].fy = 10.0;
+    world.units()[0].target = 2;                // fresh order on tank B
+    world.units()[0].attack_order = true;
+    // Note: the eject freezes the drone for 3xROF frames (paralysed), so
+    // allow the freeze to wear off plus travel plus a fresh ROF cycle.
+    for (int k = 0; k < 600 && infects < 2; ++k) {
+        world.step(1.0 / 15.0);
+        for (const Ev& e : world.take_ability_events()) {
+            if (e.kind == Ev::Kind::Infect) ++infects;
+            if (e.kind == Ev::Kind::DroneExit) ++exits;
+            if (e.kind == Ev::Kind::ParasiteTick) ++ticks;
+        }
+    }
+    CHECK(infects == 2);                        // second host infected
+    CHECK(ticks >= 1);
+    CHECK(world.units()[2].parasite_on_me == 0);
+}
