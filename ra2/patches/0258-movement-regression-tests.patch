 }
+
+TEST_CASE("slope_tilt: ramp grid feeds the pitch (data path)") {
+    // Real-map probe (Hills.mmx, Valley.mmx): TMP header byte 42 carries
+    // SlopeIndex 1..18 on ramp cells, 0 on flat. The armed grid must deliver
+    // those values to the pitch function (the draw path reads ramp_at()).
+    ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    ra2engine::World w(map);
+    const int W = w.grid_w(), H = w.grid_h();
+    const int n = W * H;
+    REQUIRE(n > 0);
+    std::vector<std::uint8_t> land(n, 0), ramp(n, 0);
+    auto at = [&](int x, int y) -> std::uint8_t& { return ramp[static_cast<std::size_t>(y) * W + x]; };
+    at(11, 11) = 7;    // single-height corner, like a real N/S ramp
+    at(21, 21) = 4;    // steep cardinal, like a real E/W ramp
+    ra2engine::World::LandSpeedRules r;
+    w.arm_land_speed(land, ramp, r);
+    CHECK(w.ramp_at(11, 11) == 7);
+    CHECK(w.ramp_at(21, 21) == 4);
+    CHECK(w.ramp_at(0, 0) == 0);
+    CHECK(w.ramp_at(-1, 0) == 0);
+    CHECK(ra2engine::slope_tilt_pitch(w.ramp_at(11, 11), 0x2000) != doctest::Approx(0.0));
+    CHECK(ra2engine::slope_tilt_pitch(w.ramp_at(21, 21), 0x4000) != doctest::Approx(0.0));
+    CHECK(ra2engine::slope_tilt_pitch(w.ramp_at(0, 0), 0x4000) == doctest::Approx(0.0));
+}
