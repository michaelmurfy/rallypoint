diff --git a/engine/sidebar.hpp b/engine/sidebar.hpp
--- a/engine/sidebar.hpp
+++ b/engine/sidebar.hpp
@@ -125,4 +125,12 @@
     bool contains(int px, int py) const { return bar.contains(px, py); }
 };

+// G-08 cursor rule: B's action cursor wins on the tactical view and on the
+// radar minimap (patch 0117: Move with a selection); the probe's answer
+// stands on the rest of the sidebar, where the action is None anyway (None
+// resolves to Default, the probe's answer there). Pure so the gates pin it.
+inline bool action_cursor_wins(bool over_sidebar, bool over_radar, int mx, int view_w) {
+    return (!over_sidebar && mx < view_w) || over_radar;
+}
+
 }  // namespace ra2engine
diff --git a/tests/test_sidebar.cpp b/tests/test_sidebar.cpp
--- a/tests/test_sidebar.cpp
+++ b/tests/test_sidebar.cpp
@@ -183,3 +183,20 @@
     CHECK(lay.bar.h == 1080);
     CHECK(lay.side2_rows == (1080 - 234 - 26) / 50);
 }
+
+TEST_CASE("sidebar cursor: B's action wins on the view and the radar, the probe elsewhere") {
+    auto lay = SidebarLayout::compute(1280, 720, {1, 2, 3});
+    const int view_w = 1280 - 168;   // the playfield ends where the bar starts
+    const int rx = lay.radar.x + 10, ry = lay.radar.y + 10;
+    REQUIRE(lay.contains(rx, ry));         // the radar lives in the sidebar
+    REQUIRE(lay.radar.contains(rx, ry));
+    // The tactical view follows B's action (a click orders there).
+    CHECK(action_cursor_wins(false, false, view_w - 1, view_w));
+    // The radar minimap too (patch 0117: Move with a selection orders there).
+    CHECK(action_cursor_wins(true, true, rx, view_w));
+    // The rest of the sidebar keeps the probe's answer (no orders from it).
+    CHECK_FALSE(action_cursor_wins(true, false, lay.bar.x + 10, view_w));
+    CHECK_FALSE(action_cursor_wins(true, false, lay.tabs[0].x + 1, view_w));
+    // Off the view the probe stands (a stale coordinate never takes the action).
+    CHECK_FALSE(action_cursor_wins(false, false, view_w + 600, view_w));
+}
