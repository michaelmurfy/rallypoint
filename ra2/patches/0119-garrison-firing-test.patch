+TEST_CASE("w7units: a garrison fires at an enemy that enters range") {
+    ra2assets::MapFile map;
+    World world(map);
+
+    BuildingTypeDef civ = bdef("CABHUT");
+    civ.can_be_occupied = true;
+    civ.can_occupy_fire = true;
+    civ.max_occupants = 1;
+    world.set_building_types({civ});
+    const int b = world.add_building(0, 20, 20, 2, 2, 2, 400,
+                                    armor_index("wood"), 0.0, true);
+
+    UnitCombat gi = mk("E1", 125, "none", 15, 20, 4.0, kAll100);
+    gi.occupier = true;
+    gi.occupy_weapon.valid = true;
+    gi.occupy_weapon.id = "GarrisonTestWeapon";
+    gi.occupy_weapon.rof = 20;
+    gi.occupy_weapon.damage = 15;
+    gi.occupy_weapon.range = 4.0;
+    gi.occupy_weapon.verses = kAll100;
+    world.add_combat_unit(19, 20, 0, gi);
+
+    UnitCombat enemy = mk("E2", 125, "none", 15, 20, 4.0, kAll100);
+    world.add_combat_unit(30, 20, 1, enemy);
+
+    World::DepthRules rules;
+    rules.occupy_weapon_range = 3;
+    world.set_depth_rules(rules);
+
+    REQUIRE(world.campaign_occupy_now(0, b));
+    REQUIRE(world.units()[0].garrison_of == b);
+    CHECK(world.buildings()[b].house == 0);   // sync_garrison_owner
+
+    world.step(1.0 / 15.0);
+    CHECK(world.garrison_shots() == 0);       // enemy is outside garrison range
+
+    // The enemy walks into range. Garrison range is half the 2x2 foundation
+    // plus OccupyWeaponRange: 1 + 3 cells.
+    world.units()[1].cell_x = 23;
+    world.units()[1].fx = 23.0;
+    world.units()[1].fy = 20.0;
+    for (int i = 0; i < 5 && world.garrison_shots() == 0; ++i)
+        world.step(1.0 / 15.0);
+    CHECK(world.garrison_shots() > 0);
+}
