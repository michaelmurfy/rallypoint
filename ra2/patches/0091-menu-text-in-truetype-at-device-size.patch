+// Menu text through the TrueType face (ttfont.hpp) instead of the 16 px bitmap
+// font. `cell` is the height in device pixels the bitmap glyph cell would have
+// (16 * the UI scale at 12 px control text), so every caller keeps its sizes;
+// the layout (box, alignment) stays the caller's, only the glyphs change. The
+// bitmap path remains for when the face did not load.
+inline bool tt_ok() { return ra2engine::ttfont::available(); }
+inline double tt_text_w(const std::string& s, double cell) {
+    return ra2engine::ttfont::measure(s, cell * ra2engine::ttfont::kEmPerCell);
+}
+// Draw `s` with its pen at x, capitals centred vertically in [box_y, box_y+box_h).
+// Colour: the palette's brightest entry, a little lighter on top, darker below.
+void tt_draw(SDL_Renderer* ren, ra2engine::TextureCache& tc, const ra2assets::Palette& pal,
+             const std::string& s, double x, double box_y, double box_h, double cell,
+             const char* keypfx) {
+    namespace tf = ra2engine::ttfont;
+    const double em = cell * ra2engine::ttfont::kEmPerCell;
+    const ra2assets::Rgba c = pal[15];
+    auto pack = [](int r, int g, int b) {
+        return (static_cast<std::uint32_t>(std::clamp(r, 0, 255)) << 16) |
+               (static_cast<std::uint32_t>(std::clamp(g, 0, 255)) << 8) |
+               static_cast<std::uint32_t>(std::clamp(b, 0, 255));
+    };
+    const std::uint32_t top = pack(c.r * 11 / 10 + 12, c.g * 11 / 10 + 12, c.b * 11 / 10 + 8);
+    const std::uint32_t bot = pack(c.r * 78 / 100, c.g * 78 / 100, c.b * 78 / 100);
+    const std::string key = std::string("tt:") + keypfx + std::to_string(std::lround(em * 8)) + ":" +
+                            std::to_string(top) + ":" + std::to_string(bot) + ":" + s;
+    SDL_Texture* tex = static_cast<SDL_Texture*>(tc.peek(key));
+    if (!tex) {
+        const tf::Run run = tf::render(s, em, top, bot);
+        if (run.w <= 0) return;
+        tex = static_cast<SDL_Texture*>(tc.get_rgba(key, run.rgba.data(), run.w, run.h));
+    }
+    if (!tex) return;
+    int w = 0, h = 0;
+    SDL_QueryTexture(tex, nullptr, nullptr, &w, &h);
+    const double base = box_y + box_h / 2.0 + tf::cap_height(em) / 2.0;
+    SDL_Rect dst{static_cast<int>(std::lround(x)) - tf::kPad, static_cast<int>(std::lround(base)) - tf::baseline_row(em), w, h};
+    SDL_RenderCopy(ren, tex, nullptr, &dst);
+}
