@@ -0,0 +1,35 @@
+#pragma once
+// Menu text at the real pixel size: Liberation Sans Bold (SIL OFL, embedded,
+// see third_party/fonts) rasterised with stb_truetype. The game's own bitmap
+// fonts are 16 px tall, made for 640x480; blown up they smear. Pure C++ (no
+// SDL), so the layout maths is host-testable. `em` is the font size in device
+// pixels. Strings are UTF-8 (bytes that are not valid UTF-8 are read as Latin-1).
+#include <cstdint>
+#include <string>
+#include <vector>
+namespace ra2engine::ttfont {
+
+// Size of the text for a bitmap-font cell of the same height: the original's 16 px
+// cell has 10 px capitals and narrow letters, so the face is 0.86 em per cell px,
+// drawn 16% narrower than its design (x scale only).
+inline constexpr double kEmPerCell = 0.86;
+
+bool available();                              // the embedded font parsed
+double measure(const std::string& s, double em);   // pen advance in px
+double cap_height(double em);                  // height of a capital above the baseline
+double line_height(double em);                 // ascent + descent
+
+inline constexpr int kPad = 2;                  // blank pixels round a run (Run::pen_x)
+int baseline_row(double em);                    // Run::baseline for this size, without rendering
+
+struct Run {
+    int w = 0, h = 0;          // bitmap size, RGBA8 (R,G,B,A memory order)
+    int pen_x = 0;             // bitmap column of the pen start
+    int baseline = 0;          // bitmap row of the baseline
+    std::vector<uint8_t> rgba;
+};
+// Rasterise `s`: letter colour fades from `top` to `bottom` (0xRRGGBB) down the
+// capital height, and a dark shadow of about em/14 px sits behind it.
+Run render(const std::string& s, double em, std::uint32_t top, std::uint32_t bottom);
+
+}  // namespace ra2engine::ttfont
--- a/engine/ttfont.cpp
+++ b/engine/ttfont.cpp
@@ -0,0 +1,163 @@
+#include "ttfont.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "stb_truetype.h"
+
+namespace ra2engine::ttfont {
+namespace {
+
+const unsigned char kFontData[] = {
+#include "ttfont_data.inc"
+};
+
+struct Face {
+    stbtt_fontinfo info;
+    bool ok = false;
+    Face() { ok = stbtt_InitFont(&info, kFontData, stbtt_GetFontOffsetForIndex(kFontData, 0)) != 0; }
+};
+Face& face() {
+    static Face f;
+    return f;
+}
+
+// UTF-8 to code points; input that is not valid UTF-8 is taken as Latin-1.
+std::vector<int> decode(const std::string& s) {
+    std::vector<int> out;
+    for (std::size_t i = 0; i < s.size();) {
+        const unsigned char c = static_cast<unsigned char>(s[i]);
+        int n = c < 0x80 ? 0 : (c >> 5) == 6 ? 1 : (c >> 4) == 14 ? 2 : (c >> 3) == 30 ? 3 : -1;
+        bool ok = n >= 0;
+        int cp = n == 0 ? c : (c & (0x3F >> n));
+        for (int k = 1; ok && k <= n; ++k) {
+            if (i + k >= s.size() || (static_cast<unsigned char>(s[i + k]) & 0xC0) != 0x80) { ok = false; break; }
+            cp = (cp << 6) | (static_cast<unsigned char>(s[i + k]) & 0x3F);
+        }
+        if (ok) { out.push_back(cp); i += n + 1; }
+        else    { out.push_back(c);  i += 1; }
+    }
+    return out;
+}
+
+constexpr double kCondense = 0.84;   // horizontal scale (the design is wider than the original's)
+
+double scale_for(double em) { return stbtt_ScaleForMappingEmToPixels(&face().info, static_cast<float>(em)); }
+
+double advance_of(int cp, int next, double sc) {
+    const stbtt_fontinfo* fi = &face().info;
+    int adv = 0, lsb = 0;
+    stbtt_GetCodepointHMetrics(fi, cp, &adv, &lsb);
+    double a = adv;
+    if (next) a += stbtt_GetCodepointKernAdvance(fi, cp, next);
+    return a * sc * kCondense;
+}
+
+}  // namespace
+
+// RA2_NO_TTF=1 forces the bitmap fonts (to compare, or if the face misbehaves).
+bool available() {
+    static const bool off = std::getenv("RA2_NO_TTF") != nullptr;
+    return face().ok && !off;
+}
+
+double measure(const std::string& s, double em) {
+    if (!available() || em <= 0.0) return 0.0;
+    const double sc = scale_for(em);
+    const std::vector<int> cps = decode(s);
+    double w = 0.0;
+    for (std::size_t i = 0; i < cps.size(); ++i)
+        w += advance_of(cps[i], i + 1 < cps.size() ? cps[i + 1] : 0, sc);
+    return w;
+}
+
+double cap_height(double em) {
+    if (!available() || em <= 0.0) return 0.0;
+    int x0, y0, x1, y1;
+    if (!stbtt_GetCodepointBox(&face().info, 'H', &x0, &y0, &x1, &y1)) return em * 0.72;
+    return y1 * scale_for(em);
+}
+
+double line_height(double em) {
+    if (!available() || em <= 0.0) return 0.0;
+    int asc, desc, gap;
+    stbtt_GetFontVMetrics(&face().info, &asc, &desc, &gap);
+    return (asc - desc) * scale_for(em);
+}
+
+int baseline_row(double em) {
+    if (!available() || em <= 0.0) return 0;
+    int asc = 0, desc = 0, gap = 0;
+    stbtt_GetFontVMetrics(&face().info, &asc, &desc, &gap);
+    return kPad + static_cast<int>(std::ceil(asc * scale_for(em)));
+}
+
+Run render(const std::string& s, double em, std::uint32_t top, std::uint32_t bottom) {
+    Run run;
+    if (!available() || em <= 0.0 || s.empty()) return run;
+    const stbtt_fontinfo* fi = &face().info;
+    const double sc = scale_for(em);
+    int asc = 0, desc = 0, gap = 0;
+    stbtt_GetFontVMetrics(fi, &asc, &desc, &gap);
+    const int sh = std::max(1, static_cast<int>(std::lround(em / 14.0)));   // shadow offset
+    const int pad = kPad;
+    const int up = static_cast<int>(std::ceil(asc * sc)), down = static_cast<int>(std::ceil(-desc * sc));
+    const int w = static_cast<int>(std::ceil(measure(s, em))) + 2 * pad + sh;
+    const int h = up + down + 2 * pad + sh;
+    run.w = w; run.h = h; run.pen_x = pad; run.baseline = pad + up;
+    std::vector<uint8_t> cov(static_cast<std::size_t>(w) * h, 0);
+    const std::vector<int> cps = decode(s);
+    double pen = 0.0;
+    for (std::size_t i = 0; i < cps.size(); ++i) {
+        const int cp = cps[i];
+        const double x = pen + pad;
+        const int xi = static_cast<int>(std::floor(x));
+        const float fx = static_cast<float>(x - xi);
+        int x0, y0, x1, y1;
+        stbtt_GetCodepointBitmapBoxSubpixel(fi, cp, static_cast<float>(sc * kCondense), static_cast<float>(sc), fx, 0, &x0, &y0, &x1, &y1);
+        const int gw = x1 - x0, gh = y1 - y0;
+        if (gw > 0 && gh > 0) {
+            std::vector<uint8_t> g(static_cast<std::size_t>(gw) * gh);
+            stbtt_MakeCodepointBitmapSubpixel(fi, g.data(), gw, gh, gw, static_cast<float>(sc * kCondense), static_cast<float>(sc), fx, 0, cp);
+            for (int yy = 0; yy < gh; ++yy)
+                for (int xx = 0; xx < gw; ++xx) {
+                    const int dx = xi + x0 + xx, dy = run.baseline + y0 + yy;
+                    if (dx < 0 || dx >= w || dy < 0 || dy >= h) continue;
+                    uint8_t& c = cov[static_cast<std::size_t>(dy) * w + dx];
+                    c = static_cast<uint8_t>(std::min(255, c + g[static_cast<std::size_t>(yy) * gw + xx]));
+                }
+        }
+        pen += advance_of(cp, i + 1 < cps.size() ? cps[i + 1] : 0, sc);
+    }
+    const double cap = std::max(1.0, cap_height(em));
+    run.rgba.assign(static_cast<std::size_t>(w) * h * 4, 0);
+    for (int y = 0; y < h; ++y) {
+        // 0 at the top of the capitals, 1 at the baseline, clamped.
+        const double t = std::clamp((y - (run.baseline - cap)) / cap, 0.0, 1.0);
+        auto mix = [&](int shift) {
+            const double a = (top >> shift) & 255, b = (bottom >> shift) & 255;
+            return static_cast<int>(std::lround(a + (b - a) * t));
+        };
+        const int r = mix(16), gc = mix(8), b = mix(0);
+        for (int x = 0; x < w; ++x) {
+            const int fg = cov[static_cast<std::size_t>(y) * w + x];
+            const int bgx = x - sh, bgy = y - sh;
+            const int shadow = (bgx >= 0 && bgy >= 0) ? cov[static_cast<std::size_t>(bgy) * w + bgx] * 200 / 255 : 0;
+            // Letter over shadow, premultiplied then straightened for SDL's blend.
+            const double fa = fg / 255.0, sa = shadow / 255.0;
+            const double oa = fa + sa * (1.0 - fa);
+            uint8_t* p = &run.rgba[(static_cast<std::size_t>(y) * w + x) * 4];
+            if (oa <= 0.0) continue;
+            p[0] = static_cast<uint8_t>(std::lround(r * fa / oa));
+            p[1] = static_cast<uint8_t>(std::lround(gc * fa / oa));
+            p[2] = static_cast<uint8_t>(std::lround(b * fa / oa));
+            p[3] = static_cast<uint8_t>(std::lround(oa * 255.0));
+        }
+    }
+    return run;
+}
+
+}  // namespace ra2engine::ttfont
