+#include "doctest.h"
+#include "asset_fixture.hpp"
+#include "ra2assets/fnt.hpp"
+#include "ra2assets/mix.hpp"
+#include "ttfont.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+using namespace ra2engine;
+
+TEST_CASE("ttfont: the embedded face loads and measures") {
+    REQUIRE(ttfont::available());
+    CHECK(ttfont::measure("", 20) == 0.0);
+    // Linear in the size, wider letters measure wider.
+    const double a = ttfont::measure("Game Options", 20), b = ttfont::measure("Game Options", 40);
+    CHECK(a > 0.0);
+    CHECK(b == doctest::Approx(2.0 * a).epsilon(0.01));
+    CHECK(ttfont::measure("iii", 20) < ttfont::measure("WWW", 20));
+    CHECK(ttfont::measure("ab", 20) > ttfont::measure("a", 20));
+    // UTF-8 and Latin-1 spell the same text.
+    CHECK(ttfont::measure("caf\xC3\xA9", 20) == doctest::Approx(ttfont::measure("caf\xE9", 20)));
+    CHECK(ttfont::cap_height(40) == doctest::Approx(2.0 * ttfont::cap_height(20)).epsilon(0.05));
+    CHECK(ttfont::cap_height(20) > 10.0);
+    CHECK(ttfont::cap_height(20) < 18.0);
+}
+
+TEST_CASE("ttfont: a rendered run has the promised layout and colours") {
+    const double em = 30.0;
+    const ttfont::Run r = ttfont::render("Sound", em, 0xFFFF00, 0x808000);
+    REQUIRE(r.w > 0);
+    CHECK(r.rgba.size() == static_cast<size_t>(r.w) * r.h * 4);
+    CHECK(r.pen_x == ttfont::kPad);
+    CHECK(r.baseline == ttfont::baseline_row(em));
+    CHECK(r.w >= static_cast<int>(std::ceil(ttfont::measure("Sound", em))) + 2 * ttfont::kPad);
+    int ink = 0, opaque_yellowish = 0, shadow = 0, above_top = 0;
+    for (int y = 0; y < r.h; ++y)
+        for (int x = 0; x < r.w; ++x) {
+            const uint8_t* p = &r.rgba[(static_cast<size_t>(y) * r.w + x) * 4];
+            if (p[3] == 0) continue;
+            ++ink;
+            if (p[3] > 200 && p[0] > 120 && p[1] > 120 && p[2] < 40) ++opaque_yellowish;
+            if (p[3] > 100 && p[0] < 10 && p[1] < 10 && p[2] < 10) ++shadow;
+            if (y < r.baseline - static_cast<int>(std::ceil(ttfont::cap_height(em))) - 2) ++above_top;   // 'S' has overshoot only
+        }
+    CHECK(ink > 100);
+    CHECK(opaque_yellowish > 50);   // the letters keep the control colour
+    CHECK(shadow > 20);             // and carry a dark shadow
+    CHECK(above_top == 0);          // nothing floats above the capitals
+    CHECK(ttfont::render("", em, 0, 0).w == 0);
+}
+
+// The bitmap shell font is the size reference: at the same cell height the
+// TrueType text must be about as wide and as tall as the original's, so every
+// layout built for it still fits. Uses the player's own 12metfnt.fnt.
+TEST_CASE("ttfont: matches the size of the original 12metfnt text (real assets)") {
+    if (!ra2fixture::ra2_available()) { MESSAGE("ra2.mix absent; skipped"); return; }
+    const ra2assets::MixFile& top = ra2fixture::mix_by_name("ra2.mix");
+    ra2assets::MixFile cache = top.open_nested("cache.mix");
+    const ra2assets::MixEntry* e = cache.find("12metfnt.fnt");
+    REQUIRE(e != nullptr);
+    const ra2assets::Font f = ra2assets::load_fnt(cache.read(*e));
+    const double cell = f.height();   // 16
+    const double kEmPerCell = ttfont::kEmPerCell;
+    for (const char* s : {"Game Speed", "Scroll Rate", "Target Lines", "See Hidden Objects", "Keyboard", "Music Volume"}) {
+        int bw = 0;
+        for (unsigned char ch : std::string(s)) bw += f.width(ch) > 0 ? f.width(ch) : f.height() / 2;
+        const double tw = ttfont::measure(s, cell * kEmPerCell);
+        std::printf("[ttfont] \"%s\" bitmap %d px, TrueType %.1f px (%.2f)\n", s, bw, tw, tw / bw);
+        CHECK(tw / bw > 0.92);
+        CHECK(tw / bw < 1.12);
+    }
+    // Capital height: the bitmap 'H' rows with any ink vs the TrueType cap height.
+    const ra2assets::FntGlyph& H = f.glyph('H');
+    int rows = 0;
+    for (int y = 0; y < H.h; ++y) {
+        bool any = false;
+        for (int x = 0; x < H.w; ++x) any |= H.pixels[static_cast<size_t>(y) * H.w + x] != 0;
+        rows += any;
+    }
+    const double cap = ttfont::cap_height(cell * kEmPerCell);
+    std::printf("[ttfont] capital H: bitmap %d rows, TrueType %.1f px\n", rows, cap);
+    CHECK(cap / rows > 0.92);
+    CHECK(cap / rows < 1.1);
+}
