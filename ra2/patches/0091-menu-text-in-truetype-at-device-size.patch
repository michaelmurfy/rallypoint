+// text_shot.inc -- `--text-shot <prefix>`: renders the shell text pages (main
+// menu, Options, and the in-game Game Options / Controls / Sound / Keyboard
+// pages) at each size in RA2_SHOT_SIZES (default 1280x720, e.g.
+// "1920x1080,3440x1440") to <prefix>_<WxH>_<page>.png, with the real assets
+// from RA2_INSTALL_DIR. Used to look at menu text; changes nothing in a game.
+int run_text_shot(const std::string& prefix) {
+    const std::string dir = env_install_dir();
+    Ini rules_ini = load_ini_from_ra2md(dir, "rulesmd.ini");
+    Rules rules = Rules::load(rules_ini);
+    MenuArtStore store;
+    load_menu_art(dir, /*no_audio=*/true, store);
+    g_menu_art = &store.art;
+    std::vector<std::pair<int, int>> sizes;
+    {
+        std::string s = std::getenv("RA2_SHOT_SIZES") ? std::getenv("RA2_SHOT_SIZES") : "1280x720";
+        std::stringstream ss(s);
+        std::string tok;
+        while (std::getline(ss, tok, ',')) {
+            int w = 0, h = 0;
+            if (std::sscanf(tok.c_str(), "%dx%d", &w, &h) == 2 && w > 0 && h > 0) sizes.push_back({w, h});
+        }
+    }
+    for (const auto& wh : sizes) {
+        const int W = wh.first, H = wh.second;
+        g_ui_w = W;
+        g_ui_h = H;
+        ra2engine::Platform plat = ra2engine::Platform::create("text-shot", W, H, /*hidden=*/true);
+        ra2engine::TextureCache tc(plat.renderer());
+        SDL_Renderer* ren = static_cast<SDL_Renderer*>(plat.renderer());
+        const std::string stem = prefix + "_" + std::to_string(W) + "x" + std::to_string(H) + "_";
+        auto frame = [&](const std::string& name, const std::function<void()>& draw) {
+            for (int i = 0; i < 2; ++i) {
+                plat.begin_frame();
+                draw();
+                plat.present();
+            }
+            capture_png(ren, stem + name + ".png", W, H);
+            std::cerr << "[text-shot] wrote " << stem + name + ".png\n";
+        };
+        ShellScene main_page(rules, true, store.art, PAGE_MAIN);
+        frame("main", [&] { main_page.render(plat, tc); });
+        ShellScene opt_page(rules, true, store.art, PAGE_OPTIONS);
+        frame("options", [&] { opt_page.render(plat, tc); });
+        InGameMenu m;
+        m.configure(false, false);
+        m.open(InGameMenu::P_OPTIONS);
+        frame("gameoptions", [&] { m.render(ren, tc); });
+        m.open(InGameMenu::P_CONTROLS);
+        frame("controls", [&] { m.render(ren, tc); });
+        m.open(InGameMenu::P_SOUND);
+        frame("sound", [&] { m.render(ren, tc); });
+        m.open(InGameMenu::P_CONTROLS);
+        m.keyboard().open();
+        frame("keyboard", [&] { m.render(ren, tc); });
+    }
+    g_menu_art = nullptr;
+    return 0;
+}
