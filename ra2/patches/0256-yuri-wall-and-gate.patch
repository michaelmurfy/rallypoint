+TEST_CASE("ai catalog: ConcreteWalls pick is side-correct incl. Yuri GAFWLL [0256]") {
+    // Retail [AI] list order with per-side AIBasePlanningSide (ok_index stubbed:
+    // the routing, not the roster, is under test here).
+    ra2assets::Ini ini = ra2assets::Ini::parse(
+        "[AI]\nConcreteWalls=GAWALL,NAWALL,GAFWLL\n"
+        "[GAWALL]\nAIBasePlanningSide=0\nOwner=Americans,Russians,YuriCountry\n"
+        "[NAWALL]\nAIBasePlanningSide=1\nOwner=Americans,Russians,YuriCountry\n"
+        "[GAFWLL]\nAIBasePlanningSide=2\nOwner=Americans,Russians,YuriCountry\n");
+    ra2assets::Rules rules = ra2assets::Rules::load(ini);
+    auto ok_index = [](const char* id) -> int {
+        const std::string s = id;
+        if (s == "GAWALL") return 10;
+        if (s == "NAWALL") return 11;
+        if (s == "GAFWLL") return 12;
+        return -1;
+    };
+    using Side = ra2engine::World::Side;
+    CHECK(aiside::pick_from_list(rules, "AI", "ConcreteWalls", Side::Allied, "Americans", ok_index) == 10);
+    CHECK(aiside::pick_from_list(rules, "AI", "ConcreteWalls", Side::Soviet, "Russians", ok_index) == 11);
+    CHECK(aiside::pick_from_list(rules, "AI", "ConcreteWalls", Side::Yuri, "YuriCountry", ok_index) == 12);
+}
