+TEST_CASE("factory: ExitCoord= leans the door anchor (retail GAWEAP check)") {
+    // Real GAWEAP: 5x3 foundation, ExitCoord=(512,256,0). Center leptons
+    // (cx*256+640, cy*256+384) + lean = cell-center (cx+4, cy+2), the SE
+    // corner foundation cell, so the walk exits just off the SE corner.
+    Building b = fac(0, 10, 20, 5, 3);
+    BuildingTypeDef d = def("GAWEAP", 5, 3);
+    d.exit_x = 512; d.exit_y = 256;
+    auto in_foundation = [](int x, int y) { return x >= 10 && x < 15 && y >= 20 && y < 23; };
+    Cellxy e = exit_cell(b, d, [&](int x, int y) { return !in_foundation(x, y); });
+    CHECK(e.x == 14);
+    CHECK(e.y == 23);
+    CHECK_FALSE(in_foundation(e.x, e.y));
+    // GAPILE's quarter-cell lean (-64,+64) is cell-neutral: same door as zero lean.
+    BuildingTypeDef g = def("GAPILE", 3, 2);
+    g.exit_x = -64; g.exit_y = 64;
+    Building bg = fac(1, 10, 20, 3, 2);
+    auto in_gap = [](int x, int y) { return x >= 10 && x < 13 && y >= 20 && y < 22; };
+    Cellxy e2 = exit_cell(bg, g, [&](int x, int y) { return !in_gap(x, y); });
+    BuildingTypeDef z = def("GAPILE", 3, 2);   // zero lean
+    Cellxy e3 = exit_cell(bg, z, [&](int x, int y) { return !in_gap(x, y); });
+    CHECK(e2.x == e3.x);
+    CHECK(e2.y == e3.y);
+    CHECK(e2.x == 11); CHECK(e2.y == 22);       // south door, unchanged
+    // Boxed-in still HOLDs, lean or not.
+    Cellxy e4 = exit_cell(b, d, [](int, int) { return false; });
+    CHECK(e4.x == -1); CHECK(e4.y == -1);
+}
