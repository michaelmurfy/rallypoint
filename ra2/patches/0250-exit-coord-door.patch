 namespace ra2engine {
 
+namespace {
+// Floor division for the ExitCoord anchor (anchor leptons can in theory go
+// negative; C++ truncation would round the wrong way there).
+int floor_div_256(int n) {
+    int q = n / 256, r = n % 256;
+    if (r != 0 && n < 0) --q;
+    return q;
+}
+// Strict whole-string integer (no trailing junk), like Art::docking_offset.
+bool strict_int(const std::string& f, int& v) {
+    if (f.empty()) return false;
+    char* end = nullptr;
+    const long r = std::strtol(f.c_str(), &end, 10);
+    if (end == f.c_str() || *end != '\0') return false;
+    v = static_cast<int>(r);
+    return true;
+}
+}  // namespace
+
+bool parse_exit_coord(const std::string& s, int& x, int& y) {
+    x = 0; y = 0;
+    std::string v = s;
+    const std::string::size_type semi = v.find(';');
+    if (semi != std::string::npos) v = v.substr(0, semi);
+    int vals[3]; int count = 0;
+    std::string::size_type pos = 0;
+    while (true) {
+        const std::string::size_type comma = v.find(',', pos);
+        std::string field = (comma == std::string::npos) ? v.substr(pos) : v.substr(pos, comma - pos);
+        const std::string::size_type b = field.find_first_not_of(" \t");
+        const std::string::size_type e = field.find_last_not_of(" \t");
+        field = (b == std::string::npos) ? std::string() : field.substr(b, e - b + 1);
+        if (count >= 3 || !strict_int(field, vals[count])) return false;
+        ++count;
+        if (comma == std::string::npos) break;
+        pos = comma + 1;
+    }
+    if (count < 2) return false;
+    x = vals[0]; y = vals[1];
+    return true;
+}
