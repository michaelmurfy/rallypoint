+TEST_CASE("factory: parse_exit_coord reads retail x,y,z leptons, strict") {
+    int x = -1, y = -1;
+    CHECK(parse_exit_coord("512,256,0", x, y));
+    CHECK(x == 512); CHECK(y == 256);
+    CHECK(parse_exit_coord("512,256,0 ;must be center of cell", x, y));   // retail YAWEAP comment
+    CHECK(x == 512); CHECK(y == 256);
+    CHECK(parse_exit_coord("-64,64,0", x, y));   // retail GAPILE/YABRCK lean
+    CHECK(x == -64); CHECK(y == 64);
+    CHECK(parse_exit_coord("1,2", x, y));         // z optional
+    CHECK(x == 1); CHECK(y == 2);
+    CHECK_FALSE(parse_exit_coord("", x, y));
+    CHECK(x == 0); CHECK(y == 0);
+    CHECK_FALSE(parse_exit_coord("abc,1,0", x, y));
+    CHECK_FALSE(parse_exit_coord("1", x, y));
+    CHECK_FALSE(parse_exit_coord("1,2,3,4", x, y));
+    CHECK_FALSE(parse_exit_coord("1.5,2,0", x, y));
