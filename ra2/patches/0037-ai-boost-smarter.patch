diff --git a/engine/ai_boost.hpp b/engine/ai_boost.hpp
new file mode 100644
index 0000000..11eb50e
--- /dev/null
+++ b/engine/ai_boost.hpp
@@ -0,0 +1,99 @@
+#pragma once
+// [RP-AI-BOOST] Rallypoint optional smarter skirmish AI layer.
+// Off by default. Levels 1..3 scale the stock three-layer brain's timers and
+// knobs (TeamDelays / DifficultyClass BuildDelay / CreditReserve / IQ Harvester
+// / ComputerBaseDefenseResponse) without replacing aimd or AITriggers.
+// Multipliers mirror Generals GEN_AI_BOOST speed steps where comparable; the
+// credit / defense / composition extras are Rallypoint-only expansions.
+#include <cstdlib>
+#include <algorithm>
+
+namespace ra2engine {
+
+inline int clamp_ai_boost(int level) {
+    if (level < 0) return 0;
+    if (level > 3) return 3;
+    return level;
+}
+
+// Launch key AIBoost= wins when present (>= 0); else RA2_AI_BOOST; else 0.
+inline int resolve_ai_boost(int launch_value /* -1 = absent */) {
+    if (launch_value >= 0) return clamp_ai_boost(launch_value);
+    const char* e = std::getenv("RA2_AI_BOOST");
+    if (!e || !*e) return 0;
+    return clamp_ai_boost(std::atoi(e));
+}
+
+// Level 1+: divide TeamDelays / BuildDelay (gamemd DifficultyClass BuildDelay=
+// minutes; TeamDelays= CSV frames). Same step curve as Generals AI::boostSpeed.
+inline double ai_boost_delay_div(int level) {
+    static const double k[4] = {1.0, 1.35, 1.7, 2.0};
+    return k[clamp_ai_boost(level)];
+}
+
+// Level 1+: lower CreditReserve floor -> higher production pressure (AI only).
+// [RP-AI-BOOST] Expansion: stock CreditReserve=100 is a hard floor, not a
+// DifficultyClass field; we scale it rather than inventing a second brain.
+inline double ai_boost_credit_reserve_mul(int level) {
+    static const double k[4] = {1.0, 0.75, 0.55, 0.40};
+    return k[clamp_ai_boost(level)];
+}
+
+// Level 2+: extra miners beyond HarvestersPerRefinery (gamemd General CSV).
+inline int ai_boost_extra_harvesters(int level) {
+    static const int k[4] = {0, 0, 1, 1};
+    return k[clamp_ai_boost(level)];
+}
+
+// Level 2+: multiply ComputerBaseDefenseResponse (Rules+0xB18) for call_for_help.
+inline double ai_boost_defense_response_mul(int level) {
+    static const double k[4] = {1.0, 1.0, 1.5, 2.0};
+    return k[clamp_ai_boost(level)];
+}
+
+// Level 2+: shorten BaseDefenseDelay cooldown after a help call (frames).
+inline double ai_boost_defense_delay_mul(int level) {
+    static const double k[4] = {1.0, 1.0, 0.75, 0.5};
+    return k[clamp_ai_boost(level)];
+}
+
+// Level 3: additive nudge on AITrigger RegisterSuccess (stock delta is +20).
+// [RP-AI-BOOST] Expansion: keeps the adaptive track-record rule, only biases
+// toward re-picking a successful attack composition.
+inline double ai_boost_success_weight_nudge(int level) {
+    return clamp_ai_boost(level) >= 3 ? 10.0 : 0.0;
+}
+
+inline bool ai_boost_compose_counters(int level) {
+    return clamp_ai_boost(level) >= 3;
+}
+
+// Apply L1/L2 timer and economy knobs onto a computer house's resolved config.
+// Caller sets cfg.ai_boost first. Safe at level 0 (no-op).
+template <class AiHouseConfigT>
+inline void apply_ai_boost(AiHouseConfigT& cfg) {
+    const int level = clamp_ai_boost(cfg.ai_boost);
+    if (level <= 0) return;
+    const double delay_div = ai_boost_delay_div(level);
+    const double credit_mul = ai_boost_credit_reserve_mul(level);
+
+    // TeamDelays frames (gamemd [General] TeamDelays= CSV at house+0x184).
+    {
+        const int frames = cfg.team.rules.team_delay_frames;
+        cfg.team.rules.team_delay_frames =
+            std::max(1, static_cast<int>(frames / delay_div + 0.5));
+    }
+    // DifficultyClass BuildDelay= minutes between AI build passes.
+    cfg.mods.build_delay_min = cfg.mods.build_delay_min / delay_div;
+
+    cfg.ai.credit_reserve = cfg.ai.credit_reserve * credit_mul;
+    cfg.team.rules.credit_reserve = cfg.team.rules.credit_reserve * credit_mul;
+
+    if (level >= 2) {
+        // IQ Harvester path: keep more miners per refinery.
+        if (cfg.team.harvesters_per_refinery > 0)
+            cfg.team.harvesters_per_refinery += ai_boost_extra_harvesters(level);
+    }
+}
+
+}  // namespace ra2engine
diff --git a/tests/test_ai_boost.cpp b/tests/test_ai_boost.cpp
new file mode 100644
index 0000000..4f99f8e
--- /dev/null
+++ b/tests/test_ai_boost.cpp
@@ -0,0 +1,96 @@
+#include "doctest.h"
+#include "../engine/ai_boost.hpp"
+
+using namespace ra2engine;
+
+TEST_CASE("ai_boost: clamp and delay/credit multipliers") {
+    CHECK(clamp_ai_boost(-1) == 0);
+    CHECK(clamp_ai_boost(0) == 0);
+    CHECK(clamp_ai_boost(3) == 3);
+    CHECK(clamp_ai_boost(9) == 3);
+
+    // Same step curve as Generals AI::boostSpeed (GEN_AI_BOOST).
+    CHECK(ai_boost_delay_div(0) == doctest::Approx(1.0));
+    CHECK(ai_boost_delay_div(1) == doctest::Approx(1.35));
+    CHECK(ai_boost_delay_div(2) == doctest::Approx(1.7));
+    CHECK(ai_boost_delay_div(3) == doctest::Approx(2.0));
+
+    CHECK(ai_boost_credit_reserve_mul(0) == doctest::Approx(1.0));
+    CHECK(ai_boost_credit_reserve_mul(1) == doctest::Approx(0.75));
+    CHECK(ai_boost_credit_reserve_mul(2) == doctest::Approx(0.55));
+    CHECK(ai_boost_credit_reserve_mul(3) == doctest::Approx(0.40));
+}
+
+TEST_CASE("ai_boost: L2 harvester and defense response multipliers") {
+    CHECK(ai_boost_extra_harvesters(0) == 0);
+    CHECK(ai_boost_extra_harvesters(1) == 0);
+    CHECK(ai_boost_extra_harvesters(2) == 1);
+    CHECK(ai_boost_extra_harvesters(3) == 1);
+
+    // ComputerBaseDefenseResponse (Rules+0xB18) scale.
+    CHECK(ai_boost_defense_response_mul(0) == doctest::Approx(1.0));
+    CHECK(ai_boost_defense_response_mul(1) == doctest::Approx(1.0));
+    CHECK(ai_boost_defense_response_mul(2) == doctest::Approx(1.5));
+    CHECK(ai_boost_defense_response_mul(3) == doctest::Approx(2.0));
+
+    CHECK(ai_boost_defense_delay_mul(2) == doctest::Approx(0.75));
+    CHECK(ai_boost_defense_delay_mul(3) == doctest::Approx(0.5));
+}
+
+TEST_CASE("ai_boost: L3 success nudge and compose flag") {
+    CHECK(ai_boost_success_weight_nudge(0) == doctest::Approx(0.0));
+    CHECK(ai_boost_success_weight_nudge(2) == doctest::Approx(0.0));
+    CHECK(ai_boost_success_weight_nudge(3) == doctest::Approx(10.0));
+    CHECK_FALSE(ai_boost_compose_counters(2));
+    CHECK(ai_boost_compose_counters(3));
+}
+
+TEST_CASE("ai_boost: apply_ai_boost mutates TeamDelays / BuildDelay / CreditReserve") {
+    // Duck-typed stand-in for AiHouseConfig (header-only apply_ai_boost).
+    struct TeamRules {
+        int team_delay_frames = 2000;
+        double credit_reserve = 100.0;
+    };
+    struct Team {
+        TeamRules rules;
+        int harvesters_per_refinery = 2;
+    };
+    struct Mods {
+        double build_delay_min = 0.03;
+    };
+    struct Ai {
+        double credit_reserve = 100.0;
+    };
+    struct Cfg {
+        int ai_boost = 0;
+        Team team;
+        Mods mods;
+        Ai ai;
+    };
+
+    Cfg cfg;
+    apply_ai_boost(cfg);
+    CHECK(cfg.team.rules.team_delay_frames == 2000);
+    CHECK(cfg.ai.credit_reserve == doctest::Approx(100.0));
+
+    cfg.ai_boost = 1;
+    apply_ai_boost(cfg);
+    CHECK(cfg.team.rules.team_delay_frames == static_cast<int>(2000 / 1.35 + 0.5));
+    CHECK(cfg.mods.build_delay_min == doctest::Approx(0.03 / 1.35));
+    CHECK(cfg.ai.credit_reserve == doctest::Approx(75.0));
+    CHECK(cfg.team.rules.credit_reserve == doctest::Approx(75.0));
+    CHECK(cfg.team.harvesters_per_refinery == 2);  // L1: no extra miners
+
+    cfg = Cfg{};
+    cfg.ai_boost = 2;
+    apply_ai_boost(cfg);
+    CHECK(cfg.team.harvesters_per_refinery == 3);  // +1 at L2
+    CHECK(cfg.ai.credit_reserve == doctest::Approx(55.0));
+    CHECK(cfg.team.rules.team_delay_frames == static_cast<int>(2000 / 1.7 + 0.5));
+}
+
+TEST_CASE("ai_boost: resolve_ai_boost clamps launch values") {
+    CHECK(resolve_ai_boost(0) == 0);
+    CHECK(resolve_ai_boost(2) == 2);
+    CHECK(resolve_ai_boost(99) == 3);
+}
