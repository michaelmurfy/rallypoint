 // +version). Every art layer is null-guarded: on a partial install a missing SHP
 // simply skips its layer and a missing button SHP leaves label-only buttons --
 // never crashes. Palettes fall back to art.pal when shell/button pals are absent.
+//
+// The WARNING-needle clock: ONE ticked clock for the whole shell, 1/15 s a
+// frame (the original advances a shell anim control one SHP frame per timer
+// tick; the monitor's needle was observed at ~60-90 ms a frame). A single clock
+// keeps the phase across page changes instead of restarting per scene.
+int shell_monitor_frame(int count) {
+    static constexpr double kFrameDt = 1.0 / 15.0;
+    static const Uint64 t0 = SDL_GetTicks64();
+    if (count <= 0) return 0;
+    return static_cast<int>(static_cast<double>(SDL_GetTicks64() - t0) / (kFrameDt * 1000.0)) % count;
+}
