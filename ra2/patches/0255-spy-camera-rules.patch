+TEST_CASE("superweapon: spy fallback reveal disc follows SwParams spy_camera_reveal") {
+    // No SPYP type registered: the fire clears a Camera Damage= disc at the
+    // target. Retuning the param shrinks the disc. Asset-free (blank map).
+    for (int trial = 0; trial < 2; ++trial) {
+        const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+        World w(map);
+        w.enable_shroud(true);
+        SwParams p;
+        if (trial == 1) p.spy_camera_reveal = 2;
+        w.set_sw_params(p);
+        w.grant_superweapon_type(0, SuperweaponType::SpyPlane, /*recharge_secs=*/0.5,
+                                 /*is_powered=*/false);
+        for (int i = 0; i < 15 && !w.sw_ready(0, SuperweaponType::SpyPlane); ++i)
+            w.step(1.0 / 15.0);
+        REQUIRE(w.sw_ready(0, SuperweaponType::SpyPlane));
+        REQUIRE(w.fire_superweapon_at(0, SuperweaponType::SpyPlane, 20, 20));
+        CHECK(w.explored_at(0, 20, 20));
+        if (trial == 0) {
+            CHECK(w.explored_at(0, 25, 20));          // 5 out: inside r=6
+            CHECK_FALSE(w.explored_at(0, 30, 20));    // 10 out: outside
+        } else {
+            CHECK(w.explored_at(0, 21, 20));
+            CHECK_FALSE(w.explored_at(0, 25, 20));    // 5 out: outside r=2
+        }
+    }
+}
