+    World w(map);
+    w.enable_shroud(true);
+    SwParams p;
+    p.spy_camera_frames = 4;
+    w.set_sw_params(p);
+    UnitCombat spy;
+    spy.strength = 100;
+    spy.an.fixed_wing = true;
+    w.add_combat_unit(20, 20, 0, spy);
