     // G-08: the cursor STATE under the pointer (what a left click would do).
     // Agent E draws the cursor art from this; over the sidebar it is None.
     ra2engine::Input::Action cursor_action() const {
+        int cx = 0, cy = 0;
+        const bool armed = input_.sw_targeting() || input_.base_mode() != ra2engine::Input::BaseMode::None || input_.placement_active();
+        if (!armed && !input_.selection().ids().empty() && radar_active() && radar_cell_at(mx_, my_, cx, cy))
+            return ra2engine::Input::Action::Move;
         if (sidebar_up_ && lay_.contains(mx_, my_)) return ra2engine::Input::Action::None;
         return input_.action_at(zx(mx_), zy(my_));
     }
