diff --git a/engine/radar_map.hpp b/engine/radar_map.hpp
--- a/engine/radar_map.hpp
+++ b/engine/radar_map.hpp
@@ -26,6 +26,17 @@
         cx = std::clamp(static_cast<int>(std::lround((u + v) / 2.0)), 0, gw - 1);
         cy = std::clamp(static_cast<int>(std::lround((v - u) / 2.0)), 0, gh - 1);
         return true;
     }
+    // Radar pixel -> the nearest cell, WITHOUT clamping: out-of-grid pixels
+    // report out-of-grid coords (the draw fill keeps those transparent, so
+    // the diamond corners and off-map grid stay black). Same centre rounding
+    // as cell_at, so a click lands on the cell drawn under it.
+    bool cell_at_raw(int px, int py, int& cx, int& cy) const {
+        if (s <= 0 || gw <= 0 || gh <= 0) return false;
+        const double u = (px - ox) / s + u0 - 0.5, v = (py - oy) / (0.5 * s) + v0 - 0.5;
+        cx = static_cast<int>(std::lround((u + v) / 2.0));
+        cy = static_cast<int>(std::lround((v - u) / 2.0));
+        return true;
+    }
 };
 
 // What a mouse press on the sidebar radar does [RE: RadarClass::Action 0x006539D0, via vera20k's reading:
