         CHECK(radar_click_action(true, false, false, have) == RadarClickAction::Inert);
     }
 }
+
+TEST_CASE("radar map: raw pixels map to their cell unclamped, outside stays outside") {
+    RadarMap m;
+    m.ox = 10; m.oy = 20; m.s = 3.0; m.u0 = -39; m.v0 = 0; m.gw = 40; m.gh = 40;
+    // Every cell centre pixel maps back onto its cell, exactly like the clamped probe.
+    for (int y = 0; y < m.gh; ++y)
+        for (int x = 0; x < m.gw; ++x) {
+            double px, py;
+            m.cell_to_pixel(x, y, px, py);
+            int cx = -999, cy = -999, kx = -999, ky = -999;
+            REQUIRE(m.cell_at_raw(static_cast<int>(px), static_cast<int>(py), cx, cy));
+            REQUIRE(m.cell_at(static_cast<int>(px), static_cast<int>(py), kx, ky));
+            CHECK(cx == x);
+            CHECK(cy == y);
+            CHECK(cx == kx);   // the draw fill and B's clicks agree
+            CHECK(cy == ky);
+        }
+    // Far outside the diamond reports out-of-grid (the draw fill keeps those transparent).
+    int cx = 0, cy = 0;
+    REQUIRE(m.cell_at_raw(-1000, -1000, cx, cy));
+    CHECK((cx < 0 || cy < 0 || cx >= m.gw || cy >= m.gh));
+    REQUIRE(m.cell_at_raw(10000, 10000, cx, cy));
+    CHECK((cx < 0 || cy < 0 || cx >= m.gw || cy >= m.gh));
+    // Degenerate maps refuse.
+    RadarMap none;
+    CHECK_FALSE(none.cell_at_raw(1, 1, cx, cy));
+}
