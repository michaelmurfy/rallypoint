+TEST_CASE("slave miner: world movement carries a worker to ore and back") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(24, 24);
+    World world(map);
+
+    BuildingTypeDef refinery;
+    refinery.id = "YAREFN";
+    refinery.fw = 3;
+    refinery.fh = 3;
+    refinery.enslaves = "SLAV";
+    refinery.slaves_number = 1;
+    refinery.slave_reload_rate = 25;
+    refinery.slave_storage = 1;
+    world.set_economy({refinery}, {}, OreValues{25, 50}, 100000.0, 0.0, 0.0);
+    world.set_slave_scan(14);
+    UnitCombat slave_proto;
+    slave_proto.image = "SLAV";
+    slave_proto.strength = 125;
+    slave_proto.is_infantry = true;
+    slave_proto.speed_cps = 0.4;
+    world.set_slave_prototype(slave_proto);
+
+    Unit& master = world.add_unit(10, 10, "SMIN");
+    arm_slave_master(master, 1, 500, 25, 1);
+    world.ore().set(15, 10, OreKind::Ore, kMaxOreDensity, 0);
+
+    bool moved = false;
+    bool delivered = false;
+    int spawn_x = -1, spawn_y = -1;
+    for (int frame = 0; frame < 900 && !delivered; ++frame) {
+        world.step(1.0 / 15.0);
+        if (world.units().size() >= 2) {
+            const Unit& slave = world.units()[1];
+            if (spawn_x < 0) {
+                spawn_x = slave.cell_x;
+                spawn_y = slave.cell_y;
+            }
+            moved |= slave.cell_x != spawn_x || slave.cell_y != spawn_y;
+        }
+        delivered = world.take_income(0) > 0.0;
+    }
+
+    CHECK(delivered);
+    CHECK(moved);
+    REQUIRE(world.units().size() >= 2);
+}
+
+TEST_CASE("slave miner: returning workers retain their reserved delivery pad") {
+    std::vector<std::uint8_t> passable(24 * 24, 1);
+    Occupancy occ(24, 24);
+    Building building;
+    building.cx = 10;
+    building.cy = 10;
+    building.fw = 3;
+    building.fh = 3;
+
+    int x = -1, y = -1;
+    REQUIRE(slave_pad_cell(building, passable, 24, 24, occ, x, y));
+    occ.set(x, y, 7);
+    int next_x = -1, next_y = -1;
+    REQUIRE(slave_pad_cell(building, passable, 24, 24, occ, next_x, next_y, 7));
+    CHECK(next_x == x);
+    CHECK(next_y == y);
+
+    Unit master;
+    master.cell_x = 10;
+    master.cell_y = 10;
+    occ.release_all_of(7, -1, -1);
+    REQUIRE(slave_pad_cell_unit(master, passable, 24, 24, occ, x, y));
+    occ.set(x, y, 7);
+    REQUIRE(slave_pad_cell_unit(master, passable, 24, 24, occ, next_x, next_y, 7));
+    CHECK(next_x == x);
+    CHECK(next_y == y);
+}
