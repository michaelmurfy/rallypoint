+// 0252 Force Shield end-to-end: grant + fire puts ForceShieldDuration frames
+// of iron curtain on every alive building of the firing house (the shared
+// Iron Curtain timer: damage negated, then expires). Synthetic types on a
+// blank map: no game data needed.
+#include "doctest.h"
+
+#include "world.hpp"
+
+using namespace ra2engine;
+
+TEST_CASE("force shield: fire shields every alive house building, negates damage, then expires") {
+    ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.force_shield_frames = 30;
+    w.set_sw_params(p);
+    BuildingTypeDef hut;
+    hut.id = "GAPILL";
+    hut.strength = 500;
+    w.set_building_types({hut});
+    const int b0 = w.add_building(0, 5, 5, 2, 2, 0, 500, 0, 0.0, true);
+    const int b1 = w.add_building(0, 10, 10, 2, 2, 0, 500, 0, 0.0, true);
+    const int foe = w.add_building(0, 20, 20, 2, 2, 1, 500, 0, 0.0, true);
+    const int dead = w.add_building(0, 25, 25, 2, 2, 0, 500, 0, 0.0, true);
+    w.buildings()[static_cast<std::size_t>(dead)].alive = false;
+    w.buildings()[static_cast<std::size_t>(dead)].state = Building::State::Dead;
+    // Sidebar charge/ready via the existing HouseSuperweapon machinery.
+    w.grant_superweapon_type(0, SuperweaponType::ForceShield, /*recharge_secs=*/0.5,
+                             /*is_powered=*/false);
+    for (int i = 0; i < 15 && !w.sw_ready(0, SuperweaponType::ForceShield); ++i)
+        w.step(1.0 / 15.0);
+    REQUIRE(w.sw_ready(0, SuperweaponType::ForceShield));
+    CHECK(w.sw_charge_fraction(0, SuperweaponType::ForceShield) == doctest::Approx(1.0));
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::ForceShield, 5, 5));
+    CHECK_FALSE(w.sw_ready(0, SuperweaponType::ForceShield));   // full recharge
+    CHECK(w.buildings()[static_cast<std::size_t>(b0)].iron_left_frames == 30);
+    CHECK(w.buildings()[static_cast<std::size_t>(b1)].iron_left_frames == 30);
+    CHECK(w.buildings()[static_cast<std::size_t>(foe)].iron_left_frames == 0);
+    CHECK(w.buildings()[static_cast<std::size_t>(dead)].iron_left_frames == 0);
+    // Damage negated while shielded, normal elsewhere.
+    w.campaign_damage_building(b0, 100);
+    CHECK(w.buildings()[static_cast<std::size_t>(b0)].hp == 500);
+    w.campaign_damage_building(foe, 100);
+    CHECK(w.buildings()[static_cast<std::size_t>(foe)].hp == 400);
+    // Expiry through the shared Iron Curtain countdown.
+    for (int i = 0; i < 30; ++i) w.step(1.0 / 15.0);
+    CHECK(w.buildings()[static_cast<std::size_t>(b0)].iron_left_frames == 0);
+    w.campaign_damage_building(b0, 100);
+    CHECK(w.buildings()[static_cast<std::size_t>(b0)].hp == 400);
+}
