+// 0252 Force Shield: ForceShieldDuration frames of iron curtain on every
+// alive building of the firing house at fire time. The countdown is the
+// shared Iron Curtain expiry (step_air_naval); buildings placed after the
+// fire are NOT covered.
+void World::an_force_shield(int house) {
+    const int secs = an_.sw.force_shield_frames;   // Net L0: whole frames
+    for (Building& b : buildings_) {
+        if (!b.alive || b.house != house || b.state == Building::State::Dead) continue;
+        b.iron_left_frames = secs;
+    }
+}
