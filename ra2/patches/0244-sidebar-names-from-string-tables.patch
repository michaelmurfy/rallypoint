+            INFO("buildable " << id << " UIName='" << lbl << "'");
+            if (lbl.empty()) continue;   // map decorations with a tech level
+            CHECK(!tables().text(lbl).empty());
+        }
+}
+
+TEST_CASE("real install: naval units need their Naval Yard, never a War Factory") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: RA2 install not found"); return; }
+    const ra2assets::Ini& ini = ra2fixture::rulesmd_ini();
+    const ra2assets::Rules& rules = ra2fixture::rulesmd();
