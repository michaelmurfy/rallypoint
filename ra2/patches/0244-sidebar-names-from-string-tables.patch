+                if (t == "GAYARD" || t == "NAYARD" || t == "YAYARD") yard = t;
+            }
+            INFO(country << " " << id);
+            CHECK(!yard.empty());   // a Naval Yard is in the chain
+            // Everything the unit lists, placed, makes it available; without the yard it is not.
+            std::vector<Building> own, no_yard;
+            for (const std::string& t : pre) {
+                std::string real = t;
+                for (const auto& g : groups)
+                    if (g.first == t && !g.second.empty()) real = g.second.front();
+                Building b; b.type = type_of(real); b.house = 3; b.alive = true; b.state = Building::State::Idle;
+                own.push_back(b);
+                if (t != yard) no_yard.push_back(b);
+            }
+            CHECK(prerequisites_met(pre, own, types, 3, groups));
+            CHECK(!prerequisites_met(pre, no_yard, types, 3, groups));
+            // and the Naval queue's own state decides: a busy Vehicle queue changes nothing
+            UnitTypeDef u; u.id = id; u.tech_level = 4; u.naval = true; u.is_vehicle = true; u.prerequisite = pre;
+            ProductionQueues q;
+            q.set_credits(10000);
+            start(q.state(QueueCat::Vehicle), 1000, 1000, 0.7);   // a tank in production
+            CHECK(can_start_unit(q.state(QueueCat::Naval), 0, {u}, own, types, 3, groups, /*factory_alive=*/true));
+            CHECK(!can_start_unit(q.state(QueueCat::Naval), 0, {u}, own, types, 3, groups, /*factory_alive=*/false));
+            ++boats_seen;
+        }
+        // every faction gets boats, from its own yard
+        INFO(country);
+        if (country != "Civilian" && country != "Neutral" && country != "Special" && country != "GDI" && country != "Nod") CHECK(!boats_for_country.empty());
+    }
+    CHECK(countries >= 10);
+    CHECK(boats_seen >= 40);
+}
