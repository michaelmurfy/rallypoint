diff --git a/engine/ui_names.cpp b/engine/ui_names.cpp
new file mode 100644
index 0000000..0554e20
--- /dev/null
+++ b/engine/ui_names.cpp
@@ -0,0 +1,134 @@
+#include "ui_names.hpp"
+
+#include "ra2assets/fileio.hpp"
+#include "ra2assets/mix.hpp"
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+
+namespace ra2engine {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+std::string lower(std::string s) {
+    for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return s;
+}
+
+// dir + name, matching the file name case-insensitively ("" when absent).
+std::string find_file(const std::string& dir, const std::string& name) {
+    std::error_code ec;
+    const fs::path exact = fs::path(dir) / name;
+    if (fs::is_regular_file(exact, ec)) return exact.string();
+    const std::string want = lower(name);
+    for (fs::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+        if (lower(it->path().filename().string()) == want) return it->path().string();
+    return "";
+}
+
+std::shared_ptr<const ra2assets::CsfStrings> parse(const std::vector<uint8_t>& raw) {
+    if (raw.empty()) return nullptr;
+    try {
+        return std::make_shared<const ra2assets::CsfStrings>(ra2assets::CsfStrings::load(raw.data(), raw.size()));
+    } catch (const std::exception&) { return nullptr; }
+}
+
+std::shared_ptr<const ra2assets::CsfStrings> from_file(const std::string& dir, const std::string& name) {
+    const std::string p = find_file(dir, name);
+    if (p.empty()) return nullptr;
+    try { return parse(ra2assets::read_file(p)); } catch (const std::exception&) { return nullptr; }
+}
+
+std::shared_ptr<const ra2assets::CsfStrings> from_mix(const std::string& dir, const std::string& mix,
+                                                       const std::string& name) {
+    const std::string p = find_file(dir, mix);
+    if (p.empty()) return nullptr;
+    try {
+        ra2assets::MixFile m = ra2assets::MixFile::open_path(p);
+        const ra2assets::MixEntry* e = m.find(name);
+        return e ? parse(m.read(*e)) : nullptr;
+    } catch (const std::exception&) { return nullptr; }
+}
+
+// "Name:" / "UI:" style prefix up to the first ':' is not part of a readable name.
+std::string strip_label_prefix(const std::string& s) {
+    const size_t c = s.find(':');
+    return c == std::string::npos ? s : s.substr(c + 1);
+}
+
+}  // namespace
+
+const std::u16string* StringTables::find(const std::string& label) const {
+    for (const auto& t : layers_)
+        if (const std::u16string* v = t->find(label)) return v;
+    return nullptr;
+}
+
+std::string StringTables::text(const std::string& label) const {
+    const std::u16string* t = find(label);
+    if (!t) return "";
+    std::string out;
+    for (char16_t ch : *t) out += (ch >= 32 && ch < 127) ? static_cast<char>(ch) : (ch == '\n' ? '\n' : '?');
+    return out;
+}
+
+StringTables StringTables::load_install(const std::string& dir) {
+    StringTables st;
+    // Yuri's Revenge strings first: ra2md.csf carries every Yuri unit and
+    // structure (and the YR wording of the base ones); ra2.csf is the fallback.
+    st.add(from_file(dir, "ra2md.csf"));
+    st.add(from_mix(dir, "langmd.mix", "ra2md.csf"));
+    st.add(from_file(dir, "ra2.csf"));
+    st.add(from_mix(dir, "language.mix", "ra2.csf"));
+    return st;
+}
+
+std::string readable_name(const std::string& id_or_label) {
+    const std::string s = strip_label_prefix(id_or_label);
+    const bool shouting = std::none_of(s.begin(), s.end(), [](unsigned char c) { return std::islower(c); });
+    std::string out;
+    for (size_t i = 0; i < s.size(); ++i) {
+        const unsigned char c = static_cast<unsigned char>(s[i]);
+        if (c == '_' || c == '-' || c == '.' || c == ' ') {
+            if (!out.empty() && out.back() != ' ') out += ' ';
+            continue;
+        }
+        // "CruiseShip" -> "Cruise Ship"
+        if (!shouting && i > 0 && std::isupper(c) && std::islower(static_cast<unsigned char>(s[i - 1])) && !out.empty() &&
+            out.back() != ' ')
+            out += ' ';
+        const bool start = out.empty() || out.back() == ' ';
+        out += static_cast<char>(start ? std::toupper(c) : (shouting ? std::tolower(c) : c));
+    }
+    while (!out.empty() && out.back() == ' ') out.pop_back();
+    return out;
+}
+
+std::string display_name(const ra2assets::Ini& rules, const StringTables& tables, const std::string& id) {
+    auto clean = [](std::string v) {
+        const size_t sc = v.find(';');
+        if (sc != std::string::npos) v.erase(sc);
+        while (!v.empty() && std::isspace(static_cast<unsigned char>(v.back()))) v.pop_back();
+        size_t b = 0;
+        while (b < v.size() && std::isspace(static_cast<unsigned char>(v[b]))) ++b;
+        return v.substr(b);
+    };
+    const std::string label = clean(rules.get(id, "UIName"));
+    if (!label.empty()) {
+        const std::string t = tables.text(label);
+        if (!t.empty()) return t;
+    }
+    const std::string byid = tables.text("Name:" + id);
+    if (!byid.empty()) return byid;
+    // rules Name= is a plain-text name on some entries (not on stock ones, where it is a label or absent).
+    const std::string nm = clean(rules.get(id, "Name"));
+    if (!nm.empty() && nm.find(':') == std::string::npos && nm != id &&
+        std::any_of(nm.begin(), nm.end(), [](unsigned char c) { return std::islower(c) || c == ' '; }))
+        return nm;
+    return readable_name(id);
+}
+
+}  // namespace ra2engine
diff --git a/engine/ui_names.hpp b/engine/ui_names.hpp
new file mode 100644
index 0000000..a1c21eb
--- /dev/null
+++ b/engine/ui_names.hpp
@@ -0,0 +1,44 @@
+#pragma once
+// Player-facing names (SDL-free). The retail game shows the localised string
+// behind a rules section's UIName= (a CSF label such as "Name:GAPOWR"); it
+// never shows the section id. This module resolves that through every string
+// table the install has (Yuri's ra2md.csf over the base ra2.csf, loose files
+// over the ones inside language*.mix) and, when nothing resolves, builds a
+// readable name from the id so a codename never reaches the screen.
+#include "ra2assets/csf.hpp"
+#include "ra2assets/ini.hpp"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace ra2engine {
+
+// CSF tables in priority order (first table holding a label wins).
+class StringTables {
+public:
+    void add(std::shared_ptr<const ra2assets::CsfStrings> t) { if (t) layers_.push_back(std::move(t)); }
+    bool empty() const { return layers_.empty(); }
+    size_t layers() const { return layers_.size(); }
+    // nullptr when no table holds the label.
+    const std::u16string* find(const std::string& label) const;
+    // ASCII text of a label ("" when absent): non-ASCII units become '?', newlines stay.
+    std::string text(const std::string& label) const;
+
+    // Loads ra2md.csf (loose, then langmd.mix) then ra2.csf (loose, then
+    // language.mix) from the install dir (ends with a separator). File names
+    // match case-insensitively; a missing or damaged file is skipped.
+    static StringTables load_install(const std::string& dir);
+
+private:
+    std::vector<std::shared_ptr<const ra2assets::CsfStrings>> layers_;
+};
+
+// "Name:GAPOWR" -> "Gapowr"; "MTNK_2" -> "Mtnk 2"; never empty for a non-empty input.
+std::string readable_name(const std::string& id_or_label);
+
+// The name the sidebar, selection and queue text show for rules section `id`:
+// UIName= label -> "Name:<id>" -> rules Name= (when it reads as text) -> readable_name(id).
+std::string display_name(const ra2assets::Ini& rules, const StringTables& tables, const std::string& id);
+
+}  // namespace ra2engine
