+        {"PROC", rules.prerequisite_group("Proc")},     {"FACTORY", rules.prerequisite_group("Factory")},
+        {"RADAR", rules.prerequisite_group("Radar")},   {"TECH", rules.prerequisite_group("Tech")}};
+    std::set<std::string> war_factories;
+    for (const std::string& g : rules.prerequisite_group("Factory")) war_factories.insert(g);
+    // the group the unit's "FACTORY" token names holds the war factories, not the yards
