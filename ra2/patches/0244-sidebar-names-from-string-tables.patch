+// Player-facing names (tooltips and every other place a codename could leak)
+// and the Naval Yard availability rules, against the real rulesmd.ini and
+// string tables. Install-gated: RA2_INSTALL_DIR (a skip is not a pass).
+#include "doctest.h"
+#include "asset_fixture.hpp"
+#include "country_bonuses.hpp"
+#include "production.hpp"
+#include "ui_names.hpp"
+
+#include <algorithm>
+#include <set>
+
+using namespace ra2engine;
+
+namespace {
+std::vector<std::string> list_of(const ra2assets::Ini& ini, const char* sec) {
+    std::vector<std::string> v;
+    for (const auto& kv : ini.section(sec)) {
+        std::string s = kv.second.substr(0, kv.second.find(';'));
+        while (!s.empty() && (unsigned char)s.back() <= 0x20) s.pop_back();
+        if (!s.empty()) v.push_back(s);
+    }
+    return v;
+}
+const StringTables& tables() {
+    static const StringTables t = StringTables::load_install(ra2fixture::install_base());
+    return t;
+}
+}  // namespace
+
+TEST_CASE("readable_name never returns the raw label or codename shape") {
+    CHECK(readable_name("Name:GAPOWR") == "Gapowr");
+    CHECK(readable_name("CruiseShip") == "Cruise Ship");
+    CHECK(readable_name("MTNK_2") == "Mtnk 2");
+    CHECK(readable_name("Name:") == "");
+    CHECK(readable_name("E1") == "E1");
+}
+
+TEST_CASE("display_name falls back without any string table") {
+    ra2assets::Ini ini = ra2assets::Ini::parse("[GAPOWR]\nUIName=Name:GAPOWR\n[MYBOAT]\nName=Fast Boat\n[ZZZ]\n");
+    StringTables none;
+    CHECK(display_name(ini, none, "GAPOWR") == "Gapowr");   // readable, and never "Name:GAPOWR"
+    CHECK(display_name(ini, none, "MYBOAT") == "Fast Boat");
+    CHECK(display_name(ini, none, "ZZZ") == "Zzz");
+}
+
+TEST_CASE("real install: the sidebar names are the CSF text, in every list") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: RA2 install not found"); return; }
+    const ra2assets::Ini& ini = ra2fixture::rulesmd_ini();
+    CHECK(tables().layers() >= 2);                 // ra2md.csf over ra2.csf
+    CHECK(tables().text("Name:GAPOWR") == "Power Plant");
+    CHECK(tables().text("Name:E1") == "GI");
+    CHECK(display_name(ini, tables(), "GAPOWR") == "Power Plant");
+    CHECK(display_name(ini, tables(), "E1") == "GI");
+    CHECK(display_name(ini, tables(), "DEST") == "Destroyer");
+    int checked = 0;
+    for (const char* list : {"InfantryTypes", "VehicleTypes", "AircraftTypes", "BuildingTypes", "SuperWeaponTypes"})
+        for (const std::string& id : list_of(ini, list)) {
+            const std::string n = display_name(ini, tables(), id);
+            INFO(list << " " << id << " -> '" << n << "'");
+            CHECK(!n.empty());
+            CHECK(n.find("Name:") == std::string::npos);
+            CHECK(n.find(':') == std::string::npos);
+            // the label the rules point at resolves, or the name is the readable fallback
+            const std::string lbl = ini.get(id, "UIName");
+            if (!lbl.empty() && !tables().text(lbl).empty()) CHECK(n == tables().text(lbl));
