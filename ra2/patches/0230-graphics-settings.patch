+#include "post_fx.hpp"
+
+#include <algorithm>
+#include <vector>
+
+namespace ra2engine {
+
+namespace {
+SDL_Texture* make_target(SDL_Renderer* r, int w, int h) {
+    SDL_Texture* t = SDL_CreateTexture(r, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_TARGET, std::max(1, w), std::max(1, h));
+    if (t) {
+        SDL_SetTextureBlendMode(t, SDL_BLENDMODE_NONE);
+        SDL_SetTextureScaleMode(t, SDL_ScaleModeLinear);
+    }
+    return t;
+}
+void kill(SDL_Texture*& t) {
+    if (t) SDL_DestroyTexture(t);
+    t = nullptr;
+}
+}  // namespace
+
+PostFx::~PostFx() { release(); }
+
+void PostFx::release() {
+    kill(half_);
+    kill(quarter_);
+    kill(bright_);
+    kill(eighth_);
+    kill(tmp_);
+    kill(vig_);
+    vw_ = vh_ = vig_level_ = 0;
+}
+
+bool PostFx::ensure_bloom(SDL_Renderer* r, int vw, int vh) {
+    if (half_ && vw_ == vw && vh_ == vh) return true;
+    kill(half_);
+    kill(quarter_);
+    kill(bright_);
+    kill(eighth_);
+    kill(tmp_);
+    vw_ = vw;
+    vh_ = vh;
+    half_ = make_target(r, (vw + 1) / 2, (vh + 1) / 2);
+    quarter_ = make_target(r, (vw + 3) / 4, (vh + 3) / 4);
+    bright_ = make_target(r, (vw + 3) / 4, (vh + 3) / 4);
+    eighth_ = make_target(r, (vw + 7) / 8, (vh + 7) / 8);
+    tmp_ = make_target(r, (vw + 3) / 4, (vh + 3) / 4);
+    if (!half_ || !quarter_ || !bright_ || !eighth_ || !tmp_) {
+        kill(half_);
+        kill(quarter_);
+        kill(bright_);
+        kill(eighth_);
+        kill(tmp_);
+        return false;
+    }
+    return true;
+}
+
+// Bright pass and blur with two or three small targets: world -> 1/2 -> 1/4 (linear: a box average each),
+// bright = quarter squared (multiply blend: only near-white survives), -> 1/8 (more blur), then the glow is
+// added back over the world at the destination size.
+void PostFx::bloom(SDL_Renderer* r, SDL_Texture* world, int vw, int vh, const SDL_Rect& dst, int level) {
+    const BloomParams bp = bloom_params(level);
+    if (bp.alpha == 0 || !ensure_bloom(r, vw, vh)) return;
+    SDL_Texture* prev = SDL_GetRenderTarget(r);
+    SDL_SetTextureScaleMode(world, SDL_ScaleModeLinear);
+    SDL_SetRenderTarget(r, half_);
+    SDL_RenderCopy(r, world, nullptr, nullptr);
+    SDL_SetRenderTarget(r, quarter_);
+    SDL_RenderCopy(r, half_, nullptr, nullptr);
+    SDL_SetRenderTarget(r, bright_);
+    SDL_SetTextureBlendMode(quarter_, SDL_BLENDMODE_NONE);
+    SDL_RenderCopy(r, quarter_, nullptr, nullptr);
+    // Square it `squares` times (x^2, x^4, x^8): a multiply blend cannot read its own target, so each round
+    // copies the current result to `tmp_` and multiplies it by that.
+    for (int i = 0; i < bp.squares; ++i) {
+        SDL_SetRenderTarget(r, tmp_);
+        SDL_SetTextureBlendMode(bright_, SDL_BLENDMODE_NONE);
+        SDL_RenderCopy(r, bright_, nullptr, nullptr);
+        SDL_SetRenderTarget(r, bright_);
+        SDL_SetTextureBlendMode(tmp_, SDL_BLENDMODE_MOD);
+        SDL_RenderCopy(r, tmp_, nullptr, nullptr);
+        SDL_SetTextureBlendMode(tmp_, SDL_BLENDMODE_NONE);
+    }
+    SDL_SetRenderTarget(r, eighth_);
+    SDL_RenderCopy(r, bright_, nullptr, nullptr);
+    SDL_SetRenderTarget(r, prev);
+    SDL_SetTextureBlendMode(eighth_, SDL_BLENDMODE_ADD);
+    SDL_SetTextureAlphaMod(eighth_, bp.alpha);
+    SDL_RenderCopy(r, eighth_, nullptr, &dst);
+    SDL_SetTextureBlendMode(bright_, SDL_BLENDMODE_ADD);
+    SDL_SetTextureAlphaMod(bright_, static_cast<Uint8>(bp.alpha / 2));
+    SDL_RenderCopy(r, bright_, nullptr, &dst);
+    SDL_SetTextureAlphaMod(eighth_, 255);
+    SDL_SetTextureAlphaMod(bright_, 255);
+    SDL_SetTextureBlendMode(eighth_, SDL_BLENDMODE_NONE);
+    SDL_SetTextureBlendMode(bright_, SDL_BLENDMODE_NONE);
+}
+
+void PostFx::vignette(SDL_Renderer* r, const SDL_Rect& dst, int level) {
+    if (level <= 0) return;
+    if (!vig_ || vig_level_ != level) {
+        kill(vig_);
+        constexpr int W = 128, H = 72;
+        std::vector<Uint32> px(static_cast<std::size_t>(W) * H);
+        for (int y = 0; y < H; ++y)
+            for (int x = 0; x < W; ++x)
+                px[static_cast<std::size_t>(y) * W + x] =
+                    static_cast<Uint32>(vignette_alpha((x + 0.5) / W, (y + 0.5) / H, level)) << 24;   // black, alpha only
+        vig_ = SDL_CreateTexture(r, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STATIC, W, H);
+        if (!vig_) return;
+        SDL_UpdateTexture(vig_, nullptr, px.data(), W * 4);
+        SDL_SetTextureBlendMode(vig_, SDL_BLENDMODE_BLEND);
+        SDL_SetTextureScaleMode(vig_, SDL_ScaleModeLinear);
+        vig_level_ = level;
+    }
+    SDL_RenderCopy(r, vig_, nullptr, &dst);
+}
+
+void PostFx::draw(SDL_Renderer* r, SDL_Texture* world, int vw, int vh, const SDL_Rect& dst, bool nearest, const GfxSettings& g) {
+    const GradeParams gp = grade_params(g.grade);
+    SDL_SetTextureScaleMode(world, nearest ? SDL_ScaleModeNearest : SDL_ScaleModeLinear);
+    SDL_SetTextureColorMod(world, gp.r, gp.g, gp.b);
+    SDL_RenderCopy(r, world, nullptr, &dst);
+    if (gp.gain) {   // Vivid: the picture added onto itself, brights clip towards white and colours push apart
+        SDL_SetTextureBlendMode(world, SDL_BLENDMODE_ADD);
+        SDL_SetTextureAlphaMod(world, gp.gain);
+        SDL_RenderCopy(r, world, nullptr, &dst);
+        SDL_SetTextureAlphaMod(world, 255);
+        SDL_SetTextureBlendMode(world, SDL_BLENDMODE_NONE);
+    }
+    SDL_SetTextureColorMod(world, 255, 255, 255);
+    if (g.bloom > 0) bloom(r, world, vw, vh, dst, g.bloom);
+    vignette(r, dst, g.vignette);
+}
+
+}  // namespace ra2engine
