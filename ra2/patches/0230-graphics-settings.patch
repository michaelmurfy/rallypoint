+#pragma once
+#include <cstdint>
+#include <vector>
+
+namespace ra2engine {
+
+// Classic EPX / Scale2x of an RGBA image (4 bytes a pixel, w x h): every pixel becomes 2x2. A quarter takes the
+// colour of the neighbour on its two sides only when those two agree with each other and not with the opposite
+// pair, so corners are cut and no new colour is ever made. Colours are compared exactly (all-transparent pixels
+// count as equal whatever their RGB), edges repeat. Output (2w) x (2h).
+std::vector<std::uint8_t> scale2x_rgba(const std::uint8_t* src, int w, int h);
+
+}  // namespace ra2engine
