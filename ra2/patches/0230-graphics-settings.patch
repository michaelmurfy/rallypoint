diff --git a/tests/test_gfx_settings.cpp b/tests/test_gfx_settings.cpp
new file mode 100644
index 0000000..6614735
--- /dev/null
+++ b/tests/test_gfx_settings.cpp
@@ -0,0 +1,108 @@
+#include "doctest.h"
+#include "../engine/gfx_settings.hpp"
+#include "../engine/logical_canvas.hpp"
+
+using namespace ra2engine;
+
+TEST_CASE("RA2_GFX: absent, empty and garbage are the defaults") {
+    for (const char* s : {static_cast<const char*>(nullptr), "", "nonsense", "Scale=wobbly;Bloom=9;=;;Grade=?"}) {
+        const GfxSettings g = parse_gfx(s);
+        CHECK(g.scale == ScaleFilter::Auto);
+        CHECK(g.sprites == SpriteUp::Aa);
+        CHECK(g.bloom == 0);
+        CHECK(g.vignette == 0);
+        CHECK(g.grade == Grade::Standard);
+        CHECK(!g.zoom_smooth);
+        CHECK(!g.zoom_wide);
+        CHECK(!g.world_fx());
+    }
+}
+
+TEST_CASE("RA2_GFX: every key") {
+    const GfxSettings g = parse_gfx(" Scale = Sharp ; smooth=2;Sprites=scale2x;BLOOM=strong;Vignette=1;Grade=warm;ZoomSmooth=on;ZoomRange=wide");
+    CHECK(g.scale == ScaleFilter::Sharp);
+    CHECK(g.smooth == 2);
+    CHECK(g.sprites == SpriteUp::Scale2x);
+    CHECK(g.bloom == 2);
+    CHECK(g.vignette == 1);
+    CHECK(g.grade == Grade::Warm);
+    CHECK(g.zoom_smooth);
+    CHECK(g.zoom_wide);
+    CHECK(g.world_fx());
+    CHECK(parse_gfx("Sprites=off").sprites == SpriteUp::Off);
+    CHECK(parse_gfx("Scale=integer").scale == ScaleFilter::Integer);
+}
+
+TEST_CASE("vignette: clear in the middle, darkest at the corners, smooth between") {
+    CHECK(vignette_alpha(0.5, 0.5, 2) == 0);
+    CHECK(vignette_alpha(0.0, 0.0, 2) == 150);
+    CHECK(vignette_alpha(1.0, 1.0, 1) == 80);
+    CHECK(vignette_alpha(0.0, 0.0, 0) == 0);
+    int last = -1;
+    for (int i = 0; i <= 10; ++i) {
+        const int a = vignette_alpha(0.5 - i * 0.05, 0.5 - i * 0.05, 2);
+        CHECK(a >= last);
+        last = a;
+    }
+    CHECK(vignette_alpha(0.1, 0.9, 2) == vignette_alpha(0.9, 0.1, 2));   // symmetric
+}
+
+TEST_CASE("grade only takes light away; vivid adds gain; bloom levels") {
+    for (Grade g : {Grade::Standard, Grade::Warm, Grade::Cool, Grade::Vivid}) {
+        const GradeParams p = grade_params(g);
+        CHECK(p.r <= 255);
+        CHECK(p.g >= 200);
+    }
+    CHECK(grade_params(Grade::Standard).gain == 0);
+    CHECK(grade_params(Grade::Vivid).gain > 0);
+    CHECK(bloom_params(0).alpha == 0);
+    CHECK(bloom_params(2).alpha > bloom_params(1).alpha);
+}
+
+TEST_CASE("wide zoom range reaches further both ways and never inverts") {
+    for (double s : {0.5, 1.0, 1.5, 2.0, 3.0}) {
+        CHECK(zoom_min_for(s, false) == doctest::Approx(zoom_min(s)));
+        CHECK(zoom_max_for(s, false) == doctest::Approx(zoom_max(s)));
+        CHECK(zoom_min_for(s, true) <= zoom_min_for(s, false));
+        CHECK(zoom_max_for(s, true) >= zoom_max_for(s, false));
+        CHECK(zoom_min_for(s, true) >= 0.15);
+        CHECK(zoom_min_for(s, true) < zoom_max_for(s, true));
+    }
+    // a Retina 2x screen: native is 0.5 canvas px per world px; wide goes to a half of that
+    CHECK(zoom_min_for(2.0, true) == doctest::Approx(0.25));
+}
+
+TEST_CASE("smooth zoom: geometric steps, clamped, glide settles on the target") {
+    CHECK(zoom_step_smooth(1.0, 1, 0.5, 2.0) == doctest::Approx(1.18));
+    CHECK(zoom_step_smooth(1.0, -1, 0.5, 2.0) == doctest::Approx(1.0 / 1.18));
+    CHECK(zoom_step_smooth(1.9, 1, 0.5, 2.0) == doctest::Approx(2.0));
+    CHECK(zoom_step_smooth(0.52, -1, 0.5, 2.0) == doctest::Approx(0.5));
+    // in then out returns to where it started
+    CHECK(zoom_step_smooth(zoom_step_smooth(1.0, 1, 0.1, 9.0), -1, 0.1, 9.0) == doctest::Approx(1.0));
+    double z = 1.0;
+    int frames = 0;
+    for (; z != 2.0 && frames < 600; ++frames) z = zoom_glide(z, 2.0, 1.0 / 60.0);
+    CHECK(z == 2.0);
+    CHECK(frames > 5);
+    CHECK(frames < 60);   // under a second at 60 fps
+    // same wall-clock time, different frame rates: nearly the same place
+    double a = 1.0, b = 1.0;
+    for (int i = 0; i < 6; ++i) a = zoom_glide(a, 2.0, 1.0 / 60.0);
+    for (int i = 0; i < 12; ++i) b = zoom_glide(b, 2.0, 1.0 / 120.0);
+    CHECK(a == doctest::Approx(b).epsilon(0.01));
+    CHECK(zoom_glide(1.0, 2.0, 0.0) == 1.0);
+}
+
+TEST_CASE("zooming on the pointer keeps the world point under it through a glide") {
+    double z = 1.0;
+    int cam = 100;
+    const int anchor = 300;
+    const int world = anchor - cam;   // the camera is the world origin's place on screen: world = pixel / zoom - cam
+    for (int i = 0; i < 40; ++i) {
+        const double n = zoom_glide(z, 2.0, 1.0 / 60.0);
+        cam = zoom_keep_point(cam, anchor, z, n);
+        z = n;
+    }
+    const double under = anchor / z - cam;
+    CHECK(under == doctest::Approx(world).epsilon(0.01));
+}
diff --git a/tests/test_pixel_scale.cpp b/tests/test_pixel_scale.cpp
new file mode 100644
index 0000000..8da9cbe
--- /dev/null
+++ b/tests/test_pixel_scale.cpp
@@ -0,0 +1,45 @@
+#include "doctest.h"
+#include "../engine/pixel_scale.hpp"
+
+#include <cstring>
+
+using namespace ra2engine;
+
+static std::uint32_t px(const std::vector<std::uint8_t>& v, int w, int x, int y) {
+    std::uint32_t c;
+    std::memcpy(&c, &v[(static_cast<std::size_t>(y) * w + x) * 4], 4);
+    return c;
+}
+
+TEST_CASE("scale2x: a flat image is just doubled") {
+    std::vector<std::uint8_t> src(3 * 3 * 4, 0x7f);
+    const auto out = scale2x_rgba(src.data(), 3, 3);
+    REQUIRE(out.size() == 6u * 6u * 4u);
+    for (std::uint8_t b : out) CHECK(b == 0x7f);
+}
+
+TEST_CASE("scale2x: an L-shaped staircase gets its corner cut and nothing else") {
+    // 3x3, colours as one byte repeated: A above and C left of the middle pixel agree, the others differ.
+    const std::uint8_t W = 255, K = 10;
+    std::uint8_t m[3][3] = {{W, W, K}, {W, K, K}, {K, K, K}};
+    std::vector<std::uint8_t> src;
+    for (auto& row : m) for (std::uint8_t v : row) { src.push_back(v); src.push_back(v); src.push_back(v); src.push_back(255); }
+    const auto out = scale2x_rgba(src.data(), 3, 3);
+    const std::uint32_t white = 0xFFFFFFFFu, dark = 0xFF0A0A0Au;
+    // The middle pixel (1,1) is dark; up (1,0) is white, left (0,1) is white, right and down dark.
+    // C == A and C != D and A != B: the top-left quarter becomes white.
+    CHECK(px(out, 6, 2, 2) == white);
+    CHECK(px(out, 6, 3, 2) == dark);
+    CHECK(px(out, 6, 2, 3) == dark);
+    CHECK(px(out, 6, 3, 3) == dark);
+    // No colour that is not in the source.
+    for (int y = 0; y < 6; ++y) for (int x = 0; x < 6; ++x) { const auto c = px(out, 6, x, y); CHECK((c == white || c == dark)); }
+}
+
+TEST_CASE("scale2x: transparent pixels count as equal whatever their colour; bad input is empty") {
+    std::vector<std::uint8_t> src = {1, 2, 3, 0, 9, 9, 9, 0, 9, 9, 9, 0, 5, 5, 5, 255};   // 2x2
+    const auto out = scale2x_rgba(src.data(), 2, 2);
+    CHECK(out.size() == 4u * 4u * 4u);
+    CHECK(scale2x_rgba(nullptr, 2, 2).empty());
+    CHECK(scale2x_rgba(src.data(), 0, 2).empty());
+}
