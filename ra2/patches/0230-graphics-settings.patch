+++ b/engine/post_fx.hpp
@@ -0,0 +1,33 @@
+#pragma once
+#include <SDL.h>
+
+#include "gfx_settings.hpp"
+
+namespace ra2engine {
+
+// Picture-only effects on the finished world view (RA2_GFX Bloom, Vignette, Grade), drawn with SDL's own
+// renderer: texture colour modulation, additive and multiplying blends and linear down/up-scaling, so they
+// run on the GPU where SDL has one and need no shader. The sidebar, text and cursor are drawn after this and
+// stay untouched. Nothing here reads or changes the game.
+class PostFx {
+public:
+    ~PostFx();
+    // Draws `world` (a render-target texture of vw x vh) into the current target at `dst` with the grade,
+    // the glow and the vignette of `g`. `nearest`: sample the world without filtering (whole scales).
+    void draw(SDL_Renderer* r, SDL_Texture* world, int vw, int vh, const SDL_Rect& dst, bool nearest, const GfxSettings& g);
+    void release();
+
+private:
+    SDL_Texture* half_ = nullptr;
+    SDL_Texture* quarter_ = nullptr;
+    SDL_Texture* bright_ = nullptr;
+    SDL_Texture* eighth_ = nullptr;
+    SDL_Texture* tmp_ = nullptr;
+    SDL_Texture* vig_ = nullptr;
+    int vw_ = 0, vh_ = 0, vig_level_ = 0;
+    bool ensure_bloom(SDL_Renderer* r, int vw, int vh);
+    void bloom(SDL_Renderer* r, SDL_Texture* world, int vw, int vh, const SDL_Rect& dst, int level);
+    void vignette(SDL_Renderer* r, const SDL_Rect& dst, int level);
+};
+
+}  // namespace ra2engine
