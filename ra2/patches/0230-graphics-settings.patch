@@ -0,0 +1,47 @@
+#include "pixel_scale.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace ra2engine {
+
+namespace {
+bool same(const std::uint8_t* a, const std::uint8_t* b) {
+    if (a[3] == 0 && b[3] == 0) return true;
+    return std::memcmp(a, b, 4) == 0;
+}
+}  // namespace
+
+std::vector<std::uint8_t> scale2x_rgba(const std::uint8_t* src, int w, int h) {
+    std::vector<std::uint8_t> out;
+    if (!src || w <= 0 || h <= 0) return out;
+    const int ow = w * 2;
+    out.assign(static_cast<std::size_t>(ow) * h * 2 * 4, 0);
+    auto at = [&](int x, int y) -> const std::uint8_t* {
+        x = std::max(0, std::min(w - 1, x));
+        y = std::max(0, std::min(h - 1, y));
+        return src + (static_cast<std::size_t>(y) * w + x) * 4;
+    };
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const std::uint8_t* P = at(x, y);
+            const std::uint8_t* A = at(x, y - 1);   // up
+            const std::uint8_t* B = at(x + 1, y);   // right
+            const std::uint8_t* C = at(x - 1, y);   // left
+            const std::uint8_t* D = at(x, y + 1);   // down
+            const std::uint8_t* q[4] = {P, P, P, P};
+            if (same(C, A) && !same(C, D) && !same(A, B)) q[0] = A;
+            if (same(A, B) && !same(A, C) && !same(B, D)) q[1] = B;
+            if (same(D, C) && !same(D, B) && !same(C, A)) q[2] = C;
+            if (same(B, D) && !same(B, A) && !same(D, C)) q[3] = D;
+            std::uint8_t* p0 = out.data() + (static_cast<std::size_t>(2 * y) * ow + 2 * x) * 4;
+            std::memcpy(p0, q[0], 4);
+            std::memcpy(p0 + 4, q[1], 4);
+            std::memcpy(p0 + static_cast<std::size_t>(ow) * 4, q[2], 4);
+            std::memcpy(p0 + static_cast<std::size_t>(ow) * 4 + 4, q[3], 4);
+        }
+    }
+    return out;
+}
+
+}  // namespace ra2engine
