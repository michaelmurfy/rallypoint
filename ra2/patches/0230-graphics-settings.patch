new file mode 100644
index 0000000..bc54f79
--- /dev/null
+++ b/engine/gfx_settings.hpp
@@ -0,0 +1,173 @@
+#pragma once
+// Presentation settings (launcher: Settings > Graphics for Red Alert 2). Picture only: nothing here
+// reaches the simulation, the commands or the saves. One environment variable carries them all:
+//   RA2_GFX="Scale=sharp;Smooth=1;Sprites=aa;Bloom=1;Vignette=1;Grade=warm;ZoomSmooth=1;ZoomRange=wide"
+// Keys are case-insensitive, unknown keys and bad values are ignored, an empty or absent variable is
+// the defaults, and the defaults are exactly the picture of builds before these settings existed.
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <string>
+
+namespace ra2engine {
+
+// How the finished canvas reaches the window.
+enum class ScaleFilter {
+    Auto,       // whole scales go through SDL's integer scale, fractional ones are drawn by SDL (the old behaviour)
+    Nearest,    // hard pixels at any scale
+    Integer,    // the largest whole scale, black bars around it
+    Bilinear,   // plain linear filtering
+    Sharp,      // nearest up to the next whole scale, then linear: even pixels, one pixel of softening at edges
+};
+// Which pixel-art upscaler the unit, building and effect sprites go through (texture_cache.cpp).
+enum class SpriteUp {
+    Aa,         // 2x EPX with sub-pixel corner anti-aliasing (the old behaviour)
+    Scale2x,    // classic EPX / Scale2x: exact-colour corner rule, no new colours
+    Off,        // the art pixels as they are
+};
+enum class Grade { Standard, Warm, Cool, Vivid };
+
+struct GfxSettings {
+    ScaleFilter scale = ScaleFilter::Auto;
+    int smooth = 0;          // 0..2: a linear copy blended over the nearest/integer picture (post-scale softening)
+    SpriteUp sprites = SpriteUp::Aa;
+    int bloom = 0;           // 0 off, 1 subtle, 2 strong
+    int vignette = 0;        // 0 off, 1 subtle, 2 strong
+    Grade grade = Grade::Standard;
+    bool zoom_smooth = false;   // the wheel glides to its target instead of jumping in eighths
+    bool zoom_wide = false;     // zooms out to half the screen's own pixel density, in to 3 screen pixels per world pixel
+    bool world_fx() const { return bloom > 0 || vignette > 0 || grade != Grade::Standard; }
+};
+
+inline std::string gfx_lower(std::string s) {
+    for (char& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+    return s;
+}
+inline int gfx_level(const std::string& v, int hi) {
+    if (v == "off" || v == "0" || v == "no") return 0;
+    if (v == "low" || v == "subtle" || v == "1") return 1;
+    if (v == "high" || v == "strong" || v == "2") return std::min(2, hi);
+    return -1;
+}
+inline bool gfx_on(const std::string& v, bool& out) {
+    if (v == "1" || v == "on" || v == "yes" || v == "true") { out = true; return true; }
+    if (v == "0" || v == "off" || v == "no" || v == "false") { out = false; return true; }
+    return false;
+}
+
+// Parses "Key=value;Key=value". Anything it does not understand keeps the default.
+inline GfxSettings parse_gfx(const char* text) {
+    GfxSettings g;
+    if (!text) return g;
+    const std::string all = text;
+    std::size_t at = 0;
+    while (at <= all.size()) {
+        std::size_t end = all.find(';', at);
+        if (end == std::string::npos) end = all.size();
+        const std::string item = all.substr(at, end - at);
+        at = end + 1;
+        const std::size_t eq = item.find('=');
+        if (eq == std::string::npos) continue;
+        auto trim = [](std::string s) {
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.front()))) s.erase(s.begin());
+            while (!s.empty() && std::isspace(static_cast<unsigned char>(s.back()))) s.pop_back();
+            return s;
+        };
+        const std::string k = gfx_lower(trim(item.substr(0, eq))), v = gfx_lower(trim(item.substr(eq + 1)));
+        bool b = false;
+        int n = 0;
+        if (k == "scale") {
+            if (v == "auto") g.scale = ScaleFilter::Auto;
+            else if (v == "nearest") g.scale = ScaleFilter::Nearest;
+            else if (v == "integer") g.scale = ScaleFilter::Integer;
+            else if (v == "bilinear") g.scale = ScaleFilter::Bilinear;
+            else if (v == "sharp") g.scale = ScaleFilter::Sharp;
+        } else if (k == "smooth") {
+            if ((n = gfx_level(v, 2)) >= 0) g.smooth = n;
+        } else if (k == "sprites") {
+            if (v == "aa" || v == "epx") g.sprites = SpriteUp::Aa;
+            else if (v == "scale2x") g.sprites = SpriteUp::Scale2x;
+            else if (v == "off" || v == "none") g.sprites = SpriteUp::Off;
+        } else if (k == "bloom") {
+            if ((n = gfx_level(v, 2)) >= 0) g.bloom = n;
+        } else if (k == "vignette") {
+            if ((n = gfx_level(v, 2)) >= 0) g.vignette = n;
+        } else if (k == "grade") {
+            if (v == "standard" || v == "off") g.grade = Grade::Standard;
+            else if (v == "warm") g.grade = Grade::Warm;
+            else if (v == "cool") g.grade = Grade::Cool;
+            else if (v == "vivid") g.grade = Grade::Vivid;
+        } else if (k == "zoomsmooth") {
+            if (gfx_on(v, b)) g.zoom_smooth = b;
+        } else if (k == "zoomrange") {
+            if (v == "wide") g.zoom_wide = true;
+            else if (v == "normal") g.zoom_wide = false;
+        }
+    }
+    return g;
+}
+
+// The process's settings, read once (RA2_GFX).
+inline const GfxSettings& gfx() {
+    static const GfxSettings g = parse_gfx(std::getenv("RA2_GFX"));
+    return g;
+}
+
+// Vignette: the darkening (0..255 alpha of black) at normalised position (u, v) in 0..1 of the view.
+// Zero inside an ellipse that touches the middle 60% of each side, rising smoothly to `corner` at the corners.
+inline int vignette_alpha(double u, double v, int level) {
+    if (level <= 0) return 0;
+    const double dx = (u - 0.5) * 2.0, dy = (v - 0.5) * 2.0;   // -1..1
+    const double r = std::sqrt(dx * dx + dy * dy) / std::sqrt(2.0);   // 0 centre .. 1 corner
+    const double t = std::max(0.0, (r - 0.45) / 0.55);
+    const double s = t * t * (3.0 - 2.0 * t);   // smoothstep
+    const double corner = level == 1 ? 80.0 : 150.0;
+    return static_cast<int>(std::lround(s * corner));
+}
+
+// Colour grade as a multiplier on the world picture (r, g, b in 0..255; never above 255, so a grade only
+// takes light away) and `gain`, the alpha of an additive copy of the picture on itself (0 = none).
+struct GradeParams { std::uint8_t r, g, b; std::uint8_t gain; };
+inline GradeParams grade_params(Grade g) {
+    switch (g) {
+        case Grade::Warm: return {255, 244, 222, 0};
+        case Grade::Cool: return {226, 240, 255, 0};
+        case Grade::Vivid: return {255, 255, 255, 40};
+        default: return {255, 255, 255, 0};
+    }
+}
+
+// Bloom strength: alpha of the additive glow, and how many times the bright pass squares the picture
+// (3 squares = 8th power, 4 = 16th: only things near white glow).
+struct BloomParams { std::uint8_t alpha; int squares; };
+inline BloomParams bloom_params(int level) {
+    return level >= 2 ? BloomParams{150, 3} : level == 1 ? BloomParams{120, 4} : BloomParams{0, 0};
+}
+
+// Zoom ranges on top of logical_canvas.hpp's: `wide` takes the minimum down to half the screen's pixel
+// density (a view with at most 4x the screen's pixels) and the maximum to 3 screen pixels per world pixel.
+inline double zoom_min_for(double screen_px_per_canvas_px, bool wide) {
+    const double s = screen_px_per_canvas_px > 0.0 ? screen_px_per_canvas_px : 1.0;
+    const double normal = std::max(0.25, std::min(0.75, 1.0 / s));
+    return wide ? std::max(0.15, std::min(normal, 0.5 / s)) : normal;
+}
+inline double zoom_max_for(double screen_px_per_canvas_px, bool wide) {
+    const double s = screen_px_per_canvas_px > 0.0 ? screen_px_per_canvas_px : 1.0;
+    return std::max(1.0, (wide ? 3.0 : 2.0) / s);
+}
+// A wheel notch in smooth mode: 18% either way (a geometric step feels the same near and far), clamped.
+inline double zoom_step_smooth(double target, int dir, double zmin, double zmax) {
+    const double z = dir > 0 ? target * 1.18 : target / 1.18;
+    return std::max(zmin, std::min(zmax, z));
+}
+// One frame of the glide towards the target: exponential, ~90% of the way in 150 ms, independent of the
+// frame rate; settles exactly on the target.
+inline double zoom_glide(double cur, double target, double dt) {
+    const double k = 1.0 - std::exp(-std::max(0.0, dt) * 15.0);
+    const double z = cur + (target - cur) * k;
+    return std::fabs(z - target) < std::max(0.002, target * 0.002) ? target : z;
+}
+
+}  // namespace ra2engine
