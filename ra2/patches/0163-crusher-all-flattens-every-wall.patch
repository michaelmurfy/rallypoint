+// 0163 [RE: Per_Cell_Process FUN_0073AFD4 @0x73B02D]: a MovementZone=CrusherAll unit (the Battle Fortress) flattens every
+// Wall=yes overlay; a plain Crusher only the Crushable= ones. Real rules, real map, a wall across an open field; the plain Crusher's grid keeps the wall closed (checked above).
+TEST_CASE("w6units 0163: a CrusherAll unit drives through a wall that is not Crushable") {
+    if (ra2fixture::rulesmd_bytes().empty() || !ra2fixture::mapsmd03_available()) { MESSAGE("no install"); return; }
+    World world(ra2fixture::mapsmd03_map());
+    int x0 = 0, y0 = 0;
+    REQUIRE(w6_open_rect(world, 12, 7, x0, y0));
+    const int wx = x0 + 6;
+    for (int y = y0; y < y0 + 7; ++y) {
+        world.block_wall_cell(wx, y);
+        world.mark_crushable_wall(wx, y, /*omni_only=*/true);
+    }
+    const std::vector<int> all100 = {100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100};
+    world.add_combat_unit(x0, y0 + 3, 0, w6mk("BFRT", 600, "heavy", 0, 60, 0.0, all100, true));
+    world.add_combat_unit(x0, y0 + 3 + 1, 0, w6mk("HTNK", 600, "heavy", 0, 60, 0.0, all100, true));
+    Unit& bf = world.units()[0];
+    Unit& rh = world.units()[1];
+    bf.crusher = rh.crusher = true;
+    bf.is_vehicle = rh.is_vehicle = true;
+    bf.w6.t.omni_crusher = true;
+    CHECK(world.crush_grid_of(bf)[static_cast<std::size_t>(y0 + 3) * world.grid_w() + wx] == 1);
+    CHECK(world.crush_grid_of(rh)[static_cast<std::size_t>(y0 + 3) * world.grid_w() + wx] == 0);
+    world.order_unit_move(0, x0 + 11, y0 + 3);
+    for (int k = 0; k < 15 * 60 && world.units()[0].moving(); ++k) world.step(1.0 / 15.0);
+    CHECK(world.units()[0].cell_x >= wx);   // through the wall
+    CHECK(world.wall_crushed(wx, y0 + 3));
+}
