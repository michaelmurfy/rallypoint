+const std::vector<std::uint8_t>& World::crush_grid_omni() const {
+    static std::vector<std::uint8_t> cache;   // derived per call, like crush_grid_ (not a World member: nothing to save)
+    cache = passable_;
+    const std::size_t n = std::min(cache.size(), crush_wall_.size());
+    for (std::size_t i = 0; i < n; ++i)
+        if (crush_wall_[i] == 1 || crush_wall_[i] == 3) cache[i] = 1;
+    return cache;
+}
+
+const std::vector<std::uint8_t>* World::crush_leak_omni() const {
+    const std::vector<std::uint8_t>* l = wall_leak();
+    if (!l) return nullptr;
+    static std::vector<std::uint8_t> cache;
+    cache = *l;
+    const std::size_t n = std::min(cache.size(), crush_wall_.size());
+    for (std::size_t i = 0; i < n; ++i)
+        if (crush_wall_[i] == 1 || crush_wall_[i] == 3) cache[i] = 0;
+    return &cache;
+}
