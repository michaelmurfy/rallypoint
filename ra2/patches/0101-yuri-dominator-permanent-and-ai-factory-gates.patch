@@ -5540,11 +5540,27 @@ void World::step_ai_teams(double dt) {
         // 2) Factory-lost cancel for the unit queues (the queues themselves
         //    already TICKED inside step_ai_houses's ai_econ(rec).queues.tick — no new
         //    production code) [RE: ai-team.md §6].
+        //    Ships and fixed-wing aircraft share QueueCat::Vehicle with land
+        //    vehicles (see ai_launch_unit_ready), so resolve the factory list
+        //    from the unit type itself rather than always tc.veh_factory_types.
+        std::vector<int> air_ft;
+        for (int bt = 0; bt < (int)an_.airfield_btype.size(); ++bt)
+            if (an_.airfield_btype[(std::size_t)bt]) air_ft.push_back(bt);
+        auto unit_ft = [&](int ut) -> const std::vector<int>& {
+            if (ut >= 0 && ut < (int)tc.unit_roster.size()) {
