+TEST_CASE("psychic dominator: retail default permanently captures the 3x3 spiral and frees a prior MC link") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.dominator_damage = 0;   // stock range=1, anim_frames=90, fire_percent=20 (frame 18), hold_frames=0 (permanent)
+    w.set_sw_params(p);
+    UnitCombat psi = mk_inf("YURI");
+    psi.w7.mind_control = true;
+    psi.w7.mc_capacity = 1;
+    w.add_combat_unit(15, 15, 1, psi);                    // index 0: enemy controller
+    w.add_combat_unit(11, 11, 0, mk_inf("E1"));           // index 1: diagonal corner (11,11) of (10,10), captured by enemy psi
+    w.add_combat_unit(10, 10, 1, mk_inf("E1"));           // index 2: centre cell
+    REQUIRE(w.mc_capture(0, 1));
+    REQUIRE(w.units()[1].house == 1);
+    REQUIRE(w.units()[1].w7.mc_controller == 0);
+    arm_sw(w, 0, SuperweaponType::PsychicDominator);
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::PsychicDominator, 10, 10));
+    run(w, 20);   // fires at frame 18 (20% of 90)
+    CHECK(w.units()[1].house == 0);
+    CHECK(w.units()[1].w7.mc_controller == -1);           // prior MC link freed (FUN_00471ff0)
+    CHECK(w.units()[0].w7.mc_victims.empty());
+    CHECK(w.units()[2].house == 0);
+    run(w, 600);                                          // permanent: never reverts
+    CHECK(w.units()[1].house == 0);
+    CHECK(w.units()[2].house == 0);
+}
