+TEST_CASE("immune buildings take no damage (CABHUT Immune=)") {
+    ra2assets::MapFile map;
+    World w(map);
+    BuildingTypeDef hut;
+    hut.id = "CABHUT";
+    hut.strength = 500;
+    hut.immune = true;
+    BuildingTypeDef pill;
+    pill.id = "GAPILL";
+    pill.strength = 400;
+    w.set_building_types({hut, pill});
+    const int hut_b = w.add_building(0, 2, 2, 1, 1, 1, 500, 0, 0.0, true);
+    const int pill_b = w.add_building(1, 6, 6, 1, 1, 1, 400, 0, 0.0, true);
+    REQUIRE(hut_b == 0);
+    REQUIRE(pill_b == 1);
+
+    // Ability path (Ivan / death-weapon blasts route through it).
+    w.campaign_damage_building(hut_b, 500);
+    CHECK(w.buildings()[0].hp == 500);
+    CHECK(w.buildings()[0].alive);
+    w.campaign_damage_building(pill_b, 100);
+    CHECK(w.buildings()[1].hp == 300);
+
+    // Live direct fire: an enemy tank ordered onto the hut shoots it every
+    // ROF tick but never scratches it (force-fire stays allowed, as retail).
+    UnitCombat tank;
+    tank.strength = 400;
+    tank.damage = 90;
+    tank.rof = 15;
+    tank.range = 5.0;
+    tank.verses = {100, 100, 100, 100, 100, 100, 100, 100, 100, 100, 100};
+    w.add_combat_unit(2, 3, 0, tank);
+    w.order_unit_attack_building(0, hut_b);
+    for (int f = 0; f < 120; ++f) w.step(1.0 / 15.0);
+    CHECK(w.buildings()[0].hp == 500);
+    CHECK(w.buildings()[0].alive);
+    bool fired = false;
+    for (const auto& ev : w.take_fire_events()) fired = fired || ev.target_building == hut_b;
+    CHECK(fired);   // the gun spoke; the hut ignored it
+}
