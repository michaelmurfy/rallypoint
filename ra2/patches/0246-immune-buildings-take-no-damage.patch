+bool World::building_immune(int b_idx) const {
+    if (b_idx < 0 || b_idx >= static_cast<int>(buildings_.size())) return false;
+    const Building& b = buildings_[static_cast<std::size_t>(b_idx)];
+    if (b.type < 0 || b.type >= static_cast<int>(btypes().size())) return false;
+    return btypes()[static_cast<std::size_t>(b.type)].immune;
+}
