+
+// REAL rulesmd.ini: the pool a skirmish draws its starting force from
+// (FUN_006880F0). [DeathDummy] has no Owner= and no TechLevel (so 0) and only a
+// Primary=, but passed every filter, so about half of each house's start force
+// was invisible dummy vehicles blocking the base (harvesters sealed in behind
+// them, units that could not leave).
+#include "asset_fixture.hpp"
+TEST_CASE("country: real rules, the start pool holds only types a country owns (no DeathDummy)") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: no install under RA2_INSTALL_DIR"); return; }
+    const ra2assets::Rules& rules = ra2fixture::rulesmd();
+    const ra2assets::Ini& ini = ra2fixture::rulesmd_ini();
+    const char* kCountries[] = {"Americans", "Alliance", "French", "Germans", "British",
+                                "Africans", "Arabs", "Confederation", "Russians", "YuriCountry"};
+    for (const char* cn : kCountries) {
+        CHECK(c::country_allows(rules, "DEATHDUMMY", cn));          // the old filter let it in
+        CHECK_FALSE(c::start_pool_allows(rules, "DEATHDUMMY", cn));  // the start pool does not
+        int pool = 0;
+        std::string names;
+        for (const char* list : {"VehicleTypes", "InfantryTypes"})
+            for (const auto& kv : ini.section(list)) {
+                std::string id = kv.second;
+                for (char& ch : id) ch = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+                if (id.empty() || !ini.has(id)) continue;
+                if (!rules.section_flag(id, "AllowedToStartInMultiplayer", true)) continue;
+                if (rules.tech_level(id) > 10 || rules.tech_level(id) < 0) continue;
+                if (!c::start_pool_allows(rules, id, cn)) continue;
+                ++pool;
+                names += id + " ";
+                CAPTURE(id);
+                CHECK(rules.strength(id) > 0);
+                CHECK(rules.cost(id) > 0);
+            }
+        std::cout << "[start pool] " << cn << ": " << names << "\n";
+        CAPTURE(cn);
+        CHECK(pool >= 3);
+    }
+}
