@@ -92,3 +92,19 @@ TEST_CASE("radar map: real maps in the real radar box click back onto the cell t
         radar_roundtrip(n, map, 336, 220);
     }
 }
+
+TEST_CASE("radar click: left orders a selection, right only centres, offline radar is inert") {
+    using ra2engine::RadarClickAction;
+    using ra2engine::radar_click_action;
+    // left: order with units or an armed mode, centre with nothing, inert when the radar is off
+    CHECK(radar_click_action(false, false, true, true) == RadarClickAction::Order);
+    CHECK(radar_click_action(false, true, true, false) == RadarClickAction::Order);
+    CHECK(radar_click_action(false, false, true, false) == RadarClickAction::Centre);
+    CHECK(radar_click_action(false, false, false, true) == RadarClickAction::Inert);
+    // right: never an order, whatever is selected; cancels an armed mode; inert when the radar is off
+    for (bool have : {false, true}) {
+        CHECK(radar_click_action(true, false, true, have) == RadarClickAction::Centre);
+        CHECK(radar_click_action(true, true, true, have) == RadarClickAction::Cancel);
+        CHECK(radar_click_action(true, false, false, have) == RadarClickAction::Inert);
+    }
+}
