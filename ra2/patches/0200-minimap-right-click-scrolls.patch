diff --git a/engine/radar_map.hpp b/engine/radar_map.hpp
index b5137a1..31126ca 100644
--- a/engine/radar_map.hpp
+++ b/engine/radar_map.hpp
@@ -28,4 +28,14 @@ struct RadarMap {
     }
 };
 
+// What a mouse press on the sidebar radar does [RE: RadarClass::Action 0x006539D0, via vera20k's reading:
+// left starts the context order or, with nothing to order, centres the view; right only centres it].
+// An armed mode (superweapon, repair, sell, placement) takes a left click as on the map and a right click cancels it.
+enum class RadarClickAction { Inert, Order, Centre, Cancel };
+inline RadarClickAction radar_click_action(bool right, bool armed, bool radar_active, bool have_order_actor) {
+    if (right) return armed ? RadarClickAction::Cancel : (radar_active ? RadarClickAction::Centre : RadarClickAction::Inert);
+    if (!radar_active) return RadarClickAction::Inert;
+    return (armed || have_order_actor) ? RadarClickAction::Order : RadarClickAction::Centre;
+}
+
 }  // namespace ra2engine
