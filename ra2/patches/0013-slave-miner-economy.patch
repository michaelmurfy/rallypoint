+#pragma once
+// Yuri Slave Miner economy [rulesmd Enslaves= / ModEnc SlaveManager].
+ // Deployed YAREFN (BuildingTypes with Enslaves=) maintains SlavesNumber slaves
+ // of that infantry type. Slaves gather ore into their Storage and deliver it
+ // at the master; income lands in house_credits like a classic unload. Pure:
+ // no SDL/OS. Frame rates use 15 logic frames per engine second (gamespeed).
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "harvest.hpp"  // OreValues, kGulpSecs
+#include "occupancy.hpp"
+#include "ore.hpp"
+#include "world.hpp"
+
+namespace ra2engine {
+
+// [General] SlaveMiner*Scan defaults from rulesmd (Yuri's Revenge).
+constexpr int kSlaveMinerSlaveScanDefault = 14;
+constexpr int kSlaveLogicFps = 15;  // frames per engine second
+
+struct SlaveSpawn {
+    int building = -1;
+    int gx = 0, gy = 0;
+    int house = 0;
+    int storage_bales = 4;
+};
+
+struct SlaveMove {
+    int unit = -1;
+    int gx = 0, gy = 0;
+};
+
+// Drop cell beside a master's foundation (scan order); falls back to south
+ // centre. Used for spawn and delivery approach.
+bool slave_pad_cell(const Building& b, const std::vector<std::uint8_t>& passable, int gw, int gh,
+                    const Occupancy& occ, int& out_x, int& out_y);
+
+// Liberate every slave of a dead/missing master: clear is_slave / slave state.
+ // If liberator_house >= 0, the slave joins that house (YR: killer's house).
+void liberate_orphaned_slaves(std::vector<Unit>& units, const std::vector<Building>& buildings,
+                              int liberator_house = -1);
+
+// Advance slave managers + slave gather AI by dt. Deterministic: ascending
+ // building then unit index. Emits Spawn/Move requests; the caller places
+ // units and paths (World::order_unit_move / add_slave).
+ // `slave_scan` = [General] SlaveMinerSlaveScan (cells).
+void step_slave_miners(std::vector<Unit>& units, std::vector<Building>& buildings,
+                       const std::vector<BuildingTypeDef>& types, OreField& ore,
+                       const std::vector<std::uint8_t>& passable, int gw, int gh, Occupancy& occ,
+                       double dt, const OreValues& values, double* house_credits, int n_houses,
+                       int slave_scan, std::vector<SlaveSpawn>& spawns,
+                       std::vector<SlaveMove>& moves);
+
+// Install slave fields on a freshly spawned unit (tests / World).
+inline void make_slave(Unit& u, int master_building, int storage_bales) {
+    u.is_slave = true;
+    u.slave_master = master_building;
+    u.slave = SlaveState::SeekOre;
+    u.storage_bales = storage_bales > 0 ? storage_bales : 4;
+    u.bales_ore = 0.0;
+    u.bales_gems = 0.0;
+    u.harv_timer = kRescanSecs;  // seek on the next step
+    u.is_harvester = false;
+    u.manual_hold = false;
+}
+
+}  // namespace ra2engine
