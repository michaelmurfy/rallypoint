+// What the last draw_terrain call put on screen: each tile's diamond (x, y, w, h)
+// and, when it has one, the cliff/slope image (ex, ey, ew, eh; `extra` is its
+// SDL_Texture*). The shroud pass uses it to find the real edge of the lit ground.
+struct TerrainFoot {
+    int x = 0, y = 0, w = 0, h = 0;
+    int ex = 0, ey = 0, ew = 0, eh = 0;
+    void* extra = nullptr;
+};
+const std::vector<TerrainFoot>& terrain_footprint();
