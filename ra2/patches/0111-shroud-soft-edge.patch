+// Fully covered cell: extend the solid diamond by 1 px, then fade its edge over
+// 9 px. `alpha` is the cover opacity.
+inline SDL_Texture* feathered_diamond_tex(ra2engine::TextureCache& tc, int alpha) {
+    char key[32];
+    std::snprintf(key, sizeof key, "shroud:feather%d", alpha);
+    SDL_Texture* tex = static_cast<SDL_Texture*>(tc.peek(key));
+    if (tex) return tex;
+    constexpr int kGrow = 9, kW = 112, kH = 56;
+    std::vector<uint8_t> rgba(static_cast<std::size_t>(kW) * kH * 4, 0);
+    for (int y = 0; y < kH; ++y)
+        for (int x = 0; x < kW; ++x) {
+            const double dx = std::abs(x + 0.5 - kW / 2.0), dy = std::abs(y + 0.5 - kH / 2.0);
+            const double outside = (dx / 30.0 + dy / 15.0 - 1.0) * 13.4 - 1.0;
+            const double a = outside <= 0.0 ? 1.0 : 1.0 - outside / kGrow;
+            if (a > 0.0) rgba[(static_cast<std::size_t>(y) * kW + x) * 4 + 3] = static_cast<uint8_t>(a * alpha + 0.5);
+        }
+    return static_cast<SDL_Texture*>(tc.get_rgba(key, rgba.data(), kW, kH));
+}
