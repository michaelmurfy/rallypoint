+// Soften hard edges left by raised cells or cliffs. Blur the drawn terrain
+// footprint as a void mask, then use it to darken the frame.
+inline void draw_lit_outline(SDL_Renderer* ren, const ra2engine::Camera& cam, int W, int H) {
+    (void)cam;
+    constexpr int kQ = 8;
+    const int qw = (W + kQ - 1) / kQ, qh = (H + kQ - 1) / kQ;
+    const std::vector<ra2engine::TerrainFoot>& feet = ra2engine::terrain_footprint();
+    if (qw <= 0 || qh <= 0 || feet.empty()) return;
+    // main() owns one process-lifetime renderer shared by every scene.
+    static SDL_Texture* mask = nullptr;
+    static SDL_Texture* blur = nullptr;
+    static SDL_Renderer* rt_ren = nullptr;
+    static int rt_w = 0, rt_h = 0;
+    static int blend_ok = -1;
+    static SDL_BlendMode b_cut = SDL_BLENDMODE_INVALID, b_dark = SDL_BLENDMODE_INVALID;
+    const bool new_renderer = rt_ren != ren;
+    const bool resize = rt_w != qw || rt_h != qh;
+    if (!new_renderer && blend_ok == 0) return;
+    if (new_renderer || resize || !mask || !blur) {
+        // A different renderer owns and frees its old textures. On this engine
+        // path the shared renderer does not change before process exit.
+        if (!new_renderer) {
+            if (mask) SDL_DestroyTexture(mask);
+            if (blur) SDL_DestroyTexture(blur);
+        }
+        mask = blur = nullptr;
+        SDL_Texture* new_mask = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_TARGET, qw, qh);
+        SDL_Texture* new_blur = SDL_CreateTexture(ren, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_TARGET, qw, qh);
+        if (!new_mask || !new_blur) {
+            if (new_mask) SDL_DestroyTexture(new_mask);
+            if (new_blur) SDL_DestroyTexture(new_blur);
+            return;
+        }
+        SDL_SetTextureScaleMode(new_mask, SDL_ScaleModeLinear);
+        SDL_SetTextureScaleMode(new_blur, SDL_ScaleModeLinear);
+        if (new_renderer) {
+            // cut: dst *= 1 - src.a. dark: dst.rgb *= 1 - src.rgb.
+            b_cut = SDL_ComposeCustomBlendMode(
+                SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA, SDL_BLENDOPERATION_ADD,
+                SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE_MINUS_SRC_ALPHA, SDL_BLENDOPERATION_ADD);
+            b_dark = SDL_ComposeCustomBlendMode(
+                SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE_MINUS_SRC_COLOR, SDL_BLENDOPERATION_ADD,
+                SDL_BLENDFACTOR_ZERO, SDL_BLENDFACTOR_ONE, SDL_BLENDOPERATION_ADD);
+        }
+        const bool modes_ok = SDL_SetTextureBlendMode(new_mask, b_cut) == 0 &&
+                              SDL_SetTextureBlendMode(new_blur, b_dark) == 0;
+        if (!modes_ok) {
+            SDL_DestroyTexture(new_mask);
+            SDL_DestroyTexture(new_blur);
+            blend_ok = 0;
+            rt_ren = ren;
+            return;
+        }
+        mask = new_mask;
+        blur = new_blur;
+        rt_ren = ren;
+        rt_w = qw;
+        rt_h = qh;
+        blend_ok = 1;
+    }
+    if (blend_ok != 1) return;
+    SDL_Texture* prev = SDL_GetRenderTarget(ren);
+    SDL_BlendMode prev_draw_blend = SDL_BLENDMODE_NONE;
+    Uint8 prev_r = 0, prev_g = 0, prev_b = 0, prev_a = 0;
+    SDL_GetRenderDrawBlendMode(ren, &prev_draw_blend);
+    SDL_GetRenderDrawColor(ren, &prev_r, &prev_g, &prev_b, &prev_a);
+    if (SDL_SetRenderTarget(ren, mask) != 0) return;
+    SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_NONE);
+    SDL_SetRenderDrawColor(ren, 255, 255, 255, 255);
+    SDL_RenderClear(ren);
+    const SDL_Color black{0, 0, 0, 255};
+    const float q = 1.0f / kQ;
+    std::vector<SDL_Vertex> v;
+    std::vector<int> idx;
+    for (const ra2engine::TerrainFoot& f : feet) {
+        // The diamond, a pixel wider so neighbours never leave a seam at this size.
+        const float x0 = static_cast<float>(f.x), y0 = static_cast<float>(f.y);
+        const float hw = f.w * 0.5f, hh = f.h * 0.5f;
+        const int b0 = static_cast<int>(v.size());
+        v.push_back({{(x0 + hw) * q, (y0 - 1) * q}, black, {0, 0}});
+        v.push_back({{(x0 + f.w + 1) * q, (y0 + hh) * q}, black, {0, 0}});
+        v.push_back({{(x0 + hw) * q, (y0 + f.h + 1) * q}, black, {0, 0}});
+        v.push_back({{(x0 - 1) * q, (y0 + hh) * q}, black, {0, 0}});
+        for (int k : {0, 1, 2, 0, 2, 3}) idx.push_back(b0 + k);
+    }
+    if (!v.empty())
+        SDL_RenderGeometry(ren, nullptr, v.data(), static_cast<int>(v.size()), idx.data(), static_cast<int>(idx.size()));
+    // Include cliff and slope art using its alpha silhouette.
+    for (const ra2engine::TerrainFoot& f : feet) {
+        if (!f.extra) continue;
+        SDL_Texture* et = static_cast<SDL_Texture*>(f.extra);
+        SDL_BlendMode keep_blend = SDL_BLENDMODE_BLEND;
+        SDL_ScaleMode keep_scale = SDL_ScaleModeNearest;
+        SDL_GetTextureBlendMode(et, &keep_blend);
+        SDL_GetTextureScaleMode(et, &keep_scale);
+        SDL_SetTextureBlendMode(et, b_cut);
+        SDL_SetTextureScaleMode(et, SDL_ScaleModeLinear);
+        const SDL_FRect to{f.ex * q, f.ey * q, f.ew * q, f.eh * q};
+        SDL_RenderCopyF(ren, et, nullptr, &to);
+        SDL_SetTextureScaleMode(et, keep_scale);
+        SDL_SetTextureBlendMode(et, keep_blend);
+    }
+    const bool blurred = SDL_SetRenderTarget(ren, blur) == 0;
+    if (blurred) {
+        SDL_SetRenderDrawBlendMode(ren, SDL_BLENDMODE_NONE);
+        SDL_SetRenderDrawColor(ren, 0, 0, 0, 255);
+        SDL_RenderClear(ren);
+        SDL_SetTextureBlendMode(mask, SDL_BLENDMODE_BLEND);
+        static const int kTap[5][2] = {{0, 0}, {1, 0}, {-1, 0}, {0, 1}, {0, -1}};
+        for (int i = 0; i < 5; ++i) {
+            SDL_SetTextureAlphaMod(mask, static_cast<Uint8>(255 / (i + 1)));
+            const SDL_Rect to{kTap[i][0], kTap[i][1], qw, qh};
+            SDL_RenderCopy(ren, mask, nullptr, &to);
+        }
+    }
+    SDL_SetTextureAlphaMod(mask, 255);
+    SDL_SetTextureBlendMode(mask, b_cut);
+    SDL_SetRenderTarget(ren, prev);
+    if (blurred) {
+        const SDL_Rect all{0, 0, W, H};
+        SDL_RenderCopy(ren, blur, nullptr, &all);
+    }
+    SDL_SetRenderDrawBlendMode(ren, prev_draw_blend);
+    SDL_SetRenderDrawColor(ren, prev_r, prev_g, prev_b, prev_a);
+}
