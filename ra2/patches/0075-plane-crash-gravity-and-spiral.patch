+
+TEST_CASE("w7airnav crash: a shot-down plane keeps flying forward, spirals and accelerates down") {
+    ra2assets::MapFile map;
+    if (!w7_map(map)) {
+        MESSAGE("skipped: real map assets not found under RA2_INSTALL_DIR");
+        return;
+    }
+    World w(map);
+    const ra2assets::MapCell* c = pick_start_cell(map);
+    REQUIRE(c != nullptr);
+    UnitCombat jet;
+    jet.strength = 100;
+    jet.image = "W7JET";
+    jet.is_aircraft = true;
+    jet.is_vehicle = true;
+    jet.verses = std::vector<int>(11, 0);
+    jet.an.fixed_wing = true;
+    jet.an.fly_speed_cps = 2.0;
+    w.register_an_type("W7JET", jet);
+    w.add_combat_unit(c->x, c->y, 0, jet);
+    Unit& u = w.units()[0];
+    u.altitude = 1000.0;
+    u.flight_state = FlightState::Cruising;
+    u.body_facing = 0.0;   // north
+    u.hp = 0;
+    u.die_time = 0.0;
+    const double x0 = u.fx, y0 = u.fy;
+    double prev_alt = u.altitude, prev_drop = 0.0;
+    int frames = 0;
+    for (; frames < 200 && w.units()[0].altitude > 0.0; ++frames) {
+        w.step(1.0 / 15.0);
+        const Unit& v = w.units()[0];
+        const double drop = prev_alt - v.altitude;
+        if (frames > 0 && v.altitude > 0.0) CHECK(drop > prev_drop);   // gravity: each frame drops more
+        prev_drop = drop;
+        prev_alt = v.altitude;
+        if (frames == 3) CHECK(v.an.crashing);
+    }
+    CHECK(frames > 15);   // not a one-second plunge
+    CHECK(frames < 200);
+    const Unit& v = w.units()[0];
+    CHECK(std::hypot(v.fx - x0, v.fy - y0) > 1.0);   // travelled on, not straight down
+}
