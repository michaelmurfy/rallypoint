+// Output / logical scale for crisp bitmap-font sizing (HiDPI letterboxing).
+inline int hud_present_scale(SDL_Renderer* ren) {
+    int ow = 0, oh = 0, lw = 0, lh = 0;
+    if (SDL_GetRendererOutputSize(ren, &ow, &oh) != 0 || ow <= 0 || oh <= 0) return 1;
+    SDL_RenderGetLogicalSize(ren, &lw, &lh);   // void in SDL2
+    if (lw <= 0 || lh <= 0) {
+        lw = 1280;
+        lh = 720;
+    }
+    const double s = std::min(ow / static_cast<double>(lw), oh / static_cast<double>(lh));
+    return std::max(1, static_cast<int>(std::lround(s)));
+}
