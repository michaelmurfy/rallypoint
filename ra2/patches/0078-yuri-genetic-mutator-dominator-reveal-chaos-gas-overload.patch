diff --git a/rp-beta5/ra2/engine/tests/test_yuri_specials.cpp b/tests/test_yuri_specials.cpp
new file mode 100644
index 0000000..7e90e9a
--- /dev/null
+++ b/tests/test_yuri_specials.cpp
@@ -0,0 +1,201 @@
+// Yuri's specials on the World: Genetic Mutator, Psychic Dominator, Psychic Reveal
+// (superweapons, world_yuri.cpp), Master Mind overload (world_mind_control.cpp),
+// Chaos gas confusion. Synthetic types and an empty map: no game data needed.
+#include "doctest.h"
+
+#include "combat.hpp"
+#include "world.hpp"
+
+using namespace ra2engine;
+
+namespace {
+
+UnitCombat mk_inf(const char* image, const char* armor = "none") {
+    UnitCombat c;
+    c.image = image;
+    c.strength = 100;
+    c.armor = armor;
+    c.damage = 10;
+    c.rof = 15;
+    c.range = 5.0;
+    c.verses = std::vector<int>(11, 100);
+    c.is_infantry = true;
+    return c;
+}
+
+// The rules' Mutate verses: none / flak / plate only.
+std::array<int, 11> inf_only() {
+    std::array<int, 11> a{};
+    a[0] = a[1] = a[2] = 100;
+    return a;
+}
+
+void run(World& w, int frames) {
+    for (int i = 0; i < frames; ++i) w.step(1.0 / 15.0);
+}
+
+void arm_sw(World& w, int house, SuperweaponType t) {
+    w.grant_superweapon_type(house, t, /*recharge_secs=*/0.5, /*is_powered=*/false, 0, 0.0, 1.0, {});
+    for (int i = 0; i < 15 && !w.sw_ready(house, t); ++i) w.step(1.0 / 15.0);
+    REQUIRE(w.sw_ready(house, t));
+}
+
+}  // namespace
+
+TEST_CASE("genetic mutator: infantry become Brutes, vehicles and psi-immune infantry stay") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.mutate_verses = inf_only();
+    p.mutate_spread = 5.0;
+    p.mutate_delay_frames = 4;
+    w.set_sw_params(p);
+    w.register_an_type("BRUTE", mk_inf("BRUTE", "plate"));
+    w.add_combat_unit(10, 10, 1, mk_inf("E1"));
+    UnitCombat tank = mk_inf("MTNK", "heavy");
+    tank.is_vehicle = true;
+    w.add_combat_unit(11, 10, 1, tank);
+    UnitCombat yuri = mk_inf("YURI");
+    yuri.tg.immune_psionics = true;
+    w.add_combat_unit(12, 10, 1, yuri);
+    w.add_combat_unit(30, 30, 1, mk_inf("E2"));   // out of range
+    w.units()[0].hp = 50;
+    arm_sw(w, 0, SuperweaponType::GeneticConverter);
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::GeneticConverter, 10, 10));
+    CHECK_FALSE(w.sw_ready(0, SuperweaponType::GeneticConverter));
+    run(w, 8);
+    int brutes = 0;
+    for (const Unit& u : w.units())
+        if (u.alive && u.image == "BRUTE") {
+            ++brutes;
+            CHECK(u.house == 1);          // stays with its owner
+            CHECK(u.hp == 50);            // same health fraction (50/100 of a 100 HP Brute)
+        }
+    CHECK(brutes == 1);
+    CHECK_FALSE(w.units()[0].alive);      // the GI is replaced, not left behind
+    CHECK(w.units()[1].alive);            // tank untouched
+    CHECK(w.units()[1].image == "MTNK");
+    CHECK(w.units()[2].image == "YURI");  // ImmuneToPsionics
+    CHECK(w.units()[3].image == "E2");    // out of the explosion
+}
+
+TEST_CASE("psychic dominator: enemies in capture range change sides, then come back") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.dominator_capture_range = 2;
+    p.dominator_anim_frames = 20;
+    p.dominator_fire_percent = 50;   // fires at frame 10
+    p.dominator_hold_frames = 30;
+    p.dominator_damage = 0;
+    w.set_sw_params(p);
+    w.add_combat_unit(10, 10, 1, mk_inf("E1"));           // near: taken
+    UnitCombat dog = mk_inf("DOG");
+    dog.tg.immune_psionics = true;
+    w.add_combat_unit(11, 10, 1, dog);                    // ImmuneToPsionics: refused
+    w.add_combat_unit(20, 20, 1, mk_inf("E2"));           // far: untouched
+    w.add_combat_unit(10, 11, 0, mk_inf("E1"));           // the firer's own unit
+    arm_sw(w, 0, SuperweaponType::PsychicDominator);
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::PsychicDominator, 10, 10));
+    run(w, 5);
+    CHECK(w.units()[0].house == 1);   // not yet: the head is still coming down
+    run(w, 8);
+    CHECK(w.units()[0].house == 0);
+    CHECK(w.units()[0].w7.mc_orig_house == 1);
+    CHECK(w.units()[1].house == 1);
+    CHECK(w.units()[2].house == 1);
+    CHECK(w.units()[3].house == 0);
+    run(w, 40);
+    CHECK(w.units()[0].house == 1);   // released
+    CHECK(w.units()[0].w7.mc_orig_house == -1);
+}
+
+TEST_CASE("psychic dominator: a victim killed meanwhile is not resurrected into the firer's house") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.dominator_capture_range = 2;
+    p.dominator_anim_frames = 10;
+    p.dominator_fire_percent = 10;
+    p.dominator_hold_frames = 20;
+    p.dominator_damage = 0;
+    w.set_sw_params(p);
+    w.add_combat_unit(10, 10, 1, mk_inf("E1"));
+    arm_sw(w, 0, SuperweaponType::PsychicDominator);
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::PsychicDominator, 10, 10));
+    run(w, 3);
+    REQUIRE(w.units()[0].house == 0);
+    w.units()[0].alive = false;
+    run(w, 30);   // release must not touch a dead unit
+    CHECK_FALSE(w.units()[0].alive);
+}
+
+TEST_CASE("psychic reveal: reveals around the target without a strike") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    arm_sw(w, 0, SuperweaponType::PsychicReveal);
+    CHECK(w.fire_superweapon_at(0, SuperweaponType::PsychicReveal, 5, 5));
+    CHECK_FALSE(w.sw_ready(0, SuperweaponType::PsychicReveal));
+}
+
+TEST_CASE("master mind overload: damage grows with the number of victims") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.overload_count = {3, 6};
+    p.overload_damage = {0, 20};
+    p.overload_frames = {30, 10};
+    w.set_sw_params(p);
+    UnitCombat mm = mk_inf("MIND", "heavy");
+    mm.strength = 1000;
+    mm.is_vehicle = true;
+    mm.w7.mind_control = true;
+    mm.w7.mc_capacity = 3;
+    mm.w7.mc_infinite = true;
+    w.add_combat_unit(10, 10, 0, mm);
+    for (int i = 0; i < 5; ++i) w.add_combat_unit(12 + i, 10, 1, mk_inf("E1"));
+    for (int i = 0; i < 3; ++i) REQUIRE(w.mc_capture(0, 1 + i));
+    for (int i = 0; i < 20; ++i) w.step_mind_control();   // 3 victims: free
+    CHECK(w.units()[0].hp == 1000);
+    REQUIRE(w.mc_capture(0, 4));
+    REQUIRE(w.mc_capture(0, 5));   // infinite: beyond its pips
+    CHECK(w.units()[0].w7.mc_victims.size() == 5);
+    const int hp0 = w.units()[0].hp;
+    for (int i = 0; i < 50; ++i) {
+        w.step(1.0 / 15.0);
+        if (w.units()[0].hp < hp0) break;
+    }
+    CHECK(w.units()[0].hp < hp0);   // 4..6 victims: the second row hurts it
+}
+
+TEST_CASE("chaos gas: a confused unit takes its own side for an enemy; others are left alone") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    SwParams p;
+    p.psychedelic_frames = 100;
+    w.set_sw_params(p);
+    UnitCombat drone = mk_inf("CAOS", "light");
+    drone.w7.psychedelic = true;
+    drone.is_vehicle = true;
+    drone.cell_spread = 3.0;
+    w.add_combat_unit(10, 10, 1, drone);
+    w.add_combat_unit(11, 10, 0, mk_inf("E1"));   // in the cloud
+    w.add_combat_unit(12, 10, 0, mk_inf("E1"));
+    w.units()[0].w_cell_spread = 3.0;
+    w.units()[0].w_verses = std::vector<int>(11, 100);
+    w.add_combat_unit(25, 25, 0, mk_inf("E1"));   // far away (index 3)
+    w.units()[0].w7.psy_shot = 1;
+    w.step_psychedelic();
+    CHECK(w.unit_confused(w.units()[1]));
+    CHECK(w.unit_confused(w.units()[2]));
+    CHECK_FALSE(w.unit_confused(w.units()[3]));   // out of the cloud
+    CHECK_FALSE(w.unit_confused(w.units()[0]));   // the drone itself
+    // A confused unit's own side is fair game: everything is house 0 and unit 1 picks a target.
+    w.units()[0].house = 0;
+    w.step(1.0 / 15.0);
+    CHECK(w.units()[1].target >= 0);
+    CHECK(w.units()[1].house == w.units()[w.units()[1].target].house);
+    CHECK(w.units()[3].target < 0);   // a sane unit has nobody to shoot
+    run(w, 120);
+    CHECK_FALSE(w.unit_confused(w.units()[1]));   // wears off
+}
