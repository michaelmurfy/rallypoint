diff --git a/rp-beta5/ra2/engine/engine/world_yuri.cpp b/engine/world_yuri.cpp
new file mode 100644
index 0000000..b0583b0
--- /dev/null
+++ b/engine/world_yuri.cpp
@@ -0,0 +1,128 @@
+// Yuri's specials that act on the World: Chaos gas confusion (Psychedelic=yes
+// warhead), the Genetic Mutator and Psychic Dominator superweapons (SwStrike
+// kinds 4 and 3), and Psychic Reveal. Mind control lives in
+// world_mind_control.cpp, Grinder / Bio Reactor in world_grinder_bio.cpp.
+// Everything is saved: the Dominator's victims ride in SwStrike::recent, the
+// confusion in UnitW7::confused_until, so no state is lost across a save.
+#include <algorithm>
+#include <cmath>
+
+#include "orig_math.hpp"
+#include "world.hpp"
+
+namespace ra2engine {
+
+namespace {
+constexpr double kLept = 256.0;
+}
+
+void World::confuse_unit(int idx, int frames) {
+    if (idx < 0 || idx >= static_cast<int>(units_.size()) || frames <= 0) return;
+    Unit& u = units_[static_cast<std::size_t>(idx)];
+    if (!u.alive || u.die_time >= 0.0) return;
+    u.w7.confused_until = static_cast<std::int64_t>(repair_frame_) + frames;
+    u.target = -1;            // pick a fresh victim, friend or foe
+    u.attack_order = false;
+}
+
+// Chaos gas: every unit within round(CellSpread) cells of the shot, whose armor
+// the warhead's Verses reach, goes mad for psychedelic_frames. The shooter
+// itself is left alone; the gas does no damage.
+void World::step_psychedelic() {
+    for (std::size_t i = 0; i < units_.size(); ++i) {
+        Unit& u = units_[i];
+        const int vi = u.w7.psy_shot;
+        if (vi < 0) continue;
+        u.w7.psy_shot = -1;
+        if (vi >= static_cast<int>(units_.size()) || !u.alive || u.die_time >= 0.0) continue;
+        const double cx = units_[static_cast<std::size_t>(vi)].fx, cy = units_[static_cast<std::size_t>(vi)].fy;
+        const double radius = std::max(0.5, std::round(u.w_cell_spread)) * kLept;
+        for (int j = 0; j < static_cast<int>(units_.size()); ++j) {
+            if (j == static_cast<int>(i)) continue;
+            const Unit& w = units_[static_cast<std::size_t>(j)];
+            if (!w.alive || w.die_time >= 0.0 || w.cargo_of >= 0) continue;
+            if (w.armor_ix < 0 || w.armor_ix >= static_cast<int>(u.w_verses.size()) ||
+                u.w_verses[static_cast<std::size_t>(w.armor_ix)] <= 0)
+                continue;
+            if (om::hypot((w.fx - cx) * kLept, (w.fy - cy) * kLept) > radius) continue;
+            confuse_unit(j, an_.sw.psychedelic_frames);
+        }
+    }
+}
+
+// ---- Genetic Mutator: infantry the MutateExplosion warhead reaches become the
+// mutant type (Brute) in the same house, same cell, same health fraction;
+// ImmuneToPsionics infantry (Yuri, Brutes) and everything that is not infantry
+// are left alone.
+void World::an_mutate_detonate(const SwStrike& s) {
+    const SwParams& P = an_.sw;
+    if (!an_.types.count(P.mutant_type)) return;
+    const double radius = std::max(0.5, std::round(P.mutate_spread)) * kLept;
+    const int n = static_cast<int>(units_.size());
+    for (int j = 0; j < n; ++j) {
+        const Unit& w = units_[static_cast<std::size_t>(j)];
+        if (!w.alive || w.die_time >= 0.0 || w.cargo_of >= 0 || w.is_vehicle || w.is_aircraft || w.is_naval)
+            continue;
+        if (w.tg.t.immune_psionics || w.image == an_.types[P.mutant_type].image) continue;
+        if (w.armor_ix < 0 || w.armor_ix >= static_cast<int>(P.mutate_verses.size()) ||
+            P.mutate_verses[static_cast<std::size_t>(w.armor_ix)] <= 0)
+            continue;
+        if (om::hypot((w.fx - s.x) * kLept, (w.fy - s.y) * kLept) > radius) continue;
+        const int house = w.house, cx = w.cell_x, cy = w.cell_y, facing = w.facing;
+        const double fx = w.fx, fy = w.fy;
+        const double frac = w.max_hp > 0 ? static_cast<double>(w.hp) / w.max_hp : 1.0;
+        occ_.release_all_of(j, -1, -1);
+        Unit& old = units_[static_cast<std::size_t>(j)];
+        old.alive = false;   // replaced, not killed: no corpse, no kill credit
+        old.target = -1;
+        old.target_building = -1;
+        old.path.clear();
+        old.path_idx = 0;
+        const int ni = an_spawn(P.mutant_type, house, cx, cy);
+        if (ni < 0) continue;
+        Unit& b = units_[static_cast<std::size_t>(ni)];
+        b.facing = facing;
+        b.fx = fx;
+        b.fy = fy;
+        b.hp = std::max(1, om::ftol(frac * b.max_hp));
+    }
+}
+
+// ---- Psychic Dominator: at fire_percent of the head animation the warhead
+// damages (buildings: Verses 0 on every unit armor) and every non-allied unit
+// within DominatorCaptureRange that can be mind controlled changes sides; they
+// go back dominator_hold_frames later. Victims live in s.recent.
+void World::an_dominator_fire(SwStrike& s) {
+    const SwParams& P = an_.sw;
+    an_area_damage(s.house, s.x, s.y, P.dominator_damage, P.dominator_spread, P.dominator_pmax,
+                   P.dominator_verses, /*hit_air=*/false, /*spare_house=*/false, 0.0, 0, -1);
+    const double radius = std::max(0.5, static_cast<double>(P.dominator_capture_range)) * kLept;
+    for (int j = 0; j < static_cast<int>(units_.size()); ++j) {
+        const Unit& v = units_[static_cast<std::size_t>(j)];
+        if (!v.alive || v.die_time >= 0.0 || v.cargo_of >= 0 || v.garrison_of >= 0 || v.is_aircraft) continue;
+        if (v.house == s.house || !is_enemy(s.house, v.house)) continue;
+        if (!psionic_target_ok(j) || v.an.iron_left_frames > 0.0 || v.w7.mc_controller >= 0 ||
+            v.w7.mc_orig_house >= 0)
+            continue;
+        if (om::hypot((v.fx - s.x) * kLept, (v.fy - s.y) * kLept) > radius) continue;
+        units_[static_cast<std::size_t>(j)].w7.mc_orig_house = v.house;
+        set_unit_owner(j, s.house);
+        units_[static_cast<std::size_t>(j)].target = -1;
+        units_[static_cast<std::size_t>(j)].attack_order = false;
+        s.recent.push_back(j);
+    }
+}
+
+void World::an_dominator_release(SwStrike& s) {
+    for (int j : s.recent) {
+        if (j < 0 || j >= static_cast<int>(units_.size())) continue;
+        Unit& v = units_[static_cast<std::size_t>(j)];
+        const int orig = v.w7.mc_orig_house;
+        v.w7.mc_orig_house = -1;
+        if (orig < 0 || !v.alive || v.die_time >= 0.0 || v.house != s.house) continue;
+        set_unit_owner(j, orig);
+    }
+    s.recent.clear();
+}
+
+}  // namespace ra2engine
