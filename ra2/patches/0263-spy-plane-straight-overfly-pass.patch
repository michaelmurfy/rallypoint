+namespace {
+
+// Retail SPYP (rulesmd [SPYP]): Speed=15, ROT=2, Ammo=100, Sight=0. The zero
+// sight isolates the camera: only SpyCameraWeapon snapshots reveal.
+UnitCombat spyp_like() {
+    UnitCombat c;
+    c.image = "SPYP";
+    c.strength = 400;
+    c.armor = "light";
+    c.is_aircraft = true;
+    c.is_vehicle = true;
+    c.verses = std::vector<int>(11, 100);
+    c.sight = 0;
+    c.an.fixed_wing = true;
+    c.an.ammo = 100;
+    c.an.fly_speed_cps = 2.25;               // Speed=15 -> 15*15/100 cells/sec
+    c.flight_turn = 2 * 256.0 * 15.0;        // ROT=2 (w2air_main.inc)
+    return c;
+}
+
+int count_dropped(const World& w) {
+    int n = 0;
+    for (const SwEvent& e : w.sw_events())
+        if (e.kind == SwEvent::Dropped) ++n;
+    return n;
+}
+
+}  // namespace
+
+TEST_CASE("superweapon: spy plane flies a straight overfly pass, then leaves with ammo spare") {
+    // [RE: FUN_004155F0/FUN_004157C0]: at 3 cells the plane latches its
+    // heading and flies straight to the far edge (never homing on the
+    // target: homing circled it until the ammo ran out, painting loops and
+    // missing the straight corridor). The pass clears a corridor along the
+    // target row and the plane is gone long before the ammo is spent.
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(64, 64);
+    World w(map);
+    w.enable_shroud(true);
+    w.register_an_type("SPYP", spyp_like());
+    w.grant_superweapon_type(0, SuperweaponType::SpyPlane, /*recharge_secs=*/0.5,
+                             /*is_powered=*/false);
+    for (int i = 0; i < 15 && !w.sw_ready(0, SuperweaponType::SpyPlane); ++i)
+        w.step(1.0 / 15.0);
+    REQUIRE(w.sw_ready(0, SuperweaponType::SpyPlane));
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::SpyPlane, 32, 32));
+    int plane = -1;
+    for (std::size_t i = 0; i < w.units().size(); ++i)
+        if (w.units()[i].image == "SPYP") plane = static_cast<int>(i);
+    REQUIRE(plane >= 0);
+    int gone_at = -1;
+    const int kCap = 1500;
+    for (int f = 0; f < kCap; ++f) {
+        w.step(1.0 / 15.0);
+        if (!w.units()[static_cast<std::size_t>(plane)].alive) { gone_at = f; break; }
+    }
+    REQUIRE(gone_at >= 0);   // the loaner left the map, not orbited forever
+    CHECK(gone_at < 1000);   // one pass (~450 frames), not 100 orbits (~2000)
+    const int ammo_left = w.units()[static_cast<std::size_t>(plane)].an.ammo;
+    CHECK(ammo_left > 0);    // retail leaves past the edge with shots to spare
+    CHECK(ammo_left < 100);  // ... after photographing the pass
+    CHECK(w.units()[static_cast<std::size_t>(plane)].deployed_away);  // gone, not destroyed
+    // The corridor follows the target row through the target ...
+    CHECK(w.explored_at(0, 32, 32));
+    CHECK(w.explored_at(0, 20, 32));
+    CHECK(w.explored_at(0, 50, 32));
+    // ... and stays narrow: well off the row nothing was cleared.
+    CHECK_FALSE(w.explored_at(0, 32, 44));
+    CHECK_FALSE(w.explored_at(0, 44, 44));
+    CHECK_FALSE(w.explored_at(0, 20, 44));
+}
+
+TEST_CASE("superweapon: spy overfly snapshots every 3rd frame, silently") {
+    // Approach plays SpyPlaneCamera= per shot (a Dropped event); Overfly
+    // snapshots without the sound (vera20k spyplane_mission: Approach plays
+    // SpyPlaneCamera=, Overfly "without the sound").
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    w.enable_shroud(true);
+    UnitCombat spy = spyp_like();
+    spy.an.ammo = 0;   // per-unit below
+    w.add_combat_unit(20, 20, 0, spy);
+    w.units()[0].fx = 20.0; w.units()[0].fy = 20.0;
+    w.units()[0].cell_x = 20; w.units()[0].cell_y = 20;
+    w.units()[0].an.sortie = 7;   // Approach, on top of the target
+    w.units()[0].an.drop_x = 20; w.units()[0].an.drop_y = 20;
+    w.units()[0].an.ammo = 3;
+    w.units()[0].an.para_timer = 0;
+    w.step(1.0 / 15.0);
+    CHECK(w.units()[0].an.ammo == 2);   // one Approach shot ...
+    CHECK(count_dropped(w) == 1);       // ... with its camera click
+    // Overfly, held on station inside Range=: a shot every 3rd frame, silent.
+    World w2(map);
+    w2.enable_shroud(true);
+    w2.add_combat_unit(20, 20, 0, spy);
+    w2.units()[0].fx = 20.0; w2.units()[0].fy = 20.0;
+    w2.units()[0].cell_x = 20; w2.units()[0].cell_y = 20;
+    w2.units()[0].an.sortie = 8;   // kSpyplaneOverfly
+    w2.units()[0].an.drop_x = 20; w2.units()[0].an.drop_y = 20;
+    w2.units()[0].an.exit_x = 39; w2.units()[0].an.exit_y = 20;
+    w2.units()[0].an.ammo = 3;
+    w2.units()[0].an.para_timer = 0;
+    for (int f = 0; f < 12; ++f) {
+        w2.step(1.0 / 15.0);
+        w2.units()[0].fx = 20.0; w2.units()[0].fy = 20.0;   // hold station
+        w2.units()[0].cell_x = 20; w2.units()[0].cell_y = 20;
+    }
+    CHECK(w2.units()[0].an.ammo == 0);   // shots on steps 1, 4, 7
+    CHECK(count_dropped(w2) == 0);       // ... none of them clicked
+}
