-// One SpyCameraWeapon "shot": reveal Damage= cells and spend one Ammo.
-// [RE: Approach/Overfly Fire path; SpyPlaneCameraFrames paces the Report=.]
-void World::an_spy_camera_shot(int plane) {
+// One SpyCameraWeapon "shot": reveal Damage= cells around the plane's own cell
+// and spend one Ammo. The plane flies straight through (Overfly freezes the
+// heading), so consecutive shots sweep the corridor; the sight radius is the
+// weapon's Damage=, the photo gate its Range=.
+// [RE: Approach/Overfly Fire path; SpyPlaneCameraFrames paces the Report= in
+// Approach, Mission_SpyplaneOverfly returns 3 past the target. Approach plays
+// SpyPlaneCamera= at the plane; Overfly snapshots are silent.]
+void World::an_spy_camera_shot(int plane, bool sound) {
     if (plane < 0 || plane >= static_cast<int>(units_.size())) return;
     Unit& u = units_[plane];
     if (!u.alive || u.die_time >= 0.0 || u.an.ammo <= 0) return;
     if (shroud_enabled()) reveal_source(u.house, u.cell_x, u.cell_y, an_.sw.spy_camera_reveal);
     --u.an.ammo;
+    if (!sound) return;
     // Presentation: reuse Dropped so the camera-click can be wired to
     // SpyPlaneCamera / SpyPlaneSnapshot without a new SwEvent kind.
     an_event(SwEvent::Dropped, u.house, SuperweaponType::SpyPlane, u.cell_x, u.cell_y);
