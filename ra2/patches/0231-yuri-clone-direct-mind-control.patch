+// Yuri mind control: a selected controller (primary warhead MindControl=)
+// treats a capturable neutral as an attack target WITHOUT the force-fire key
+// (civilians are never is_enemy, so the hostile branch never fires for them).
+TEST_CASE("Input: Yuri Clone targets a neutral car without force-fire") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    World::HouseRec neutral;
+    neutral.combatant = false;   // civilian traffic: never an enemy of anyone
+    world.set_house(2, neutral);
+
+    ra2engine::UnitCombat yuri = gi_combat();
+    yuri.image = "YURI";
+    yuri.w7.mind_control = true;
+    yuri.w7.mc_capacity = 1;
+    world.add_combat_unit(10, 10, 0, yuri);        // 0: controller
+    ra2engine::UnitCombat car = gi_combat();
+    car.image = "CIVC";
+    car.is_vehicle = true;
+    world.add_combat_unit(14, 10, 2, car);         // 1: neutral car
+    world.add_combat_unit(10, 14, 0, gi_combat());  // 2: plain GI
+    REQUIRE(world.units().size() == 3);
+
+    Camera cam;
+    Input input(world, cam, 1280, 720);
+    int yx, yy, cx, cy, gx, gy;
+    ground_px_for_unit(world.units()[0], yx, yy);
+    ground_px_for_unit(world.units()[1], cx, cy);
+    ground_px_for_unit(world.units()[2], gx, gy);
+
+    // The controller sees the Attack cursor on the neutral, with no key held...
+    input.selection().set(0);
+    CHECK(input.action_at(cx, cy) == Input::Action::Attack);
+
+    // ... and a plain left-click orders the capture (no force-fire).
+    left_click(input, cx, cy, false, 1000);
+    CHECK(input.take_actions().attack_ordered);
+    CHECK(world.units()[0].target == 1);
+
+    // A GI selected instead gets no privileged cursor on the neutral.
+    input.selection().clear();
+    input.selection().set(2);
+    CHECK(input.action_at(cx, cy) != Input::Action::Attack);
+
+    // Own units and psi-immune targets are never victims.
+    input.selection().clear();
+    input.selection().set(0);
+    CHECK(input.action_at(yx, yy) == Input::Action::Select);
+    world.units()[1].tg.t.immune_psionics = true;
+    CHECK(input.action_at(cx, cy) != Input::Action::Attack);
+    world.units()[1].tg.t.immune_psionics = false;
+    CHECK(input.action_at(cx, cy) == Input::Action::Attack);
+}
+
+TEST_CASE("Input: a full Max>1 controller shows no Attack cursor; Max==1 may swap") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    World::HouseRec neutral;
+    neutral.combatant = false;
+    world.set_house(2, neutral);
+
+    ra2engine::UnitCombat yuri = gi_combat();
+    yuri.image = "YURI";
+    yuri.w7.mind_control = true;
+    yuri.w7.mc_capacity = 2;
+    world.add_combat_unit(10, 10, 0, yuri);        // 0: controller
+    ra2engine::UnitCombat car = gi_combat();
+    car.image = "CIVC";
+    car.is_vehicle = true;
+    world.add_combat_unit(14, 10, 2, car);         // 1: neutral car
+    world.add_combat_unit(20, 10, 1, gi_combat());  // 2: enemy GI
+    world.add_combat_unit(22, 10, 1, gi_combat());  // 3: enemy GI
+    REQUIRE(world.units().size() == 4);
+
+    Camera cam;
+    Input input(world, cam, 1280, 720);
+    int cx, cy;
+    ground_px_for_unit(world.units()[1], cx, cy);
+    input.selection().set(0);
+
+    // Two victims at capacity 2: full, so no cursor...
+    world.units()[0].w7.mc_victims.push_back(2);
+    world.units()[0].w7.mc_victims.push_back(3);
+    CHECK(input.action_at(cx, cy) != Input::Action::Attack);
+    // ... one fewer: room again...
+    world.units()[0].w7.mc_victims.pop_back();
+    CHECK(input.action_at(cx, cy) == Input::Action::Attack);
+    // ... and a full Max==1 controller may always swap.
+    world.units()[0].w7.t.mc_capacity = 1;
+    CHECK(input.action_at(cx, cy) == Input::Action::Attack);
+}
