+// Yuri mind control (Yuri Clone, Yuri Prime, ...): the primary warhead's
+// MindControl= arms a CaptureManager (UnitTypeW7::mind_control), and the sim
+// captures any live non-own non-aircraft unit that is not immune, curtained
+// or already controlled. is_enemy() is false for the neutral house, so
+// civilian cars etc. never pass the hostile branch -- without this the player
+// must hold the force-fire key to order a capture. Mirrors World::mc_capture's
+// refusals (units the player commands, aircraft, boarded/carried, the sim's
+// ImmuneToPsionics / Iron Curtain / already-controlled gates) plus the
+// CannotControlAnyMore capacity rule (a full Max>1 controller takes no more;
+// Max==1 swaps its victim, so it may always be ordered).
+bool Input::mind_control_victim(int vi) const {
+    const auto& us = world_.units();
+    if (vi < 0 || vi >= static_cast<int>(us.size())) return false;
+    const Unit& v = us[vi];
+    if (!v.alive || v.die_time >= 0.0 || v.cargo_of >= 0 || v.garrison_of >= 0) return false;
+    if (v.is_aircraft) return false;
+    if (world_.controllable(v.house)) return false;
+    if (!world_.psionic_target_ok(vi)) return false;
+    if (v.an.iron_left_frames > 0) return false;
+    if (v.w7.mc_controller >= 0) return false;
+    return true;
+}
+
+bool Input::selection_has_controller() const {
+    const auto& us = world_.units();
+    for (int si : sel_.ids()) {
+        if (si < 0 || si >= static_cast<int>(us.size())) continue;
+        const Unit& su = us[si];
+        if (!world_.controllable(su.house) || !su.alive || su.die_time >= 0.0 || su.cargo_of >= 0)
+            continue;
+        if (!su.w7.t.mind_control) continue;
+        const int cap = std::max(1, su.w7.t.mc_capacity);
+        if (!su.w7.t.mc_infinite && static_cast<int>(su.w7.mc_victims.size()) >= cap && cap != 1)
+            continue;
+        return true;
+    }
+    return false;
+}
