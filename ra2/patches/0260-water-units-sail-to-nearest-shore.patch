+// 0260: ships sail to the nearest reachable water instead of refusing the
+// order outright (the land units' nearest-fallback, W2-SK-05/16). Synthetic
+// blank(32,32) diamond (cells x/y 1..63, the x[20..40] y[20..40] rect is
+// solid), no install needed. Water block x[24..34] y[24..34], ship inside;
+// the optional second pond x[37..40] y[37..40] is landlocked from it.
+namespace {
+// Long-lived: World keeps a NON-owning pointer to its map (same pattern as
+// the mapsmd03 fixture above), so this must outlive every shore_world().
+const ra2assets::MapFile& shore_map() {
+    static const ra2assets::MapFile m = ra2assets::MapFile::blank(32, 32);
+    return m;
+}
+ra2engine::World shore_world(bool second_pond) {
+    ra2engine::World world(shore_map());
+    using ra2assets::LandType;
+    const int gw = world.grid_w(), gh = world.grid_h();
+    std::vector<LandType> lt(static_cast<size_t>(gw) * gh, LandType::Clear);
+    for (int y = 24; y <= 34; ++y)
+        for (int x = 24; x <= 34; ++x) lt[static_cast<size_t>(y) * gw + x] = LandType::Water;
+    if (second_pond)
+        for (int y = 37; y <= 40; ++y)
+            for (int x = 37; x <= 40; ++x) lt[static_cast<size_t>(y) * gw + x] = LandType::Water;
+    world.set_land_terrain(lt);   // water grid + land closed on water, as on a real map
+    return world;
+}
+}  // namespace
+
+TEST_CASE("0260: a ship ordered onto land sails to the nearest shore, not a refusal") {
+    ra2engine::World world = shore_world(false);
+    const int gw = world.grid_w();
+    REQUIRE(gw > 40);
+    world.add_combat_unit(29, 29, /*house=*/0, hyd_stats());
+    world.order_unit_move(0, 20, 20);   // materialized land, off the water block's corner
+    const ra2engine::Unit& u0 = world.units()[0];
+    REQUIRE(u0.path.size() > 1);        // refused (empty) before 0260
+    CHECK(u0.path.back().x == 24);      // the water cell nearest the click
+    CHECK(u0.path.back().y == 24);
+    const std::vector<std::uint8_t>& wg = world.grid_for(ra2engine::MovementDomain::Water);
+    for (const ra2engine::Cellxy& c : u0.path)
+        CHECK(wg[static_cast<size_t>(c.y) * gw + c.x] != 0);
+    const double dt = 1.0 / 15.0;
+    for (int f = 0; f < 4000 && world.units()[0].moving(); ++f) world.step(dt);
+    CHECK(world.units()[0].cell_x == 24);
+    CHECK(world.units()[0].cell_y == 24);
+}
+
+TEST_CASE("0260: a ship ordered to disconnected water sails to its own nearest shore") {
+    ra2engine::World world = shore_world(true);
+    world.add_combat_unit(29, 29, /*house=*/0, hyd_stats());
+    world.order_unit_move(0, 38, 38);   // water, but a pond no route reaches
+    const ra2engine::Unit& u0 = world.units()[0];
+    REQUIRE(u0.path.size() > 1);        // refused (empty) before 0260
+    CHECK(u0.path.back().x == 34);      // own water nearest the goal
+    CHECK(u0.path.back().y == 34);
+    const double dt = 1.0 / 15.0;
+    for (int f = 0; f < 4000 && world.units()[0].moving(); ++f) world.step(dt);
+    CHECK(world.units()[0].cell_x == 34);
+    CHECK(world.units()[0].cell_y == 34);
+}
+
+TEST_CASE("0260: a group of ships ordered onto land all sail (none refuses)") {
+    ra2engine::World world = shore_world(false);
+    const int gw = world.grid_w();
+    world.add_combat_unit(28, 29, /*house=*/0, hyd_stats());
+    world.add_combat_unit(30, 29, /*house=*/0, hyd_stats());
+    world.group_move(ra2engine::kAnyHouse, {0, 1}, 20, 20);
+    for (int i = 0; i < 2; ++i) CHECK(world.units()[static_cast<size_t>(i)].path.size() > 1);
+    const double dt = 1.0 / 15.0;
+    for (int f = 0; f < 4000 && (world.units()[0].moving() || world.units()[1].moving()); ++f)
+        world.step(dt);
+    const std::vector<std::uint8_t>& wg = world.grid_for(ra2engine::MovementDomain::Water);
+    for (int i = 0; i < 2; ++i) {
+        const ra2engine::Unit& u = world.units()[static_cast<size_t>(i)];
+        CHECK(wg[static_cast<size_t>(u.cell_y) * gw + u.cell_x] != 0);
+    }
+    CHECK_FALSE(world.units()[0].moving());
+    CHECK_FALSE(world.units()[1].moving());
+}
