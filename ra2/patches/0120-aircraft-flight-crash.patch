+    ra2assets::MapFile map;
+    if (!w7_map(map)) {
+        MESSAGE("skipped: real map assets not found under RA2_INSTALL_DIR");
+        return;
+    }
+    World w(map);
+    const ra2assets::MapCell* c = pick_start_cell(map);
+    REQUIRE(c != nullptr);
+
+    UnitCombat plane;
+    plane.strength = 100;
+    plane.image = "W7CRASH";
+    plane.is_aircraft = true;
+    plane.is_vehicle = true;
+    plane.an.fixed_wing = true;
+    plane.an.crash_weapon.valid = true;
+    plane.an.crash_weapon.damage = 100;
+    plane.an.crash_weapon.cell_spread = 1.0;
+    plane.an.crash_weapon.percent_at_max = 1.0;
+    plane.an.crash_weapon.verses = std::vector<int>(11, 100);
+    plane.an.crash_weapon.affects_allies = false;
+    w.add_combat_unit(c->x, c->y, 0, plane);
+    const int pi = static_cast<int>(w.units().size()) - 1;
+
+    UnitCombat victim = w7_target();
+    victim.strength = 500;
+    w.add_combat_unit(c->x, c->y, 1, victim);
