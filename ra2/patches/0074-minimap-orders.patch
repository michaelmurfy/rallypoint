+void Input::radar_order(int cx, int cy, const InputEvent& ev_in) {
+    const ra2assets::MapCell* c = world_.map().at(cx, cy);
+    InputEvent ev = ev_in;
+    ev.x = cam_.x + (cx - cy) * (kTileW / 2) + kTileW / 2;
+    ev.y = cam_.y + (cx + cy) * (kTileH / 2) + kTileH / 2 - (c ? c->level : 0) * kLevelPx;
+    mod_shift_ = ev.shift;
+    mod_ctrl_ = ev.ctrl;
+    mod_alt_ = ev.alt;
+    ev_touch_ = ev.touch;
+    if (sw_targeting_ || mode_ != BaseMode::None || placement_active()) {
+        ev.button = InputEvent::Left;
+        ev.kind = InputEvent::PointerDown;
+        handle(ev);
+        ev.kind = InputEvent::PointerUp;
+        handle(ev);
+        return;
+    }
+    sel_.prune(world_);
+    if (sel_.ids().empty()) return;
+    if (mod_ctrl_ && mod_shift_) {
+        const int actor = lowest_selected();
+        emit(make_mega(world_, sel_.ids(), Mission::AttackMove, Target{}, Target::cell(cx, cy)));
+        actions_.move_ordered = true;
+        actions_.actor = actor;
+    } else if (mod_alt_) {
+        const int actor = lowest_selected();
+        emit(make_mega(world_, sel_.ids(), Mission::Move, Target{}, Target::cell(cx, cy)));
+        actions_.move_ordered = true;
+        actions_.actor = actor;
+    } else {
+        issue_order(ev.x, ev.y);
+    }
+}
