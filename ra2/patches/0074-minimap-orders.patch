diff --git a/rp-beta5/ra2/engine/engine/radar_map.hpp b/engine/radar_map.hpp
new file mode 100644
index 0000000..b5137a1
--- /dev/null
+++ b/engine/radar_map.hpp
@@ -0,0 +1,31 @@
+// Radar minimap pixel <-> map cell (pure maths, shared by PresRadar and tests).
+// The radar draws cell (x, y) as the unit square at u = x - y - u0, v = x + y - v0
+// (v half height), scaled by `s` from the letterboxed origin (ox, oy).
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace ra2engine {
+
+struct RadarMap {
+    int ox = 0, oy = 0;      // pixel of the picture's top-left corner
+    double s = 0;            // pixels per u unit (v is half of it)
+    int u0 = 0, v0 = 0;      // projection origin (min x-y, min x+y over the map)
+    int gw = 0, gh = 0;      // grid size in cells
+
+    // Cell centre -> radar pixel.
+    void cell_to_pixel(int cx, int cy, double& px, double& py) const {
+        px = ox + (cx - cy - u0 + 0.5) * s;
+        py = oy + (cx + cy - v0 + 0.5) * 0.5 * s;
+    }
+    // Radar pixel -> the nearest cell centre, clamped into the grid.
+    bool cell_at(int px, int py, int& cx, int& cy) const {
+        if (s <= 0 || gw <= 0 || gh <= 0) return false;
+        const double u = (px - ox) / s + u0 - 0.5, v = (py - oy) / (0.5 * s) + v0 - 0.5;
+        cx = std::clamp(static_cast<int>(std::lround((u + v) / 2.0)), 0, gw - 1);
+        cy = std::clamp(static_cast<int>(std::lround((v - u) / 2.0)), 0, gh - 1);
+        return true;
+    }
+};
+
+}  // namespace ra2engine
diff --git a/rp-beta5/ra2/engine/tests/test_radar_map.cpp b/tests/test_radar_map.cpp
new file mode 100644
index 0000000..d4f22c1
--- /dev/null
+++ b/tests/test_radar_map.cpp
@@ -0,0 +1,29 @@
+// Rallypoint: radar minimap pixel -> cell mapping (minimap orders).
+#include "doctest.h"
+#include "radar_map.hpp"
+
+using ra2engine::RadarMap;
+
+TEST_CASE("radar map: every cell's centre pixel maps back to that cell") {
+    RadarMap m;
+    m.ox = 10; m.oy = 20; m.s = 3.0; m.u0 = -39; m.v0 = 0; m.gw = 40; m.gh = 40;
+    for (int y = 0; y < m.gh; ++y)
+        for (int x = 0; x < m.gw; ++x) {
+            double px, py;
+            m.cell_to_pixel(x, y, px, py);
+            int cx = -1, cy = -1;
+            REQUIRE(m.cell_at(static_cast<int>(px), static_cast<int>(py), cx, cy));
+            CHECK(cx == x);
+            CHECK(cy == y);
+        }
+}
+
+TEST_CASE("radar map: pixels outside the diamond clamp into the grid; no map is refused") {
+    RadarMap m;
+    m.s = 2.0; m.gw = 10; m.gh = 8;
+    int cx = 0, cy = 0;
+    REQUIRE(m.cell_at(-500, 900, cx, cy));
+    CHECK(cx >= 0); CHECK(cx < 10); CHECK(cy >= 0); CHECK(cy < 8);
+    RadarMap none;
+    CHECK_FALSE(none.cell_at(1, 1, cx, cy));
+}
