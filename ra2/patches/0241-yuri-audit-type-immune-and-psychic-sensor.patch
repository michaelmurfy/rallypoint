@@ -86,6 +86,13 @@ static int shot_damage(const Unit& u) {
     return u.w7.bunker_dmg == 1.0 ? u.w_damage : om::ftol(chop::mul(u.w_damage, u.w7.bunker_dmg));
 }
 
+// TypeImmune=yes (YURI, DLPH) [RE: TechnoClass::ReceiveDamage gate list]: damage from a
+// unit of the same type and the same owner is ignored.
+static bool type_immune_to(const Unit& attacker, const Unit& victim) {
+    return victim.w7.t.type_immune && attacker.house == victim.house && !victim.tg.t.rules_id.empty() &&
+           attacker.tg.t.rules_id == victim.tg.t.rules_id;
+}
+
 // Range (cells) of unit u's weapon slot `slot` without activating it: the
 // active slot's live w_range (it may carry vet/IFV adjustments), else the
 // type data of the other slot.
@@ -495,6 +502,7 @@ void deliver_unit_hit(std::vector<Unit>& units, Occupancy& occ, int attacker_idx
 void deliver_hit_from(std::vector<Unit>& units, Occupancy& occ, const Unit& u, int attacker_idx,
                       int attacker_building, int victim_idx) {
     Unit& v = units[victim_idx];
+    if (type_immune_to(u, v)) return;
     if (v.w7.bunker_of >= 0) return;   // Tank Bunker: a shot already in flight at the vehicle finds only the bunker
     // W6-04-09 [RE: FUN_004D7250 @0x4D7262: a Sonic warhead on a host with a
     // parasite (+0x694) -> ParasiteClass::ExitUnit]: marked here, the exit
@@ -613,6 +621,7 @@ void apply_spread_damage(std::vector<Unit>& units, Occupancy& occ, const Unit& a
         Unit& w = units[j];
         if (!w.alive || w.die_time >= 0.0) continue;                  // dead/dying: skip
         if (w.cargo_of >= 0 || w.w7.bunker_of >= 0) continue;        // carried: off-map; bunkered: the bunker takes the blast
+        if (type_immune_to(attacker, w)) continue;                   // TypeImmune=yes
         // Gap fix C (G-44): the blast stays in its own layer -- an AA burst at
         // an airborne target hits airborne units, a ground blast ground units
         // (the original's 3-D distance; the clone has no shared Z scale).
@@ -1003,6 +1012,7 @@ AreaResult damage_area(const World& world, std::vector<Unit>& units,
         Unit& w = units[static_cast<std::size_t>(h.idx)];
         if (!w.alive || w.die_time >= 0.0) continue;
         if (spared(w.house)) continue;
+        if (type_immune_to(shooter, w)) continue;   // TypeImmune=yes
         if (shooter.w6.sonic && w.parasite_on_me >= 0) w.w6.sonic_hit = true;   // W6-04-09
         if (w.parasite_on_me >= 0 && w.parasite_on_me != src_unit)            // W7-04-14
             w.w7.host_raw_hit = std::max(w.w7.host_raw_hit, shooter.w_damage);
