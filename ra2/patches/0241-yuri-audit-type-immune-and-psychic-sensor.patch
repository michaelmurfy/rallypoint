index 0000000..5b67620
--- /dev/null
+++ b/tests/test_yuri_audit.cpp
@@ -0,0 +1,150 @@
+// Rallypoint 0241: Yuri units and buildings against the retail rulesmd.ini. Every weapon the
+// Yuri roster fires is resolved by the engine and compared with the ini text (damage, ROF,
+// range, spread, edge scale, Verses, AffectsAllies, Burst, MinimumRange). Real-data cases need
+// RA2_INSTALL_DIR and fail (not skip) when it is set but the files are missing.
+#include "doctest.h"
+
+#include <cmath>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "asset_fixture.hpp"
+#include "../engine/combat.hpp"
+#include "../engine/unit_w7.hpp"
+#include "../engine/weapon_resolve.hpp"
+#include "../engine/world.hpp"
+
+using namespace ra2engine;
+
+namespace {
+bool have_assets() {
+    if (ra2fixture::assets_available()) return true;
+    if (std::getenv("RA2_INSTALL_DIR")) FAIL("RA2_INSTALL_DIR set but real assets missing");
+    MESSAGE("skipped: real assets not found");
+    return false;
+}
+bool yes(const std::string& v) { return !v.empty() && (v[0] == 'y' || v[0] == 'Y' || v[0] == 't' || v[0] == '1'); }
+double num(const std::string& v, double def) { return v.empty() ? def : std::atof(v.c_str()); }
+std::vector<int> percents(const std::string& v) {
+    std::vector<int> out;
+    std::stringstream ss(v);
+    std::string t;
+    while (std::getline(ss, t, ',')) out.push_back(static_cast<int>(std::lround(std::atof(t.c_str()))));   // "25%" -> 25, ".5" would be 0
+    return out;
+}
+// The Yuri roster: units and buildings Yuri builds (the ids the Yuri tech tree and map objects use).
+const char* const kYuriTypes[] = {
+    "INIT", "VIRUS", "BRUTE", "YURI", "YURIPR", "SLAV", "YENGINEER", "LTNK", "SMIN", "YTNK", "MIND", "DISK", "TELE",
+    "YHVR", "CAOS", "YABRCK", "YACNST", "YADEPT", "YAGGUN", "YAGNTC", "YAGRND", "YAPOWR", "YAPPET", "YAPSYT",
+    "YATECH", "YAWEAP", "YAYARD", "NACLON", "NAPSYB", "NAPSIS", "NATBNK", "YAREFN"};
+}  // namespace
+
+TEST_CASE("Yuri audit: every weapon of the Yuri roster resolves to its retail numbers") {
+    if (!have_assets()) return;
+    const ra2assets::Ini& r = ra2fixture::rulesmd_ini();
+    const ra2assets::Rules& rules = ra2fixture::rulesmd();
+    int weapons = 0;
+    for (const char* id : kYuriTypes) {
+        if (r.get(id, "Strength", "").empty()) continue;   // not in this install
+        const TypeWeapons tw = resolve_type_weapons(rules, id);
+        const WeaponSlot* all[4] = {&tw.slot[0], &tw.slot[1], &tw.elite[0], &tw.elite[1]};
+        for (const WeaponSlot* w : all) {
+            if (!w->valid) continue;
+            const std::string& wid = w->id;
+            const std::string wh = r.get(wid, "Warhead", "");
+            ++weapons;
+            INFO(id << " weapon " << wid);
+            CHECK(w->damage == static_cast<int>(num(r.get(wid, "Damage", ""), 0)));
+            CHECK(w->rof == static_cast<int>(num(r.get(wid, "ROF", ""), 0)));
+            CHECK(w->range == doctest::Approx(num(r.get(wid, "Range", ""), 0)));
+            CHECK(w->burst == static_cast<int>(num(r.get(wid, "Burst", ""), 1)));
+            CHECK(w->min_range == doctest::Approx(num(r.get(wid, "MinimumRange", ""), 0)));
+            CHECK(w->omni_fire == yes(r.get(wid, "OmniFire", "no")));
+            if (wh.empty()) continue;
+            CHECK(w->cell_spread == doctest::Approx(num(r.get(wh, "CellSpread", ""), 0)));
+            CHECK(w->percent_at_max == doctest::Approx(num(r.get(wh, "PercentAtMax", ""), 1.0)));
+            CHECK(w->affects_allies == !(r.get(wh, "AffectsAllies", "yes") == "no"));
+            const std::vector<int> want = percents(r.get(wh, "Verses", ""));
+            if (!want.empty()) CHECK(w->verses == want);
+        }
+    }
+    CHECK(weapons >= 30);
+}
+
+TEST_CASE("Yuri audit: type flags the Yuri roster depends on") {
+    if (!have_assets()) return;
+    const ra2assets::Ini& r = ra2fixture::rulesmd_ini();
+    const ra2assets::Rules& rules = ra2fixture::rulesmd();
+    for (const char* id : kYuriTypes) {
+        if (r.get(id, "Strength", "").empty() || !rules.is_infantry(id)) continue;
+        UnitTypeW7 w;
+        fill_unit_w7(rules, id, resolve_type_weapons(rules, id), w);
+        INFO(id);
+        CHECK(w.type_immune == yes(r.get(id, "TypeImmune", "no")));
+    }
+    UnitTypeW7 clone;
+    fill_unit_w7(rules, "YURI", resolve_type_weapons(rules, "YURI"), clone);
+    CHECK(clone.type_immune);
+    UnitTypeW7 prime;
+    fill_unit_w7(rules, "YURIPR", resolve_type_weapons(rules, "YURIPR"), prime);
+    CHECK_FALSE(prime.type_immune);
+}
+
+TEST_CASE("Yuri audit: TypeImmune ignores damage from the same type of the same owner only") {
+    ra2assets::MapFile map;
+    World w(map);
+    UnitCombat clone;
+    clone.strength = 100;
+    clone.is_infantry = true;
+    clone.damage = 25;
+    clone.rof = 15;
+    clone.range = 5.0;
+    clone.w7.type_immune = true;
+    clone.tg.rules_id = "YURI";
+    w.add_combat_unit(5, 5, 0, clone);   // 0: the shooter
+    w.add_combat_unit(6, 5, 0, clone);   // 1: another Clone of the same owner
+    w.add_combat_unit(7, 5, 1, clone);   // 2: an enemy Clone
+    UnitCombat other = clone;
+    other.w7.type_immune = false;
+    other.tg.rules_id = "INIT";
+    w.add_combat_unit(8, 5, 0, other);   // 3: an own Initiate
+    deliver_unit_hit(w.units(), const_cast<Occupancy&>(w.occupancy()), 0, 1);
+    CHECK(w.units()[1].hp == 100);       // same type, same owner: ignored
+    deliver_unit_hit(w.units(), const_cast<Occupancy&>(w.occupancy()), 0, 2);
+    CHECK(w.units()[2].hp < 100);        // an enemy Clone is hurt
+    deliver_unit_hit(w.units(), const_cast<Occupancy&>(w.occupancy()), 0, 3);
+    CHECK(w.units()[3].hp < 100);        // another type of the same owner is hurt
+}
+
+TEST_CASE("Yuri audit: the Psychic Sensor sees through a disguise inside its DetectDisguiseRange") {
+    if (have_assets()) {
+        BuildingTypeDef d;
+        fill_building_weapons(ra2fixture::rulesmd(), "NAPSIS", d);
+        CHECK(d.detect_disguise_range == doctest::Approx(15.0));
+        BuildingTypeDef none;
+        fill_building_weapons(ra2fixture::rulesmd(), "YAPOWR", none);
+        CHECK(none.detect_disguise_range == doctest::Approx(0.0));
+    }
+    ra2assets::MapFile map;
+    World w(map);
+    BuildingTypeDef sensor;
+    sensor.id = "NAPSIS";
+    sensor.strength = 750;
+    sensor.detect_disguise_range = 15.0;
+    w.set_building_types({sensor});
+    w.add_building(0, 10, 10, 1, 1, 0, 750, 0, 0.0, true);
+    UnitCombat mirage;
+    mirage.strength = 200;
+    mirage.is_vehicle = true;
+    w.add_combat_unit(14, 10, 1, mirage);
+    w.add_combat_unit(40, 10, 1, mirage);
+    for (int i = 0; i < 2; ++i) {
+        w.units()[static_cast<std::size_t>(i)].disguised = true;
+        w.units()[static_cast<std::size_t>(i)].disguise_when_still = true;
+    }
+    CHECK_FALSE(w.disguise_fools(0, w.units()[0]));   // 4 cells from the sensor: seen
+    CHECK(w.disguise_fools(0, w.units()[1]));         // 30 cells away: still fooled
+    CHECK(w.disguise_fools(1 + 1, w.units()[1]));     // a house with no sensor is fooled everywhere
+}
