+        if (t.detect_disguise_range <= 0.0 || !are_allied(viewer_house, b.house)) continue;
+        if (t.powered && (b.power_off || house_low_power(b.house))) continue;
+        if (om::hypot(u.fx - (b.cx + (b.fw - 1) / 2.0), u.fy - (b.cy + (b.fh - 1) / 2.0)) <= t.detect_disguise_range) return false;
+    }
     // A Mirage tree (no house) fools every non-ally; a spy only the houses
     // allied with the house it is disguised as [RE: 0x522520].
     if (u.disguise_when_still || u.disguised_as_house < 0) return true;
diff --git a/tests/test_yuri_audit.cpp b/tests/test_yuri_audit.cpp
