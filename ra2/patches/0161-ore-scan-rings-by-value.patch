+
+// 0161 [RE: FootClass::Scan_For_Tiberium FUN_004DD0A0]: the nearest ring wins, and inside it the cell worth
+// most (Value x (density + 1)); a tie keeps the first cell of the ring walk; the own cell wins outright.
+TEST_CASE("harvest: the ore scan takes the richest cell of the nearest ring") {
+    OreField ore(30, 30);
+    std::vector<std::uint8_t> pass(900, 1);
+    Occupancy occ(30, 30);
+    int ox = -1, oy = -1;
+    ore.set(10, 8, OreKind::Ore, 2, 0);    // ring 2, first in raster order, thin
+    ore.set(14, 12, OreKind::Gems, 1, 0);  // ring 2, 50 x 2 = 100 beats 25 x 3 = 75
+    ore.set(14, 9, OreKind::Ore, 2, 0);    // ring 2, 75
+    ore.set(20, 20, OreKind::Gems, 11, 0); // far richer, but a farther ring
+    REQUIRE(find_reachable_ore(ore, pass, 30, 30, occ, 0, 12, 10, 48, -1, -1, ox, oy));
+    CHECK(ox == 14);
+    CHECK(oy == 12);
+    // The ring bound itself is not scanned: ore on ring 6 is out of a 6-ring range.
+    OreField far(30, 30);
+    far.set(18, 10, OreKind::Ore, 3, 0);
+    CHECK_FALSE(find_reachable_ore(far, pass, 30, 30, occ, 0, 12, 10, 6, -1, -1, ox, oy));
+    CHECK(find_reachable_ore(far, pass, 30, 30, occ, 0, 12, 10, 7, -1, -1, ox, oy));
+    // Standing on ore takes it without a scan.
+    far.set(12, 10, OreKind::Ore, 0, 0);
+    REQUIRE(find_reachable_ore(far, pass, 30, 30, occ, 0, 12, 10, 48, -1, -1, ox, oy));
+    CHECK((ox == 12 && oy == 10));
+}
