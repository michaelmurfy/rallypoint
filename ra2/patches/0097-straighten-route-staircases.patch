+
+// Retail rewrites a run of two neighbouring directions (E SE E SE ...) as its
+// diagonals first and then its straight steps [FUN_0042B7F0 / FUN_0042BE20]:
+// the route keeps its length, the staircase between goes. 164 routes over a
+// seeded field of 200 obstacles: 2635 turns and 1074 single-step staircases
+// before, 1850 and 553 after.
+TEST_CASE("scenario: routes round obstacles are straightened and stay within a few steps of the shortest") {
+    const int W = 40, H = 30;
+    Grid g(W * H, 1);
+    unsigned s = 12345;
+    for (int i = 0; i < 200; ++i) {
+        s = s * 1664525u + 1013904223u; const int x = (s >> 8) % W;
+        s = s * 1664525u + 1013904223u; const int y = (s >> 8) % H;
+        if ((x < 3 && y < 3) || (x > 34 && y > 24)) continue;
+        g[y * W + x] = 0;
+    }
+    auto bfs = [&](Cellxy a, Cellxy b) {   // fewest steps, same corner rule
+        std::vector<int> d(W * H, -1);
+        std::vector<int> q{a.y * W + a.x};
+        d[q[0]] = 0;
+        for (size_t i = 0; i < q.size(); ++i) {
+            const int cx = q[i] % W, cy = q[i] / W;
+            for (int dy = -1; dy <= 1; ++dy)
+                for (int dx = -1; dx <= 1; ++dx) {
+                    if (!dx && !dy) continue;
+                    const int nx = cx + dx, ny = cy + dy;
+                    if (nx < 0 || ny < 0 || nx >= W || ny >= H || !g[ny * W + nx] || d[ny * W + nx] >= 0) continue;
+                    if (dx && dy && (!g[cy * W + nx] || !g[ny * W + cx])) continue;
+                    d[ny * W + nx] = d[q[i]] + 1;
+                    q.push_back(ny * W + nx);
+                }
+        }
+        return d[b.y * W + b.x];
+    };
+    int paths = 0, turns = 0, stairs = 0, longer = 0;
+    for (int t = 0; t < 200; ++t) {
+        s = s * 1664525u + 1013904223u; const int sx = (s >> 8) % 6, sy = (s >> 12) % 6;
+        s = s * 1664525u + 1013904223u; const int gx = 30 + (s >> 8) % 9, gy = 20 + (s >> 12) % 9;
+        if (!g[sy * W + sx] || !g[gy * W + gx]) continue;
+        auto p = find_path(g, W, H, {sx, sy}, {gx, gy});
+        if (p.empty()) continue;
+        ++paths;
+        CHECK(steps_ok(p, g, W));
+        longer = std::max(longer, (int)p.size() - 1 - bfs({sx, sy}, {gx, gy}));   // (Euclid h overestimates a diagonal: the original's routes are a step or two over the minimum too)
+        int run = 1;
+        for (size_t k = 2; k < p.size(); ++k) {
+            const bool same = (p[k].x - p[k - 1].x == p[k - 1].x - p[k - 2].x) && (p[k].y - p[k - 1].y == p[k - 1].y - p[k - 2].y);
+            if (same) { ++run; continue; }
+            ++turns;
+            if (run == 1 && k >= 3) ++stairs;
+            run = 1;
+        }
+    }
+    CHECK(paths == 164);
+    CHECK(longer <= 3);
+    CHECK(turns < 2000);
+    CHECK(stairs < 700);
+}
