+long gate_close_delay_ticks(const std::string& gate_close_delay) {
+    // GateCloseDelay= is in minutes (retail .2 on GAGATE_A); the gate tick in
+    // pres_bldanim.inc runs once per logic tick (15/s). The untraced
+    // open/close mission is not modelled: this only stretches the historical
+    // 15-tick close to the rules value.
+    if (gate_close_delay.empty()) return 15;
+    char* end = nullptr;
+    const double minutes = std::strtod(gate_close_delay.c_str(), &end);
+    if (end == gate_close_delay.c_str() || !(minutes >= 0.0)) return 15;   // unparseable/negative
+    long long ticks = std::llround(minutes * 900.0);   // minutes * 60 * 15
+    if (ticks > 1000000000LL) ticks = 1000000000LL;    // saturate, never overflow long
+    return static_cast<long>(ticks);
+}
