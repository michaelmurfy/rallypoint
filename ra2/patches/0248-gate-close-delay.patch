+TEST_CASE("gate_close_delay_ticks: GateCloseDelay= minutes -> logic ticks") {
+    // Retail GAGATE_A GateCloseDelay=.2 (minutes, "time, in minutes, to delay
+    // before closing a gate after it has opened"); the pres gate holds its
+    // stage that long, where it used to close 15 ticks after the last unit.
+    CHECK(gate_close_delay_ticks("") == 15);       // absent: historical close
+    CHECK(gate_close_delay_ticks("abc") == 15);    // unparseable: historical close
+    CHECK(gate_close_delay_ticks("-1") == 15);     // negative: historical close
+    CHECK(gate_close_delay_ticks("0") == 0);
+    CHECK(gate_close_delay_ticks(".2") == 180);    // retail GAGATE_A: 0.2 min = 12 s
+    CHECK(gate_close_delay_ticks("1") == 900);     // 1 min = 900 logic ticks (15/s)
+}
