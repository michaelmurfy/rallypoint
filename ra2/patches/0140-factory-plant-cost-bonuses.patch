+namespace ra2engine {
+int World::plant_cost(int house, QueueCat cat, int cost) const {
+    const int slot = cat == QueueCat::Infantry ? 0 : cat == QueueCat::Aircraft ? 2
+        : cat == QueueCat::Structure ? 3 : cat == QueueCat::Defense ? 4 : 1;
+    float f = 1.0f;
+    for (const Building& b : buildings_) {
+        if (!b.alive || b.state == Building::State::Dead || b.house != house) continue;
+        if (b.type < 0 || b.type >= static_cast<int>(btypes().size())) continue;
+        const std::vector<double>& pb = btypes()[static_cast<std::size_t>(b.type)].plant_bonus;
+        if (pb.size() == 5) f *= static_cast<float>(pb[static_cast<std::size_t>(slot)]);
+    }
+    return f == 1.0f ? cost : static_cast<int>(static_cast<float>(cost) * f);
+}
+}  // namespace ra2engine
