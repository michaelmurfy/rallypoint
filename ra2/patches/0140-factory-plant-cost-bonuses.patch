+++ b/tests/test_re_units_buildings.cpp
@@ -0,0 +1,73 @@
+// Rallypoint: units / buildings vs retail rules (patches 0140+). Real-data cases need
+// RA2_INSTALL_DIR and fail (not skip) when it is set but the files are missing.
+#include "doctest.h"
+
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+#include "asset_fixture.hpp"
+#include "../engine/world.hpp"
+#include "../engine/harvest.hpp"
+
+using ra2engine::ProdResult;
+using ra2engine::QueueCat;
+
+namespace {
+bool have_assets() {
+    if (ra2fixture::assets_available()) return true;
+    if (std::getenv("RA2_INSTALL_DIR")) FAIL("RA2_INSTALL_DIR set but real assets missing");
+    MESSAGE("skipped: real assets not found");
+    return false;
+}
+double num(const ra2assets::Ini& r, const char* sec, const char* key, double def) {
+    const std::string v = r.get(sec, key, "");
+    return v.empty() ? def : std::atof(v.c_str());
+}
+}  // namespace
+
+TEST_CASE("FactoryPlant: only the Soviet Industrial Plant has one, and it cheapens vehicles (real rules)") {
+    if (!have_assets()) return;
+    const ra2assets::Ini& r = ra2fixture::rulesmd_ini();
+    int plants = 0;
+    for (const auto& kv : r.section("BuildingTypes")) {
+        const std::string v = r.get(kv.second, "FactoryPlant", "no");
+        if (!v.empty() && (v[0] == 'y' || v[0] == 'Y' || v[0] == 't' || v[0] == '1')) {
+            ++plants;
+            CHECK(kv.second == "NAINDP");
+        }
+    }
+    CHECK(plants == 1);
+    CHECK(num(r, "NAINDP", "InfantryCostBonus", 1.0) == doctest::Approx(1.0));
+    CHECK(num(r, "NAINDP", "UnitsCostBonus", 1.0) == doctest::Approx(0.75));
+    CHECK(num(r, "NAINDP", "AircraftCostBonus", 1.0) == doctest::Approx(1.0));
+    CHECK(num(r, "NAINDP", "BuildingsCostBonus", 1.0) == doctest::Approx(1.0));
+    CHECK(num(r, "NAINDP", "DefensesCostBonus", 1.0) == doctest::Approx(1.0));
+}
+
+TEST_CASE("FactoryPlant: a house's plants scale the production cost of their queue only") {
+    if (!have_assets()) return;
+    ra2assets::MapFile map = ra2fixture::mapsmd03_map();
+    ra2engine::World w(map);
+    std::vector<ra2engine::BuildingTypeDef> t(2);
+    t[0].id = "GACNST"; t[0].conyard = true; t[0].cost = 3000; t[0].strength = 1000;
+    t[1].id = "NAINDP"; t[1].cost = 2500; t[1].strength = 600;
+    t[1].plant_bonus = {0.5, 0.75, 1.0, 1.0, 1.0};
+    w.set_economy(t, {}, ra2engine::OreValues{}, 600.0, 0.0, 0.0);
+    const ra2assets::MapCell* c = ra2engine::pick_start_cell(map);
+    REQUIRE(c != nullptr);
+    w.add_building(0, c->x, c->y, 1, 1, 0, 1000, 0, 0.0, true);
+    w.enable_player_economy(0, 5000.0);
+    w.enable_player_economy(1, 5000.0);
+    CHECK(w.plant_cost(0, QueueCat::Vehicle, 1000) == 1000);          // no plant yet
+    const int plant = w.add_building(1, c->x + 4, c->y, 1, 1, 0, 600, 0, 0.0, true);
+    REQUIRE(plant >= 0);
+    CHECK(w.plant_cost(0, QueueCat::Infantry, 200) == 100);
+    CHECK(w.plant_cost(0, QueueCat::Vehicle, 1000) == 750);
+    CHECK(w.plant_cost(0, QueueCat::Naval, 1000) == 750);             // ships are vehicles
+    CHECK(w.plant_cost(0, QueueCat::Aircraft, 1000) == 1000);
+    CHECK(w.plant_cost(0, QueueCat::Structure, 1000) == 1000);
+    CHECK(w.plant_cost(0, QueueCat::Defense, 1000) == 1000);
+    CHECK(w.plant_cost(1, QueueCat::Vehicle, 1000) == 1000);          // another house is not helped
+    CHECK(w.plant_cost(0, QueueCat::Vehicle, 999) == 749);            // ftol truncates
