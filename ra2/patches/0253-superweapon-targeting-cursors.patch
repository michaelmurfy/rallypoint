+// ---- 0253: the superweapon arming flow (asset-free: a blank map is enough --
+// arming, action_at and cancel never touch art or rules) ----
+
+TEST_CASE("input: arm_superweapon(type,phase) records the type, classifies SuperWeapon, and is one-shot [0253]") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    Camera cam;
+    Input in(world, cam, 1280, 720);
+    CHECK(in.arm_superweapon(1, 0));   // 1 = Nuke (SuperweaponType)
+    CHECK(in.sw_targeting());
+    CHECK(in.sw_armed_type() == 1);
+    CHECK(in.sw_armed_phase() == 0);
+    int px = 0, py = 0;
+    px_for_cell(20, 20, px, py);
+    CHECK(in.action_at(px, py) == Input::Action::SuperWeapon);
+    left_click(in, px, py, false, 1000);
+    const ra2engine::InputActions a = in.take_actions();
+    CHECK(a.sw_fire_confirmed);
+    CHECK(a.sw_cx == 20);
+    CHECK(a.sw_cy == 20);
+    CHECK_FALSE(in.sw_targeting());   // one-shot: the click disarms
+}
+
+TEST_CASE("input: SW targeting and placement are mutually exclusive, placement wins [0253]") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    Camera cam;
+    Input in(world, cam, 1280, 720);
+    CHECK(in.arm_superweapon(1, 0));
+    in.begin_placement(0, 2, 2);          // starting a placement disarms the SW
+    CHECK_FALSE(in.sw_targeting());
+    CHECK(in.placement_active());
+    CHECK_FALSE(in.arm_superweapon(1, 0));   // arming is refused while placing
+    CHECK_FALSE(in.sw_targeting());
+    CHECK(in.cancel_one_mode());          // the Esc chain drops the placement...
+    CHECK(in.arm_superweapon(1, 0));      // ...and arming works again after it
+    CHECK(in.sw_targeting());
+}
+
+TEST_CASE("input: right-click and the Esc chain cancel SW targeting without firing [0253]") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    Camera cam;
+    Input in(world, cam, 1280, 720);
+    int px = 0, py = 0;
+    px_for_cell(20, 20, px, py);
+    CHECK(in.arm_superweapon(1, 0));
+    right_click(in, px, py, 1000);        // right-click-up cancels the armed mode
+    CHECK_FALSE(in.sw_targeting());
+    const ra2engine::InputActions a = in.take_actions();
+    CHECK_FALSE(a.sw_fire_confirmed);     // a cancel never fires
+    CHECK(in.arm_superweapon(4, 1));      // 4 = ChronoSphere, destination phase...
+    CHECK(in.sw_armed_phase() == 1);
+    CHECK(in.action_at(px, py) == Input::Action::SuperWeapon);
+    CHECK(in.cancel_one_mode());          // ...cancelled by the Esc chain
+    CHECK_FALSE(in.sw_targeting());
+}
+
+TEST_CASE("input: a minimap (radar_order) click commits an armed SW target [0253]") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    Camera cam;
+    Input in(world, cam, 1280, 720);
+    CHECK(in.arm_superweapon(1, 0));
+    InputEvent ev;                        // the radar's left press (button forced Left)
+    ev.kind = InputEvent::PointerDown;
+    ev.button = InputEvent::Left;
+    in.radar_order(20, 20, ev);
+    const ra2engine::InputActions a = in.take_actions();
+    CHECK(a.sw_fire_confirmed);
+    CHECK(a.sw_cx == 20);
+    CHECK(a.sw_cy == 20);
+    CHECK_FALSE(in.sw_targeting());
+}
