+TEST_CASE("0243: a team forms once its factory stands, even when the unit's prerequisites are not met (0x00509610)") {
+    ra2assets::MapFile map;
+    if (!load_real_map_w(map)) { MESSAGE("skipped: real map assets not found"); return; }
+    ra2engine::World world(map);
+    const ra2assets::MapCell* c = ra2engine::pick_start_cell(map);
+    REQUIRE(c != nullptr);
+    world.add_building(0, c->x, c->y, 1, 1, /*house=*/1, 1000, 0, 0.0, true);       // conyard
+    world.add_building(1, c->x + 3, c->y, 1, 1, /*house=*/1, 500, 0, 0.0, true);    // barracks = the factory
+    ra2engine::AiHouseConfig cfg = ai2_cfg(/*teams_enabled=*/true);
+    cfg.team.unit_roster[0].prerequisite = {"NOSUCHBUILDING"};   // never buildable (like FLAKT without radar)
+    world.enable_ai_house(1, cfg);
+    for (int i = 0; i < 300; ++i) world.step(1.0 / 15.0);
+    REQUIRE(world.ai_team_state(1) != nullptr);
+    CHECK(world.ai_team_state(1)->teams_created >= 1);   // only a Has_Factories_For_TeamType gate
+}
+
+TEST_CASE("0243: no factory for the unit's category, no team") {
+    ra2assets::MapFile map;
+    if (!load_real_map_w(map)) { MESSAGE("skipped: real map assets not found"); return; }
+    ra2engine::World world(map);
+    const ra2assets::MapCell* c = ra2engine::pick_start_cell(map);
+    REQUIRE(c != nullptr);
+    world.add_building(0, c->x, c->y, 1, 1, /*house=*/1, 1000, 0, 0.0, true);       // conyard only
+    world.enable_ai_house(1, ai2_cfg(/*teams_enabled=*/true));
+    for (int i = 0; i < 300; ++i) world.step(1.0 / 15.0);
+    REQUIRE(world.ai_team_state(1) != nullptr);
+    CHECK(world.ai_team_state(1)->teams_created == 0);
+}
