diff --git a/tests/test_unit_art_audit.cpp b/tests/test_unit_art_audit.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_unit_art_audit.cpp
@@ -0,0 +1,85 @@
+// Real-data audit of unit art against retail artmd.ini / rulesmd.ini / SHP
+// frame counts (patch 0210). Skips without RA2_INSTALL_DIR.
+#include "doctest.h"
+#include "asset_fixture.hpp"
+#include "ra2assets/ini.hpp"
+#include "ra2assets/shp.hpp"
+#include <algorithm>
+#include <cstdio>
+#include <sstream>
+
+namespace {
+std::string lc(std::string s) { for (char& c : s) c = (char)std::tolower((unsigned char)c); return s; }
+std::string clean(std::string v) {
+    const auto sc = v.find(';');
+    if (sc != std::string::npos) v.erase(sc);
+    while (!v.empty() && std::isspace((unsigned char)v.back())) v.pop_back();
+    while (!v.empty() && std::isspace((unsigned char)v.front())) v.erase(v.begin());
+    return v;
+}
+std::vector<uint8_t> find_shp(const std::string& image) {
+    const std::string n = lc(image) + ".shp";
+    std::vector<uint8_t> b = ra2fixture::resolve_nested_bytes(n);
+    if (!b.empty()) return b;
+    for (const char* mx : {"conqmd.mix", "conquer.mix"}) {
+        try {
+            const auto& top = ra2fixture::top_mix();
+            ra2assets::MixFile m = top.open_nested(mx);
+            if (const auto* e = m.find(ra2assets::mix_id(n))) return m.read(*e);
+        } catch (const std::exception&) {}
+    }
+    try {
+        const auto& r = ra2fixture::ra2_mix();
+        ra2assets::MixFile m = r.open_nested("conquer.mix");
+        if (const auto* e = m.find(ra2assets::mix_id(n))) return m.read(*e);
+    } catch (const std::exception&) {}
+    return {};
+}
+}  // namespace
+
+TEST_CASE("unit art audit: every infantry sequence frame exists in its SHP") {
+    if (!ra2fixture::assets_available() || ra2fixture::artmd_bytes().empty() || ra2fixture::rulesmd_bytes().empty()) {
+        MESSAGE("skipped: no install"); return;
+    }
+    const ra2assets::Ini& rules = ra2fixture::rulesmd_ini();
+    const ra2assets::Ini& art = ra2fixture::artmd_ini();
+    static const char* names[] = {"Ready","Guard","Prone","Walk","FireUp","Down","Crawl","Up","FireProne","Idle1","Idle2",
+        "Die1","Die2","Die3","Die4","Die5","Tread","Swim","WetIdle1","WetIdle2","WetDie1","WetDie2","WetAttack","Hover",
+        "Fly","Tumble","FireFly","Deploy","Deployed","DeployedFire","DeployedIdle","Undeploy","Cheer","Paradrop",
+        "AirDeathStart","AirDeathFalling","AirDeathFinish","Panic","Shovel","Carry","SecondaryFire","SecondaryProne"};
+    int checked = 0, bad = 0;
+    for (const auto& kv : rules.section("InfantryTypes")) {
+        const std::string id = clean(kv.second);
+        if (id.empty()) continue;
+        std::string image = clean(rules.get(id, "Image")); if (image.empty()) image = id;
+        const std::string seq = clean(art.get(image, "Sequence"));
+        if (seq.empty()) continue;
+        const std::vector<uint8_t> raw = find_shp(image);
+        if (raw.empty()) { std::printf("[audit] %s: no SHP\n", image.c_str()); continue; }
+        const int n = ra2assets::ShpFile::load(raw).count();
+        for (const char* nm : names) {
+            const std::string v = clean(art.get(seq, nm));
+            if (v.empty()) continue;
+            int f[3] = {0, 1, 0}; int k = 0; std::stringstream ss(v); std::string tok;
+            while (k < 3 && std::getline(ss, tok, ',')) f[k++] = std::atoi(tok.c_str());
+            const int last = f[0] + (f[2] > 0 ? 7 * f[2] : 0) + std::max(f[1], 1) - 1;
+            ++checked;
+            if (last >= n) { ++bad; std::printf("[audit] %s %s %s=%s needs frame %d, SHP has %d\n", id.c_str(), seq.c_str(), nm, v.c_str(), last, n); }
+        }
+    }
+    std::printf("[audit] infantry sequences checked=%d out-of-range=%d\n", checked, bad);
+    CHECK(checked > 100);
+    CHECK(bad == 0);
+}
+
+TEST_CASE("unit art audit: SHP vehicles (DRON, SQD, DLPH) frame layout") {
+    if (!ra2fixture::assets_available() || ra2fixture::artmd_bytes().empty()) { MESSAGE("skipped: no install"); return; }
+    const ra2assets::Ini& art = ra2fixture::artmd_ini();
+    for (const char* id : {"DRON", "SQD", "DLPH"}) {
+        const auto raw = find_shp(id);
+        if (raw.empty()) { std::printf("[audit] %s no shp\n", id); continue; }
+        const int n = ra2assets::ShpFile::load(raw).count();
+        const int w = art.get_int(id, "WalkFrames", 12), f = art.get_int(id, "FiringFrames", 0), st = art.get_int(id, "StandingFrames", f > 0 ? 1 : 0);
+        std::printf("[audit] %s shp=%d walk=%d fire=%d stand=%d -> 8*(w+f+st)=%d\n", id, n, w, f, st, 8 * (w + f + st));
+    }
+}
