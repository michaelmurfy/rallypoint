+TEST_CASE("reveal/radar: World queries follow the type flags (RevealToAll=, RadarVisible=)") {
+    ra2assets::MapFile map;
+    World w(map);
+    BuildingTypeDef sw;
+    sw.id = "NAMISL";
+    sw.reveal_to_all = true;
+    BuildingTypeDef derrick;
+    derrick.id = "CAOILD";
+    derrick.radar_visible = true;
+    BuildingTypeDef pill;
+    pill.id = "GAPILL";
+    w.set_building_types({sw, derrick, pill});
+    const int a = w.add_building(0, 2, 2, 1, 1, 0, 1000, 0, 0.0, true);
+    const int b = w.add_building(1, 5, 5, 1, 1, 1, 1000, 0, 0.0, true);
+    const int c = w.add_building(2, 8, 8, 1, 1, 0, 400, 0, 0.0, true);
+    REQUIRE(a == 0);
+    REQUIRE(b == 1);
+    REQUIRE(c == 2);
+    CHECK(w.building_reveal_to_all(a));
+    CHECK_FALSE(w.building_reveal_to_all(b));
+    CHECK_FALSE(w.building_reveal_to_all(c));
+    CHECK(w.building_radar_visible(b));
+    CHECK_FALSE(w.building_radar_visible(a));
+    CHECK_FALSE(w.building_radar_visible(c));
+    CHECK_FALSE(w.building_reveal_to_all(-1));
+    CHECK_FALSE(w.building_radar_visible(99));
+    const int u = w.add_building(-1, 10, 10, 1, 1, 0, 100, 0, 0.0, true);   // untyped: no flags
+    CHECK_FALSE(w.building_reveal_to_all(u));
+    CHECK_FALSE(w.building_radar_visible(u));
+}
