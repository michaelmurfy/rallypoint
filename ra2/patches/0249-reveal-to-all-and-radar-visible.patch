+TEST_CASE("reveal/radar: real rulesmd sets RevealToAll on the SW buildings, RadarVisible on tech") {
+    if (!ra2fixture::assets_available()) { MESSAGE("no install"); return; }
+    const ra2assets::Rules& r = ra2fixture::rulesmd();
+    for (const char* id : {"GACSPH", "GAWEAT", "NAIRON", "NAMISL", "YAGNTC", "YAPPET", "GADUMY"})
+        CHECK(r.section_flag(id, "RevealToAll", false));
+    CHECK_FALSE(r.section_flag("GAPILL", "RevealToAll", false));
+    for (const char* id : {"CAOUTP", "CAAIRP", "CAOILD", "CAPOWR", "CAMACH", "CATHOSP", "CAHOSP", "CASLAB"})
+        CHECK(r.section_flag(id, "RadarVisible", false));
+    CHECK_FALSE(r.section_flag("GAPILL", "RadarVisible", false));
