@@ -0,0 +1,152 @@
+// Rallypoint: Yuri faction strength parity against the shipped rulesmd.ini.
+//
+// Ground truth: ra2md.mix/localmd.mix/rulesmd.ini (Steam YR 1.001), extracted
+// 2026-11-23. The damage chain these numbers feed was re-verified against
+// gamemd.exe with Ghidra (see ra2/docs/gamemd-parity-backlog.md, "Yuri
+// strength parity"): TechnoClass::ReceiveDamage 0x701900 (defence divides +
+// min-1) -> ObjectClass::ReceiveDamage 0x5F5390 (Verses kernel call, building
+// floor 1, heal cap) -> Modify_Damage 0x489180 (CellSpread falloff, Verses
+// multiply, MaxDamage cap). HouseClass::GetArmorMultForType 0x50BD30 reads
+// the HouseType category Armor*Mult slots (+0x100..+0x110); stock rulesmd
+// leaves every country's Armor keys unset (identity).
+#include "doctest.h"
+
+#include "asset_fixture.hpp"
+#include "combat.hpp"
+#include "ra2assets/rules.hpp"
+#include "weapon_resolve.hpp"
+
+#include <string>
+#include <vector>
+
+using namespace ra2assets;
+
+namespace {
+
+// One infantry/vehicle type's Strength=, Armor= and primary weapon.
+void pin_type(const Rules& r, const char* id, int strength, const char* armor,
+              const char* primary, int damage, int rof, double range,
+              const char* warhead) {
+    CAPTURE(id);
+    CHECK(r.strength(id) == strength);
+    CHECK(r.armor(id) == armor);
+    CHECK(r.primary(id) == primary);
+    CHECK(r.weapon_damage(primary) == damage);
+    CHECK(r.weapon_rof(primary) == rof);
+    CHECK(r.weapon_range(primary) == doctest::Approx(range));
+    CHECK(r.weapon_warhead(primary) == warhead);
+}
+
+// One structure's Strength= and Armor=.
+void pin_building(const Rules& r, const char* id, int strength, const char* armor) {
+    CAPTURE(id);
+    CHECK(r.strength(id) == strength);
+    CHECK(r.armor(id) == armor);
+}
+
+}  // namespace
+
+TEST_CASE("yuri strength: real rulesmd pins for every Yuri combat type") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: ra2md.mix not found"); return; }
+    if (ra2fixture::rulesmd_bytes().empty()) { MESSAGE("skipped: rulesmd.ini not found"); return; }
+    const Rules& r = ra2fixture::rulesmd();
+
+    // Infantry. Initiate: PsychicJab 25/15/4.5, SAFlame (SA verses, ProneDamage 70%).
+    pin_type(r, "INIT", 100, "none", "PsychicJab", 25, 15, 4.5, "SAFlame");
+    pin_type(r, "BRUTE", 200, "plate", "Punch", 100, 60, 1.4, "Battering");
+    CHECK(r.weapon_damage("Smash") == 100);   // Brute secondary
+    pin_type(r, "VIRUS", 100, "none", "Virusgun", 125, 100, 10.0, "Virus");
+    pin_type(r, "YURIPR", 150, "flak", "SuperMindControl", 1, 200, 7.0, "ControllerBuilding");
+    CHECK(r.strength("SLAV") == 125);         // Slave: SHOVEL 30/30, weak melee
+    CHECK(r.armor("SLAV") == "none");
+
+    // Vehicles.
+    pin_type(r, "LTNK", 300, "heavy", "ATGUN", 65, 60, 5.0, "AP");
+    pin_type(r, "YTNK", 210, "light", "AGGattling", 25, 16, 5.0, "GattWH");
+    CHECK(r.section_flag("YTNK", "IsGattling", false));
+    CHECK(r.section_string("YTNK", "Weapon2", "") == "AAGattling");   // AA stage
+    CHECK(r.weapon_range("AAGattling") == doctest::Approx(8.0));
+    pin_type(r, "TELE", 150, "light", "MagneticBeam", 5000, 20, 12.0, "LocomotorBeam");
+    pin_type(r, "MIND", 500, "heavy", "MultipleMindControlTank", 3, 10, 6.0, "Controller");
+    pin_type(r, "DISK", 600, "light", "DiskLaser", 90, 80, 7.0, "DiskWH");
+    pin_type(r, "CAOS", 200, "light", "ChaosAttack", 600, 30, 3.0, "PsychGasCreate");
+    CHECK(r.strength("PCV") == 1000);         // Psi Commando: no weapon
+    CHECK(r.armor("PCV") == "heavy");
+    CHECK(r.strength("YHVR") == 300);         // Hover Transport: unarmed
+    CHECK(r.armor("YHVR") == "heavy");
+    pin_type(r, "BSUB", 1200, "heavy", "BoomerTorpedo", 60, 120, 7.0, "APSplash2");
+    pin_type(r, "SMIN", 2000, "medium", "20mmRapid", 30, 20, 5.5, "HARVWH");
+    CHECK(r.strength("SMON") == 1000);        // Slave Miner (deployed): unarmed
+    CHECK(r.armor("SMON") == "medium");
+
+    // Structures.
+    pin_building(r, "YACNST", 1000, "concrete");
+    pin_building(r, "YAPOWR", 700, "wood");
+    pin_building(r, "YABRCK", 500, "steel");
+    pin_building(r, "YAWEAP", 1000, "wood");
+    pin_building(r, "YAREFN", 2000, "medium");
+    pin_building(r, "YAYARD", 1500, "concrete");
+    pin_building(r, "YADEPT", 1200, "wood");
+    pin_building(r, "YATECH", 500, "wood");
+    pin_building(r, "YAGRND", 900, "wood");
+    pin_building(r, "YAGGUN", 810, "steel");
+    pin_building(r, "YAPSYT", 455, "steel");
+    pin_building(r, "YAGNTC", 1000, "concrete");
+    pin_building(r, "YAPPET", 1000, "concrete");
+    pin_building(r, "YAROCK", 700, "wood");
+    pin_building(r, "YACOMD", 1000, "concrete");
+}
+
+TEST_CASE("yuri strength: warhead verses and the damage chain numbers") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: ra2md.mix not found"); return; }
+    if (ra2fixture::rulesmd_bytes().empty()) { MESSAGE("skipped: rulesmd.ini not found"); return; }
+    const Rules& r = ra2fixture::rulesmd();
+
+    // SAFlame (Initiate) shares SA's verses; GattWH is the gattling table.
+    const std::vector<int> sa{100, 80, 80, 50, 25, 25, 75, 50, 25, 100, 100};
+    CHECK(r.verses("SA") == sa);
+    CHECK(r.verses("SAFlame") == sa);
+    const std::vector<int> gatt{100, 80, 70, 50, 30, 10, 10, 5, 3, 200, 50};
+    CHECK(r.verses("GattWH") == gatt);
+    CHECK(ra2engine::warhead_prone_damage(r, "SAFlame") == doctest::Approx(0.7));
+
+    // The per-hit numbers a Conscript (M1Carbine 15, SA) and an Initiate
+    // (PsychicJab 25, SAFlame) deal through damage_vs -- the same multiply
+    // Modify_Damage 0x489180 runs (trunc toward zero, min 1 on a >0% hit).
+    const int none = ra2engine::armor_index("none");
+    const int flak = ra2engine::armor_index("flak");
+    const int plate = ra2engine::armor_index("plate");
+    const int wood = ra2engine::armor_index("wood");
+    const int steel = ra2engine::armor_index("steel");
+    const int concrete = ra2engine::armor_index("concrete");
+    CHECK(ra2engine::damage_vs(15, sa, none) == 15);      // E2 -> INIT
+    CHECK(ra2engine::damage_vs(15, sa, flak) == 12);      // E2 -> E2
+    CHECK(ra2engine::damage_vs(25, sa, flak) == 20);      // INIT -> E2
+    CHECK(ra2engine::damage_vs(25, sa, plate) == 20);     // INIT -> BRUTE
+    CHECK(ra2engine::damage_vs(15, sa, wood) == 11);      // E2 -> YAPOWR/YAWEAP
+    CHECK(ra2engine::damage_vs(15, sa, steel) == 7);      // E2 -> YABRCK/YAGGUN
+    CHECK(ra2engine::damage_vs(15, sa, concrete) == 3);   // E2 -> YACNST
+    CHECK(ra2engine::damage_vs(25, gatt, none) == 25);    // YTNK -> infantry
+    CHECK(ra2engine::damage_vs(25, gatt, ra2engine::armor_index("heavy")) == 2);   // 10% vs heavy
+    CHECK(ra2engine::damage_vs(25, gatt, concrete) == 1); // 3% truncates to 0, min-1 floor
+}
+
+TEST_CASE("yuri strength: stock country armor bonuses are identity") {
+    if (!ra2fixture::assets_available()) { MESSAGE("skipped: ra2md.mix not found"); return; }
+    if (ra2fixture::rulesmd_bytes().empty()) { MESSAGE("skipped: rulesmd.ini not found"); return; }
+    const Rules& r = ra2fixture::rulesmd();
+    // gamemd's GetArmorMultForType (0x50BD30) reads the HouseType category
+    // slots; the scalar Armor= only feeds the house CRC. Stock rulesmd sets
+    // neither on any country, so no spawn-HP bake or damage divide may move
+    // Yuri (or any) stats away from the type's Strength=.
+    for (const char* country : {"YuriCountry", "Russians", "Americans", "British", "French",
+                                "Germans", "Alliance", "Confederation", "Africans", "Arabs"}) {
+        CAPTURE(country);
+        CHECK(r.section_double(country, "Armor", 1.0) == doctest::Approx(1.0));
+        CHECK(r.section_double(country, "ArmorInfantryMult", 1.0) == doctest::Approx(1.0));
+        CHECK(r.section_double(country, "ArmorUnitsMult", 1.0) == doctest::Approx(1.0));
+        CHECK(r.section_double(country, "ArmorBuildingsMult", 1.0) == doctest::Approx(1.0));
+        CHECK(r.section_double(country, "ArmorDefensesMult", 1.0) == doctest::Approx(1.0));
+        CHECK(r.section_double(country, "Firepower", 1.0) == doctest::Approx(1.0));
+    }
+}
