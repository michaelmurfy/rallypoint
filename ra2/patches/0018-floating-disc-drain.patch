+            continue;
+        }
+        Building& b = buildings_[static_cast<std::size_t>(bi)];
+        if (!b.alive || b.state == Building::State::Dead || b.house == u.house) {
+            u.drain_frames = 0;
+            continue;
+        }
+        if (b.type < 0 || b.type >= static_cast<int>(btypes().size())) {
+            u.drain_frames = 0;
+            continue;
+        }
+        const BuildingTypeDef& td = btypes()[static_cast<std::size_t>(b.type)];
+        if (!disc_drain::can_target(td.drainable, true) ||
+            !disc_drain::above_foundation(u.cell_x, u.cell_y, b.cx, b.cy, b.fw, b.fh)) {
+            u.drain_frames = 0;
+            continue;
+        }
+        const disc_drain::Effect effect =
+            disc_drain::classify(td.drainable, td.resource_destination, td.power);
+        if (disc_drain::causes_blackout(effect) && b.house >= 0 && b.house < house_count())
+            blackout_frames_[static_cast<std::size_t>(b.house)] =
+                std::max(blackout_frames_[static_cast<std::size_t>(b.house)], 2);
+        if (!disc_drain::causes_money(effect)) {
+            u.drain_frames = 0;
+            continue;
+        }
+        const int victim = b.house, thief = u.house;
+        if (victim < 0 || victim >= house_count() || thief < 0 || thief >= house_count()) {
+            u.drain_frames = 0;
+            continue;
+        }
+        const int bal = static_cast<int>(credits(victim));
+        const disc_drain::MoneyTick tick =
+            disc_drain::money_tick(u.drain_frames, disc_drain::kDefaultMoneyDelay,
+                                   disc_drain::kDefaultMoneyAmount, bal);
+        u.drain_frames = tick.frames_held;
+        if (tick.transfer <= 0) continue;
+        set_wallet(victim, credits(victim) - static_cast<double>(tick.transfer));
+        set_wallet(thief, credits(thief) + static_cast<double>(tick.transfer));
+    }
+}
