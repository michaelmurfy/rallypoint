diff --git a/engine/slope_tilt.cpp b/engine/slope_tilt.cpp
new file mode 100644
--- /dev/null
+++ b/engine/slope_tilt.cpp
@@ -0,0 +1,61 @@
+#include "slope_tilt.hpp"
+#include "voxel_raster.hpp"
+#include <cmath>
+
+namespace ra2engine {
+namespace {
+
+constexpr double kPi = 3.14159265358979323846;
+// FUN_00754A20: atan(LevelHeight / 256), LevelHeight = 104 leptons/level.
+constexpr double kRampPitch = 0.38588266939807375;  // atan(104/256)
+// Steeper set (FUN_00754A50 / register ebx in FUN_00754CB0): ~atan(2*LH/cell).
+constexpr double kRampPitchSteep = 0.6857295104989298;  // atan(208/256)
+
+// Tilt-axis yaw (rad) per SlopeIndex for the FUN_007559B0 table at 0xB45188.
+// Values are the first arg to FUN_005AE6F0 in FUN_00754CB0 (0x4096cac1 = 270°,
+// 0x40490e56 = 180°, 0x3fc90e56 = 90°, 0, then 225°/135°/45°/315° repeats).
+constexpr double kSlopeYaw[17] = {
+    0.0,
+    4.712250232696533,   // 1: 270°
+    3.1414999961853027,  // 2: 180°
+    1.5707499980926514,  // 3:  90°
+    0.0,                 // 4:   0°
+    3.926875114440918,   // 5: 225°
+    2.3561251163482666,  // 6: 135°
+    0.7853749990463257,  // 7:  45°
+    5.49762487411499,    // 8: 315°
+    3.926875114440918,   // 9
+    2.3561251163482666,  // 10
+    0.7853749990463257,  // 11
+    5.49762487411499,    // 12
+    3.926875114440918,   // 13
+    2.3561251163482666,  // 14
+    0.7853749990463257,  // 15
+    5.49762487411499,    // 16
+};
+
+// Which pitch register FUN_00754CB0 pushed: ebx (steep) vs ebp (single).
+constexpr bool kSlopeSteep[17] = {
+    false,
+    true,  true,  true,  true,   // 1-4 ebx
+    false, false, false, false,  // 5-8 ebp
+    false, false, false, false,  // 9-12 ebp
+    true,  true,  true,  true,   // 13-16 ebx
+};
+
+}  // namespace
+
+double slope_tilt_pitch(int slope_index, double body_facing_u16) {
+    if (slope_index <= 0 || slope_index > 16) return 0.0;
+    const double p = kSlopeSteep[slope_index] ? kRampPitchSteep : kRampPitch;
+    const double axis = kSlopeYaw[slope_index];
+    // Model-space nose pitch before yaw: full tip when the hull faces along
+    // the tilt axis (FUN_0055A7D0 applies M_slope then body RotateZ; the
+    // nose component is p * cos(body - axis)).
+    constexpr int kFacings = 32;  // kVehicleFacings [RE: voxel-render.md §2]
+    const int bi = facing_to_index(body_facing_u16, kFacings);
+    const double body = index_to_yaw(bi, kFacings);
+    return p * std::cos(body - axis);
+}
+
+}  // namespace ra2engine
diff --git a/engine/slope_tilt.hpp b/engine/slope_tilt.hpp
new file mode 100644
--- /dev/null
+++ b/engine/slope_tilt.hpp
@@ -0,0 +1,20 @@
+#pragma once
+// Presentation-only vehicle tilt on TMP ramps (gamemd parity backlog T1.2).
+//
+// [RE: DriveLocomotionClass Draw_Matrix FUN_004B0410 -> FUN_0055A7D0 reads
+// CellClass SlopeIndex (+0x11C, TMP hdr +0x2A), copies the slope Matrix3D via
+// FUN_007559B0 (table 0xB45188, 48 bytes x SlopeIndex), then RotateZ by body
+// facing. Table built in FUN_00754CB0: index 0 = identity (FUN_005AE860);
+// 1..16 = FUN_005AE6F0(yaw, pitch) = Z(yaw)*X(pitch)*Z(-yaw). Pitch magnitude
+// FUN_00754A20 atan(LevelHeight/256) with Unsorted::LevelHeight 104.]
+
+#include <cstdint>
+
+namespace ra2engine {
+
+// Nose-up pitch (radians) for a Drive/Ship voxel hull on a cell with the given
+// TMP SlopeIndex and body facing (16-bit facing space). 0 on flat / unknown.
+// Does not touch simulation state.
+double slope_tilt_pitch(int slope_index, double body_facing_u16);
+
+}  // namespace ra2engine
diff --git a/tests/test_slope_tilt.cpp b/tests/test_slope_tilt.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_slope_tilt.cpp
@@ -0,0 +1,25 @@
+#include "doctest.h"
+#include "slope_tilt.hpp"
+#include <cmath>
+
+TEST_CASE("slope_tilt: flat SlopeIndex is zero pitch") {
+    CHECK(ra2engine::slope_tilt_pitch(0, 0) == 0.0);
+    CHECK(ra2engine::slope_tilt_pitch(-1, 0x4000) == 0.0);
+    CHECK(ra2engine::slope_tilt_pitch(17, 0) == 0.0);
+}
+
+TEST_CASE("slope_tilt: single-height corner tips along its axis") {
+    // SlopeIndex 7: yaw 45°, ebp/single pitch atan(104/256). Facing NE
+    // (0x2000 → index 4, yaw = pi/4) aligns with the axis.
+    const double along = ra2engine::slope_tilt_pitch(7, 0x2000);
+    CHECK(along == doctest::Approx(0.38588266939807375).epsilon(1e-6));
+    // Facing SE (0x6000 → index 12, yaw = -pi/4): cos(pi/2) = 0.
+    const double across = ra2engine::slope_tilt_pitch(7, 0x6000);
+    CHECK(across == doctest::Approx(0.0).epsilon(1e-4));
+}
+
+TEST_CASE("slope_tilt: steep cardinal uses larger pitch magnitude") {
+    // Index 4 (ebx/steep): yaw 0°. Facing East 0x4000 → full steep pitch.
+    const double p = ra2engine::slope_tilt_pitch(4, 0x4000);
+    CHECK(p == doctest::Approx(0.6857295104989298).epsilon(1e-5));
+}
