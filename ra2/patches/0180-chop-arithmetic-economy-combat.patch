--- a/engine/chop_math.hpp
+++ b/engine/chop_math.hpp
@@ -0,0 +1,49 @@
+#pragma once
+// gamemd runs with the x87 rounding mode set to CHOP (WinMain 0x006BBFC1
+// _controlfp(_RC_CHOP, _MCW_RC); control word 0x0E7F: 53-bit, toward zero), so
+// every double multiply/divide is truncated, not rounded to nearest. A product
+// that "should" be an integer, such as 2200 * 0.3 or 100 * (30 * 0.01), lands one
+// ulp BELOW it and _ftol then drops a whole unit (659, 29). These helpers give
+// the truncated result exactly (fma recovers the rounding error); results are
+// bit-identical on every platform. Cited from the reverse-engineered notes of
+// github.com/YuriPlanet/vera20k (ore_growth.rs, factory.rs, kernel.rs); no code copied.
+#include <cmath>
+
+namespace ra2engine {
+namespace chop {
+
+// Step a nearest-rounded result `r` toward zero when the exact value `err`
+// (exact - r) lies on the zero side of it.
+inline double toward_zero(double r, double err) {
+    if (err != 0.0 && ((err < 0.0) != (r < 0.0)) && r != 0.0) return std::nextafter(r, 0.0);
+    return r;
+}
+inline double mul(double a, double b) {
+    const double r = a * b;
+    if (!std::isfinite(r)) return r;
+    return toward_zero(r, std::fma(a, b, -r));
+}
+inline double div(double a, double b) {
+    const double r = a / b;
+    if (!std::isfinite(r) || r == 0.0) return r;
+    return toward_zero(r, std::fma(-r, b, a) / b);   // sign of (a - r*b) / b = sign of exact - r
+}
+inline double add(double a, double b) {
+    const double r = a + b;
+    if (!std::isfinite(r)) return r;
+    const double bb = r - a;
+    return toward_zero(r, (a - (r - bb)) + (b - bb));   // TwoSum error
+}
+inline double sub(double a, double b) { return add(a, -b); }
+// FSTP m32real under chop: the double truncated (not rounded) to a float.
+inline float to_f32(double x) {
+    float f = static_cast<float>(x);
+    if (std::isfinite(x) && std::isfinite(f) && std::fabs(static_cast<double>(f)) > std::fabs(x))
+        f = std::nextafter(f, 0.0f);
+    return f;
+}
+// "NN%" in rules: atoi(NN) * 0.01 under chop (WarheadType Verses reader 0x75DDCC).
+inline double percent(int pct) { return mul(static_cast<double>(pct), 0.01); }
+
+}  // namespace chop
+}  // namespace ra2engine
