+// gamemd's chop-mode x87 arithmetic (engine/chop_math.hpp). Expected values were
+// computed with exact rational arithmetic, truncated toward zero to 53 bits.
+#include "doctest.h"
+#include "../engine/chop_math.hpp"
+#include "../engine/orig_math.hpp"
+#include <cstdint>
+#include <cstring>
+using namespace ra2engine;
+
+static std::uint64_t bits(double d) { std::uint64_t u; std::memcpy(&u, &d, 8); return u; }
+
+TEST_CASE("chop: products that nearest-rounding lands on an integer fall one ulp below") {
+    // Tiberium Growth reload 0x00722C9E: 2200 * 0.3 -> 659, 10000 * 0.3 -> 2999, 10 * 0.3 -> 2.
+    CHECK(om::ftol(chop::mul(2200.0, 0.3)) == 659);
+    CHECK(om::ftol(chop::mul(10000.0, 0.3)) == 2999);
+    CHECK(om::ftol(chop::mul(10.0, 0.3)) == 2);
+    CHECK(om::ftol(2200.0 * 0.3) == 660);   // what nearest rounding gave
+    CHECK(chop::mul(0.5, 4.0) == 2.0);      // exact products are untouched
+    CHECK(chop::mul(-3.0, 0.25) == -0.75);
+}
+
+TEST_CASE("chop: divide and add truncate too") {
+    CHECK(bits(chop::div(2.0, 3.0)) == 0x3FE5555555555555ull);   // nearest gives ...556
+    CHECK(bits(chop::div(1.0, 3.0)) == 0x3FD5555555555555ull);
+    CHECK(chop::div(8.0, 4.0) == 2.0);
+    CHECK(bits(chop::add(0.1, 0.2)) == 0x3FD3333333333333ull);   // nearest gives 0.30000000000000004
+    CHECK(chop::sub(1.0, 0.25) == 0.75);
+    CHECK(chop::div(-2.0, 3.0) == -chop::div(2.0, 3.0));
+}
+
+TEST_CASE("chop: Verses percent and the damage it gives (WarheadType 0x75DDCC, 0x489227)") {
+    struct Row { int dmg, pct, want; };
+    const Row rows[] = {{100, 30, 29}, {100, 29, 28}, {100, 35, 34}, {50, 60, 29}, {1000, 75, 750},
+                        {200, 45, 89}, {300, 15, 44},  {100, 100, 100}, {250, 7, 17}, {40, 90, 35}, {66, 50, 33}};
+    for (const Row& r : rows)
+        CHECK(om::ftol(chop::mul(static_cast<double>(r.dmg), chop::percent(r.pct))) == r.want);
+}
