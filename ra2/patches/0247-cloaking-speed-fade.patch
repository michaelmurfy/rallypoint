+TEST_CASE("w7airnav CloakingSpeed=: per-type fade and re-cloak step") {
+    ra2assets::MapFile map;
+    World w(map);
+    UnitCombat sub;
+    sub.strength = 800;
+    sub.image = "W7SUB";
+    sub.damage = 90;
+    sub.rof = 15;
+    sub.range = 5.0;
+    sub.verses = std::vector<int>(11, 100);
+    sub.an.underwater = true;
+    sub.an.cloakable = true;
+    sub.an.cloak_fade_frames = 4;
+    w.add_combat_unit(2, 3, 0, sub);
+    REQUIRE(w.units()[0].an.submerged);   // spawned cloaked, no fade at spawn
+    CHECK(w.units()[0].an.cloak_left_frames == 0);
+    // Firing surfaces it: CloakDelay (18) runs with the fade pinned ...
+    w.units()[0].fire_flash = 0.4;   // kFireFlashSecs, exactly what a real shot stamps
+    w.step(1.0 / 15.0);
+    w.units()[0].fire_flash = 0.0;
+    CHECK(!w.units()[0].an.submerged);
+    CHECK(w.units()[0].an.surface_left_frames == 17);
+    CHECK(w.units()[0].an.cloak_left_frames == 4);
+    // ... still surfaced while the delay runs ...
+    for (int f = 0; f < 17; ++f) {
+        w.units()[0].fire_flash = 0.0;
+        w.step(1.0 / 15.0);
+    }
+    CHECK(w.units()[0].an.surface_left_frames == 0);
+    CHECK(w.units()[0].an.cloak_left_frames == 4);
+    CHECK(!w.units()[0].an.submerged);
+    // ... then re-cloaks one step per frame over the fade.
+    for (int f = 0; f < 3; ++f) {
+        w.units()[0].fire_flash = 0.0;
+        w.step(1.0 / 15.0);
+        CHECK(!w.units()[0].an.submerged);
+    }
+    CHECK(w.units()[0].an.cloak_left_frames == 1);
+    w.units()[0].fire_flash = 0.0;
+    w.step(1.0 / 15.0);
+    CHECK(w.units()[0].an.cloak_left_frames == 0);
+    CHECK(w.units()[0].an.submerged);
+    // A type without the key keeps the legacy instant re-cloak.
+    UnitCombat nospeed = sub;
+    nospeed.an.cloak_fade_frames = 0;
+    w.add_combat_unit(6, 6, 0, nospeed);
+    REQUIRE(w.units()[1].an.submerged);
+    w.units()[1].fire_flash = 0.4;
+    w.step(1.0 / 15.0);
+    w.units()[1].fire_flash = 0.0;
+    CHECK(!w.units()[1].an.submerged);
+    for (int f = 0; f < 18; ++f) {
+        w.units()[1].fire_flash = 0.0;
+        w.step(1.0 / 15.0);
+    }
+    CHECK(w.units()[1].an.submerged);
+    CHECK(w.units()[1].an.cloak_left_frames == 0);
+}
