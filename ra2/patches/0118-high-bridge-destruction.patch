+TEST_CASE("high bridge: a normal deck-height projectile impact passes the destruction gate") {
+    if (!ra2fixture::mapsmd03_available()) { MESSAGE("no install"); return; }
+    World w(ra2fixture::mapsmd03_map());
+    arm_high(w);
+    const int lv = w.cell_level(12, 20);
+    const int projectile_z = w.deck_z(12, 20);  // impact of a shot at a deck-cell target
+    const int window_top = (lv + 1) * 104 + 416;
+    REQUIRE(projectile_z > (lv - 2) * 104 + 416);
+    REQUIRE(projectile_z <= window_top);
+    // The old on-deck target arithmetic added unit_lz (416) to this absolute
+    // deck height, putting the roll three levels above the window.
+    const int old_bz = std::max(projectile_z, w.deck_z(12, 20) + 416);
+    CHECK(old_bz > window_top);
+    CHECK(w.bridge_area_roll(12.0, 20.0, 5000, kW6Wall, projectile_z) == 5);
+    CHECK(w.high_bridge_destroyed(12, 20));
+}
