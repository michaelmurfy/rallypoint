+TEST_CASE("slave miner: killer-house liberation on unit master death") {
+    Rig r;
+    r.buildings.clear();
+    Unit smin;
+    smin.cell_x = 10;
+    smin.cell_y = 10;
+    smin.fx = 10;
+    smin.fy = 10;
+    smin.house = 0;
+    smin.alive = true;
+    arm_slave_master(smin, 1, 500, 25, 4);
+    r.units.push_back(smin);
+    r.occ.set(10, 10, 0);
+    r.step(1.0 / 15.0);
