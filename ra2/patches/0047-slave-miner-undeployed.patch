+    r.units[0].alive = false;
+    r.units[0].die_time = 0.0;
+    r.step(1.0 / 15.0);
+    CHECK_FALSE(r.units[(size_t)slave_idx].is_slave);
+    CHECK(r.units[(size_t)slave_idx].house == 1);
+}
