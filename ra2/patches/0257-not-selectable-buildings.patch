+bool Input::building_selectable(int b) const {
+    if (b < 0 || b >= static_cast<int>(world_.buildings().size())) return false;
+    const Building& B = world_.buildings()[b];
+    if (B.type < 0 || B.type >= static_cast<int>(world_.btypes().size())) return true;
+    return world_.btypes()[static_cast<std::size_t>(B.type)].selectable;
