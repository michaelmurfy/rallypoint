+TEST_CASE("input: Selectable=no buildings are never selected, selectable ones are [0257]") {
+    // GAFWLL-style lamp (own house): the click falls through to a ground
+    // action in both schemes; a GAPILL-style pillbox still selects.
+    for (auto scheme : {Input::Scheme::Original, Input::Scheme::Legacy}) {
+        const MapFile map = MapFile::blank(40, 40);
+        World world(map);
+        ra2engine::BuildingTypeDef pill;
+        pill.id = "GAPILL"; pill.strength = 400; pill.selectable = true;
+        ra2engine::BuildingTypeDef lamp;
+        lamp.id = "INGALITE"; lamp.strength = 50; lamp.selectable = false;
+        world.set_building_types({pill, lamp});
+        const int pb = world.add_building(0, 10, 10, 2, 2, 0, 400, 0, 0.0, true);
+        const int lb = world.add_building(1, 20, 20, 1, 1, 0, 50, 0, 0.0, true);
+        REQUIRE(pb == 0); REQUIRE(lb == 1);
+        Camera cam;
+        Input in(world, cam, 1280, 720);
+        in.set_scheme(scheme);
+        int px = 0, py = 0;
+        px_for_cell(10, 10, px, py);
+        CHECK(in.action_at(px, py) == Input::Action::SelectBuilding);
+        left_click(in, px, py, false, 1000);
+        CHECK(in.selected_building() == pb);
+        px_for_cell(20, 20, px, py);
+        CHECK(in.action_at(px, py) != Input::Action::SelectBuilding);
+        left_click(in, px, py, false, 2000);
+        CHECK(in.selected_building() != lb);
+    }
+}
