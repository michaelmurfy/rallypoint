+TEST_CASE("building_damaged: one predicate, flips once while hp rises through the threshold") {
+    Building b = mk(0, 0, 2, 2);
+    b.max_hp = 1000;
+    int flips = 0; bool prev = true;
+    for (int hp = 0; hp <= 1000; ++hp) {
+        b.hp = hp;
+        const bool d = building_damaged(b, 0.3);
+        CHECK(d == (building_frame(b, 4, 0.3) == 1));   // main frame and overlays agree
+        if (d != prev) ++flips;
+        prev = d;
+    }
+    CHECK(flips == 1);
+    b.max_hp = 0; CHECK(!building_damaged(b, 0.5));
+}
