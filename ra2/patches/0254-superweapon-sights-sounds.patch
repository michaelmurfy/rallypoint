 // SuperweaponType [RE-GATE APPLIED: superweapon.md §4]. Unknown/absent ids -> None.
 SuperweaponType superweapon_type_from_id(int id);
 
+// Map a [<Special>] Type= name (what a building's SuperWeapon= section holds:
+// MultiMissile, IronCurtain, ..., PsychicReveal) to a SuperweaponType.
+// Case-insensitive; unknown/empty names -> None. Pure (no World/RNG).
+inline SuperweaponType superweapon_type_from_type_name(const std::string& name) {
+    std::string u;
+    u.reserve(name.size());
+    for (char c : name) u.push_back(static_cast<char>(std::toupper(static_cast<unsigned char>(c))));
+    if (u == "MULTIMISSILE") return SuperweaponType::Nuke;
+    if (u == "IRONCURTAIN") return SuperweaponType::IronCurtain;
+    if (u == "LIGHTNINGSTORM") return SuperweaponType::LightningStorm;
+    if (u == "CHRONOSPHERE") return SuperweaponType::ChronoSphere;
+    if (u == "CHRONOWARP") return SuperweaponType::ChronoWarp;
+    if (u == "PARADROP") return SuperweaponType::ParaDrop;
+    if (u == "AMERPARADROP") return SuperweaponType::AmerParaDrop;
+    if (u == "PSYCHICDOMINATOR") return SuperweaponType::PsychicDominator;
+    if (u == "SPYPLANE") return SuperweaponType::SpyPlane;
+    if (u == "GENETICCONVERTER") return SuperweaponType::GeneticConverter;
+    if (u == "FORCESHIELD") return SuperweaponType::ForceShield;
+    if (u == "PSYCHICREVEAL") return SuperweaponType::PsychicReveal;
+    return SuperweaponType::None;
+}
