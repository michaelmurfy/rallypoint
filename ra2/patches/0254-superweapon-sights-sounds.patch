+TEST_CASE("superweapon: [<Special>] Type= names map to all 12 types") {
+    CHECK(superweapon_type_from_type_name("MultiMissile") == SuperweaponType::Nuke);
+    CHECK(superweapon_type_from_type_name("IronCurtain") == SuperweaponType::IronCurtain);
+    CHECK(superweapon_type_from_type_name("LightningStorm") == SuperweaponType::LightningStorm);
+    CHECK(superweapon_type_from_type_name("ChronoSphere") == SuperweaponType::ChronoSphere);
+    CHECK(superweapon_type_from_type_name("ChronoWarp") == SuperweaponType::ChronoWarp);
+    CHECK(superweapon_type_from_type_name("ParaDrop") == SuperweaponType::ParaDrop);
+    CHECK(superweapon_type_from_type_name("AmerParaDrop") == SuperweaponType::AmerParaDrop);
+    CHECK(superweapon_type_from_type_name("PsychicDominator") == SuperweaponType::PsychicDominator);
+    CHECK(superweapon_type_from_type_name("SpyPlane") == SuperweaponType::SpyPlane);
+    CHECK(superweapon_type_from_type_name("GeneticConverter") == SuperweaponType::GeneticConverter);
+    CHECK(superweapon_type_from_type_name("ForceShield") == SuperweaponType::ForceShield);
+    CHECK(superweapon_type_from_type_name("PsychicReveal") == SuperweaponType::PsychicReveal);
+    CHECK(superweapon_type_from_type_name("psychicdominator") == SuperweaponType::PsychicDominator);
+    CHECK(superweapon_type_from_type_name("MULTIMISSILE") == SuperweaponType::Nuke);
+    CHECK(superweapon_type_from_type_name("") == SuperweaponType::None);
+    CHECK(superweapon_type_from_type_name("IonCannon") == SuperweaponType::None);
+}
+
+TEST_CASE("superweapon: dominator fire posts Activated, its effect posts Detonated") {
+    const ra2assets::MapFile map = ra2assets::MapFile::blank(40, 40);
+    World w(map);
+    w.grant_superweapon_type(0, SuperweaponType::PsychicDominator, /*recharge_secs=*/0.5,
+                             /*is_powered=*/false, 0, 0.0, 1.0, {});
+    for (int i = 0; i < 15 && !w.sw_ready(0, SuperweaponType::PsychicDominator); ++i)
+        w.step(1.0 / 15.0);
+    REQUIRE(w.sw_ready(0, SuperweaponType::PsychicDominator));
+    REQUIRE(w.fire_superweapon_at(0, SuperweaponType::PsychicDominator, 10, 10));
+    // Retail default: 90-frame head anim, the effect 20% in (frame 18).
+    for (int i = 0; i < 30; ++i) w.step(1.0 / 15.0);
+    bool activated = false, detonated = false;
+    for (const SwEvent& e : w.sw_events()) {
+        if (e.type != static_cast<int>(SuperweaponType::PsychicDominator)) continue;
+        if (e.kind == SwEvent::Activated && e.x == 10 && e.y == 10) activated = true;
+        if (e.kind == SwEvent::Detonated && e.x == 10 && e.y == 10) detonated = true;
+    }
+    CHECK(activated);
+    CHECK(detonated);
+}
