diff --git a/engine/slot_anim_range.hpp b/engine/slot_anim_range.hpp
new file mode 100644
index 0000000..d3d50cc
--- /dev/null
+++ b/engine/slot_anim_range.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+
+namespace ra2engine {
+
+// Slot variants can use different portions of one SHP. Keep each variant
+// inside the frame range before the next sibling's Start= boundary.
+template <typename Anim, typename ImageFor>
+void clamp_slot_anim_ranges(const std::array<Anim*, 3>& variants, ImageFor image_for) {
+    for (Anim* anim : variants) {
+        if (!anim) continue;
+        const auto image = image_for(*anim);
+        int end = anim->end;
+        for (const Anim* sibling : variants) {
+            if (!sibling || sibling == anim || sibling->start <= anim->start) continue;
+            if (image_for(*sibling) == image) end = std::min(end, sibling->start);
+        }
+        if (end >= anim->end) continue;
+        anim->end = std::max(anim->start + 1, end);
+        anim->loop_start = std::clamp(anim->loop_start, anim->start, anim->end - 1);
+        anim->loop_end = std::clamp(anim->loop_end, anim->loop_start + 1, anim->end);
+    }
+}
+
+} // namespace ra2engine
diff --git a/tests/test_slot_anim_range.cpp b/tests/test_slot_anim_range.cpp
new file mode 100644
index 0000000..41c8048
--- /dev/null
+++ b/tests/test_slot_anim_range.cpp
@@ -0,0 +1,32 @@
+#include "doctest.h"
+#include "../engine/slot_anim_range.hpp"
+
+#include <array>
+#include <string>
+
+namespace {
+struct SyntheticSlotAnim {
+    std::string image;
+    int start;
+    int end;
+    int loop_start;
+    int loop_end;
+};
+}
+
+TEST_CASE("slot animation variants sharing an image stop at the next Start frame") {
+    // Shadow=yes makes the two-image SHP expose two animation frames. With no
+    // End=, fill_type initially gives both variants the full [0, 2) range.
+    SyntheticSlotAnim healthy{"GACSPH_E", 0, 2, 0, 2};
+    SyntheticSlotAnim damaged{"GACSPH_E", 1, 2, 1, 2};
+    const std::array<SyntheticSlotAnim*, 3> variants{&healthy, &damaged, nullptr};
+
+    ra2engine::clamp_slot_anim_ranges(variants, [](const SyntheticSlotAnim& anim) { return anim.image; });
+
+    CHECK(healthy.start == 0);
+    CHECK(healthy.end == 1);
+    CHECK(healthy.loop_start == 0);
+    CHECK(healthy.loop_end == 1);
+    CHECK(damaged.start == 1);
+    CHECK(damaged.end == 2);
+}
