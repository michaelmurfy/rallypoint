+TEST_CASE("Input: a parachuting unit is selectable and can deploy") {
+    const MapFile map = MapFile::blank(40, 40);
+    World world(map);
+    world.add_combat_unit(10, 10, 0, gi_combat());
+    ra2engine::Unit& para = world.units()[0];
+    para.cargo_of = ra2engine::kParachuteCargo;
+    para.an.para_alt = 100.0;
+    para.deploy_fire = true;
+
+    Camera cam;
+    Input input(world, cam, 1280, 720);
+    int px, py;
+    ground_px_for_unit(para, px, py);
+    left_click(input, px, py, false, 1000);
+    CHECK(input.selection().has(0));
+
+    input.set_deploy_check([](const ra2engine::Unit& u) { return u.deploy_fire; });
+    CHECK(input.action_at(px, py) == Input::Action::Deploy);
+    CHECK(world.order_deploy(0));
+    CHECK(para.deployed);
+
+    // Garrison cargo remains unselectable; only the parachute sentinel is an
+    // off-map exception.
+    para.deployed = false;
+    para.cargo_of = ra2engine::kGarrisonCargo;
+    input.selection().clear();
+    left_click(input, px, py, false, 2000);
+    CHECK_FALSE(input.selection().has(0));
+}
