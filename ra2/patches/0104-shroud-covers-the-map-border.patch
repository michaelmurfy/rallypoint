diff --git a/engine/pres_shroud.inc b/engine/pres_shroud.inc
index d1b9fe3..e631e08 100644
--- a/engine/pres_shroud.inc
+++ b/engine/pres_shroud.inc
@@ -104,10 +104,10 @@ void draw_shroud_pass(SDL_Renderer* ren, ra2engine::TextureCache& tc, const ra2a
     for (int pass = 0; pass < passes; ++pass) {   // 0 shroud, 1 fog (the original's order)
         const bool fog = pass == 1;
         const ra2assets::ShpFile* shp = fog ? g_fog_shp : g_shroud_shp;
-        ra2engine::for_each_visible_cell(map, cam, W, H, 2, [&](const ra2assets::MapCell& c, int sx, int sy) {
-            if (fog && !explored(c.x, c.y)) return;   // fully shrouded already
-            const int fr = fog ? pres_shroud::frame_for(c.x, c.y, visible)
-                               : pres_shroud::frame_for(c.x, c.y, explored);
+        auto paint = [&](int cx, int cy, int sx, int sy) {
+            if (fog && !explored(cx, cy)) return;   // fully shrouded already
+            const int fr = fog ? pres_shroud::frame_for(cx, cy, visible)
+                               : pres_shroud::frame_for(cx, cy, explored);
             if (fr == 0) return;
             SDL_Texture* tex = nullptr;
             SDL_Rect dst{sx, sy, 60, 30};
@@ -124,7 +124,38 @@ void draw_shroud_pass(SDL_Renderer* ren, ra2engine::TextureCache& tc, const ra2a
                 tex = pres_shroud::diamond_tex(tc, fog);
             }
             if (tex) SDL_RenderCopy(ren, tex, nullptr, &dst);
+        };
+        // Only the map cells that can reach the view (cached painter-order rows),
+        // so scrolling never walks the whole map twice a frame.
+        ra2engine::for_each_visible_cell(map, cam, W, H, 2, [&](const ra2assets::MapCell& c, int sx, int sy) {
+            paint(c.x, c.y, sx, sy);
         });
+        // Also cover a one-cell border of virtual cells around the map's terrain
+        // diamond, so the map border is shrouded like the interior instead of
+        // ending at a bare terrain edge. Out-of-map cells are never explored (see
+        // World::explored_at), so they read as fully covered and act as the
+        // "void" side of the edge. Only the ring is visited, not the whole map.
+        const auto& cells = map.cells();
+        if (cells.empty()) continue;
+        int min_cx = cells[0].x, max_cx = cells[0].x;
+        int min_cy = cells[0].y, max_cy = cells[0].y;
+        for (const auto& cc : cells) {
+            min_cx = std::min(min_cx, cc.x); max_cx = std::max(max_cx, cc.x);
+            min_cy = std::min(min_cy, cc.y); max_cy = std::max(max_cy, cc.y);
+        }
+        min_cx -= 1; max_cx += 1; min_cy -= 1; max_cy += 1;
+        for (int d = min_cx + min_cy; d <= max_cx + max_cy; ++d) {
+            const int x0 = std::max(min_cx, d - max_cy);
+            const int x1 = std::min(max_cx, d - min_cy);
+            for (int cx = x0; cx <= x1; ++cx) {
+                const int cy = d - cx;
+                if (cx != min_cx && cx != max_cx && cy != min_cy && cy != max_cy) continue;
+                const ra2engine::ScreenPt p = ra2engine::cell_to_screen(cx, cy, 0, 60, 30, 15);
+                const int sx = p.x + cam.x, sy = p.y + cam.y;
+                if (sx + 60 + 2 <= 0 || sy + 30 + 2 <= 0 || sx - 2 >= W || sy - 2 >= H) continue;
+                paint(cx, cy, sx, sy);
+            }
+        }
     }
 }
 
