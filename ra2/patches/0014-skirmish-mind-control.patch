diff --git a/engine/world_mind_control.cpp b/engine/world_mind_control.cpp
new file mode 100644
index 0000000..f3c59d8
--- /dev/null
+++ b/engine/world_mind_control.cpp
@@ -0,0 +1,132 @@
+// Skirmish / multiplayer CaptureManager (W7-08-14 / W7-10-02..04).
+// Campaign keeps its own poll_mind_control (teams, DecideUnitFate, Track::mc_orig);
+// it sets campaign_mind_control_ so this pass is a no-op there. Same rules as the
+// campaign path: MindControl primary warhead, shot via try_fire (mc_shot),
+// ImmuneToPsionics / Iron Curtain / already-controlled refused, capacity from
+// weapon Damage (InfiniteMindControl lifts it), FreeAll on death / board / Temporal.
+
+#include "world.hpp"
+
+#include <algorithm>
+
+namespace ra2engine {
+namespace {
+
+bool mc_live(const Unit& u) { return u.alive && u.die_time < 0.0; }
+
+bool mc_boarded(const Unit& u) {
+    return (u.cargo_of >= 0 && u.cargo_of != kParachuteCargo) || u.garrison_of >= 0;
+}
+
+}  // namespace
+
+void World::set_campaign_mind_control(bool on) { campaign_mind_control_ = on; }
+
+std::vector<std::pair<int, int>> World::mind_control_pairs() const {
+    std::vector<std::pair<int, int>> out;
+    for (std::size_t i = 0; i < units_.size(); ++i) {
+        for (int v : units_[i].w7.mc_victims)
+            if (v >= 0 && v < static_cast<int>(units_.size()))
+                out.push_back({static_cast<int>(i), v});
+    }
+    return out;
+}
+
+void World::mc_release(int ctl, int vi) {
+    if (ctl < 0 || ctl >= static_cast<int>(units_.size())) return;
+    if (vi < 0 || vi >= static_cast<int>(units_.size())) return;
+    Unit& cu = units_[static_cast<std::size_t>(ctl)];
+    Unit& vu = units_[static_cast<std::size_t>(vi)];
+    auto& vv = cu.w7.mc_victims;
+    vv.erase(std::remove(vv.begin(), vv.end(), vi), vv.end());
+    if (vu.w7.mc_controller != ctl) return;
+    vu.w7.mc_controller = -1;
+    const int orig = vu.w7.mc_orig_house;
+    vu.w7.mc_orig_house = -1;
+    if (orig < 0 || !mc_live(vu)) return;
+    set_unit_owner(vi, orig);
+}
+
+void World::mc_release_all(int ctl) {
+    if (ctl < 0 || ctl >= static_cast<int>(units_.size())) return;
+    const std::vector<int> vv = units_[static_cast<std::size_t>(ctl)].w7.mc_victims;
+    for (int v : vv) mc_release(ctl, v);
+    units_[static_cast<std::size_t>(ctl)].w7.mc_victims.clear();
+}
+
+bool World::mc_capture(int ctl, int vi) {
+    if (ctl < 0 || ctl >= static_cast<int>(units_.size())) return false;
+    if (vi < 0 || vi >= static_cast<int>(units_.size())) return false;
+    Unit& u = units_[static_cast<std::size_t>(ctl)];
+    Unit& v = units_[static_cast<std::size_t>(vi)];
+    if (!mc_live(u) || !mc_live(v) || mc_boarded(v) || v.house == u.house || v.is_aircraft)
+        return false;
+    if (!psionic_target_ok(vi) || v.an.iron_left_frames > 0) return false;
+    if (v.w7.mc_controller >= 0) return false;   // W7-08-11: no stealing
+    const int cap = std::max(1, u.w7.t.mc_capacity);
+    const bool infinite = u.w7.t.mc_infinite;
+    const bool full = !infinite && static_cast<int>(u.w7.mc_victims.size()) >= cap;
+    if (full) {
+        if (cap != 1 || infinite) return false;
+        mc_release(ctl, u.w7.mc_victims.front());   // Max == 1: swap
+    }
+    if (v.w7.mc_orig_house < 0) v.w7.mc_orig_house = v.house;
+    set_unit_owner(vi, u.house);
+    v.w7.mc_controller = ctl;
+    u.w7.mc_victims.push_back(vi);
+    u.target = -1;
+    u.attack_order = false;
+    return true;
+}
+
+void World::step_mind_control() {
+    if (campaign_mind_control_) return;
+    for (std::size_t i = 0; i < units_.size(); ++i) {
+        Unit& u = units_[i];
+        const int ci = static_cast<int>(i);
+        if (!u.w7.mc_victims.empty()) {
+            const std::vector<int> vv = u.w7.mc_victims;
+            for (int v : vv) {
+                if (v < 0 || v >= static_cast<int>(units_.size())) continue;
+                const Unit& vu = units_[static_cast<std::size_t>(v)];
+                if (!mc_live(vu) || vu.w7.mc_controller != ci) {
+                    auto& lst = u.w7.mc_victims;
+                    lst.erase(std::remove(lst.begin(), lst.end(), v), lst.end());
+                    if (!mc_live(vu) && v < static_cast<int>(units_.size())) {
+                        if (vu.w7.mc_controller == ci)
+                            units_[static_cast<std::size_t>(v)].w7.mc_controller = -1;
+                        units_[static_cast<std::size_t>(v)].w7.mc_orig_house = -1;
+                    }
+                } else if (mc_boarded(vu)) {
+                    mc_release(ci, v);
+                }
+            }
+        }
+        if (!mc_live(u) || u.cargo_of >= 0 || u.warp_remaining > 0) {
+            if (!u.w7.mc_victims.empty()) mc_release_all(ci);
+            u.w7.mc_shot = -1;
+            u.w_mind_control = false;
+            continue;
+        }
+        u.w_mind_control = u.w7.t.mind_control;
+        if (!u.w_mind_control) continue;
+        const int cap = std::max(1, u.w7.t.mc_capacity);
+        const bool infinite = u.w7.t.mc_infinite;
+        const bool full = !infinite && static_cast<int>(u.w7.mc_victims.size()) >= cap;
+        if (u.target >= 0 && u.target < static_cast<int>(units_.size())) {
+            const Unit& tv = units_[static_cast<std::size_t>(u.target)];
+            if (!psionic_target_ok(u.target) || tv.an.iron_left_frames > 0 ||
+                (tv.w7.mc_controller >= 0 && tv.w7.mc_controller != ci)) {
+                u.target = -1;
+                u.attack_order = false;
+            }
+        }
+        if (full && !u.attack_order && u.target >= 0) u.target = -1;
+        const int vi = u.w7.mc_shot;
+        u.w7.mc_shot = -1;
+        if (vi < 0) continue;
+        mc_capture(ci, vi);
+    }
+}
+
+}  // namespace ra2engine
diff --git a/tests/test_mind_control.cpp b/tests/test_mind_control.cpp
new file mode 100644
index 0000000..97fd795
--- /dev/null
+++ b/tests/test_mind_control.cpp
@@ -0,0 +1,148 @@
+// W7-08-14: skirmish/MP mind control (World::step_mind_control).
+#include "doctest.h"
+
+#include "asset_fixture.hpp"
+#include "world.hpp"
+
+using namespace ra2engine;
+
+namespace {
+
+UnitCombat mk_gi() {
+    UnitCombat c;
+    c.image = "E1";
+    c.strength = 125;
+    c.armor = "none";
+    c.damage = 15;
+    c.rof = 20;
+    c.range = 4.0;
+    c.verses = std::vector<int>(11, 100);
+    return c;
+}
+
+UnitCombat mk_yuri(int capacity = 1, bool infinite = false) {
+    UnitCombat c = mk_gi();
+    c.image = "YURI";
+    c.w7.mind_control = true;
+    c.w7.mc_capacity = capacity;
+    c.w7.mc_infinite = infinite;
+    c.damage = capacity;
+    c.rof = 15;
+    c.range = 7.0;
+    return c;
+}
+
+bool open_cell(const World& w, int& x, int& y) {
+    for (int yy = 2; yy + 4 < w.grid_h() - 2; ++yy)
+        for (int xx = 2; xx + 8 < w.grid_w() - 2; ++xx)
+            if (w.walkable(xx, yy) && w.walkable(xx + 2, yy) && w.unit_at_cell(xx, yy) < 0 &&
+                w.unit_at_cell(xx + 2, yy) < 0) {
+                x = xx;
+                y = yy;
+                return true;
+            }
+    return false;
+}
+
+}  // namespace
+
+#define MC_WORLD(world, x0, y0)                                              \
+    if (!ra2fixture::mapsmd03_available()) {                                 \
+        MESSAGE("skipped: real map assets not found under RA2_INSTALL_DIR"); \
+        return;                                                              \
+    }                                                                        \
+    World world(ra2fixture::mapsmd03_map());                                 \
+    int x0 = 0, y0 = 0;                                                      \
+    REQUIRE(open_cell(world, x0, y0));
+
+TEST_CASE("mind control: Controller shot captures (no damage), ImmuneToPsionics refuses") {
+    MC_WORLD(w, x0, y0);
+    w.add_combat_unit(x0, y0, 0, mk_yuri());
+    w.add_combat_unit(x0 + 2, y0, 1, mk_gi());
+    Unit& yuri = w.units()[0];
+    Unit& gi = w.units()[1];
+    const int hp = gi.hp;
+    yuri.w7.mc_shot = 1;
+    w.step_mind_control();
+    CHECK(gi.house == 0);
+    CHECK(gi.w7.mc_controller == 0);
+    CHECK(gi.w7.mc_orig_house == 1);
+    CHECK(yuri.w7.mc_victims.size() == 1);
+    CHECK(yuri.w7.mc_victims[0] == 1);
+    CHECK(gi.hp == hp);
+
+    UnitCombat dog = mk_gi();
+    dog.image = "DOG";
+    dog.tg.immune_psionics = true;
+    w.add_combat_unit(x0 + 4, y0, 1, dog);
+    CHECK_FALSE(w.mc_capture(0, 2));
+    CHECK(w.units()[2].house == 1);
+    CHECK(gi.house == 0);
+}
+
+TEST_CASE("mind control: capacity-1 swap; capacity-3 holds three; release on death") {
+    MC_WORLD(w, x0, y0);
+    w.add_combat_unit(x0, y0, 0, mk_yuri(1));
+    w.add_combat_unit(x0 + 2, y0, 1, mk_gi());
+    w.add_combat_unit(x0 + 4, y0, 1, mk_gi());
+    REQUIRE(w.mc_capture(0, 1));
+    REQUIRE(w.mc_capture(0, 2));   // frees 1, takes 2
+    CHECK(w.units()[1].house == 1);
+    CHECK(w.units()[1].w7.mc_controller < 0);
+    CHECK(w.units()[2].house == 0);
+    CHECK(w.units()[0].w7.mc_victims.size() == 1);
+
+    World w2(ra2fixture::mapsmd03_map());
+    int a = 0, b = 0;
+    REQUIRE(open_cell(w2, a, b));
+    w2.add_combat_unit(a, b, 0, mk_yuri(3));
+    w2.add_combat_unit(a + 2, b, 1, mk_gi());
+    w2.add_combat_unit(a + 4, b, 1, mk_gi());
+    w2.add_combat_unit(a + 6, b, 1, mk_gi());
+    w2.add_combat_unit(a + 8, b, 1, mk_gi());
+    CHECK(w2.mc_capture(0, 1));
+    CHECK(w2.mc_capture(0, 2));
+    CHECK(w2.mc_capture(0, 3));
+    CHECK_FALSE(w2.mc_capture(0, 4));   // full, Max > 1
+    CHECK(w2.units()[0].w7.mc_victims.size() == 3);
+
+    w2.units()[0].alive = false;
+    w2.step_mind_control();
+    CHECK(w2.units()[0].w7.mc_victims.empty());
+    CHECK(w2.units()[1].house == 1);
+    CHECK(w2.units()[2].house == 1);
+    CHECK(w2.units()[3].house == 1);
+}
+
+TEST_CASE("mind control: campaign flag skips World pass; pairs after capture") {
+    MC_WORLD(w, x0, y0);
+    w.set_campaign_mind_control(true);
+    w.add_combat_unit(x0, y0, 0, mk_yuri());
+    w.add_combat_unit(x0 + 2, y0, 1, mk_gi());
+    w.units()[0].w7.mc_shot = 1;
+    w.step_mind_control();
+    CHECK(w.units()[1].house == 1);   // untouched
+
+    World w2(ra2fixture::mapsmd03_map());
+    int a = 0, b = 0;
+    REQUIRE(open_cell(w2, a, b));
+    w2.add_combat_unit(a, b, 0, mk_yuri());
+    w2.add_combat_unit(a + 2, b, 1, mk_gi());
+    w2.units()[0].w7.mc_shot = 1;
+    w2.step_mind_control();
+    CHECK(w2.units()[1].house == 0);
+    const auto pairs = w2.mind_control_pairs();
+    REQUIRE(pairs.size() == 1);
+    CHECK(pairs[0].first == 0);
+    CHECK(pairs[0].second == 1);
+}
+
+TEST_CASE("mind control: already-controlled target is refused (no steal)") {
+    MC_WORLD(w, x0, y0);
+    w.add_combat_unit(x0, y0, 0, mk_yuri());
+    w.add_combat_unit(x0 + 2, y0, 0, mk_yuri());
+    w.add_combat_unit(x0 + 4, y0, 1, mk_gi());
+    REQUIRE(w.mc_capture(0, 2));
+    CHECK_FALSE(w.mc_capture(1, 2));
+    CHECK(w.units()[2].w7.mc_controller == 0);
+}
