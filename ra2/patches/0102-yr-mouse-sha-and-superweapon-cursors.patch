+    CHECK(superweapon_cursor(SuperweaponType::GeneticConverter) == 0x51);
+    CHECK(superweapon_cursor(SuperweaponType::ForceShield) == 0x4F);
+    CHECK(superweapon_cursor(SuperweaponType::PsychicReveal) == 0x54);
