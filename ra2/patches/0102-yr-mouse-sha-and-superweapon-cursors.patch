+// [RE: DisplayClass::ConvertAction FUN_004aae90]:
+//   Action 0x14 Nuke -> 0x35, 0x25 IronCurtain -> 0x39,
+//   0x26 LightningStorm -> 0x32, 0x27/0x28 ChronoSphere/ChronoWarp -> 0x3A,
+//   0x29/0x41 ParaDrop/AmerParaDrop -> 0x2F, 0x42 PsychicDominator -> 0x53,
+//   0x43 SpyPlane -> 0x55, 0x44 GeneticConverter -> 0x51,
+//   0x45 ForceShield -> 0x4F, 0x48 PsychicReveal -> 0x54.
+inline int superweapon_cursor(SuperweaponType t) {
+    switch (t) {
+        case SuperweaponType::Nuke:             return 0x35;
+        case SuperweaponType::IronCurtain:      return 0x39;
+        case SuperweaponType::LightningStorm:   return 0x32;
+        case SuperweaponType::ChronoSphere:
+        case SuperweaponType::ChronoWarp:       return 0x3A;
+        case SuperweaponType::ParaDrop:
+        case SuperweaponType::AmerParaDrop:     return 0x2F;
+        case SuperweaponType::PsychicDominator: return 0x53;
+        case SuperweaponType::SpyPlane:         return 0x55;
+        case SuperweaponType::GeneticConverter: return 0x51;
+        case SuperweaponType::ForceShield:      return 0x4F;
+        case SuperweaponType::PsychicReveal:    return 0x54;
+        default:                                return 0x35;
+    }
+}
+
 }  // namespace ra2engine
