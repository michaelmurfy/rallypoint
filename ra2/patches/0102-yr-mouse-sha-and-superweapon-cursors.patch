+    CHECK(mouse_cursor_desc(0x32).count == 20);
+    CHECK(mouse_cursor_desc(0x35).start == 319);
+    CHECK(mouse_cursor_desc(0x35).count == 10);
+    CHECK(mouse_cursor_desc(0x39).start == 346);
+    CHECK(mouse_cursor_desc(0x39).count == 5);
+    CHECK(mouse_cursor_desc(0x3A).start == 357);
+    CHECK(mouse_cursor_desc(0x3A).count == 12);
+    CHECK(mouse_cursor_desc(0x4F).start == 450);
+    CHECK(mouse_cursor_desc(0x51).start == 470);
+    CHECK(mouse_cursor_desc(0x53).start == 488);
+    CHECK(mouse_cursor_desc(0x54).start == 496);
+    CHECK(mouse_cursor_desc(0x55).start == 504);
