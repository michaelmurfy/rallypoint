+// Harvesters on a real map: n driving HARV around one refinery for 4 minutes.
+void probe_econ(MoveProbe& p, const Rules& rules, const std::string& map, int n_harv) {
+    using P = MoveProbe;
+    using RP = RealPlayProbe;
+    ra2engine::SkirmishConfig cfg = P::cfg_for(rules, map);
+    GameScene g(true, cfg);
+    RP::deploy_start(g);
+    ra2engine::World& w = P::world(g);
+    RP::add_instant(g, "GAPOWR");
+    RP::add_instant(g, "GAPOWR");
+    const int t = roster_index(RP::ba(g), "GAREFN");
+    int rx = 0, ry = 0;
+    if (t < 0 || !RP::find_spot(g, t, rx, ry)) { std::cout << "[move] econ: no refinery spot\n"; return; }
+    g.place_building(t, rx, ry);
+    for (int f = 0; f < 15 * 25; ++f) g.update(1.0 / 15.0);   // build-up and the free miner
+    std::vector<int> hv;
+    for (int k = 0; k < n_harv; ++k) {
+        const int i = P::spawn_near(g, "HARV", 0, rx + 2, ry + 4);
+        if (i >= 0) { w.make_harvester(i, false, 40); hv.push_back(i); }
+    }
+    if (std::getenv("PROBE_VERBOSE"))
+        for (const ra2engine::Building& b : w.buildings())
+            if (b.alive && b.house == 0)
+                std::cout << "[move]     building " << RP::ba(g).roster[b.type].id << " at (" << b.cx << "," << b.cy << ") " << b.fw << "x" << b.fh << " state=" << (int)b.state << "\n";
+    const double c0 = RP::credits(g);
+    std::vector<int> unloads(hv.size(), 0), stall(hv.size(), 0), wait_dock(hv.size(), 0), seek(hv.size(), 0), moveore(hv.size(), 0), ret(hv.size(), 0), harvest(hv.size(), 0);
+    std::vector<ra2engine::HarvState> prev(hv.size(), ra2engine::HarvState::None);
+    std::vector<double> px(hv.size()), py(hv.size()), dist(hv.size(), 0.0);
+    for (size_t k = 0; k < hv.size(); ++k) { px[k] = w.units()[(size_t)hv[k]].fx; py[k] = w.units()[(size_t)hv[k]].fy; }
+    const int frames = 15 * 240;
+    for (int f = 0; f < frames; ++f) {
+        g.update(1.0 / 15.0);
+        for (size_t k = 0; k < hv.size(); ++k) {
+            const ra2engine::Unit& u = w.units()[(size_t)hv[k]];
+            if (!u.alive) continue;
+            const double d = std::hypot(u.fx - px[k], u.fy - py[k]);
+            dist[k] += d; px[k] = u.fx; py[k] = u.fy;
+            if (u.moving() && d < 1e-9) ++stall[k];
+            if (std::getenv("PROBE_VERBOSE") && k == 0 && f % 300 == 0)
+                for (size_t q = 0; q < w.units().size(); ++q) {
+                    const ra2engine::Unit& o = w.units()[q];
+                    if (o.alive && o.house == 0 && (o.is_harvester || o.is_vehicle))
+                        std::cout << "[move]       unit#" << q << " " << o.image << " harv=" << o.is_harvester << " chrono=" << o.chrono_miner << " cell=(" << o.cell_x << "," << o.cell_y << ") state=" << (int)o.harv
+                                  << " moving=" << o.moving() << " bales=" << o.bales_ore << " dock_ref=" << o.dock_refinery << "\n";
+                }
+            if (std::getenv("PROBE_VERBOSE") && k == 0 && f % 45 == 0 && f > 2000)
+                std::cout << "[move]     f=" << f << " harv cell=(" << u.cell_x << "," << u.cell_y << ") state=" << (int)u.harv << " path=" << u.path_idx << "/" << u.path.size()
+                          << " goal=(" << (u.path.empty() ? -1 : u.path.back().x) << "," << (u.path.empty() ? -1 : u.path.back().y) << ") wait=" << u.wait_time << " dock_ref=" << u.dock_refinery
+                          << " bales=" << u.bales_ore + u.bales_gems << " manual_hold=" << u.manual_hold << "\n";
+            if (u.harv == ra2engine::HarvState::Unloading && prev[k] != ra2engine::HarvState::Unloading) ++unloads[k];
+            prev[k] = u.harv;
+            switch (u.harv) {
+                case ra2engine::HarvState::WaitDock: ++wait_dock[k]; break;
+                case ra2engine::HarvState::SeekOre: ++seek[k]; break;
+                case ra2engine::HarvState::MoveToOre: ++moveore[k]; break;
+                case ra2engine::HarvState::ReturnToRef: ++ret[k]; break;
+                case ra2engine::HarvState::Harvesting: ++harvest[k]; break;
+                default: break;
+            }
+        }
+    }
+    int tot = 0;
+    for (size_t k = 0; k < hv.size(); ++k) {
+        tot += unloads[k];
+        std::cout << "[move] ECON " << n_harv << "xHARV #" << k << " unloads=" << unloads[k] << " travelled=" << dist[k] << " cells; frames: moveToOre=" << moveore[k]
+                  << " harvesting=" << harvest[k] << " return=" << ret[k] << " waitDock=" << wait_dock[k] << " seek=" << seek[k] << " stalled-while-moving=" << stall[k] << "\n";
+    }
+    std::cout << "[move] ECON " << n_harv << "xHARV total_unloads=" << tot << " income=" << RP::credits(g) - c0 << " in " << frames / 15 << " s refinery=(" << rx << "," << ry << ")\n";
+    (void)p;
+}
