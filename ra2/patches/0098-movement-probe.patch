+// What each house starts with (the gf start force) on a real map.
+void probe_start(MoveProbe& p, const Rules& rules, const std::string& map) {
+    using P = MoveProbe;
+    GameScene g(true, P::cfg_for(rules, map));
+    ra2engine::World& w = P::world(g);
+    std::map<int, std::map<std::string, int>> per;
+    for (const ra2engine::Unit& u : w.units())
+        if (u.alive && (u.house == 0 || u.house == 1)) ++per[u.house][u.image + (u.hp > 0 ? "" : "(hp0)")];
+    for (auto& [h, m] : per) {
+        std::cout << "[move] START " << map << " house " << h << ":";
+        int total = 0;
+        for (auto& [img, n] : m) { std::cout << " " << img << "x" << n; total += n; }
+        std::cout << " (total " << total << ")\n";
+    }
+    (void)p;
+}
