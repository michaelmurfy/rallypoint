+// Shape of the path A* returns in open ground: direction string and number of turns.
+void probe_shape(MoveProbe& p, const Rules& rules, const std::string& map) {
+    using P = MoveProbe;
+    GameScene g(true, P::cfg_for(rules, map));
+    ra2engine::World& w = P::world(g);
+    int ox = 0, oy = 0;
+    if (!P::open_rect(w, 22, 13, ox, oy)) { std::cout << "[move] shape: no open area\n"; return; }
+    static const int T[][2] = {{17, 7}, {10, 10}, {12, 5}, {20, 3}, {6, 11}, {19, 12}, {5, 2}, {15, 11}};
+    const char* dn = "NEESSWWN";   // placeholder, built below
+    (void)dn;
+    int total_turns = 0, total_min = 0;
+    for (auto& t : T) {
+        const int a = P::spawn_near(g, "MTNK", 0, ox + 1, oy + 1);
+        const ra2engine::Unit& u0 = w.units()[(size_t)a];
+        const int sx = u0.cell_x, sy = u0.cell_y;
+        w.order_unit_move(a, sx + t[0], sy + t[1]);
+        const ra2engine::Unit& u = w.units()[(size_t)a];
+        std::string s; int turns = 0, pd = -1;
+        for (size_t k = 1; k < u.path.size(); ++k) {
+            const int dx = u.path[k].x - u.path[k - 1].x, dy = u.path[k].y - u.path[k - 1].y;
+            const int d = (dx + 1) * 3 + (dy + 1);
+            static const char* nm[9] = {"NW", "W", "SW", "N", "?", "S", "NE", "E", "SE"};
+            // screen-less: x east, y south
+            s += (k > 1 ? "," : ""); s += nm[d];
+            if (pd >= 0 && d != pd) ++turns;
+            pd = d;
+        }
+        const int minturns = (t[0] != 0 && t[1] != 0 && t[0] != t[1]) ? 1 : 0;
+        total_turns += turns; total_min += minturns;
+        std::cout << "[move] SHAPE (" << t[0] << "," << t[1] << ") cells=" << u.path.size() - 1 << " turns=" << turns << " (ideal " << minturns << ") " << s.substr(0, 150) << "\n";
+        w.order_unit_move(a, sx, sy);   // park: cancel
+        w.units()[(size_t)a].path.clear();
+        w.units()[(size_t)a].alive = false;
+    }
+    std::cout << "[move] SHAPE total turns=" << total_turns << " ideal=" << total_min << "\n";
+}
