+// Units leaving a war factory one after another.
+void probe_factory(MoveProbe& p, const Rules& rules, const std::string& map, int n) {
+    using P = MoveProbe;
+    using RP = RealPlayProbe;
+    GameScene g(true, P::cfg_for(rules, map));
+    RP::deploy_start(g);
+    ra2engine::World& w = P::world(g);
+    RP::add_instant(g, "GAPOWR");
+    RP::add_instant(g, "GAPOWR");
+    RP::add_instant(g, "GAREFN");
+    const int t = roster_index(RP::ba(g), "GAWEAP");
+    int rx = 0, ry = 0;
+    if (t < 0 || !RP::find_spot(g, t, rx, ry)) { std::cout << "[move] factory: no spot\n"; return; }
+    RP::add_instant(g, "GAWEAP");
+    const int bi = RP::own_index(g, "GAWEAP");
+    if (bi < 0) { std::cout << "[move] factory: none\n"; return; }
+    const ra2engine::BuildingTypeDef& def = RP::ba(g).roster[t];
+    const ra2engine::Building& fb = w.buildings()[(size_t)bi];
+    std::cout << "[move] FACTORY at (" << fb.cx << "," << fb.cy << ") " << fb.fw << "x" << fb.fh << "\n";
+    std::vector<int> ids; std::vector<int> t_launch, t_idle;
+    for (int k = 0; k < n; ++k) {
+        const int u = w.launch_unit(bi, def, P::combat_of(g, "MTNK"));
+        if (u < 0) { std::cout << "[move]   launch " << k << ": no free exit cell\n"; for (int f = 0; f < 15; ++f) g.update(1.0 / 15.0); --k; if (ids.size() + 1 > (size_t)n) break; continue; }
+        w.units()[(size_t)u].hp = w.units()[(size_t)u].max_hp = 100000000;
+        ids.push_back(u); t_launch.push_back(k * 30); t_idle.push_back(-1);
+        for (int f = 0; f < 30; ++f) g.update(1.0 / 15.0);
+    }
+    int frame = (int)ids.size() * 30;
+    for (; frame < 15 * 90; ++frame) {
+        g.update(1.0 / 15.0);
+        for (size_t k = 0; k < ids.size(); ++k)
+            if (t_idle[k] < 0 && !w.units()[(size_t)ids[k]].moving() && frame > t_launch[k] + 5) t_idle[k] = frame - t_launch[k];
+    }
+    int moving = 0, far = 0;
+    for (size_t k = 0; k < ids.size(); ++k) {
+        const ra2engine::Unit& u = w.units()[(size_t)ids[k]];
+        const int d = std::max(std::abs(u.cell_x - (fb.cx + fb.fw / 2)), std::abs(u.cell_y - (fb.cy + fb.fh)));
+        std::cout << "[move]   unit " << k << " end=(" << u.cell_x << "," << u.cell_y << ") dist_to_door=" << d << " idle_after=" << (t_idle[k] < 0 ? -1.0 : t_idle[k] / 15.0) << " s moving=" << u.moving() << "\n";
+        moving += u.moving(); far = std::max(far, d);
+    }
+    std::cout << "[move] FACTORY launched " << ids.size() << "/" << n << " still_moving=" << moving << " farthest_from_door=" << far << "\n";
+    (void)p;
+}
