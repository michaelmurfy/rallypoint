+int run_probe_move(const std::string& map) {
+    using P = MoveProbe;
+    const std::string dir = env_install_dir();
+    Ini rules_ini = load_ini_from_ra2md(dir, "rulesmd.ini");
+    Rules rules = Rules::load(rules_ini);
+    P p;
+    if (std::getenv("PROBE_FACTORY")) { probe_factory(p, rules, map, 8); return 0; }
+    if (std::getenv("PROBE_START")) { probe_start(p, rules, map); return 0; }
+    if (std::getenv("PROBE_ECON")) { probe_econ(p, rules, map, 1); probe_econ(p, rules, map, 3); return 0; }
+    if (std::getenv("PROBE_SHAPE")) { probe_shape(p, rules, map); return 0; }
+    if (std::getenv("PROBE_SCEN2")) {
+        for (int every : {8, 15, 30}) probe_spam(p, rules, map, "MTNK", every);
+        probe_spam(p, rules, map, "E1", 8);
+        probe_unreachable(p, rules, map, "MTNK");
+        probe_unreachable(p, rules, map, "E1");
+        probe_block_midway(p, rules, map, "MTNK");
+        probe_block_midway(p, rules, map, "E1");
+        probe_same_goal(p, rules, map, "MTNK", 8);
+        probe_same_goal(p, rules, map, "E1", 8);
+        return p.fails ? 1 : 0;
+    }
+    if (std::getenv("PROBE_SCEN")) {
+        if (!std::getenv("ONLY_CORR")) { probe_group(p, rules, map, 6, 6, "MTNK");
+        probe_group(p, rules, map, 12, 0, "HTNK");
+        probe_group(p, rules, map, 0, 12, "E1");
+        probe_group(p, rules, map, 10, 10, "APOC"); }
+        probe_corridor(p, rules, map, "MTNK", "MTNK", false);
+        probe_corridor(p, rules, map, "MTNK", "E1", false);
+        probe_corridor(p, rules, map, "E1", "MTNK", false);
+        probe_corridor(p, rules, map, "MTNK", "MTNK", true);
+        probe_corridor(p, rules, map, "E1", "E1", true);
+        return p.fails ? 1 : 0;
+    }
+    const char* kTypes[] = {"MTNK", "HTNK", "APOC", "E1", "E2", "DOG", "ENGINEER", "HARV", "FV", "SREF", "DRON", "LTNK", "BRUTE", "INIT", "HYD", "HOVER"};
+    std::cout << "[move] map " << map << "\n";
+    for (const char* id : kTypes) {
+        if (rules.section_string(id, "Strength", "").empty()) { std::cout << "[move] " << id << " not in rules\n"; continue; }
+        GameScene g(true, P::cfg_for(rules, map));
+        ra2engine::World& w = P::world(g);
+        const int W = w.grid_w(), H = w.grid_h();
+        // start: the walkable centre; goals 6 reachable cells 18..30 away
+        int cx = 0, cy = 0;
+        { long sx = 0, sy = 0, n = 0;
+          for (int y = 0; y < H; ++y) for (int x = 0; x < W; ++x) if (w.walkable(x, y)) { sx += x; sy += y; ++n; }
+          cx = (int)(sx / std::max(1L, n)); cy = (int)(sy / std::max(1L, n)); }
+        int sx0 = -1, sy0 = -1;
+        for (int r = 0; r < 40 && sx0 < 0; ++r)
+            for (int dy = -r; dy <= r && sx0 < 0; ++dy)
+                for (int dx = -r; dx <= r; ++dx)
+                    if (std::max(std::abs(dx), std::abs(dy)) == r && P::ground_ok(w, cx + dx, cy + dy)) { sx0 = cx + dx; sy0 = cy + dy; break; }
+        if (sx0 < 0) { std::cout << "[move] no start cell\n"; return 1; }
+        w.add_combat_unit(sx0, sy0, 0, P::combat_of(g, id));
+        const int ui = (int)w.units().size() - 1;
+        w.units()[(size_t)ui].hp = w.units()[(size_t)ui].max_hp = 100000000;
+        static const int offs[6][2] = {{24, 0}, {-20, 18}, {0, -26}, {19, 19}, {-25, -3}, {10, -22}};
+        double tot_ratio = 0, tot_speed = 0, tot_turn = 0; int n = 0, stalls = 0, rev = 0, noarr = 0, noroute = 0;
+        double worst_ratio = 0;
+        for (auto& o : offs) {
+            int gx = -1, gy = -1;
+            const ra2engine::Unit& u = w.units()[(size_t)ui];
+            for (int r = 0; r < 6 && gx < 0; ++r)
+                for (int dy = -r; dy <= r && gx < 0; ++dy)
+                    for (int dx = -r; dx <= r; ++dx)
+                        if (std::max(std::abs(dx), std::abs(dy)) == r && P::ground_ok(w, u.cell_x + o[0] + dx, u.cell_y + o[1] + dy)) { gx = u.cell_x + o[0] + dx; gy = u.cell_y + o[1] + dy; break; }
+            if (gx < 0) continue;
+            const double opt = P::dijkstra(w, u.cell_x, u.cell_y, gx, gy);
+            if (opt < 0) { ++noroute; continue; }
+            const double sx = u.fx, sy = u.fy;
+            P::Trace t = P::run_move(g, ui, gx, gy);
+            const double ratio = opt > 0 ? t.travelled / opt : 1;
+            const double secs = t.frames / 15.0;
+            tot_ratio += ratio; tot_speed += t.travelled / secs; tot_turn += t.max_turn; ++n;
+            worst_ratio = std::max(worst_ratio, ratio);
+            stalls += t.stalls; rev += t.reversals; if (!t.arrived) ++noarr;
+            std::cout << "[move]   " << id << " (" << (int)sx << "," << (int)sy << ")->(" << gx << "," << gy << ") opt=" << opt
+                      << " travelled=" << t.travelled << " ratio=" << ratio << " path_turns=" << t.path_turns << " stair=" << t.stair
+                      << " frames=" << t.frames << " avg_cps=" << t.travelled / secs << " peak_cps=" << t.speed_max
+                      << " stalls=" << t.stalls << " rev45=" << t.reversals << " maxturn/frame=" << t.max_turn
+                      << " arrived=" << t.arrived << " end_off=" << t.end_dx << "," << t.end_dy << "\n";
+        }
+        const ra2engine::Unit& u = w.units()[(size_t)ui];
+        std::cout << "[move] SUMMARY " << id << " nominal_cps=" << w.unit_speed_cps(ui) << " rot_u16/frame=" << u.rot_u16_per_sec / 15.0
+                  << " n=" << n << " mean_ratio=" << (n ? tot_ratio / n : 0) << " worst_ratio=" << worst_ratio
+                  << " mean_avg_cps=" << (n ? tot_speed / n : 0) << " stalls=" << stalls << " rev45=" << rev
+                  << " not_arrived=" << noarr << " noroute=" << noroute << "\n";
+    }
+    return p.fails ? 1 : 0;
+}
