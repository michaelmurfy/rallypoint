diff --git a/rp-beta5/ra2/engine/tests/test_pathfind_scenarios.cpp b/tests/test_pathfind_scenarios.cpp
new file mode 100644
index 0000000..9b061fe
--- /dev/null
+++ b/tests/test_pathfind_scenarios.cpp
@@ -0,0 +1,108 @@
+// Blocking scenarios for the A* (wall with a gap, dead end, unreachable goal,
+// cost-avoided cells, large map under a budget, repeatability).
+#include "doctest.h"
+#include "pathfind.hpp"
+
+#include <cstdlib>
+
+using namespace ra2engine;
+
+namespace {
+using Grid = std::vector<uint8_t>;
+bool same(const std::vector<Cellxy>& a, const std::vector<Cellxy>& b) {
+    if (a.size() != b.size()) return false;
+    for (size_t i = 0; i < a.size(); ++i) if (a[i].x != b[i].x || a[i].y != b[i].y) return false;
+    return true;
+}
+bool steps_ok(const std::vector<Cellxy>& p, const Grid& g, int w) {
+    for (size_t i = 0; i < p.size(); ++i) {
+        if (!g[p[i].y * w + p[i].x]) return false;
+        if (i == 0) continue;
+        const int dx = p[i].x - p[i - 1].x, dy = p[i].y - p[i - 1].y;
+        if (std::abs(dx) > 1 || std::abs(dy) > 1 || (!dx && !dy)) return false;
+        if (dx && dy && (!g[p[i - 1].y * w + p[i].x] || !g[p[i].y * w + p[i - 1].x])) return false;
+    }
+    return true;
+}
+}  // namespace
+
+TEST_CASE("scenario: wall with a gap is crossed only through the gap") {
+    const int W = 20, H = 20;
+    Grid g(W * H, 1);
+    for (int y = 0; y < H; ++y) g[y * W + 10] = 0;
+    g[17 * W + 10] = 1;
+    auto p = find_path(g, W, H, {2, 2}, {18, 3});
+    REQUIRE(!p.empty());
+    CHECK(steps_ok(p, g, W));
+    bool through = false;
+    for (auto c : p) if (c.x == 10) { CHECK(c.y == 17); through = true; }
+    CHECK(through);
+}
+
+TEST_CASE("scenario: dead end, exact refuses, nearest goes to the closest reachable cell") {
+    const int W = 15, H = 15;
+    Grid g(W * H, 1);
+    for (int x = 0; x < W; ++x) g[7 * W + x] = 0;   // full wall
+    CHECK(find_path(g, W, H, {2, 2}, {12, 12}).empty());
+    auto p = find_path_nearest(g, W, H, {2, 2}, {12, 12}, 0);
+    REQUIRE(!p.empty());
+    CHECK(steps_ok(p, g, W));
+    CHECK(p.back().y == 6);
+    CHECK(p.back().x >= 11);   // the wall face nearest the goal, not the start
+}
+
+TEST_CASE("scenario: goal inside a sealed room") {
+    const int W = 15, H = 15;
+    Grid g(W * H, 1);
+    for (int i = 8; i <= 12; ++i) { g[8 * W + i] = g[12 * W + i] = g[i * W + 8] = g[i * W + 12] = 0; }
+    auto p = find_path_nearest(g, W, H, {1, 1}, {10, 10}, 0);
+    REQUIRE(!p.empty());
+    CHECK(steps_ok(p, g, W));
+    const Cellxy e = p.back();
+    CHECK(std::max(std::abs(e.x - 10), std::abs(e.y - 10)) >= 2);   // outside the walls' ring
+    CHECK(e.x <= 7 + 5);
+    CHECK(find_path(g, W, H, {1, 1}, {10, 10}).empty());
+}
+
+TEST_CASE("scenario: a diagonal squeeze between two blocked corners is refused") {
+    const int W = 6, H = 6;
+    Grid g(W * H, 1);
+    for (int x = 0; x < W; ++x) g[3 * W + x] = 0;
+    g[3 * W + 3] = 1;
+    g[2 * W + 3] = 0; g[4 * W + 3] = 0;   // a single-cell hole whose neighbours above and below are blocked
+    auto p = find_path(g, W, H, {0, 0}, {5, 5});
+    CHECK(p.empty());
+}
+
+TEST_CASE("scenario: unit costs steer round a crowded cell when a short detour exists") {
+    const int W = 12, H = 5;
+    Grid g(W * H, 1);
+    for (int y = 0; y < H; ++y) if (y != 2) g[y * W + 6] = 0;   // corridor at y=2 through x=6
+    // widen: a side lane around the choke at y=0..1 is walled, so only y=2 passes.
+    std::vector<std::uint16_t> cost(W * H, 1);
+    cost[2 * W + 6] = 8;   // a parked friendly in the only gap
+    auto p = find_path_bounded_t(g, W, H, {0, 2}, {11, 2}, 0, nullptr, nullptr, &cost);
+    REQUIRE(!p.empty());   // still routed through: the cost is not a wall
+    bool via = false;
+    for (auto c : p) if (c.x == 6 && c.y == 2) via = true;
+    CHECK(via);
+    // With a second, clear gap three cells away the busy one is avoided.
+    g[4 * W + 6] = 1;
+    auto q = find_path_bounded_t(g, W, H, {0, 2}, {11, 2}, 0, nullptr, nullptr, &cost);
+    REQUIRE(!q.empty());
+    for (auto c : q) CHECK(!(c.x == 6 && c.y == 2));
+}
+
+TEST_CASE("scenario: big map, budgeted search is bounded and repeatable") {
+    const int W = 512, H = 512;
+    Grid g(W * H, 1);
+    for (int y = 0; y < H - 1; ++y) g[y * W + 256] = 0;   // wall, gap at the bottom row
+    auto a = find_path_nearest(g, W, H, {10, 10}, {500, 10}, 3000);
+    REQUIRE(!a.empty());
+    CHECK(steps_ok(a, g, W));
+    CHECK(a.back().x <= 255);   // ran out of budget on this side, headed for the goal
+    auto b = find_path_nearest(g, W, H, {10, 10}, {500, 10}, 3000);
+    CHECK(same(a, b));
+    CHECK(find_path_bounded(g, W, H, {10, 10}, {500, 10}, 3000).empty());
+    CHECK(!find_path_bounded(g, W, H, {10, 10}, {500, 10}, 0 + 400000).empty());
+}
