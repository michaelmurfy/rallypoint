+TEST_CASE("group move: formation slots stay on the goal's side of a wall") {
+    const int W = 20, H = 10;
+    std::vector<uint8_t> pass(W * H, 1);
+    for (int y = 0; y < H; ++y) pass[y * W + 10] = 0;   // full wall at x=10
+    ra2engine::Occupancy occ(W, H);
+    auto s = ra2engine::nearest_free_cells({9, 5}, 12, pass, W, H, occ);
