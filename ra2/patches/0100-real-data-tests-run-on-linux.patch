+
+// ---- real maps, the real 168x110 radar box [RE: sidebar radar.shp] and PresRadar's own layout maths.
+#include "asset_fixture.hpp"
+#include <cstdio>
+#include <climits>
+
+namespace {
+struct RealRadar {
+    RadarMap m;
+    int cells = 0;
+};
+RealRadar real_radar(const ra2assets::MapFile& map, int rw, int rh) {
+    RealRadar r;
+    int minu = INT_MAX, maxu = INT_MIN, minv = INT_MAX, maxv = INT_MIN, gw = 0, gh = 0;
+    for (const ra2assets::MapCell& c : map.cells()) {
+        minu = std::min(minu, c.x - c.y); maxu = std::max(maxu, c.x - c.y);
+        minv = std::min(minv, c.x + c.y); maxv = std::max(maxv, c.x + c.y);
+        gw = std::max(gw, c.x + 1); gh = std::max(gh, c.y + 1);
+    }
+    const int uw = maxu - minu + 1, vh = maxv - minv + 1;
+    const double s = std::min(rw / (uw * 1.0), rh / (vh * 0.5));   // PresRadar::draw
+    r.m.ox = static_cast<int>((rw - uw * s) / 2);
+    r.m.oy = static_cast<int>((rh - vh * 0.5 * s) / 2);
+    r.m.s = s; r.m.u0 = minu; r.m.v0 = minv; r.m.gw = gw; r.m.gh = gh;
+    r.cells = static_cast<int>(map.cells().size());
+    return r;
+}
+// Click every cell's centre pixel; the cell found must be within what one pixel can resolve.
+void radar_roundtrip(const char* name, const ra2assets::MapFile& map, int rw, int rh) {
+    const RealRadar r = real_radar(map, rw, rh);
+    REQUIRE(r.cells > 1000);
+    int worst = 0;
+    long sum = 0;
+    for (const ra2assets::MapCell& c : map.cells()) {
+        double px, py;
+        r.m.cell_to_pixel(c.x, c.y, px, py);
+        int cx = -1, cy = -1;
+        REQUIRE(r.m.cell_at(static_cast<int>(px), static_cast<int>(py), cx, cy));
+        const int e = std::max(std::abs(cx - c.x), std::abs(cy - c.y));
+        worst = std::max(worst, e);
+        sum += e;
+    }
+    const double mean = static_cast<double>(sum) / r.cells;
+    std::printf("[radar] %s %dx%d box: s=%.3f px per u, %d cells, mean error %.2f cells, worst %d\n", name, rw, rh,
+                r.m.s, r.cells, mean, worst);
+    // One screen pixel is 1/s radar units, so a cell centre can only be located to ceil(1/s)+1 cells.
+    CHECK(worst <= static_cast<int>(std::ceil(1.0 / r.m.s)) + 1);
+    CHECK(mean < 1.0 / r.m.s + 0.5);
+}
+}  // namespace
+
+TEST_CASE("radar map: real maps in the real radar box click back onto the cell they show") {
+    if (!ra2fixture::mapsmd03_available()) { if (std::getenv("RA2_INSTALL_DIR")) FAIL("mapsmd03.mix not found"); MESSAGE("skipped: real map assets not found"); return; }
+    radar_roundtrip("mapsmd03 campaign map", ra2fixture::mapsmd03_map(), 168, 110);
+    radar_roundtrip("mapsmd03 campaign map", ra2fixture::mapsmd03_map(), 336, 220);
+    ra2assets::MixFile mp = ra2assets::MixFile::open(ra2fixture::slurp(ra2fixture::install_file("multimd.mix")));
+    for (const char* n : {"xmp01t4.map", "xmp31s2.map"}) {
+        const ra2assets::MixEntry* e = mp.find(std::string(n));
+        REQUIRE(e);
+        const std::vector<uint8_t> raw = mp.read(*e);
+        const ra2assets::MapFile map = ra2assets::MapFile::parse(std::string(raw.begin(), raw.end()));
+        radar_roundtrip(n, map, 168, 110);
+        radar_roundtrip(n, map, 336, 220);
+    }
+}
