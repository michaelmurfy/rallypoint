+// The shell page bands: rules [AudioVisual] names the sounds, soundmd.ini defines them.
+TEST_CASE("sounds: real menu slide sounds") {
+    if (!ra2fixture::assets_available()) { FAIL("no RA2 install: set RA2_INSTALL_DIR"); }
+    auto sb = ra2fixture::resolve_nested_bytes("soundmd.ini");
+    auto rb = ra2fixture::resolve_nested_bytes("rulesmd.ini");
+    REQUIRE_FALSE(sb.empty());
+    REQUIRE_FALSE(rb.empty());
+    Ini rules = Ini::parse(std::string(rb.begin(), rb.end()));
+    CHECK(rules.get("AudioVisual", "GUIMoveOutSound") == "MenuSlideOut");
+    CHECK(rules.get("AudioVisual", "GUIMoveInSound") == "MenuSlideIn");
+    Ini sini = Ini::parse(std::string(sb.begin(), sb.end()));   // Sounds borrows it
+    Sounds snd = Sounds::load(sini);
+    const SoundEntry out = snd.entry("MenuSlideOut");
+    REQUIRE(out.sounds.size() == 1);
+    CHECK(out.sounds[0] == "uslide2");
+    CHECK(out.volume == 60);
+    const SoundEntry in = snd.entry("MenuSlideIn");
+    REQUIRE(in.sounds.size() == 1);
+    CHECK(in.sounds[0] == "uslide1");
+    CHECK(in.volume == 65);
+}
