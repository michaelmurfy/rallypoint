+// 0160 [RE: gamemd MegaMission group destination FUN_0064CDA0; read from the
+// reverse-engineered description in vera20k, no code copied]. One move order
+// for a run of selected units: the unit nearest the group's 3-D centroid is the
+// anchor, units are sorted by 3-D distance from it, and the nearest one takes
+// the clicked cell. Every other unit probes up to six cells from the click
+// along its own anchor-relative direction (its cell minus the anchor's cell,
+// normalised, in float), so a column stays a column and a flank stays on its
+// side. Units standing in the same cell as an already-assigned unit share its
+// destination (that is how infantry end up sharing a cell).
+struct GroupMember {
+    int x = 0, y = 0, z = 0;   // lepton position
+    Cellxy cell{0, 0};         // source cell
+    Cellxy nav{0, 0};          // navigation cell (the cell it is heading to, else its own)
+};
+struct GroupCandidate {
+    bool in_playfield = false;
+    bool same_zone = false;
+    bool height_ok = false;
+    int enter_code = 0;        // Can_Enter_Cell: >= 4 and != 6 is blocked
+};
+std::vector<Cellxy> distribute_group_destinations(
+    Cellxy clicked, const std::vector<GroupMember>& members,
+    const std::function<GroupCandidate(std::size_t member, Cellxy cell)>& facts);
+
 }  // namespace ra2engine
