+// 0160: retail group destination (gamemd FUN_0064CDA0).
+namespace {
+ra2engine::GroupMember gmem(int cx, int cy) {
+    ra2engine::GroupMember m;
+    m.x = cx * 256 + 128; m.y = cy * 256 + 128; m.z = 0;
+    m.cell = {cx, cy}; m.nav = {cx, cy};
+    return m;
+}
+ra2engine::GroupCandidate clear_cell(std::size_t, Cellxy) { return {true, true, true, 0}; }
+}  // namespace
+
+TEST_CASE("distribute_group_destinations: the unit nearest the centroid takes the click, the others keep their side") {
+    std::vector<ra2engine::GroupMember> m{gmem(10, 10), gmem(12, 10), gmem(10, 12)};
+    const auto d = ra2engine::distribute_group_destinations({20, 20}, m, clear_cell);
+    CHECK((d[0].x == 20 && d[0].y == 20));   // anchor
+    CHECK((d[1].x == 21 && d[1].y == 20));   // east of the anchor stays east of the click
+    CHECK((d[2].x == 20 && d[2].y == 21));   // south stays south
+}
+
+TEST_CASE("distribute_group_destinations: a blocked probe followed by a clear one falls back to the click") {
+    std::vector<ra2engine::GroupMember> m{gmem(10, 10), gmem(12, 10)};
+    auto facts = [](std::size_t, Cellxy c) {
+        return ra2engine::GroupCandidate{true, true, true, c.x == 21 ? 4 : 0};
+    };
+    const auto d = ra2engine::distribute_group_destinations({20, 20}, m, facts);
+    CHECK((d[1].x == 20 && d[1].y == 20));   // saw a bad cell, then a good one: takes the saved fallback
+}
+
+TEST_CASE("distribute_group_destinations: units standing in one cell share a destination; probes stop at the map edge") {
+    std::vector<ra2engine::GroupMember> m{gmem(10, 10), gmem(12, 10), gmem(12, 10), gmem(12, 10)};
+    const auto d = ra2engine::distribute_group_destinations({20, 20}, m, clear_cell);
+    CHECK((d[1].x == d[2].x && d[1].y == d[2].y && d[2].x == d[3].x));
+    auto edge = [](std::size_t, Cellxy) { return ra2engine::GroupCandidate{}; };   // off the playfield
+    const auto e = ra2engine::distribute_group_destinations({20, 20}, m, edge);
+    for (const Cellxy& c : e) CHECK((c.x == 20 && c.y == 20));
+    CHECK(ra2engine::distribute_group_destinations({1, 1}, {}, clear_cell).empty());
+}
