+std::vector<Cellxy> distribute_group_destinations(
+    Cellxy clicked, const std::vector<GroupMember>& m,
+    const std::function<GroupCandidate(std::size_t, Cellxy)>& facts) {
+    const std::size_t n = m.size();
+    std::vector<Cellxy> dest(n, clicked);
+    if (n == 0) return dest;
+    auto dist3 = [](long long dx, long long dy, long long dz) {
+        return om::ftol(om::sqrt(static_cast<double>(dx * dx + dy * dy + dz * dz)));
+    };
+    long long sx = 0, sy = 0, sz = 0;
+    for (const GroupMember& g : m) { sx += g.x; sy += g.y; sz += g.z; }
+    const long long cx = sx / static_cast<long long>(n), cy = sy / static_cast<long long>(n),
+                    cz = sz / static_cast<long long>(n);
+    // Nearest the centroid; a tie keeps the highest index (the original scans down from the last).
+    std::size_t anchor = n - 1;
+    int best = dist3(m[anchor].x - cx, m[anchor].y - cy, m[anchor].z - cz);
+    for (std::size_t i = n - 1; i-- > 0;) {
+        const int d = dist3(m[i].x - cx, m[i].y - cy, m[i].z - cz);
+        if (d < best) { best = d; anchor = i; }
+    }
+    std::vector<int> dist(n);
+    for (std::size_t i = 0; i < n; ++i)
+        dist[i] = dist3(m[i].x - m[anchor].x, m[i].y - m[anchor].y, m[i].z - m[anchor].z);
+    std::vector<std::size_t> order(n);
+    for (std::size_t i = 0; i < n; ++i) order[i] = i;
+    std::stable_sort(order.begin(), order.end(), [&](std::size_t a, std::size_t b) { return dist[a] < dist[b]; });
+
+    std::vector<bool> done(n, false);
+    std::vector<Cellxy> reserved{clicked};
+    auto is_reserved = [&](Cellxy c) {
+        for (const Cellxy& r : reserved) if (r.x == c.x && r.y == c.y) return true;
+        return false;
+    };
+    done[order[0]] = true;
+    for (std::size_t p = 1; p < n; ++p) {
+        const std::size_t i = order[p];
+        if (done[i]) continue;
+        float dx = static_cast<float>(m[i].nav.x - m[anchor].cell.x);
+        float dy = static_cast<float>(m[i].nav.y - m[anchor].cell.y);
+        if (dx != 0.0f || dy != 0.0f) {
+            const float len = static_cast<float>(om::sqrt(static_cast<double>(dx) * dx + static_cast<double>(dy) * dy));
+            dx /= len;
+            dy /= len;
+        }
+        float fx = static_cast<float>(clicked.x) + 0.5f, fy = static_cast<float>(clicked.y) + 0.5f;
+        Cellxy chosen = clicked;
+        bool bad = false;
+        for (int k = 0; k < 6; ++k) {
+            fx += dx;
+            fy += dy;
+            const Cellxy c{static_cast<int>(fx), static_cast<int>(fy)};   // truncation, as _ftol
+            const GroupCandidate f = facts(i, c);
+            if (!f.in_playfield) break;
+            if (!f.same_zone) { bad = true; continue; }
+            if (is_reserved(c)) { chosen = c; continue; }   // keeps the last reserved cell as the fallback
+            if (!f.height_ok) break;
+            if (f.enter_code >= 4 && f.enter_code != 6) { bad = true; continue; }
+            if (bad) break;   // the original runs a zone estimate here and takes the saved fallback
+            chosen = c;
+            break;
+        }
+        dest[i] = chosen;
+        done[i] = true;
+        reserved.push_back(chosen);
+        for (std::size_t j = p + 1; j < n; ++j) {   // same source cell = same destination
+            const std::size_t o = order[j];
+            if (!done[o] && m[o].cell.x == m[i].cell.x && m[o].cell.y == m[i].cell.y) { dest[o] = chosen; done[o] = true; }
+        }
+    }
+    return dest;
+}
+
 }  // namespace ra2engine
