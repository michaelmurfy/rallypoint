diff --git a/engine/pres_chrono_warp.hpp b/engine/pres_chrono_warp.hpp
new file mode 100644
index 0000000..83904be
--- /dev/null
+++ b/engine/pres_chrono_warp.hpp
@@ -0,0 +1,30 @@
+#pragma once
+// The picture half of a chrono warp: which anims and for how long. Kept apart
+// from pres_state.inc / pres_audio_events.inc so the rules lookup and the
+// window length can be regression-tested without game assets or SDL.
+
+#include <cstddef>
+#include <string>
+
+// An anim name from a Rules key. [General] WarpOut=WARPOUT;WAKE2, WarpIn /
+// WarpAway / ChronoSparkle1 alike: the ';' starts an INI comment, which the
+// reader already cut, and a mod may write a comma list. The first name is the
+// one the game spawns. An empty or absent key keeps the stock name.
+inline std::string pres_warp_anim_name(const std::string& ini_value, const char* fallback) {
+    std::string v = ini_value;
+    const std::size_t cut = v.find_first_of(",;");
+    if (cut != std::string::npos) v.erase(cut);
+    const std::size_t first = v.find_first_not_of(" \t");
+    if (first == std::string::npos) return std::string(fallback);
+    const std::size_t last = v.find_last_not_of(" \t");
+    return v.substr(first, last - first + 1);
+}
+
+// Logic frames the warp stays drawn (translucent + sparkles). A unit teleport
+// reports the delay it froze the unit for [RE: 0x718761..0x7188B0, delay =
+// max(dist / ChronoDistanceFactor, ChronoMinimumDelay)]; the Chrono Miner's
+// warp home has no freeze in this engine, so it shows the minimum.
+constexpr long kPresWarpMinFrames = 16;   // [General] ChronoMinimumDelay
+inline long pres_warp_display_frames(long reported) {
+    return reported > 0 ? reported : kPresWarpMinFrames;
+}
