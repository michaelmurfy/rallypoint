diff --git a/tests/test_pres_chrono_warp.cpp b/tests/test_pres_chrono_warp.cpp
new file mode 100644
index 0000000..2b512be
--- /dev/null
+++ b/tests/test_pres_chrono_warp.cpp
@@ -0,0 +1,23 @@
+#include "doctest.h"
+#include "pres_chrono_warp.hpp"
+
+TEST_CASE("chrono warp anims come from the Rules keys, stock names as fallback") {
+    // [General] WarpOut=WARPOUT;WAKE2 -- the reader cuts the comment, so the
+    // value is already tidy, and the stock name is used when it is not.
+    CHECK(pres_warp_anim_name("WARPOUT", "WARPOUT") == "WARPOUT");
+    CHECK(pres_warp_anim_name("WARPIN", "WARPOUT") == "WARPIN");
+    // A mod list: the first name is the one spawned.
+    CHECK(pres_warp_anim_name("CHRONOSK,WAKE2", "WARPIN") == "CHRONOSK");
+    CHECK(pres_warp_anim_name(" RING1 ; alt", "WARPAWAY") == "RING1");
+    CHECK(pres_warp_anim_name("", "WARPAWAY") == "WARPAWAY");
+    CHECK(pres_warp_anim_name("   ", "CHRONOSK") == "CHRONOSK");
+}
+
+TEST_CASE("chrono warp display lasts the reported delay, else the minimum") {
+    // A unit teleport reports the frames it froze the unit for.
+    CHECK(pres_warp_display_frames(53) == 53);
+    CHECK(pres_warp_display_frames(16) == 16);
+    // The Chrono Miner's warp home freezes nothing: minimum (ChronoMinimumDelay).
+    CHECK(pres_warp_display_frames(0) == kPresWarpMinFrames);
+    CHECK(pres_warp_display_frames(-1) == kPresWarpMinFrames);
+}
