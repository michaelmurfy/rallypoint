+        // Stock rulesmd: WARPIN / WARPOUT / WARPAWAY / CHRONOSK; an absent key
+        // keeps the stock name, so a rules without them still shows the warp.
+        {
+            auto gen_anim = [&](const char* k, const char* def) {
+                return pres_warp_anim_name(rules_ini.get("General", k), def);
+            };
+            g_warp_in_anim = gen_anim("WarpIn", "WARPIN");
+            g_warp_out_anim = gen_anim("WarpOut", "WARPOUT");
