+void World::on_building_destroyed(int b_idx) {
+    if (!crates_any_) return;
+    if (b_idx < 0 || b_idx >= static_cast<int>(buildings_.size())) return;
+    const Building& b = buildings_[static_cast<std::size_t>(b_idx)];
+    if (b.sold) return;   // retail sell does not run AfterDestruction
+    if (b.type < 0 || b.type >= static_cast<int>(btypes().size())) return;
+    const BuildingTypeDef& t = btypes()[static_cast<std::size_t>(b.type)];
+    if (!t.crate_beneath) return;
+    place_crate(b.cx, b.cy, t.crate_beneath_is_money ? static_cast<int>(Powerup::Money) : -1);
