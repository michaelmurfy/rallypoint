+TEST_CASE("crate beneath: sold buildings drop nothing (retail sell skips AfterDestruction)") {
+    ra2assets::MapFile map = ra2assets::MapFile::blank(32, 32);
+    World w(map);
+    w.enable_veterancy(ra2engine::VeterancyRules{});
+    World::CrateConfig cc;
+    cc.seed = 7;
+    cc.place_initial = false;
+    REQUIRE(w.enable_crates(cc));
+    BuildingTypeDef hut;
+    hut.id = "CAWASH01"; hut.strength = 500;
+    hut.crate_beneath = true; hut.crate_beneath_is_money = true;
+    w.set_building_types({hut});
+    const int m = w.add_building(0, 10, 10, 1, 1, 1, 500, 0, 0.0, true);
+    REQUIRE(m == 0);
+    // The sell flow marks sold at kill time; the tombstone hook must skip it.
+    w.buildings()[0].sold = true;
+    w.campaign_damage_building(m, 5000);
+    for (int f = 0; f < 30; ++f) w.step(1.0 / 15.0);
+    for (const auto& c : w.crates()) CHECK(c.x < 0);
+}
