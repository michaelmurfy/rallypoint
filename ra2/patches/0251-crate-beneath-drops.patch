+TEST_CASE("crate beneath: destroyed CrateBeneath= buildings drop origin crates at tombstone") {
+    // Retail AfterDestruction tail (gated here on the crate-system switch):
+    // money-typed for CrateBeneathIsMoney=, random draw otherwise, nothing for
+    // other buildings. Drops land at tombstone time (kBuildingDieSecs after
+    // the kill), deterministically.
+    ra2assets::MapFile map = ra2assets::MapFile::blank(32, 32);
+    World w(map);
+    w.enable_veterancy(ra2engine::VeterancyRules{});
+    World::CrateConfig cc;
+    cc.seed = 4242;
+    cc.place_initial = false;
+    REQUIRE(w.enable_crates(cc));
+    BuildingTypeDef hut;
+    hut.id = "CAWASH01"; hut.strength = 500;
+    hut.crate_beneath = true; hut.crate_beneath_is_money = true;
+    BuildingTypeDef city;
+    city.id = "CARUS07"; city.strength = 500;
+    city.crate_beneath = true;   // random draw (no IsMoney)
+    BuildingTypeDef pill;
+    pill.id = "GAPILL"; pill.strength = 400;
+    w.set_building_types({hut, city, pill});
+    const int m = w.add_building(0, 10, 10, 1, 1, 1, 500, 0, 0.0, true);
+    const int r = w.add_building(1, 14, 14, 1, 1, 1, 500, 0, 0.0, true);
+    const int p = w.add_building(2, 20, 20, 1, 1, 1, 400, 0, 0.0, true);
+    REQUIRE(m == 0); REQUIRE(r == 1); REQUIRE(p == 2);
+    w.campaign_damage_building(m, 5000);
+    w.campaign_damage_building(r, 5000);
+    w.campaign_damage_building(p, 5000);
+    for (int f = 0; f < 30; ++f) w.step(1.0 / 15.0);   // past the 1s death anim
+    auto nearby = [&](int x0, int y0, int powerup) {
+        for (const auto& c : w.crates())
+            if (c.x >= 0 && std::abs(c.x - x0) <= 2 && std::abs(c.y - y0) <= 2 && c.powerup == powerup) return true;
+        return false;
+    };
+    CHECK(nearby(10, 10, static_cast<int>(ra2engine::Powerup::Money)));
+    CHECK(nearby(14, 14, -1));
+    int n = 0;
+    for (const auto& c : w.crates()) if (c.x >= 0) ++n;
+    CHECK(n == 2);   // control pill drops nothing
+    // Deterministic: an identical run drops identical crates.
+    World w2(map);
+    w2.enable_veterancy(ra2engine::VeterancyRules{});
+    REQUIRE(w2.enable_crates(cc));
+    w2.set_building_types({hut, city, pill});
+    w2.add_building(0, 10, 10, 1, 1, 1, 500, 0, 0.0, true);
+    w2.add_building(1, 14, 14, 1, 1, 1, 500, 0, 0.0, true);
+    w2.add_building(2, 20, 20, 1, 1, 1, 400, 0, 0.0, true);
+    w2.campaign_damage_building(0, 5000);
+    w2.campaign_damage_building(1, 5000);
+    w2.campaign_damage_building(2, 5000);
+    for (int f = 0; f < 30; ++f) w2.step(1.0 / 15.0);
+    REQUIRE(w2.crates().size() == w.crates().size());
+    for (size_t i = 0; i < w.crates().size(); ++i) {
+        CHECK(w2.crates()[i].x == w.crates()[i].x);
+        CHECK(w2.crates()[i].y == w.crates()[i].y);
+        CHECK(w2.crates()[i].powerup == w.crates()[i].powerup);
+        CHECK(w2.crates()[i].lifetime == w.crates()[i].lifetime);
+    }
+}
