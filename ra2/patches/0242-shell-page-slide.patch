+#include "doctest.h"
+#include "asset_fixture.hpp"
+#include "ra2assets/shp.hpp"
+#include "../engine/shell_wave.hpp"
+#include <vector>
+using namespace ra2engine;
+
+static std::vector<int> row_run(int row, bool button, bool entering, bool map = false) {
+    std::vector<int> v;
+    for (int t = 0; t < kWaveTicks; ++t) v.push_back(wave_row_frame(t, row, button, entering, map));
+    return v;
+}
+
+TEST_CASE("page slide: the loop is rows + 9 ticks of 30 ms") {
+    CHECK(kWaveTicks == 15);
+    CHECK(wave_tick(0.0) == 0);
+    CHECK(wave_tick(0.029) == 0);
+    CHECK(wave_tick(0.030) == 1);
+    CHECK(wave_tick(0.449) == 14);
+    ShellBand b;
+    b.t = 0.449;
+    CHECK_FALSE(b.done());
+    b.t = 0.450;
+    CHECK(b.done());
+}
+
+TEST_CASE("page slide: button rows sink 5..10 leaving and rise 10..5 entering, row r starts at r + 1") {
+    const int S = kBtnSettled;
+    // row 0 leaves from tick 1, row 5 (Back) from tick 6
+    CHECK(row_run(0, true, false) == std::vector<int>{S, 5, 6, 7, 8, 9, 10, 10, 10, 10, 10, 10, 10, 10, 10});
+    CHECK(row_run(5, true, false) == std::vector<int>{S, S, S, S, S, S, 5, 6, 7, 8, 9, 10, 10, 10, 10});
+    CHECK(row_run(0, true, true) == std::vector<int>{10, 10, 9, 8, 7, 6, 5, S, S, S, S, S, S, S, S});
+    CHECK(row_run(5, true, true) == std::vector<int>{10, 10, 10, 10, 10, 10, 10, 9, 8, 7, 6, 5, S, S, S});
+}
+
+TEST_CASE("page slide: empty rows play the plate, 16..11 entering to frame 0 and 11..16 leaving to the socket") {
+    CHECK(row_run(2, false, true) == std::vector<int>{10, 10, 10, 16, 15, 14, 13, 12, 11, 0, 0, 0, 0, 0, 0});
+    CHECK(row_run(2, false, false) == std::vector<int>{0, 0, 0, 11, 12, 13, 14, 15, 16, 10, 10, 10, 10, 10, 10});
+}
+
+TEST_CASE("page slide: a map button takes row 0 and moves every other row one tick earlier") {
+    CHECK(wave_entry_tick(0, true) == 0);
+    CHECK(wave_entry_tick(1, true) == 1);
+    CHECK(wave_entry_tick(1, false) == 2);
+    CHECK(wave_entry_tick(5, true) == 6);   // Back keeps its own entry
+    CHECK(wave_entry_tick(5, false) == 6);
+}
+
+TEST_CASE("page slide: top panel housing then SDWRNTMP over it from tick 9") {
+    WaveSpec s;
+    s.top_panel = true;
+    for (int t = 0; t < 9; ++t) {
+        CHECK(wave_panel(t, true, s).sdtp == 0);
+        CHECK(wave_panel(t, true, s).shutter == -1);
+        CHECK(wave_panel(t, false, s).sdtp == 1);
+        CHECK(wave_panel(t, false, s).shutter == -1);
+    }
+    const int in[] = {5, 4, 3, 2, 1, 0};
+    for (int k = 0; k < 6; ++k) {
+        CHECK(wave_panel(9 + k, true, s).shutter == in[k]);
+        CHECK(wave_panel(9 + k, true, s).sdtp == 1);
+        CHECK(wave_panel(9 + k, false, s).shutter == k);
+    }
+    s.top_panel = false;
+    CHECK(wave_panel(10, true, s).shutter == -1);
+    s.map_button = true;
+    CHECK(wave_panel(0, true, s).map == 6);
+    CHECK(wave_panel(5, true, s).map == 1);
+    CHECK(wave_panel(6, true, s).map == 0);
+    CHECK(wave_panel(0, false, s).map == 1);
+    CHECK(wave_panel(6, false, s).map == 6);
+    CHECK(wave_panel(6, false, s).map_under);
+}
+
+TEST_CASE("page slide: ShellBand rows follow the page's buttons") {
+    ShellBand b;
+    b.active = true;
+    b.entering = false;
+    b.t = 0.030 * 3;   // tick 3
+    const bool used[kWaveRows] = {false, true, true, false, false, true};
+    int out[kWaveRows];
+    b.rows(used, out);
+    CHECK(out[0] == 13);        // plate, 2 ticks in (entry tick 1)
+    CHECK(out[1] == 5 + 1);     // button, 1 tick in
+    CHECK(out[2] == 5);         // entry tick 3: starts now
+    CHECK(out[3] == 0);
+    CHECK(out[5] == kBtnSettled);
+}
+
+TEST_CASE("page slide: every frame it asks for exists in the real shell art") {
+    REQUIRE_MESSAGE(ra2fixture::ra2_available(), "RA2_INSTALL_DIR must point at a Yuri's Revenge install");
+    ra2assets::MixFile n = ra2fixture::ra2_mix().open_nested("neutral.mix");
+    auto load = [&](const char* name) {
+        const auto* e = n.find(name);
+        REQUIRE_MESSAGE(e, name);
+        return ra2assets::ShpFile::load(n.read(*e));
+    };
+    const ra2assets::ShpFile btn = load("sdbtnanm.shp"), tmp = load("sdwrntmp.shp"), mp = load("sdmpbtn.shp"),
+                             tp = load("sdtp.shp");
+    // frame counts the frame tables rely on
+    CHECK(btn.count() == 17);
+    CHECK(tmp.count() == 6);
+    CHECK(mp.count() == 7);
+    CHECK(tp.count() == 2);
+    CHECK(btn.width() == 156);
+    CHECK(btn.height() == 42);
+    CHECK(tmp.width() == 168);
+    for (bool entering : {true, false})
+        for (bool button : {true, false})
+            for (int row = 0; row < kWaveRows; ++row)
+                for (int t = 0; t < kWaveTicks; ++t) {
+                    const int f = wave_row_frame(t, row, button, entering, false);
+                    if (f == kBtnSettled) continue;
+                    REQUIRE(f >= 0);
+                    REQUIRE(f < btn.count());
+                    CHECK(btn.frame_info(f).w > 0);
+                }
+    WaveSpec s;
+    s.top_panel = true;
+    s.map_button = true;
+    for (bool entering : {true, false})
+        for (int t = 0; t < kWaveTicks; ++t) {
+            const WavePanel p = wave_panel(t, entering, s);
+            CHECK(p.sdtp < tp.count());
+            if (p.shutter >= 0) { CHECK(p.shutter < tmp.count()); CHECK(tmp.frame_info(p.shutter).w > 0); }
+            if (p.map >= 0) { CHECK(p.map < mp.count()); CHECK(mp.frame_info(p.map).w > 0); }
+        }
+}
