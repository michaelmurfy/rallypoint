index 0000000..f6a191e
--- /dev/null
+++ b/engine/shell_wave.hpp
@@ -0,0 +1,95 @@
+#pragma once
+// The shell's page slide, as a pure function of the tick (RE: gamemd 0x006071E0 for the
+// enter/leave bands, 0x00606980 for the page-to-page leave). Every front-end shell page
+// slides its right-hand column in on its first paint and out when it closes, one tick
+// per 30 ms, never skipped:
+//   * button rows (SDBTNANM 17 frames: 2 normal, 3 hover, 4 pressed, 5..9 the face
+//     sliding out, 10 the empty socket, 11..16 the blank plate coming in)
+//       enter: 10 held, then 10..5, then the settled face
+//       leave: the settled face, then 5..10, then 10 held
+//   * empty tile rows
+//       enter: 10 held, then 16..11, then 0 (the plate)
+//       leave: 0 held, then 11..16, then 10
+//   * row r (of 6) starts at tick r + 1, or r on a page with a map button (it takes
+//     row 0, entry tick 0); the bottom row (Back) starts at tick 6; the top panel at 9.
+//   * a page with a top panel shows SDTP 0 (enter) / 1 (leave) until tick 9, then SDTP 1
+//     with SDWRNTMP (6 frames) over it: 5..0 entering, 0..5 leaving.
+//   * a map button is SDMPBTN (7 frames): 6..0 entering, 1..6 leaving, over ticks 0..5.
+//   * the loop runs rows + 9 = 15 ticks.
+namespace ra2engine {
+
+constexpr double kWaveTickSec = 0.030;
+constexpr int kWaveRows = 6;
+constexpr int kWaveRamp = 6;
+constexpr int kWaveTicks = kWaveRows + 9;
+constexpr int kWavePanelEntry = kWaveRows + 3;
+constexpr int kBtnSettled = -1;   // "draw the normal / hover / pressed face"
+
+struct WaveSpec {
+    bool map_button = false;
+    bool top_panel = false;
+};
+
+inline int wave_tick(double t) { return t < 0.0 ? 0 : static_cast<int>(t / kWaveTickSec); }
+
+inline int wave_entry_tick(int row, bool map_button) {
+    return (row == kWaveRows - 1 || !map_button) ? row + 1 : row;
+}
+
+// SDBTNANM frame of one row at `tick`. `button`: the row holds a button. Returns
+// kBtnSettled for a button at rest (the caller draws its normal/hover/pressed face).
+inline int wave_row_frame(int tick, int row, bool button, bool entering, bool map_button) {
+    const int d = tick - wave_entry_tick(row, map_button);
+    if (entering) {
+        if (d < 0) return 10;
+        if (d < kWaveRamp) return button ? 10 - d : 16 - d;
+        return button ? kBtnSettled : 0;
+    }
+    if (d < 0) return button ? kBtnSettled : 0;
+    if (d < kWaveRamp) return button ? 5 + d : 11 + d;
+    return 10;
+}
+
+struct WavePanel {
+    int sdtp = 1;       // SDTP frame
+    int shutter = -1;   // SDWRNTMP frame over it, -1 = none
+    int map = -1;       // SDMPBTN frame, -1 = none
+    bool map_under = false;   // leaving: the closed map rail is drawn under the panel
+};
+
+inline WavePanel wave_panel(int tick, bool entering, WaveSpec spec) {
+    WavePanel p;
+    if (spec.top_panel) {
+        const int d = tick - kWavePanelEntry;
+        p.sdtp = (d < 0 && entering) ? 0 : 1;
+        if (d >= 0) {
+            const int f = entering ? 5 - d : d;
+            p.shutter = f < 0 ? 0 : f > 5 ? 5 : f;
+        }
+    }
+    if (spec.map_button) {
+        const bool ramp = tick < kWaveRamp;
+        p.map = entering ? (ramp ? 6 - tick : 0) : (ramp ? 1 + tick : 6);
+        p.map_under = !entering && !ramp;
+    }
+    return p;
+}
+
+// One page's band: which way it runs, how long it has run, what the page has.
+struct ShellBand {
+    bool active = false;
+    bool entering = true;
+    double t = 0.0;
+    WaveSpec spec;
+    int tick() const { return wave_tick(t); }
+    bool done() const { return tick() >= kWaveTicks; }
+    // rows[r]: SDBTNANM frame per row; kBtnSettled = a button at rest.
+    void rows(const bool used[kWaveRows], int out[kWaveRows]) const {
+        for (int r = 0; r < kWaveRows; ++r) {
+            if (spec.map_button && r == 0) { out[r] = kBtnSettled; continue; }   // SDMPBTN's row
+            out[r] = wave_row_frame(tick(), r, used[r], entering, spec.map_button);
+        }
+    }
+};
+
+}  // namespace ra2engine
