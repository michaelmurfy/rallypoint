--- /dev/null
+++ b/tests/test_building_frames.cpp
@@ -0,0 +1,93 @@
+#include "doctest.h"
+#include "asset_fixture.hpp"
+#include "ra2assets/asset_fs.hpp"
+#include "ra2assets/shp.hpp"
+#include "ra2assets/theater_name.hpp"
+#include "../engine/building.hpp"
+#include <algorithm>
+#include <cstdio>
+#include <set>
+#include <cstdlib>
+#include <string>
+
+using namespace ra2assets;
+
+// Real-data check (needs RA2_INSTALL_DIR, never skipped): every building type of
+// rulesmd, at full health, over a few hundred AnimActive ticks, draws a frame of
+// the healthy art, and below ConditionYellow one of the damaged art. The
+// ConYards' AnimActive=0,26,3 on a 3 image SHP clamped to the last image used to
+// draw the damaged frames on healthy buildings (macOS report, 0.10).
+static std::string join(const std::set<int>& s) {
+    std::string o;
+    for (int f : s) o += (o.empty() ? "" : ",") + std::to_string(f);
+    return o;
+}
+
+TEST_CASE("every building type draws healthy art at full health (real rules and art)") {
+    if (!ra2fixture::assets_available()) { if (std::getenv("RA2_INSTALL_DIR")) FAIL("real assets missing"); MESSAGE("skipped: real assets not found"); return; }
+    const Ini& rules = ra2fixture::rulesmd_ini();
+    const Ini& art = ra2fixture::artmd_ini();
+    std::string dir = ra2fixture::install_base();
+    if (dir.back() != '/') dir += '/';
+    const TheaterChain* ch = theater_chain("TEMPERATE");
+    AssetFS fs(dir, ch);
+    auto yes = [](const std::string& v) { return !v.empty() && (v[0] == 'y' || v[0] == 'Y' || v[0] == 't' || v[0] == '1'); };
+    int types = 0, animated = 0, old_bad = 0;
+    for (const auto& kv : rules.section("BuildingTypes")) {
+        const std::string& id = kv.second;
+        const std::string image = rules.get(id, "Image", id);
+        std::vector<uint8_t> data;
+        for (const std::string& base : art_base_names(image, ch->letter))
+            if (fs.read(base + ".shp", data)) break;
+        if (data.empty()) continue;
+        int count = 0;
+        try { count = ShpFile::load(data).count(); } catch (const std::exception&) { continue; }
+        const int images = std::max(1, count / 2);
+        ra2engine::BuildingFrameArt fa;
+        fa.occupiable = yes(rules.get(id, "CanBeOccupied"));
+        fa.gate = yes(rules.get(id, "Gate"));
+        fa.gate_stages = art.get_int(image, "GateStages", 0);
+        int start = 0, cnt = 1;
+        const std::string aa = art.get(image, "AnimActive");
+        if (!aa.empty()) std::sscanf(aa.c_str(), "%d,%d", &start, &cnt);
+        fa.anim_start = start;
+        fa.anim_count = std::max(1, cnt);
+        if (fa.anim_count > 1) ++animated;
+        ++types;
+        ra2engine::Building b;
+        b.max_hp = 1000;
+        std::set<int> healthy, hurt, old_healthy;
+        for (int stage = 0; stage < 400; ++stage)
+            for (int gs = 0; gs <= (fa.gate ? fa.gate_stages : 0); ++gs)
+                for (int occ = 0; occ < (fa.occupiable ? 2 : 1); ++occ) {
+                    b.occupants.assign(occ, 0);
+                    b.hp = 1000;
+                    healthy.insert(ra2engine::building_main_frame(b, count, 0.5, fa, gs, stage % fa.anim_count));
+                    b.hp = 400;
+                    hurt.insert(ra2engine::building_main_frame(b, count, 0.5, fa, gs, stage % fa.anim_count));
+                    // the old rule: stage + SimpleDamage, clamped to the last image
+                    if (fa.anim_count > 1 && !fa.occupiable && !fa.gate) {
+                        const int of = std::min(std::max(start + stage % fa.anim_count, 0), images - 1);
+                        old_healthy.insert(of);
+                        if (of >= 1) ++old_bad;
+                    }
+                }
+        for (int f : healthy) {
+            CHECK_MESSAGE(f >= 0, id);
+            CHECK_MESSAGE(f < images, id);
+            // static art: frame 0 healthy; a 4 image occupiable: 0 empty, 2 garrisoned; a gate: its stage
+            if (!fa.gate) CHECK_MESSAGE((f == 0 || (fa.occupiable && images >= 4 && f == 2)), id << " healthy frame " << f);
+        }
+        for (int f : hurt) {
+            CHECK_MESSAGE(f < images, id);
+            if (!fa.gate && images >= 2) CHECK_MESSAGE(f >= 1, id << " damaged frame " << f);
+        }
+        if (fa.anim_count > 1)
+            std::printf("TABLE %-8s images=%d AnimActive=%-9s healthy before {%s} after {%s}, damaged after {%s}\n", id.c_str(), images,
+                        aa.c_str(), join(old_healthy).c_str(), join(healthy).c_str(), join(hurt).c_str());
+    }
+    std::printf("types checked=%d, with AnimActive count>1=%d, old rule drew a damaged-range frame at full health %d times\n",
+                types, animated, old_bad);
+    CHECK(types > 250);
+    CHECK(animated >= 8);
+}
