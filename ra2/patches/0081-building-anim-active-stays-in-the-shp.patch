+int building_main_frame(const Building& b, int shp_frames, double condition_yellow, const BuildingFrameArt& a,
+                        int gate_stage, int stage) {
+    const int images = std::max(1, shp_frames / 2);
+    const bool damaged = building_damaged(b, condition_yellow);
+    if (a.occupiable && images >= 4) return std::min((b.occupants.empty() ? 0 : 2) + (damaged ? 1 : 0), images - 1);
+    if (a.gate) return std::clamp(gate_stage + (damaged ? a.gate_stages + 1 : 0), 0, images - 1);
+    if (a.anim_count > 1 || a.anim_start != 0)
+        return building_anim_active_frame(stage, a.anim_start, a.anim_count, damaged, images);
+    return building_frame(b, shp_frames, condition_yellow);
+}
+
 bool building_damage_fires_on(int hp, int max_hp, bool can_be_occupied, double yellow, double red) {
     return max_hp > 0 && hp <= (can_be_occupied ? red : yellow) * max_hp;
 }
