+TEST_CASE("Tank Bunker: AI script action 61 is EnterTankBunker, and the team member leaves the team") {
+    CHECK(classify_op(kSaRemoveIfB) == OpClass::EnterBunker);
+    CHECK(classify_op(kSaRemoveIfA) == OpClass::Inert);
