+TEST_CASE("Tank Bunker: a vehicle that dies, or changes owner, frees the bunker") {
+    NEED_MAP();
+    BunkerWorld t;
+    const int a = t.add_tank(-6, 0);
+    t.w.group_occupy(0, {a}, t.bunker);
+    t.run(300);
+    REQUIRE(t.w.units()[static_cast<std::size_t>(a)].w7.bunker_of == t.bunker);
+    t.w.set_unit_owner(a, 1);   // mind control
+    t.run(3);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].w7.bunker_of == -1);
+    CHECK_FALSE(t.w.bunker_occupied(t.bunker));
+}
