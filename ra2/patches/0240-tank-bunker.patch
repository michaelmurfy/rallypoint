diff --git a/engine/world_bunker.cpp b/engine/world_bunker.cpp
new file mode 100644
index 0000000..d7bc085
--- /dev/null
+++ b/engine/world_bunker.cpp
@@ -0,0 +1,204 @@
+// Tank Bunker (Rallypoint 0240). Rules: Bunker=yes on the building, Bunkerable=
+// on the vehicle (default yes for vehicles), [CombatDamage] BunkerDamageMultiplier
+// / BunkerROFMultiplier / BunkerWeaponRangeBonus, [AudioVisual] BunkerWallsUp/DownSound.
+// [RE: gamemd Techno +0x2E4 = the building<->unit link, set by UpdateBunker
+// FUN_00458E50 state 5 @0x459301, released by EmptyBunker @0x4595C0 (unload),
+// the sell/death release @0x4593A0 and ClearBunker @0x459470; admission is
+// FUN_0070FB50: Bunkerable, a turret, a current weapon, SpeedType not Hover,
+// no parasite.]
+// The retail install is a state machine of turns and a forced track onto the
+// foundation centre; here the vehicle walks beside the bunker, then settles on
+// the foundation centre facing south in one step [RE-FALLBACK: no walls-rising
+// animation delay]. The vehicle stays a live unit, so its own targeting,
+// turret and projectiles fire from the bunker; combat.cpp applies the three
+// multipliers through Unit::w7.bunker_*, and every scan skips a bunkered
+// vehicle (the building is what an enemy hits).
+#include <algorithm>
+#include <cmath>
+
+#include "group_move.hpp"   // nearest_free_cells
+#include "world.hpp"
+
+namespace ra2engine {
+
+namespace {
+int cheb_to_foundation(const Building& b, int x, int y) {
+    int best = -1;
+    for (const Cellxy& c : foundation_cells(b.cx, b.cy, b.fw, b.fh)) {
+        const int d = std::max(std::abs(x - c.x), std::abs(y - c.y));
+        if (best < 0 || d < best) best = d;
+    }
+    return best;
+}
+constexpr double kSouth = 32768.0;   // 0x8000
+}  // namespace
+
+bool World::bunker_occupied(int bi) const {
+    return bi >= 0 && bi < static_cast<int>(buildings_.size()) &&
+           buildings_[static_cast<std::size_t>(bi)].w7.bunker_unit >= 0;
+}
+
+bool World::can_bunker(int ui, int bi) const {
+    if (ui < 0 || ui >= static_cast<int>(units_.size())) return false;
+    if (bi < 0 || bi >= static_cast<int>(buildings_.size())) return false;
+    const Unit& u = units_[static_cast<std::size_t>(ui)];
+    const Building& b = buildings_[static_cast<std::size_t>(bi)];
+    if (!u.alive || u.die_time >= 0.0 || u.cargo_of >= 0 || u.w7.bunker_of >= 0) return false;
+    if (!u.is_vehicle || u.is_aircraft || u.is_naval) return false;
+    if (!u.w7.t.bunkerable || !u.w7.t.has_turret) return false;
+    if (u.speed_type == 3 || u.parasite_on_me >= 0) return false;       // Hover / a parasite on board
+    if (!(u.w_damage > 0 || u.w2.valid)) return false;                   // a current weapon
+    if (!b.alive || b.state != Building::State::Idle || b.selling) return false;
+    if (b.type < 0 || b.type >= static_cast<int>(btypes().size()) || !btypes()[static_cast<std::size_t>(b.type)].bunker)
+        return false;
+    return b.w7.bunker_unit < 0 && b.house == u.house;
+}
+
+int World::nearest_free_bunker(int ui) const {
+    if (ui < 0 || ui >= static_cast<int>(units_.size())) return -1;
+    const Unit& u = units_[static_cast<std::size_t>(ui)];
+    int best = -1, best_d = 0;
+    for (int bi = 0; bi < static_cast<int>(buildings_.size()); ++bi) {
+        if (!can_bunker(ui, bi)) continue;
+        const Building& b = buildings_[static_cast<std::size_t>(bi)];
+        bool taken = false;   // another vehicle is already on its way
+        for (const Unit& o : units_)
+            if (o.w7.bunker_target == bi && o.alive) { taken = true; break; }
+        if (taken) continue;
+        const int d = cheb_to_foundation(b, u.cell_x, u.cell_y);
+        if (best < 0 || d < best_d) { best = bi; best_d = d; }
+    }
+    return best;
+}
+
+void World::order_bunker(int ui, int bi) {
+    if (!can_bunker(ui, bi)) return;
+    Unit& u = units_[static_cast<std::size_t>(ui)];
+    u.target = -1;
+    u.target_building = -1;
+    u.attack_order = false;
+    u.enter_target = -1;
+    u.capture_target = -1;
+    u.infiltrate_target = -1;
+    u.occupy_target = -1;
+    u.attack_cell_x = u.attack_cell_y = -1;
+    const Building& b = buildings_[static_cast<std::size_t>(bi)];
+    if (cheb_to_foundation(b, u.cell_x, u.cell_y) > 1) {
+        int nx = b.cx, ny = b.cy, best = -1;
+        for (const Cellxy& c : foundation_cells(b.cx, b.cy, b.fw, b.fh)) {
+            const int d = std::max(std::abs(u.cell_x - c.x), std::abs(u.cell_y - c.y));
+            if (best < 0 || d < best) { best = d; nx = c.x; ny = c.y; }
+        }
+        const std::vector<Cellxy> free = nearest_free_cells({nx, ny}, 8, passable_, grid_w_, grid_h_, occ_);
+        for (const Cellxy& g : free) {
+            order_unit_move(ui, g.x, g.y);
+            if (units_[static_cast<std::size_t>(ui)].moving()) break;
+        }
+    }
+    units_[static_cast<std::size_t>(ui)].w7.bunker_target = bi;   // after order_unit_move, which clears it
+}
+
+// UpdateBunker state 5 [@0x459301..0x459337]: reciprocal links, then the
+// walls-up sound at the building.
+void World::bunker_install(int ui, int bi) {
+    Unit& u = units_[static_cast<std::size_t>(ui)];
+    Building& b = buildings_[static_cast<std::size_t>(bi)];
+    occ_.release_all_of(ui, -1, -1);
+    u.path.clear();
+    u.path_idx = 0;
+    u.target = -1;
+    u.target_building = -1;
+    u.attack_order = false;
+    u.cell_x = b.cx + b.fw - 1;
+    u.cell_y = b.cy + b.fh - 1;
+    u.fx = u.cell_x;                  // idle units are snapped to their cell every step, so the
+    u.fy = u.cell_y;                  // foundation centre is carried as the lepton offset from it
+    u.sub_x = (b.cx + (b.fw - 1) / 2.0 - u.cell_x) * 256.0;
+    u.sub_y = (b.cy + (b.fh - 1) / 2.0 - u.cell_y) * 256.0;
+    u.body_facing = kSouth;
+    u.on_deck = 0;
+    if (map_) if (const ra2assets::MapCell* mc = map_->at(b.cx, b.cy)) u.level = mc->level;
+    u.guard_x = u.cell_x;
+    u.guard_y = u.cell_y;
+    occ_.set(u.cell_x, u.cell_y, ui);
+    u.w7.bunker_of = bi;
+    u.w7.bunker_target = -1;
+    u.w7.bunker_dmg = depth_rules_.bunker_damage_mult;
+    u.w7.bunker_rof = depth_rules_.bunker_rof_mult;
+    u.w7.bunker_range = depth_rules_.bunker_range_bonus;
+    b.w7.bunker_unit = ui;
+    garrison_events_.push_back({GarrisonEvent::BunkerUp, bi, b.house});
+}
+
+// EmptyBunker / the sell and death release: the vehicle leaves its link and
+// stands on the nearest free cell beside the foundation, alive and unhurt.
+void World::bunker_release(int bi) {
+    if (bi < 0 || bi >= static_cast<int>(buildings_.size())) return;
+    Building& b = buildings_[static_cast<std::size_t>(bi)];
+    const int ui = b.w7.bunker_unit;
+    b.w7.bunker_unit = -1;
+    if (ui < 0 || ui >= static_cast<int>(units_.size())) return;
+    Unit& u = units_[static_cast<std::size_t>(ui)];
+    if (u.w7.bunker_of != bi) return;
+    u.w7.bunker_of = -1;
+    u.w7.bunker_dmg = u.w7.bunker_rof = 1.0;
+    u.w7.bunker_range = 0.0;
+    garrison_events_.push_back({GarrisonEvent::BunkerDown, bi, b.house});
+    if (!u.alive || u.die_time >= 0.0) return;
+    occ_.release_all_of(ui, -1, -1);   // the cell on the foundation is not free ground
+    int layer = 0;
+    Cellxy c = nearest_exit_from_host(u, b.cx + b.fw, b.cy + b.fh, 0, &layer);
+    if (c.x < 0) c = Cellxy{b.cx + b.fw - 1, b.cy + b.fh - 1};   // nowhere to go: stay on the pad
+    u.cell_x = c.x;
+    u.cell_y = c.y;
+    u.fx = c.x;
+    u.fy = c.y;
+    u.sub_x = u.sub_y = 0.0;
+    u.guard_x = c.x;
+    u.guard_y = c.y;
+    u.on_deck = static_cast<std::uint8_t>(layer == 1 ? 1 : 0);
+    if (map_) if (const ra2assets::MapCell* mc = map_->at(c.x, c.y)) u.level = mc->level;
+    occ_.set(c.x, c.y, ui);
+}
+
+void World::step_bunkers() {
+    for (int ui = 0; ui < static_cast<int>(units_.size()); ++ui) {
+        Unit& u = units_[static_cast<std::size_t>(ui)];
+        const int bi = u.w7.bunker_target;
+        if (bi < 0) continue;
+        if (!can_bunker(ui, bi)) { u.w7.bunker_target = -1; continue; }
+        if (u.moving()) continue;
+        const Building& b = buildings_[static_cast<std::size_t>(bi)];
+        if (cheb_to_foundation(b, u.cell_x, u.cell_y) <= 1) {
+            bunker_install(ui, bi);
+            continue;
+        }
+        order_bunker(ui, bi);   // blocked on the way: ask again once
+        if (!units_[static_cast<std::size_t>(ui)].moving()) units_[static_cast<std::size_t>(ui)].w7.bunker_target = -1;
+    }
+    for (int bi = 0; bi < static_cast<int>(buildings_.size()); ++bi) {
+        Building& b = buildings_[static_cast<std::size_t>(bi)];
+        const int ui = b.w7.bunker_unit;
+        if (ui < 0) continue;
+        const bool bad_unit = ui >= static_cast<int>(units_.size()) || !units_[static_cast<std::size_t>(ui)].alive ||
+                              units_[static_cast<std::size_t>(ui)].die_time >= 0.0 ||
+                              units_[static_cast<std::size_t>(ui)].w7.bunker_of != bi;
+        if (bad_unit) {   // it died, was erased or mind-controlled away: the bunker is free again
+            b.w7.bunker_unit = -1;
+            if (ui < static_cast<int>(units_.size()) && units_[static_cast<std::size_t>(ui)].w7.bunker_of == bi) {
+                Unit& u = units_[static_cast<std::size_t>(ui)];
+                u.w7.bunker_of = -1;
+                u.w7.bunker_dmg = u.w7.bunker_rof = 1.0;
+                u.w7.bunker_range = 0.0;
+            }
+            garrison_events_.push_back({GarrisonEvent::BunkerDown, bi, b.house});
+            continue;
+        }
+        // The bunker died or is being sold, or changed hands (an engineer, a
+        // trigger): the vehicle drives out [RE: @0x4593A0 / ClearBunker].
+        if (!b.alive || b.state == Building::State::Dead || b.selling || units_[static_cast<std::size_t>(ui)].house != b.house)
+            bunker_release(bi);
+    }
+}
+
+}  // namespace ra2engine
