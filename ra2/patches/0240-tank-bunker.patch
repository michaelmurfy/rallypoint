+TEST_CASE("Tank Bunker: the new fields survive a save round trip") {
+    UnitW7 u;
+    u.bunker_of = 3; u.bunker_target = 4; u.bunker_dmg = 1.3; u.bunker_rof = 1.3; u.bunker_range = 2.0;
