+// Tank Bunker (Rallypoint 0240): Bunker= / Bunkerable= against the real rulesmd.ini, and the
+// mechanic in a World (enter, protection, bunker bonuses, unload, sell, destruction, save).
+// Real-data cases need RA2_INSTALL_DIR and fail (not skip) when it is set but the files are missing.
+#include "doctest.h"
+
+#include <cstdlib>
+#include <string>
+
+#include "asset_fixture.hpp"
+#include "../engine/ai_team.hpp"
+#include "../engine/save_fields.hpp"
+#include "../engine/savegame.hpp"
+#include "../engine/selection.hpp"
+#include "../engine/weapon_resolve.hpp"
+#include "../engine/world.hpp"
+
+using namespace ra2engine;
+
+namespace {
+bool have_assets() {
+    if (ra2fixture::assets_available()) return true;
+    if (std::getenv("RA2_INSTALL_DIR")) FAIL("RA2_INSTALL_DIR set but real assets missing");
+    MESSAGE("skipped: real assets not found");
+    return false;
+}
+bool yes(const std::string& v) { return !v.empty() && (v[0] == 'y' || v[0] == 'Y' || v[0] == 't' || v[0] == '1'); }
+
+UnitCombat mk_tank() {
+    UnitCombat t;
+    t.strength = 300;
+    t.damage = 40;
+    t.rof = 30;
+    t.range = 5.0;
+    t.is_vehicle = true;
+    t.speed_cps = 3.0;
+    t.rot = 127;
+    t.w7.bunkerable = true;
+    t.w7.has_turret = true;
+    return t;
+}
+
+// A free walkable block on the real map: bunker origin (ox, oy) with room to the west and south.
+bool free_block(const World& w, int& ox, int& oy) {
+    for (int y = 12; y + 10 < w.grid_h() - 2; ++y)
+        for (int x = 12; x + 14 < w.grid_w() - 2; ++x) {
+            bool ok = true;
+            for (int dy = -2; dy <= 8 && ok; ++dy)
+                for (int dx = -8; dx <= 10 && ok; ++dx) ok = w.walkable(x + dx, y + dy);
+            if (ok) { ox = x; oy = y; return true; }
+        }
+    return false;
+}
+
+struct BunkerWorld {
+    World w{ra2fixture::mapsmd03_map()};
+    int ox = 0, oy = 0;
+    int bunker = -1;
+    BunkerWorld() {
+        REQUIRE(free_block(w, ox, oy));
+        BuildingTypeDef b;
+        b.id = "NATBNK";
+        b.strength = 1000;
+        b.fw = b.fh = 2;
+        b.bunker = true;
+        b.armor_ix = 0;
+        World::DepthRules r;
+        r.bunker_damage_mult = 1.3;
+        r.bunker_rof_mult = 1.3;
+        r.bunker_range_bonus = 2;
+        w.set_depth_rules(r);
+        w.set_building_types({b});
+        bunker = w.add_building(0, ox, oy, 2, 2, 0, 1000, 0, 0.0, true);
+    }
+    int add_tank(int dx, int dy, int house = 0) { w.add_combat_unit(ox + dx, oy + dy, house, mk_tank()); return static_cast<int>(w.units().size()) - 1; }
+    void run(int frames) { for (int f = 0; f < frames; ++f) w.step(1.0 / 15.0); }
+};
+}  // namespace
+
+TEST_CASE("Tank Bunker: Bunker= and Bunkerable= in the real rules") {
+    if (!have_assets()) return;
+    const ra2assets::Ini& r = ra2fixture::rulesmd_ini();
+    const ra2assets::Rules& rules = ra2fixture::rulesmd();
+    // Exactly one building is a Tank Bunker.
+    int bunkers = 0;
+    for (const auto& kv : r.section("BuildingTypes")) {
+        BuildingTypeDef d;
+        fill_building_weapons(rules, kv.second, d);
+        if (d.bunker) { ++bunkers; CHECK(kv.second == "NATBNK"); }
+    }
+    CHECK(bunkers == 1);
+    // Vehicles default to Bunkerable=yes; 17 opt out; infantry and aircraft default to no.
+    int opt_out = 0, vehicles = 0;
+    for (const auto& kv : r.section("VehicleTypes")) {
+        const TypeWeapons tw = resolve_type_weapons(rules, kv.second);
+        UnitTypeW7 w;
+        fill_unit_w7(rules, kv.second, tw, w);
+        const bool explicit_no = r.get(kv.second, "Bunkerable", "") == "no";
+        CHECK(w.bunkerable == !explicit_no);
+        ++vehicles;
+        if (explicit_no) ++opt_out;
+    }
+    CHECK(vehicles > 40);
+    CHECK(opt_out == 17);
+    for (const char* inf : {"E1", "E2", "ENGINEER"}) {
+        UnitTypeW7 w;
+        fill_unit_w7(rules, inf, resolve_type_weapons(rules, inf), w);
+        CHECK_FALSE(w.bunkerable);
+    }
+    for (const char* tank : {"MTNK", "HTNK", "FV", "LTNK", "TNKD"}) {   // Grizzly, Rhino, IFV, Lasher, Tank Destroyer
+        if (r.get(tank, "Strength", "").empty()) continue;
+        UnitTypeW7 w;
+        fill_unit_w7(rules, tank, resolve_type_weapons(rules, tank), w);
+        CHECK(w.bunkerable);
+    }
+    for (const char* no : {"AMCV", "SMCV", "HARV", "CMIN", "V3", "TERROR"}) {
+        if (r.get(no, "Strength", "").empty()) continue;
+        UnitTypeW7 w;
+        fill_unit_w7(rules, no, resolve_type_weapons(rules, no), w);
+        CHECK_FALSE(w.bunkerable);
+    }
+    // The shot multipliers the engine reads.
+    CHECK(rules.section_double("CombatDamage", "BunkerDamageMultiplier", 1.0) == doctest::Approx(1.3));
+    CHECK(rules.section_double("CombatDamage", "BunkerROFMultiplier", 1.0) == doctest::Approx(1.3));
+    CHECK(rules.section_double("CombatDamage", "BunkerWeaponRangeBonus", 0.0) == doctest::Approx(2.0));
+    CHECK(r.get("AudioVisual", "BunkerWallsUpSound", "").find("TankBunkerUp") != std::string::npos);
+}
+
+TEST_CASE("Tank Bunker: PenetratesBunker warheads of the real rules") {
+    if (!have_assets()) return;
+    const ra2assets::Ini& r = ra2fixture::rulesmd_ini();
+    for (const char* wh : {"Super", "Crush", "ORCAAP", "DiskWH"}) CHECK(yes(r.get(wh, "PenetratesBunker", "no")));
+    CHECK_FALSE(yes(r.get("AP", "PenetratesBunker", "no")));
+}
+
+#define NEED_MAP()                                                           \
+    if (!ra2fixture::mapsmd03_available()) {                                 \
+        if (std::getenv("RA2_INSTALL_DIR")) FAIL("RA2_INSTALL_DIR set but real map missing"); \
+        MESSAGE("skipped: real map assets not found");                       \
+        return;                                                              \
+    }
+
+TEST_CASE("Tank Bunker: a free own bunker takes one armed, turreted vehicle") {
+    NEED_MAP();
+    BunkerWorld t;
+    const int a = t.add_tank(-10, 0), b = t.add_tank(-8, 0), foe = t.add_tank(-6, 0, 1);
+    CHECK(t.w.can_bunker(a, t.bunker));
+    CHECK_FALSE(t.w.can_bunker(foe, t.bunker));               // another house
+    t.w.units()[static_cast<std::size_t>(b)].w7.t.bunkerable = false;   // Bunkerable=no (MCV, miners, V3...)
+    CHECK_FALSE(t.w.can_bunker(b, t.bunker));
+    t.w.units()[static_cast<std::size_t>(b)].w7.t.bunkerable = true;
+    t.w.units()[static_cast<std::size_t>(b)].w7.t.has_turret = false;   // no Turret=
+    CHECK_FALSE(t.w.can_bunker(b, t.bunker));
+    t.w.units()[static_cast<std::size_t>(b)].w7.t.has_turret = true;
+    t.w.units()[static_cast<std::size_t>(b)].speed_type = 3;            // Hover
+    CHECK_FALSE(t.w.can_bunker(b, t.bunker));
+    t.w.units()[static_cast<std::size_t>(b)].speed_type = -1;
+    t.w.units()[static_cast<std::size_t>(b)].w_damage = 0;              // no weapon
+    CHECK_FALSE(t.w.can_bunker(b, t.bunker));
+    t.w.units()[static_cast<std::size_t>(b)].w_damage = 40;
+    CHECK(t.w.can_bunker(b, t.bunker));
+    CHECK(t.w.group_occupy_count(0, {a, b}, t.bunker) == 1);   // one vehicle per bunker
+}
+
+TEST_CASE("Tank Bunker: the vehicle drives in, faces south and stops taking orders") {
+    NEED_MAP();
+    BunkerWorld t;
+    const int a = t.add_tank(-6, 0);
+    CHECK(t.w.group_occupy(0, {a}, t.bunker) == 1);
+    t.run(300);
+    const Unit& u = t.w.units()[static_cast<std::size_t>(a)];
+    REQUIRE(u.w7.bunker_of == t.bunker);
+    CHECK(t.w.buildings()[static_cast<std::size_t>(t.bunker)].w7.bunker_unit == a);
+    CHECK(u.fx + u.sub_x / 256.0 == doctest::Approx(t.ox + 0.5));   // the foundation centre
+    CHECK(u.fy + u.sub_y / 256.0 == doctest::Approx(t.oy + 0.5));
+    CHECK(u.body_facing == doctest::Approx(32768.0));
+    CHECK(u.w7.bunker_dmg == doctest::Approx(1.3));
+    CHECK(u.w7.bunker_range == doctest::Approx(2.0));
+    CHECK(Selection::unselectable(u));
+    // No order moves it, and a second vehicle is refused.
+    const int cx = u.cell_x, cy = u.cell_y;
+    t.w.order_unit_move(a, 30, 30);
+    t.run(30);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].cell_x == cx);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].cell_y == cy);
+    const int b = t.add_tank(-6, 4);
+    CHECK_FALSE(t.w.can_bunker(b, t.bunker));
+    // The occupied bunker is armed as far as an enemy's threat scan goes.
+    CHECK(t.w.bunker_occupied(t.bunker));
+}
+
+TEST_CASE("Tank Bunker: a bunkered vehicle is not a target and takes no damage; the bunker does") {
+    NEED_MAP();
+    BunkerWorld t;
+    const int a = t.add_tank(-6, 0);
+    t.w.group_occupy(0, {a}, t.bunker);
+    t.run(300);
+    REQUIRE(t.w.units()[static_cast<std::size_t>(a)].w7.bunker_of == t.bunker);
+    const int foe = t.add_tank(2, 4, 1);
+    t.w.units()[static_cast<std::size_t>(foe)].w_range = 8.0;
+    t.w.group_attack(1, {foe}, a);   // an order against the vehicle itself
+    t.run(120);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].hp == 300);
+    t.w.units()[static_cast<std::size_t>(foe)].target = -1;   // idle: it picks the manned bunker on its own
+    t.run(150);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].hp == 300);
+    CHECK(t.w.buildings()[static_cast<std::size_t>(t.bunker)].hp < 1000);
+}
+
+TEST_CASE("Tank Bunker: range bonus, damage and rate of fire come from the bunker") {
+    NEED_MAP();
+    BunkerWorld t;
+    const int a = t.add_tank(-6, 0);
+    t.w.group_occupy(0, {a}, t.bunker);
+    t.run(300);
+    REQUIRE(t.w.units()[static_cast<std::size_t>(a)].w7.bunker_of == t.bunker);
+    // Weapon range 5 + bonus 2 = 7 cells from the bunker centre (20.5, 20.5): a target at 6.8 cells
+    // is out of reach for a loose tank and in reach from the bunker.
+    UnitCombat dummy = mk_tank();
+    dummy.damage = 0;
+    dummy.strength = 1000;
+    t.w.add_combat_unit(t.ox + 7, t.oy, 1, dummy);
+    const int d = static_cast<int>(t.w.units().size()) - 1;
+    t.run(60);
+    CHECK(t.w.units()[static_cast<std::size_t>(d)].hp < 1000);
+    // First hit is 40 x 1.3 = 52.
+    CHECK((1000 - t.w.units()[static_cast<std::size_t>(d)].hp) % 52 == 0);
+    // ROF 30 / 1.3 = 23 frames (+ jitter) between shots: more shots than the loose rate.
+    const int shots = (1000 - t.w.units()[static_cast<std::size_t>(d)].hp) / 52;
+    CHECK(shots >= 2);
+    CHECK(t.w.units()[static_cast<std::size_t>(a)].cell_x == t.ox + 1);   // it did not move to get there
+}
+
+TEST_CASE("Tank Bunker: Deploy (unload), sell and destruction put the vehicle beside the bunker, alive") {
+    NEED_MAP();
+    for (int how = 0; how < 3; ++how) {
+        BunkerWorld t;
+        const int a = t.add_tank(-6, 0);
+        t.w.group_occupy(0, {a}, t.bunker);
+        t.run(300);
+        REQUIRE(t.w.units()[static_cast<std::size_t>(a)].w7.bunker_of == t.bunker);
+        if (how == 0) t.w.bunker_release(t.bunker);
+        else if (how == 1) REQUIRE(t.w.begin_sell(t.bunker, 0));
+        else { t.w.buildings()[static_cast<std::size_t>(t.bunker)].hp = 0; kill_building(t.w.buildings()[static_cast<std::size_t>(t.bunker)]); }
+        t.run(5);
+        const Unit& u = t.w.units()[static_cast<std::size_t>(a)];
+        CHECK(u.w7.bunker_of == -1);
+        CHECK(t.w.buildings()[static_cast<std::size_t>(t.bunker)].w7.bunker_unit == -1);
+        CHECK(u.alive);
+        CHECK(u.hp == 300);
+        CHECK(u.w7.bunker_dmg == doctest::Approx(1.0));
+        CHECK_FALSE(Selection::unselectable(u));
+        const bool beside = (u.cell_x < t.ox || u.cell_x > t.ox + 1 || u.cell_y < t.oy || u.cell_y > t.oy + 1);
+        CHECK(beside);
+        // It takes orders again.
+        t.w.order_unit_move(a, u.cell_x, u.cell_y + 3);
+        CHECK(t.w.units()[static_cast<std::size_t>(a)].moving());
+    }
+}
