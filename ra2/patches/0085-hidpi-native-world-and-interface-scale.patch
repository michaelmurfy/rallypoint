+TEST_CASE("world scale is native, interface scale is whole") {
+    int w = 0, h = 0;
+    // 3440x1440 Retina drawable: interface x2, world native (0.5 canvas px per world px).
+    desktop_canvas(3440, 1440, w, h);
+    CHECK(w == 1720); CHECK(h == 720);
+    CHECK(zoom_start(2.0, 1.0) == doctest::Approx(0.5));
+    CHECK(zoom_view(w - 168, 0.5) == 2 * (1720 - 168));     // the world view is the screen's own pixels
+    CHECK(zoom_to_view(100, 0.5) == 200);
+    // 1080p 1x: native is zoom 1, units may grow to 2 screen pixels.
+    desktop_canvas(1920, 1080, w, h);
+    CHECK(w == 1920); CHECK(h == 1080);
+    CHECK(zoom_start(1.0, 1.0) == doctest::Approx(1.0));
+    CHECK(zoom_start(1.0, 1.5) == doctest::Approx(1.5));
+    CHECK(zoom_start(1.0, 9.0) == doctest::Approx(1.0));      // out of range: Automatic
+    // 2560x1600 at 2x = 5120x3200: interface x3, world native 1/3, and 2x = 2/3.
+    desktop_canvas(5120, 3200, w, h);
+    CHECK(h == 1066);
+    CHECK(zoom_start(3.0, 1.0) == doctest::Approx(1.0 / 3.0));
+    CHECK(zoom_start(3.0, 2.0) == doctest::Approx(2.0 / 3.0));
+    CHECK(zoom_max(3.0) == doctest::Approx(1.0));
+    CHECK(zoom_start(2.0, 4.0) == doctest::Approx(1.0));       // never past zoom_max
+    // Interface size picks k, but never leaves less than 720 lines.
+    desktop_canvas(3440, 1440, w, h, 1);
+    CHECK(h == 1440);
+    desktop_canvas(1920, 1080, w, h, 3);
+    CHECK(h == 1080);
+    desktop_canvas(3840, 2160, w, h, 3);
+    CHECK(h == 720);
+}
