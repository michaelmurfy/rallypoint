diff --git a/tests/test_logical_canvas.cpp b/tests/test_logical_canvas.cpp
new file mode 100644
index 0000000..d9c49e8
--- /dev/null
+++ b/tests/test_logical_canvas.cpp
@@ -0,0 +1,34 @@
+#include "doctest.h"
+#include "../engine/logical_canvas.hpp"
+
+static void canvas(int ww, int wh, int& w, int& h) {
+    ra2engine::logical_size_for_height(ra2engine::desktop_logical_height(wh), ww, wh, w, h);
+}
+
+TEST_CASE("desktop logical canvas follows the window, 720..1440") {
+    int w = 0, h = 0;
+    canvas(800, 600, w, h);
+    CHECK(w == 1280);
+    CHECK(h == 720);
+    canvas(1280, 720, w, h);
+    CHECK(w == 1280);
+    CHECK(h == 720);
+    canvas(1600, 900, w, h);
+    CHECK(w == 1600);
+    CHECK(h == 900);
+    canvas(1920, 1080, w, h);
+    CHECK(w == 1920);
+    CHECK(h == 1080);
+    canvas(2560, 1440, w, h);
+    CHECK(w == 2560);
+    CHECK(h == 1440);
+    canvas(3840, 2160, w, h);
+    CHECK(w == 2560);
+    CHECK(h == 1440);
+    canvas(3440, 1440, w, h);
+    CHECK(w == 3440);
+    CHECK(h == 1440);
+    canvas(5120, 1440, w, h);
+    CHECK(w == 1440 * 239 / 100);
+    CHECK(h == 1440);
+}
