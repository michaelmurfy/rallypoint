diff --git a/engine/logical_canvas.hpp b/engine/logical_canvas.hpp
new file mode 100644
index 0000000..81b2f37
--- /dev/null
+++ b/engine/logical_canvas.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+namespace ra2engine {
+
+// Desktop tactical-view height from the window's pixel height. A bigger
+// window shows more of the map (the original grew with ScreenHeight) instead
+// of magnifying a 720-line picture. 720 is the floor so a small window keeps
+// today's canvas; 1440 is the cap so a 4K window does not draw 4K of sprites.
+inline int desktop_logical_height(int output_h) {
+    int lh = output_h;
+    if (lh < 720) lh = 720;
+    if (lh > 1440) lh = 1440;
+    return lh & ~1;
+}
+
+// Width is `lh` times the window's aspect, kept between 16:9 and ~21:9.
+// Narrower windows letterbox; wider ones gain map until the cap.
+inline void logical_size_for_height(int lh, int window_w, int window_h, int& out_w, int& out_h) {
+    const int lw = static_cast<int>(std::lround(static_cast<double>(lh) * window_w / window_h)) & ~1;
+    out_h = lh;
+    out_w = std::max(lh * 16 / 9, std::min(lh * 239 / 100, lw));
+}
+
+}  // namespace ra2engine
