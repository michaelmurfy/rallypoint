+TEST_CASE("0265: a Terror Drone (infantry-path SHP vehicle) advances the walk stage") {
+    using ra2engine::unit_advances_walk_stage;
+    ra2engine::Unit drone;   // DRON: combat is_vehicle/is_aircraft/is_naval all false
+    drone.alive = true;
+    drone.die_time = -1.0;
+    // Drawn through the SHP-vehicle frame rule (g_shp_vehicles): must tick,
+    // or its walk frames never step while it moves.
+    CHECK(unit_advances_walk_stage(drone, /*shp_vehicle=*/true));
+    // An infantry-path unit with no SHP-vehicle draw keeps the old behavior.
+    CHECK_FALSE(unit_advances_walk_stage(drone, /*shp_vehicle=*/false));
+    // Vehicles are unaffected by the new flag.
+    ra2engine::Unit tank;
+    tank.alive = true;
+    tank.die_time = -1.0;
+    tank.is_vehicle = true;
+    CHECK(unit_advances_walk_stage(tank, false));
+    CHECK(unit_advances_walk_stage(tank, true));
+    // Dead / dying units never advance, SHP draw or not.
+    drone.alive = false;
+    CHECK_FALSE(unit_advances_walk_stage(drone, true));
+    drone.alive = true;
+    drone.die_time = 0.0;
+    CHECK_FALSE(unit_advances_walk_stage(drone, true));
+}
