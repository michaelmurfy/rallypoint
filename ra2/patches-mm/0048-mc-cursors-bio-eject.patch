diff --git a/engine/world_grinder_bio.cpp b/engine/world_grinder_bio.cpp
--- a/engine/world_grinder_bio.cpp
+++ b/engine/world_grinder_bio.cpp
@@ -1,8 +1,20 @@
 // Yuri Grinder / Bio Reactor enter fates (skirmish CaptureManager victims).
- // Grinding: destroy the unit, pay Soylent to the building's house, free the
- // MC slot without restoring the original house (unit is dead). InfantryAbsorb
- // (YAPOWR): limbo into occupants, free the MC slot but keep the controller's
- // house so ExtraPower still counts (YR: release capacity while they sit inside).
+//
+// RE (Steam YR gamemd.exe):
+//   BuildingType LoadFromINI @0x460971 / @0x4609A9: Grinding=+0x16AD,
+//   UnitAbsorb=+0x16AE, InfantryAbsorb=+0x16AF; ExtraPower=+0xEE8 @0x4610B3.
+//   InfantryClass::What_Action FUN_0051E010 @0x51E643 (and UnitClass @0x73F645 /
+//   @0x7401AD): Grinding -> ACTION_ENTER 0x0B (else NoEnter).
+//   Mission_Enter FUN_00519449 @0x51989F grinds; @0x51A2E5 / FUN_004598A0
+//   gates InfantryAbsorb|UnitAbsorb boarding.
+//   BuildingClass::Mission_Unload FUN_0044D880 @0x44D8B1 ejects absorb
+//   occupants via UnloadOccupants FUN_00457DD0; What_Action @0x44731C shows
+//   ACTION_DEPLOY when those buildings have occupants.
+//
+// Grinding: destroy the unit, pay Soylent to the building's house, free the
+// MC slot without restoring the original house (unit is dead). InfantryAbsorb
+// (YAPOWR): limbo into occupants, free the MC slot but keep the controller's
+// house so ExtraPower still counts (YR: release capacity while they sit inside).
 #include "world.hpp"
 
 #include "grinder_bio.hpp"
diff --git a/tests/test_grinder_bio.cpp b/tests/test_grinder_bio.cpp
--- a/tests/test_grinder_bio.cpp
+++ b/tests/test_grinder_bio.cpp
@@ -149,3 +149,60 @@
     const auto pt = power_totals(w.buildings(), w.btypes(), 0);
     CHECK(pt.output == 250);   // 150 + 100
 }
+
+TEST_CASE("group_occupy: orders grind and absorb enters (Mission_Enter)") {
+    GB_WORLD(w, x0, y0);
+    BuildingTypeDef grind;
+    grind.id = "YAGRND";
+    grind.fw = 2;
+    grind.fh = 2;
+    grind.grinding = true;
+    BuildingTypeDef reactor;
+    reactor.id = "YAPOWR";
+    reactor.fw = 2;
+    reactor.fh = 2;
+    reactor.infantry_absorb = true;
+    reactor.extra_power = 100;
+    reactor.passengers = 5;
+    reactor.power = 150;
+    w.set_building_types({grind, reactor});
+    const int gi = w.add_building(0, x0 + 4, y0, 2, 2, 0, 900, 0, 0.0, true);
+    const int ri = w.add_building(1, x0 + 8, y0, 2, 2, 0, 700, 0, 0.0, true);
+    w.add_combat_unit(x0, y0, 0, mk_gi());
+    w.add_combat_unit(x0 + 2, y0, 0, mk_gi());
+    CHECK(w.group_occupy_count(0, {0}, gi) == 1);
+    CHECK(w.group_occupy(0, {0}, gi) == 1);
+    CHECK(w.units()[0].occupy_target == gi);
+    CHECK(w.group_occupy_count(0, {1}, ri) == 1);
+    CHECK(w.group_occupy(0, {1}, ri) == 1);
+    CHECK(w.units()[1].occupy_target == ri);
+}
+
+TEST_CASE("bio reactor: Deploy unload_occupants ejects and keeps house") {
+    GB_WORLD(w, x0, y0);
+    BuildingTypeDef reactor;
+    reactor.id = "YAPOWR";
+    reactor.fw = 2;
+    reactor.fh = 2;
+    reactor.infantry_absorb = true;
+    reactor.extra_power = 100;
+    reactor.passengers = 5;
+    reactor.power = 150;
+    w.set_building_types({reactor});
+    const int bi = w.add_building(0, x0 + 4, y0, 2, 2, 0, 700, 0, 0.0, true);
+    w.add_combat_unit(x0, y0, 0, mk_gi());
+    w.add_combat_unit(x0 + 2, y0, 0, mk_gi());
+    REQUIRE(w.absorb_now(0, bi));
+    REQUIRE(w.absorb_now(1, bi));
+    CHECK(w.buildings()[bi].occupants.size() == 2);
+    CHECK(w.buildings()[bi].house == 0);
+    w.unload_occupants(bi);
+    CHECK(w.buildings()[bi].occupants.empty());
+    CHECK(w.buildings()[bi].house == 0);   // must not flip to neutral
+    CHECK(w.units()[0].garrison_of < 0);
+    CHECK(w.units()[0].cargo_of < 0);
+    CHECK(w.units()[0].alive);
+    CHECK(w.units()[1].alive);
+    const auto pt = power_totals(w.buildings(), w.btypes(), 0);
+    CHECK(pt.output == 150);   // ExtraPower gone with occupants
+}
